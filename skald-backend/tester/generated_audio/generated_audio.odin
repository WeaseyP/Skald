	for i in 0..<4 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_3_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_3_stage = .Release
	}
}

Lead_trigger :: proc(p: ^Lead_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (f32(0.004000000)) + (f32(0.140000000)) > d do d = (f32(0.004000000)) + (f32(0.140000000))
		if d <= 0.0 do d = 0.001
	}
	Lead_note_on(p, note, velocity, d)
}

Lead_feed_input :: proc(p: ^Lead_Processor, in_left: f32, in_right: f32) {
	p.ext_in_l = in_left
	p.ext_in_r = in_right
}

Lead_start :: proc(p: ^Lead_Processor) {
	p.playing = true
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
}

Lead_stop :: proc(p: ^Lead_Processor) {
	p.playing = false
}

Lead_set_loop :: proc(p: ^Lead_Processor, loop: bool) {
	p.loop = loop
}

Lead_set_volume :: proc(p: ^Lead_Processor, value: f32) {
	p.volume = math.clamp(value, 0.0, 1.0)
}

Lead_is_playing :: proc(p: ^Lead_Processor) -> bool {
	if p.playing do return true
	for i in 0..<4 {
		if p.voices[i].active do return true
	}
	return false
}

Lead_PARAMS := []Skald_Param_Info{
}

Lead_set_param :: proc(p: ^Lead_Processor, name: string, value: f32) -> bool {
	return false
}

Lead_get_param :: proc(p: ^Lead_Processor, name: string) -> (f32, bool) {
	return 0.0, false
}

Lead_process :: proc(p: ^Lead_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	p.total_samples += 1

	for v_idx in 0..<4 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.current_freq != voice.target_freq {
			glide_k := 1.0 / math.max(voice.glide_time * sample_rate, 1.0)
			if glide_k > 1.0 do glide_k = 1.0
			voice.current_freq += (voice.target_freq - voice.current_freq) * glide_k
			if abs(voice.target_freq - voice.current_freq) < 0.1 do voice.current_freq = voice.target_freq
		}
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_3_stage != .Release && voice.adsr_3_stage != .Idle {
				voice.adsr_3_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_1_out: f32 = 0.0
		node_2_out: f32 = 0.0
		node_3_out: f32 = 0.0
		node_4_out: f32 = 0.0

		// --- MIDI Input Node 1 ---
		node_1_out_pitch := (f32(voice.note) - 69.0) / 12.0
		node_1_out_gate := f32(1.0)
		if voice.time_released > 0.0 do node_1_out_gate = 0.0
		node_1_out_velocity := voice.velocity

		// --- Oscillator Node 2 (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 2;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (6.000000000);
				detuned_freq: f32 = ((voice.current_freq) * math.pow(2.0, math.clamp(f32(node_1_out_pitch), -10.0, 10.0))) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_2_phase[i] = math.mod(voice.osc_2_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_2_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += ((final_phase / f32(math.PI)) - 1.0);
			}
			node_2_out = (unison_out / f32(unison_count)) * (f32(0.500000000));
		}

		// --- ADSR Node 3 ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_3_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.004000000)) > 0 do envelope = voice.adsr_3_attack_start + (1.0 - voice.adsr_3_attack_start) * (voice.age / math.max(f32(f32(0.004000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_3_release_level = envelope;
				if voice.age >= (f32(0.004000000)) {
					voice.adsr_3_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.004000000));
				if (f32(0.140000000)) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(f32(0.140000000)), 0.000001)) * (1.0 - (f32(0.600000000))); else do envelope = (f32(0.600000000));
				voice.adsr_3_release_level = envelope;
				if time_in_decay >= (f32(0.140000000)) {
					voice.adsr_3_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.600000000));
				voice.adsr_3_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.220000000)) > 0 do envelope = voice.adsr_3_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.220000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_3_stage = .Idle;
				}
			}
			vel_scale_3: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_3_out = ((node_1_out_gate + node_2_out)) * envelope * (f32(1.000000000)) * vel_scale_3;
		}

		output_left += node_3_out
		output_right += node_3_out
		if voice.adsr_3_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	if math.is_nan(output_left) || math.is_inf(output_left) || math.is_nan(output_right) || math.is_inf(output_right) {
		p.nonfinite_count += 1
		output_left, output_right = 0.0, 0.0
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
Lead_process_sequence :: proc(p: ^Lead_Processor) {
}

Kick_2_Voice_State :: struct {
	active: bool,
	note: u8,
	velocity: f32,
	age: f32,
	time_released: f32,
	current_freq: f32,
	target_freq: f32,
	glide_time: f32,
	duration: f32,
	noise_1_rng: PRNG_State,
	adsr_2_stage: ADSR_Stage,
	adsr_2_release_level: f32,
	adsr_2_attack_start: f32,
}

Kick_2_Processor :: struct {
	sample_rate: f32,
	bpm: f32,
	voices: [1]Kick_2_Voice_State,
	prng: PRNG_State,
	total_samples: u64,
	playing: bool,
	loop: bool,
	current_step: u64,
	samples_until_next_step: u64,
	step_frac_acc: f32,
	ext_in_l: f32,
	ext_in_r: f32,
	volume: f32,
	nonfinite_count: i32,
}

Kick_2_init :: proc(p: ^Kick_2_Processor, sr: f32) {
	p.sample_rate = sr
	p.bpm = 120.000000000
	p.volume = 0.800000012
	p.prng.state = 12345
	p.loop = true
	p.voices = {}
	p.total_samples = 0
	p.playing = false
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
	p.ext_in_l = 0.0
	p.ext_in_r = 0.0
	p.nonfinite_count = 0
	for i in 0..<1 {
		v := &p.voices[i]
		v.noise_1_rng.state = u32(0xC0FFEE01) ~ u32(i + 1) * 2654435761
	}
}

Kick_2_note_on :: proc(p: ^Kick_2_Processor, note: u8, velocity: f32, duration: f32) {
	// note and velocity are clamped silently to their MIDI/normalized domains.
	note := note
	if note > 127 do note = 127
	velocity := math.clamp(velocity, 0.0, 1.0)
	voice_idx := -1
	for i in 0..<1 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_releasing_age: f32 = -1.0
		for i in 0..<1 {
			releasing := true
			if p.voices[i].adsr_2_stage != .Release && p.voices[i].adsr_2_stage != .Idle do releasing = false
			if releasing && p.voices[i].age > oldest_releasing_age {
				oldest_releasing_age = p.voices[i].age
				voice_idx = i
			}
		}
		if voice_idx == -1 {
			oldest_age: f32 = -1.0
			for i in 0..<1 {
				if p.voices[i].age > oldest_age {
					oldest_age = p.voices[i].age
					voice_idx = i
				}
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	adsr_2_prev_level: f32 = 0.0
	if stolen && v.adsr_2_stage != .Idle {
		adsr_2_prev_level = v.adsr_2_release_level
		if v.adsr_2_stage == .Release {
			rel_t_2: f32 = (f32(0.030000000));
			if rel_t_2 > 0.0 {
				rf_2 := 1.0 - (v.age - v.time_released) / math.max(rel_t_2, 0.000001)
				if rf_2 < 0.0 do rf_2 = 0.0
				adsr_2_prev_level *= rf_2
			} else {
				adsr_2_prev_level = 0.0
			}
		}
	}
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.000000000
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	v.adsr_2_stage = .Attack
	v.adsr_2_attack_start = adsr_2_prev_level
	v.adsr_2_release_level = adsr_2_prev_level
}

Kick_2_note_off :: proc(p: ^Kick_2_Processor, note: u8) {
	// Clamped to match _note_on: `note` is the voice key, so both must map it.
	note := note
	if note > 127 do note = 127
	best := -1
	best_age: f32 = -1.0
	for i in 0..<1 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_2_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_2_stage = .Release
	}
}

Kick_2_trigger :: proc(p: ^Kick_2_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (f32(0.001000000)) + (f32(0.040000000)) > d do d = (f32(0.001000000)) + (f32(0.040000000))
		if d <= 0.0 do d = 0.001
	}
	Kick_2_note_on(p, note, velocity, d)
}

Kick_2_feed_input :: proc(p: ^Kick_2_Processor, in_left: f32, in_right: f32) {
	p.ext_in_l = in_left
	p.ext_in_r = in_right
}

