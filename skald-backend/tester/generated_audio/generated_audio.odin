		if p.voices[i].active do return true
	}
	return false
}

Kick_2_PARAMS := []Skald_Param_Info{
}

Kick_2_set_param :: proc(p: ^Kick_2_Processor, name: string, value: f32) -> bool {
	return false
}

Kick_2_get_param :: proc(p: ^Kick_2_Processor, name: string) -> (f32, bool) {
	return 0.0, false
}

Kick_2_process :: proc(p: ^Kick_2_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	p.total_samples += 1

	for v_idx in 0..<1 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_2_stage != .Release && voice.adsr_2_stage != .Idle {
				voice.adsr_2_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_1_out: f32 = 0.0
		node_2_out: f32 = 0.0
		node_3_out: f32 = 0.0

		// --- Noise Node 1 ---
		node_1_out = (next_float32(&voice.noise_1_rng) * 2.0 - 1.0) * (f32(0.500000000));

		// --- ADSR Node 2 ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_2_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.001000000)) > 0 do envelope = voice.adsr_2_attack_start + (1.0 - voice.adsr_2_attack_start) * (voice.age / math.max(f32(f32(0.001000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_2_release_level = envelope;
				if voice.age >= (f32(0.001000000)) {
					voice.adsr_2_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.001000000));
				if (f32(0.040000000)) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(f32(0.040000000)), 0.000001)) * (1.0 - (f32(0.000000000))); else do envelope = (f32(0.000000000));
				voice.adsr_2_release_level = envelope;
				if time_in_decay >= (f32(0.040000000)) {
					voice.adsr_2_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.000000000));
				voice.adsr_2_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.030000000)) > 0 do envelope = voice.adsr_2_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.030000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_2_stage = .Idle;
				}
			}
			vel_scale_2: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_2_out = ((node_1_out)) * envelope * (f32(1.000000000)) * vel_scale_2;
		}

		output_left += node_2_out
		output_right += node_2_out
		if voice.adsr_2_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	if math.is_nan(output_left) || math.is_inf(output_left) || math.is_nan(output_right) || math.is_inf(output_right) {
		p.nonfinite_count += 1
		output_left, output_right = 0.0, 0.0
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
