	{"Scoop_depth", 0.000000000, 1.000000000, 1.000000000, ""},
	{"Scoop_release", 0.001000000, 10.000000000, 0.050000001, "s"},
	{"Scoop_sustain", 0.000000000, 1.000000000, 1.000000000, ""},
	{"Vibrato_amplitude", 0.000000000, 20000.000000000, 0.020000000, ""},
	{"drive", 1.000000000, 100.000000000, 18.000000000, "x"},
	{"frequency", 0.010000000, 100.000000000, 5.500000000, "Hz"},
	{"outMin", -1000000.000000000, 1000000.000000000, -0.119999997, ""},
	{"tone", 100.000000000, 20000.000000000, 5000.000000000, "Hz"},
	{"velocitySensitivity", 0.000000000, 1.000000000, 0.800000012, ""},
}

Growly_Sax_set_param :: proc(p: ^Growly_Sax_Processor, name: string, value: f32) -> bool {
	switch name {
	case "Air_cutoff":
		Growly_Sax_set_Air_cutoff(p, value)
		return true
	case "Air_resonance":
		Growly_Sax_set_Air_resonance(p, value)
		return true
	case "Amp_attack":
		Growly_Sax_set_Amp_attack(p, value)
		return true
	case "Amp_decay":
		Growly_Sax_set_Amp_decay(p, value)
		return true
	case "Amp_depth":
		Growly_Sax_set_Amp_depth(p, value)
		return true
	case "Amp_release":
		Growly_Sax_set_Amp_release(p, value)
		return true
	case "Amp_sustain":
		Growly_Sax_set_Amp_sustain(p, value)
		return true
	case "Body_cutoff":
		Growly_Sax_set_Body_cutoff(p, value)
		return true
	case "Body_resonance":
		Growly_Sax_set_Body_resonance(p, value)
		return true
	case "Breath_amplitude":
		Growly_Sax_set_Breath_amplitude(p, value)
		return true
	case "Expression_mix":
		Growly_Sax_set_Expression_mix(p, value)
		return true
	case "Formant_cutoff":
		Growly_Sax_set_Formant_cutoff(p, value)
		return true
	case "Formant_resonance":
		Growly_Sax_set_Formant_resonance(p, value)
		return true
	case "Puff_attack":
		Growly_Sax_set_Puff_attack(p, value)
		return true
	case "Puff_decay":
		Growly_Sax_set_Puff_decay(p, value)
		return true
	case "Puff_depth":
		Growly_Sax_set_Puff_depth(p, value)
		return true
	case "Puff_release":
		Growly_Sax_set_Puff_release(p, value)
		return true
	case "Puff_sustain":
		Growly_Sax_set_Puff_sustain(p, value)
		return true
	case "Reed_amplitude":
		Growly_Sax_set_Reed_amplitude(p, value)
		return true
	case "Room_decay":
		Growly_Sax_set_Room_decay(p, value)
		return true
	case "Room_mix":
		Growly_Sax_set_Room_mix(p, value)
		return true
	case "Scoop_attack":
		Growly_Sax_set_Scoop_attack(p, value)
		return true
	case "Scoop_depth":
		Growly_Sax_set_Scoop_depth(p, value)
		return true
	case "Scoop_release":
		Growly_Sax_set_Scoop_release(p, value)
		return true
	case "Scoop_sustain":
		Growly_Sax_set_Scoop_sustain(p, value)
		return true
	case "Vibrato_amplitude":
		Growly_Sax_set_Vibrato_amplitude(p, value)
		return true
	case "drive":
		Growly_Sax_set_drive(p, value)
		return true
	case "frequency":
		Growly_Sax_set_frequency(p, value)
		return true
	case "outMin":
		Growly_Sax_set_outMin(p, value)
		return true
	case "tone":
		Growly_Sax_set_tone(p, value)
		return true
	case "velocitySensitivity":
		Growly_Sax_set_velocitySensitivity(p, value)
		return true
	}
	return false
}

Growly_Sax_get_param :: proc(p: ^Growly_Sax_Processor, name: string) -> (f32, bool) {
	switch name {
	case "Air_cutoff":
		return p.Air_cutoff, true
	case "Air_resonance":
		return p.Air_resonance, true
	case "Amp_attack":
		return p.Amp_attack, true
	case "Amp_decay":
		return p.Amp_decay, true
	case "Amp_depth":
		return p.Amp_depth, true
	case "Amp_release":
		return p.Amp_release, true
	case "Amp_sustain":
		return p.Amp_sustain, true
	case "Body_cutoff":
		return p.Body_cutoff, true
	case "Body_resonance":
		return p.Body_resonance, true
	case "Breath_amplitude":
		return p.Breath_amplitude, true
	case "Expression_mix":
		return p.Expression_mix, true
	case "Formant_cutoff":
		return p.Formant_cutoff, true
	case "Formant_resonance":
		return p.Formant_resonance, true
	case "Puff_attack":
		return p.Puff_attack, true
	case "Puff_decay":
		return p.Puff_decay, true
	case "Puff_depth":
		return p.Puff_depth, true
	case "Puff_release":
		return p.Puff_release, true
	case "Puff_sustain":
		return p.Puff_sustain, true
	case "Reed_amplitude":
		return p.Reed_amplitude, true
	case "Room_decay":
		return p.Room_decay, true
	case "Room_mix":
		return p.Room_mix, true
	case "Scoop_attack":
		return p.Scoop_attack, true
	case "Scoop_depth":
		return p.Scoop_depth, true
	case "Scoop_release":
		return p.Scoop_release, true
	case "Scoop_sustain":
		return p.Scoop_sustain, true
	case "Vibrato_amplitude":
		return p.Vibrato_amplitude, true
	case "drive":
		return p.drive, true
	case "frequency":
		return p.frequency, true
	case "outMin":
		return p.outMin, true
	case "tone":
		return p.tone, true
	case "velocitySensitivity":
		return p.velocitySensitivity, true
	}
	return 0.0, false
}

Growly_Sax_process :: proc(p: ^Growly_Sax_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	p.total_samples += 1

	node_growl_amp_out_vsum: f32 = 0.0
	for v_idx in 0..<4 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.current_freq != voice.target_freq {
			glide_k := 1.0 / math.max(voice.glide_time * sample_rate, 1.0)
			if glide_k > 1.0 do glide_k = 1.0
			voice.current_freq += (voice.target_freq - voice.current_freq) * glide_k
			if abs(voice.target_freq - voice.current_freq) < 0.1 do voice.current_freq = voice.target_freq
		}
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_growl_amp_stage != .Release && voice.adsr_growl_amp_stage != .Idle {
				voice.adsr_growl_amp_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_growl_puff_stage != .Release && voice.adsr_growl_puff_stage != .Idle {
				voice.adsr_growl_puff_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_growl_scoop_stage != .Release && voice.adsr_growl_scoop_stage != .Idle {
				voice.adsr_growl_scoop_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_growl_air_out: f32 = 0.0
		node_growl_amp_out: f32 = 0.0
		node_growl_body_out: f32 = 0.0
		node_growl_breath_out: f32 = 0.0
		node_growl_drive_out: f32 = 0.0
		node_growl_formant_out: f32 = 0.0
		node_growl_mixer_out: f32 = 0.0
		node_growl_puff_out: f32 = 0.0
		node_growl_reed_out: f32 = 0.0
		node_growl_scoop_out: f32 = 0.0
		node_growl_scoop_map_out: f32 = 0.0
		node_growl_vibrato_out: f32 = 0.0

		// --- Noise Node growl_breath ---
		{
			white_growl_breath := next_float32(&voice.noise_growl_breath_rng) * 2.0 - 1.0;
			voice.noise_growl_breath_p0 = 0.99765 * voice.noise_growl_breath_p0 + white_growl_breath * 0.0990460;
			voice.noise_growl_breath_p1 = 0.96300 * voice.noise_growl_breath_p1 + white_growl_breath * 0.2965164;
			voice.noise_growl_breath_p2 = 0.57000 * voice.noise_growl_breath_p2 + white_growl_breath * 1.0526913;
			node_growl_breath_out = (voice.noise_growl_breath_p0 + voice.noise_growl_breath_p1 + voice.noise_growl_breath_p2 + white_growl_breath * 0.1848) * 0.25 * (p.Breath_amplitude);
		}

		// --- ADSR Node growl_scoop ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_growl_scoop_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Scoop_attack) > 0 do envelope = voice.age / math.max(f32(p.Scoop_attack), 0.000001); else do envelope = 1.0;
				voice.adsr_growl_scoop_release_level = envelope;
				if voice.age >= (p.Scoop_attack) {
					voice.adsr_growl_scoop_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Scoop_attack);
				if (f32(0.200000000)) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(f32(0.200000000)), 0.000001)) * (1.0 - (p.Scoop_sustain)); else do envelope = (p.Scoop_sustain);
				voice.adsr_growl_scoop_release_level = envelope;
				if time_in_decay >= (f32(0.200000000)) {
					voice.adsr_growl_scoop_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Scoop_sustain);
				voice.adsr_growl_scoop_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_growl_scoop_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Scoop_release) > 0 do envelope = voice.adsr_growl_scoop_release_level * (1.0 - (time_in_release / math.max(f32(p.Scoop_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_growl_scoop_stage = .Idle;
				}
			}
			vel_scale_growl_scoop: f32 = (1.0 - (f32(0.000000000))) + (f32(0.000000000)) * voice.velocity;
			node_growl_scoop_out = (1.0) * envelope * (p.Scoop_depth) * vel_scale_growl_scoop;
		}

		// --- LFO Node growl_vibrato ---
		voice.lfo_growl_vibrato_phase = math.mod(voice.lfo_growl_vibrato_phase + (2 * f32(math.PI) * (p.frequency) / sample_rate), 2 * f32(math.PI));
		if voice.lfo_growl_vibrato_phase < 0.0 do voice.lfo_growl_vibrato_phase += 2 * f32(math.PI);
		node_growl_vibrato_out = math.sin(voice.lfo_growl_vibrato_phase) * (p.Vibrato_amplitude);

		// --- Filter Node growl_air (SVF) ---
		{
			cutoff_c_growl_air: f32 = math.clamp(f32(p.Air_cutoff), 10.0, sample_rate * 0.16);
			f_growl_air := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_growl_air / sample_rate));
			q_growl_air: f32 = math.clamp(1.0 / math.max(f32(p.Air_resonance), 0.1), 0.05, 1.9 - f_growl_air);
			voice.filter_growl_air_low += f_growl_air * voice.filter_growl_air_band;
			high_growl_air := f32(((node_growl_breath_out)) - voice.filter_growl_air_low - q_growl_air * voice.filter_growl_air_band);
			voice.filter_growl_air_band += f_growl_air * high_growl_air;
			node_growl_air_out = voice.filter_growl_air_band;
		}

		// --- Mapper Node growl_scoop_map ---
		{
			in_range_growl_scoop_map: f32 = f32(f32(1.000000000)) - f32(f32(0.000000000));
			if in_range_growl_scoop_map == 0.0 do in_range_growl_scoop_map = 1.0;
			node_growl_scoop_map_out = math.lerp(f32(p.outMin), f32(f32(0.000000000)), math.clamp((f32((node_growl_scoop_out)) - f32(f32(0.000000000))) / in_range_growl_scoop_map, 0.0, 1.0));
		}

		// --- ADSR Node growl_puff ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_growl_puff_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Puff_attack) > 0 do envelope = voice.age / math.max(f32(p.Puff_attack), 0.000001); else do envelope = 1.0;
				voice.adsr_growl_puff_release_level = envelope;
				if voice.age >= (p.Puff_attack) {
					voice.adsr_growl_puff_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Puff_attack);
				if (p.Puff_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Puff_decay), 0.000001)) * (1.0 - (p.Puff_sustain)); else do envelope = (p.Puff_sustain);
				voice.adsr_growl_puff_release_level = envelope;
				if time_in_decay >= (p.Puff_decay) {
					voice.adsr_growl_puff_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Puff_sustain);
				voice.adsr_growl_puff_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_growl_puff_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Puff_release) > 0 do envelope = voice.adsr_growl_puff_release_level * (1.0 - (time_in_release / math.max(f32(p.Puff_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_growl_puff_stage = .Idle;
				}
			}
			vel_scale_growl_puff: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_growl_puff_out = ((node_growl_air_out)) * envelope * (p.Puff_depth) * vel_scale_growl_puff;
		}

		// --- Oscillator Node growl_reed (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = ((voice.current_freq) * math.pow(2.0, math.clamp(f32(node_growl_scoop_map_out + node_growl_vibrato_out), -10.0, 10.0))) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_growl_reed_phase[i] = math.mod(voice.osc_growl_reed_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_growl_reed_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += ((final_phase / f32(math.PI)) - 1.0);
			}
			if unison_count > 0 do node_growl_reed_out = (unison_out / f32(unison_count)) * (p.Reed_amplitude);
		}

		// --- Filter Node growl_body (SVF) ---
		{
			cutoff_c_growl_body: f32 = math.clamp(f32(p.Body_cutoff), 10.0, sample_rate * 0.16);
			f_growl_body := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_growl_body / sample_rate));
			q_growl_body: f32 = math.clamp(1.0 / math.max(f32(p.Body_resonance), 0.1), 0.05, 1.9 - f_growl_body);
			voice.filter_growl_body_low += f_growl_body * voice.filter_growl_body_band;
			high_growl_body := f32(((node_growl_reed_out)) - voice.filter_growl_body_low - q_growl_body * voice.filter_growl_body_band);
			voice.filter_growl_body_band += f_growl_body * high_growl_body;
			node_growl_body_out = voice.filter_growl_body_low;
		}

		// --- Filter Node growl_formant (SVF) ---
		{
			cutoff_c_growl_formant: f32 = math.clamp(f32(p.Formant_cutoff), 10.0, sample_rate * 0.16);
			f_growl_formant := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_growl_formant / sample_rate));
			q_growl_formant: f32 = math.clamp(1.0 / math.max(f32(p.Formant_resonance), 0.1), 0.05, 1.9 - f_growl_formant);
			voice.filter_growl_formant_low += f_growl_formant * voice.filter_growl_formant_band;
			high_growl_formant := f32(((node_growl_reed_out)) - voice.filter_growl_formant_low - q_growl_formant * voice.filter_growl_formant_band);
			voice.filter_growl_formant_band += f_growl_formant * high_growl_formant;
			node_growl_formant_out = voice.filter_growl_formant_band;
		}

		// --- Mixer Node growl_mixer (3 inputs) ---
		{
			mix_sum_growl_mixer: f32 = 0.0;
			mix_sum_growl_mixer += node_growl_body_out * (f32(0.800000012));
			mix_sum_growl_mixer += node_growl_formant_out * (f32(0.500000000));
			mix_sum_growl_mixer += node_growl_puff_out * (f32(0.349999994));
		node_growl_mixer_out = mix_sum_growl_mixer;
		}

		// --- Distortion Node growl_drive (soft) ---
		{
			dist_in_growl_drive: f32 = ((node_growl_mixer_out));
			dist_k_growl_drive: f32 = math.max(f32(p.drive), 1.0);
			dist_wet_growl_drive: f32 = math.tanh(dist_in_growl_drive * dist_k_growl_drive);
			tone_k_growl_drive: f32 = math.clamp(2.0 * f32(math.PI) * math.clamp(f32(p.tone), 100.0, 20000.0) / sample_rate, 0.001, 1.0);
			voice.dist_growl_drive_tone += tone_k_growl_drive * (dist_wet_growl_drive - voice.dist_growl_drive_tone);
			mix_growl_drive: f32 = math.clamp(f32(p.Expression_mix), 0.0, 1.0);
			node_growl_drive_out = dist_in_growl_drive * (1.0 - mix_growl_drive) + voice.dist_growl_drive_tone * mix_growl_drive;
		}

		// --- ADSR Node growl_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_growl_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Amp_attack) > 0 do envelope = voice.age / math.max(f32(p.Amp_attack), 0.000001); else do envelope = 1.0;
				voice.adsr_growl_amp_release_level = envelope;
				if voice.age >= (p.Amp_attack) {
					voice.adsr_growl_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Amp_attack);
				if (p.Amp_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Amp_decay), 0.000001)) * (1.0 - (p.Amp_sustain)); else do envelope = (p.Amp_sustain);
				voice.adsr_growl_amp_release_level = envelope;
				if time_in_decay >= (p.Amp_decay) {
					voice.adsr_growl_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Amp_sustain);
				voice.adsr_growl_amp_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_growl_amp_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Amp_release) > 0 do envelope = voice.adsr_growl_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.Amp_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_growl_amp_stage = .Idle;
				}
			}
			vel_scale_growl_amp: f32 = (1.0 - (p.velocitySensitivity)) + (p.velocitySensitivity) * voice.velocity;
			node_growl_amp_out = ((node_growl_drive_out)) * envelope * (p.Amp_depth) * vel_scale_growl_amp;
		}

		node_growl_amp_out_vsum += node_growl_amp_out
		if voice.adsr_growl_amp_stage != .Idle do voice_busy = true
		if voice.adsr_growl_puff_stage != .Idle do voice_busy = true
		if voice.adsr_growl_scoop_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}

	// --- Bus effects (once per sample, post voice sum) ---
	{
		node_growl_amp_out := node_growl_amp_out_vsum
		node_growl_reverb_out: f32 = 0.0
		// --- Reverb Node growl_reverb (Simple FDN) ---
		{
			delay_samples_growl_reverb := int(math.clamp((0.075000000) * sample_rate, 0, 96000-1));
			read_index_growl_reverb := (p.delay_growl_reverb_write_index - delay_samples_growl_reverb + len(p.delay_growl_reverb_buffer)) % len(p.delay_growl_reverb_buffer);
			delayed_sample_growl_reverb := p.delay_growl_reverb_buffer[read_index_growl_reverb];
			decay_gain_growl_reverb: f32 = math.clamp(math.pow(f32(0.001), f32(0.075) / math.max(f32(p.Room_decay), 0.01)), 0.0, 0.95);
			p.delay_growl_reverb_buffer[p.delay_growl_reverb_write_index] = ((node_growl_amp_out)) + delayed_sample_growl_reverb * decay_gain_growl_reverb;
			p.delay_growl_reverb_write_index = (p.delay_growl_reverb_write_index + 1) % len(p.delay_growl_reverb_buffer);
			node_growl_reverb_out = ((node_growl_amp_out)) * (1.0 - (p.Room_mix)) + delayed_sample_growl_reverb * (p.Room_mix);
		}

		output_left += node_growl_reverb_out
		output_right += node_growl_reverb_out
	}
	return output_left * f32(0.660000026), output_right * f32(0.660000026)
}
Growly_Sax_process_sequence :: proc(p: ^Growly_Sax_Processor) {
}

Kick_Voice_State :: struct {
	active: bool,
	note: u8,
	velocity: f32,
	age: f32,
	time_released: f32,
	current_freq: f32,
	target_freq: f32,
	glide_time: f32,
	duration: f32,
	adsr_kick_amp_envelope_stage: ADSR_Stage,
	adsr_kick_amp_envelope_release_level: f32,
	dist_kick_distortion_tone: f32,
	osc_kick_oscillator_phase: [1]f32,
	adsr_kick_pitch_envelope_stage: ADSR_Stage,
	adsr_kick_pitch_envelope_release_level: f32,
}

Kick_Processor :: struct {
	sample_rate: f32,
	bpm: f32,
	voices: [8]Kick_Voice_State,
	prng: PRNG_State,
	total_samples: u64,
	playing: bool,
	loop: bool,
	current_step: u64,
	samples_until_next_step: u64,
	step_frac_acc: f32,
	ext_in_l: f32,
	ext_in_r: f32,
	Amp_attack: f32,
	Amp_decay: f32,
	Amp_depth: f32,
	Amp_release: f32,
	Amp_sustain: f32,
	Pitch_attack: f32,
	Pitch_decay: f32,
	Pitch_depth: f32,
	Pitch_release: f32,
	Pitch_sustain: f32,
	amplitude: f32,
	drive: f32,
	frequency: f32,
	mix: f32,
	phase: f32,
	pulseWidth: f32,
	tone: f32,
}

Kick_init :: proc(p: ^Kick_Processor, sr: f32) {
	p.sample_rate = sr
	p.bpm = 120.000000000
	p.prng.state = 12345
	p.loop = true
	p.Amp_attack = 0.001000000
	p.Amp_decay = 0.250000000
	p.Amp_depth = 1.000000000
	p.Amp_release = 0.050000001
	p.Amp_sustain = 0.000000000
	p.Pitch_attack = 0.001000000
	p.Pitch_decay = 0.059999999
	p.Pitch_depth = 1.000000000
	p.Pitch_release = 0.010000000
	p.Pitch_sustain = 0.000000000
	p.amplitude = 0.500000000
	p.drive = 8.000000000
	p.frequency = 50.000000000
	p.mix = 0.400000006
	p.phase = 0.000000000
	p.pulseWidth = 0.500000000
	p.tone = 3000.000000000
}

Kick_note_on :: proc(p: ^Kick_Processor, note: u8, velocity: f32, duration: f32) {
	voice_idx := -1
	for i in 0..<8 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_age: f32 = -1.0
		for i in 0..<8 {
			if p.voices[i].age > oldest_age {
				oldest_age = p.voices[i].age
				voice_idx = i
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.050000001
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	v.adsr_kick_amp_envelope_stage = .Attack
	v.adsr_kick_amp_envelope_release_level = 0.0
	v.dist_kick_distortion_tone = 0.0
	v.osc_kick_oscillator_phase = {}
	v.adsr_kick_pitch_envelope_stage = .Attack
	v.adsr_kick_pitch_envelope_release_level = 0.0
}

Kick_note_off :: proc(p: ^Kick_Processor, note: u8) {
	best := -1
	best_age: f32 = -1.0
	for i in 0..<8 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_kick_amp_envelope_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_kick_amp_envelope_stage = .Release
		p.voices[best].adsr_kick_pitch_envelope_stage = .Release
	}
}

Kick_trigger :: proc(p: ^Kick_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (p.Amp_attack) + (p.Amp_decay) > d do d = (p.Amp_attack) + (p.Amp_decay)
		if (p.Pitch_attack) + (p.Pitch_decay) > d do d = (p.Pitch_attack) + (p.Pitch_decay)
		if d <= 0.0 do d = 0.001
	}
	Kick_note_on(p, note, velocity, d)
}

Kick_feed_input :: proc(p: ^Kick_Processor, in_left: f32, in_right: f32) {
	p.ext_in_l = in_left
	p.ext_in_r = in_right
}

Kick_start :: proc(p: ^Kick_Processor) {
	p.playing = true
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
}

Kick_stop :: proc(p: ^Kick_Processor) {
	p.playing = false
}

Kick_set_loop :: proc(p: ^Kick_Processor, loop: bool) {
	p.loop = loop
}

Kick_is_playing :: proc(p: ^Kick_Processor) -> bool {
	if p.playing do return true
	for i in 0..<8 {
		if p.voices[i].active do return true
	}
	return false
}

