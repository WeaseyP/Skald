sadfsadf_PARAMS := []Skald_Param_Info{
}

sadfsadf_set_param :: proc(p: ^sadfsadf_Processor, name: string, value: f32) -> bool {
	return false
}

sadfsadf_get_param :: proc(p: ^sadfsadf_Processor, name: string) -> (f32, bool) {
	return 0.0, false
}

sadfsadf_process :: proc(p: ^sadfsadf_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	p.total_samples += 1

	node_3_out_vsum: f32 = 0.0
	for v_idx in 0..<8 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.current_freq != voice.target_freq {
			glide_k := 1.0 / math.max(voice.glide_time * sample_rate, 1.0)
			if glide_k > 1.0 do glide_k = 1.0
			voice.current_freq += (voice.target_freq - voice.current_freq) * glide_k
			if abs(voice.target_freq - voice.current_freq) < 0.1 do voice.current_freq = voice.target_freq
		}
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_2_stage != .Release && voice.adsr_2_stage != .Idle {
				voice.adsr_2_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_1_out: f32 = 0.0
		node_2_out: f32 = 0.0
		node_3_out: f32 = 0.0

		// --- Oscillator Node 1 (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (5.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_1_phase[i] = math.mod(voice.osc_1_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_1_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += ((final_phase / f32(math.PI)) - 1.0);
			}
			if unison_count > 0 do node_1_out = (unison_out / f32(unison_count)) * (f32(0.500000000));
		}

		// --- ADSR Node 2 ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_2_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(3.000000000)) > 0 do envelope = voice.age / math.max(f32(f32(3.000000000)), 0.000001); else do envelope = 1.0;
				voice.adsr_2_release_level = envelope;
				if voice.age >= (f32(3.000000000)) {
					voice.adsr_2_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(3.000000000));
				if (f32(2.500000000)) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(f32(2.500000000)), 0.000001)) * (1.0 - (f32(1.000000000))); else do envelope = (f32(1.000000000));
				voice.adsr_2_release_level = envelope;
				if time_in_decay >= (f32(2.500000000)) {
					voice.adsr_2_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(1.000000000));
				voice.adsr_2_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_2_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(4.000000000)) > 0 do envelope = voice.adsr_2_release_level * (1.0 - (time_in_release / math.max(f32(f32(4.000000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_2_stage = .Idle;
				}
			}
			vel_scale_2: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_2_out = ((node_1_out)) * envelope * (f32(1.000000000)) * vel_scale_2;
		}

		// --- Filter Node 3 (SVF) ---
		{
			cutoff_c_3: f32 = math.clamp(f32(f32(2000.000000000)), 10.0, sample_rate * 0.16);
			f_3 := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_3 / sample_rate));
			q_3: f32 = math.clamp(1.0 / math.max(f32(f32(0.300000000)), 0.1), 0.05, 1.9 - f_3);
			voice.filter_3_low += f_3 * voice.filter_3_band;
			high_3 := f32(((node_2_out)) - voice.filter_3_low - q_3 * voice.filter_3_band);
			voice.filter_3_band += f_3 * high_3;
			node_3_out = voice.filter_3_low;
		}

		node_3_out_vsum += node_3_out
		if voice.adsr_2_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}

	// --- Bus effects (once per sample, post voice sum) ---
	{
		node_3_out := node_3_out_vsum
		node_4_out: f32 = 0.0
		// --- Reverb Node 4 (Simple FDN) ---
		{
			delay_samples_4 := int(math.clamp((0.075000000) * sample_rate, 0, 96000-1));
			read_index_4 := (p.delay_4_write_index - delay_samples_4 + len(p.delay_4_buffer)) % len(p.delay_4_buffer);
			delayed_sample_4 := p.delay_4_buffer[read_index_4];
			decay_gain_4: f32 = math.clamp(math.pow(f32(0.001), f32(0.075) / math.max(f32(f32(6.000000000)), 0.01)), 0.0, 0.95);
			p.delay_4_buffer[p.delay_4_write_index] = ((node_3_out)) + delayed_sample_4 * decay_gain_4;
			p.delay_4_write_index = (p.delay_4_write_index + 1) % len(p.delay_4_buffer);
			node_4_out = ((node_3_out)) * (1.0 - (f32(0.600000000))) + delayed_sample_4 * (f32(0.600000000));
		}

		output_left += node_4_out
		output_right += node_4_out
	}
	return output_left * f32(1.000000000), output_right * f32(1.000000000)
}
sadfsadf_process_sequence :: proc(p: ^sadfsadf_Processor) {
}

Growly_Sax_Voice_State :: struct {
	active: bool,
	note: u8,
	velocity: f32,
	age: f32,
	time_released: f32,
	current_freq: f32,
	target_freq: f32,
	glide_time: f32,
	duration: f32,
	filter_growl_air_low: f32,
	filter_growl_air_band: f32,
	adsr_growl_amp_stage: ADSR_Stage,
	adsr_growl_amp_release_level: f32,
	filter_growl_body_low: f32,
	filter_growl_body_band: f32,
	noise_growl_breath_rng: PRNG_State,
	noise_growl_breath_p0: f32,
	noise_growl_breath_p1: f32,
	noise_growl_breath_p2: f32,
	dist_growl_drive_tone: f32,
	filter_growl_formant_low: f32,
	filter_growl_formant_band: f32,
	adsr_growl_puff_stage: ADSR_Stage,
	adsr_growl_puff_release_level: f32,
	osc_growl_reed_phase: [1]f32,
	adsr_growl_scoop_stage: ADSR_Stage,
	adsr_growl_scoop_release_level: f32,
	lfo_growl_vibrato_phase: f32,
}

Growly_Sax_Processor :: struct {
	sample_rate: f32,
	bpm: f32,
	voices: [4]Growly_Sax_Voice_State,
	prng: PRNG_State,
	total_samples: u64,
	playing: bool,
	loop: bool,
	current_step: u64,
	samples_until_next_step: u64,
	step_frac_acc: f32,
	ext_in_l: f32,
	ext_in_r: f32,
	delay_growl_reverb_buffer: [96000]f32,
	delay_growl_reverb_write_index: int,
	Air_cutoff: f32,
	Air_resonance: f32,
	Amp_attack: f32,
	Amp_decay: f32,
	Amp_depth: f32,
	Amp_release: f32,
	Amp_sustain: f32,
	Body_cutoff: f32,
	Body_resonance: f32,
	Breath_amplitude: f32,
	Expression_mix: f32,
	Formant_cutoff: f32,
	Formant_resonance: f32,
	Puff_attack: f32,
	Puff_decay: f32,
	Puff_depth: f32,
	Puff_release: f32,
	Puff_sustain: f32,
	Reed_amplitude: f32,
	Room_decay: f32,
	Room_mix: f32,
	Scoop_attack: f32,
	Scoop_depth: f32,
	Scoop_release: f32,
	Scoop_sustain: f32,
	Vibrato_amplitude: f32,
	drive: f32,
	frequency: f32,
	outMin: f32,
	tone: f32,
	velocitySensitivity: f32,
}

Growly_Sax_init :: proc(p: ^Growly_Sax_Processor, sr: f32) {
	p.sample_rate = sr
	p.bpm = 120.000000000
	p.prng.state = 12345
	p.loop = true
	for i in 0..<4 {
		v := &p.voices[i]
		v.noise_growl_breath_rng.state = u32(0xC0FFEE01) ~ u32(i + 1) * 2654435761
	}
	p.Air_cutoff = 4500.000000000
	p.Air_resonance = 1.000000000
	p.Amp_attack = 0.050000001
	p.Amp_decay = 0.180000007
	p.Amp_depth = 1.000000000
	p.Amp_release = 0.140000001
	p.Amp_sustain = 0.800000012
	p.Body_cutoff = 1600.000000000
	p.Body_resonance = 1.200000048
	p.Breath_amplitude = 0.150000006
	p.Expression_mix = 0.250000000
	p.Formant_cutoff = 1100.000000000
	p.Formant_resonance = 2.500000000
	p.Puff_attack = 0.010000000
	p.Puff_decay = 0.119999997
	p.Puff_depth = 1.000000000
	p.Puff_release = 0.079999998
	p.Puff_sustain = 0.250000000
	p.Reed_amplitude = 0.550000012
	p.Room_decay = 1.500000000
	p.Room_mix = 0.150000006
	p.Scoop_attack = 0.070000000
	p.Scoop_depth = 1.000000000
	p.Scoop_release = 0.050000001
	p.Scoop_sustain = 1.000000000
	p.Vibrato_amplitude = 0.020000000
	p.drive = 18.000000000
	p.frequency = 5.500000000
	p.outMin = -0.119999997
	p.tone = 5000.000000000
	p.velocitySensitivity = 0.800000012
}

Growly_Sax_note_on :: proc(p: ^Growly_Sax_Processor, note: u8, velocity: f32, duration: f32) {
	voice_idx := -1
	for i in 0..<4 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_age: f32 = -1.0
		for i in 0..<4 {
			if p.voices[i].age > oldest_age {
				oldest_age = p.voices[i].age
				voice_idx = i
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.039999999
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	v.filter_growl_air_low = 0.0
	v.filter_growl_air_band = 0.0
	v.adsr_growl_amp_stage = .Attack
	v.adsr_growl_amp_release_level = 0.0
	v.filter_growl_body_low = 0.0
	v.filter_growl_body_band = 0.0
	v.dist_growl_drive_tone = 0.0
	v.filter_growl_formant_low = 0.0
	v.filter_growl_formant_band = 0.0
	v.adsr_growl_puff_stage = .Attack
	v.adsr_growl_puff_release_level = 0.0
	v.osc_growl_reed_phase = {}
	v.adsr_growl_scoop_stage = .Attack
	v.adsr_growl_scoop_release_level = 0.0
}

Growly_Sax_note_off :: proc(p: ^Growly_Sax_Processor, note: u8) {
	best := -1
	best_age: f32 = -1.0
	for i in 0..<4 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_growl_amp_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_growl_amp_stage = .Release
		p.voices[best].adsr_growl_puff_stage = .Release
		p.voices[best].adsr_growl_scoop_stage = .Release
	}
}

Growly_Sax_trigger :: proc(p: ^Growly_Sax_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (p.Amp_attack) + (p.Amp_decay) > d do d = (p.Amp_attack) + (p.Amp_decay)
		if (p.Puff_attack) + (p.Puff_decay) > d do d = (p.Puff_attack) + (p.Puff_decay)
		if (p.Scoop_attack) + (f32(0.200000000)) > d do d = (p.Scoop_attack) + (f32(0.200000000))
		if d <= 0.0 do d = 0.001
	}
	Growly_Sax_note_on(p, note, velocity, d)
}

Growly_Sax_feed_input :: proc(p: ^Growly_Sax_Processor, in_left: f32, in_right: f32) {
	p.ext_in_l = in_left
	p.ext_in_r = in_right
}

Growly_Sax_start :: proc(p: ^Growly_Sax_Processor) {
	p.playing = true
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
}

Growly_Sax_stop :: proc(p: ^Growly_Sax_Processor) {
	p.playing = false
}

Growly_Sax_set_loop :: proc(p: ^Growly_Sax_Processor, loop: bool) {
	p.loop = loop
}

Growly_Sax_is_playing :: proc(p: ^Growly_Sax_Processor) -> bool {
	if p.playing do return true
	for i in 0..<4 {
		if p.voices[i].active do return true
	}
	return false
}

