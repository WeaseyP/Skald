	}
	return 0.0, false
}

Snare_process :: proc(p: ^Snare_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	Snare_process_sequence(p)
	p.total_samples += 1

	for v_idx in 0..<8 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.current_freq != voice.target_freq {
			glide_k := 1.0 / math.max(voice.glide_time * sample_rate, 1.0)
			if glide_k > 1.0 do glide_k = 1.0
			voice.current_freq += (voice.target_freq - voice.current_freq) * glide_k
			if abs(voice.target_freq - voice.current_freq) < 0.1 do voice.current_freq = voice.target_freq
		}
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_snare_rattle_envelope_stage != .Release && voice.adsr_snare_rattle_envelope_stage != .Idle {
				voice.adsr_snare_rattle_envelope_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_snare_thump_envelope_stage != .Release && voice.adsr_snare_thump_envelope_stage != .Idle {
				voice.adsr_snare_thump_envelope_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_snare_highpass_out: f32 = 0.0
		node_snare_mixer_out: f32 = 0.0
		node_snare_noise_out: f32 = 0.0
		node_snare_oscillator_out: f32 = 0.0
		node_snare_output_out: f32 = 0.0
		node_snare_rattle_envelope_out: f32 = 0.0
		node_snare_thump_envelope_out: f32 = 0.0

		// --- Noise Node snare_noise ---
		node_snare_noise_out = (next_float32(&voice.noise_snare_noise_rng) * 2.0 - 1.0) * (p.White_Noise_amplitude);

		// --- Oscillator Node snare_oscillator (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (5.000000000);
				detuned_freq: f32 = (p.frequency) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(p.phase) * (f32(math.PI) / 180.0);
				voice.osc_snare_oscillator_phase[i] = math.mod(voice.osc_snare_oscillator_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_snare_oscillator_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += math.sin(final_phase);
			}
			if unison_count > 0 do node_snare_oscillator_out = (unison_out / f32(unison_count)) * (p.Thump_Oscillator_amplitude);
		}

		// --- Filter Node snare_highpass (SVF) ---
		{
			cutoff_c_snare_highpass: f32 = math.clamp(f32(p.cutoff), 10.0, sample_rate * 0.16);
			f_snare_highpass := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_snare_highpass / sample_rate));
			q_snare_highpass: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_snare_highpass);
			voice.filter_snare_highpass_low += f_snare_highpass * voice.filter_snare_highpass_band;
			high_snare_highpass := f32(((node_snare_noise_out)) - voice.filter_snare_highpass_low - q_snare_highpass * voice.filter_snare_highpass_band);
			voice.filter_snare_highpass_band += f_snare_highpass * high_snare_highpass;
			node_snare_highpass_out = high_snare_highpass;
		}

		// --- ADSR Node snare_thump_envelope ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_snare_thump_envelope_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Thump_attack) > 0 do envelope = voice.age / math.max(f32(p.Thump_attack), 0.000001); else do envelope = 1.0;
				voice.adsr_snare_thump_envelope_release_level = envelope;
				if voice.age >= (p.Thump_attack) {
					voice.adsr_snare_thump_envelope_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Thump_attack);
				if (p.Thump_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Thump_decay), 0.000001)) * (1.0 - (p.Thump_sustain)); else do envelope = (p.Thump_sustain);
				voice.adsr_snare_thump_envelope_release_level = envelope;
				if time_in_decay >= (p.Thump_decay) {
					voice.adsr_snare_thump_envelope_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Thump_sustain);
				voice.adsr_snare_thump_envelope_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_snare_thump_envelope_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Thump_release) > 0 do envelope = voice.adsr_snare_thump_envelope_release_level * (1.0 - (time_in_release / math.max(f32(p.Thump_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_snare_thump_envelope_stage = .Idle;
				}
			}
			vel_scale_snare_thump_envelope: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_snare_thump_envelope_out = ((node_snare_oscillator_out)) * envelope * (p.Thump_depth) * vel_scale_snare_thump_envelope;
		}

		// --- ADSR Node snare_rattle_envelope ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_snare_rattle_envelope_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Rattle_attack) > 0 do envelope = voice.age / math.max(f32(p.Rattle_attack), 0.000001); else do envelope = 1.0;
				voice.adsr_snare_rattle_envelope_release_level = envelope;
				if voice.age >= (p.Rattle_attack) {
					voice.adsr_snare_rattle_envelope_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Rattle_attack);
				if (p.Rattle_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Rattle_decay), 0.000001)) * (1.0 - (p.Rattle_sustain)); else do envelope = (p.Rattle_sustain);
				voice.adsr_snare_rattle_envelope_release_level = envelope;
				if time_in_decay >= (p.Rattle_decay) {
					voice.adsr_snare_rattle_envelope_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Rattle_sustain);
				voice.adsr_snare_rattle_envelope_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_snare_rattle_envelope_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Rattle_release) > 0 do envelope = voice.adsr_snare_rattle_envelope_release_level * (1.0 - (time_in_release / math.max(f32(p.Rattle_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_snare_rattle_envelope_stage = .Idle;
				}
			}
			vel_scale_snare_rattle_envelope: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_snare_rattle_envelope_out = ((node_snare_highpass_out)) * envelope * (p.Rattle_depth) * vel_scale_snare_rattle_envelope;
		}

		// --- Mixer Node snare_mixer (2 inputs) ---
		{
			mix_sum_snare_mixer: f32 = 0.0;
			mix_sum_snare_mixer += node_snare_rattle_envelope_out * (f32(0.800000012));
			mix_sum_snare_mixer += node_snare_thump_envelope_out * (f32(0.600000024));
		node_snare_mixer_out = mix_sum_snare_mixer;
		}

		output_left += node_snare_mixer_out
		output_right += node_snare_mixer_out
		if voice.adsr_snare_rattle_envelope_stage != .Idle do voice_busy = true
		if voice.adsr_snare_thump_envelope_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	return output_left * f32(1.000000000), output_right * f32(1.000000000)
}
Snare_process_sequence :: proc(p: ^Snare_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "Snare" (16 steps)
		switch p.current_step % 16 {
		case 4:
			Snare_note_on(p, 38, 1.000000000, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			Snare_note_on(p, 38, 0.949999988, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

WUBBLE_Voice_State :: struct {
	active: bool,
	note: u8,
	velocity: f32,
	age: f32,
	time_released: f32,
	current_freq: f32,
	target_freq: f32,
	glide_time: f32,
	duration: f32,
	lfo_1_phase: f32,
	osc_2_phase: [1]f32,
	filter_3_low: f32,
	filter_3_band: f32,
	adsr_4_stage: ADSR_Stage,
	adsr_4_release_level: f32,
}

WUBBLE_Processor :: struct {
	sample_rate: f32,
	bpm: f32,
	voices: [8]WUBBLE_Voice_State,
	prng: PRNG_State,
	total_samples: u64,
	playing: bool,
	loop: bool,
	current_step: u64,
	samples_until_next_step: u64,
	step_frac_acc: f32,
	ext_in_l: f32,
	ext_in_r: f32,
}

WUBBLE_init :: proc(p: ^WUBBLE_Processor, sr: f32) {
	p.sample_rate = sr
	p.bpm = 120.000000000
	p.prng.state = 12345
	p.loop = true
}

WUBBLE_note_on :: proc(p: ^WUBBLE_Processor, note: u8, velocity: f32, duration: f32) {
	voice_idx := -1
	for i in 0..<8 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_age: f32 = -1.0
		for i in 0..<8 {
			if p.voices[i].age > oldest_age {
				oldest_age = p.voices[i].age
				voice_idx = i
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.050000001
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	v.osc_2_phase = {}
	v.filter_3_low = 0.0
	v.filter_3_band = 0.0
	v.adsr_4_stage = .Attack
	v.adsr_4_release_level = 0.0
}

WUBBLE_note_off :: proc(p: ^WUBBLE_Processor, note: u8) {
	best := -1
	best_age: f32 = -1.0
	for i in 0..<8 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_4_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_4_stage = .Release
	}
}

WUBBLE_trigger :: proc(p: ^WUBBLE_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (f32(0.020000000)) + (f32(0.200000000)) > d do d = (f32(0.020000000)) + (f32(0.200000000))
		if d <= 0.0 do d = 0.001
	}
	WUBBLE_note_on(p, note, velocity, d)
}

WUBBLE_feed_input :: proc(p: ^WUBBLE_Processor, in_left: f32, in_right: f32) {
	p.ext_in_l = in_left
	p.ext_in_r = in_right
}

WUBBLE_start :: proc(p: ^WUBBLE_Processor) {
	p.playing = true
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
}

WUBBLE_stop :: proc(p: ^WUBBLE_Processor) {
	p.playing = false
}

WUBBLE_set_loop :: proc(p: ^WUBBLE_Processor, loop: bool) {
	p.loop = loop
}

WUBBLE_is_playing :: proc(p: ^WUBBLE_Processor) -> bool {
	if p.playing do return true
	for i in 0..<8 {
		if p.voices[i].active do return true
	}
	return false
}

WUBBLE_PARAMS := []Skald_Param_Info{
}

WUBBLE_set_param :: proc(p: ^WUBBLE_Processor, name: string, value: f32) -> bool {
	return false
}

WUBBLE_get_param :: proc(p: ^WUBBLE_Processor, name: string) -> (f32, bool) {
	return 0.0, false
}

WUBBLE_process :: proc(p: ^WUBBLE_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	WUBBLE_process_sequence(p)
	p.total_samples += 1

	for v_idx in 0..<8 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.current_freq != voice.target_freq {
			glide_k := 1.0 / math.max(voice.glide_time * sample_rate, 1.0)
			if glide_k > 1.0 do glide_k = 1.0
			voice.current_freq += (voice.target_freq - voice.current_freq) * glide_k
			if abs(voice.target_freq - voice.current_freq) < 0.1 do voice.current_freq = voice.target_freq
		}
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_4_stage != .Release && voice.adsr_4_stage != .Idle {
				voice.adsr_4_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_1_out: f32 = 0.0
		node_2_out: f32 = 0.0
		node_3_out: f32 = 0.0
		node_4_out: f32 = 0.0
		node_5_out: f32 = 0.0

		// --- LFO Node 1 ---
		voice.lfo_1_phase = math.mod(voice.lfo_1_phase + (2 * f32(math.PI) * ((1.0 / ((60.0 / p.bpm) * 1.000000000))) / sample_rate), 2 * f32(math.PI));
		if voice.lfo_1_phase < 0.0 do voice.lfo_1_phase += 2 * f32(math.PI);
		node_1_out = math.sin(voice.lfo_1_phase) * (f32(1.000000000));

		// --- Oscillator Node 2 (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (5.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_2_phase[i] = math.mod(voice.osc_2_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_2_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += ((final_phase / f32(math.PI)) - 1.0);
			}
			if unison_count > 0 do node_2_out = (unison_out / f32(unison_count)) * (f32(0.500000000));
		}

		// --- Filter Node 3 (SVF) ---
		{
			cutoff_c_3: f32 = math.clamp(f32((f32(150.000000000)) + (node_1_out)), 10.0, sample_rate * 0.16);
			f_3 := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_3 / sample_rate));
			q_3: f32 = math.clamp(1.0 / math.max(f32(f32(0.800000000)), 0.1), 0.05, 1.9 - f_3);
			voice.filter_3_low += f_3 * voice.filter_3_band;
			high_3 := f32(((node_2_out)) - voice.filter_3_low - q_3 * voice.filter_3_band);
			voice.filter_3_band += f_3 * high_3;
			node_3_out = voice.filter_3_low;
		}

		// --- ADSR Node 4 ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_4_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.020000000)) > 0 do envelope = voice.age / math.max(f32(f32(0.020000000)), 0.000001); else do envelope = 1.0;
				voice.adsr_4_release_level = envelope;
				if voice.age >= (f32(0.020000000)) {
					voice.adsr_4_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.020000000));
				if (f32(0.200000000)) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(f32(0.200000000)), 0.000001)) * (1.0 - (f32(0.900000000))); else do envelope = (f32(0.900000000));
				voice.adsr_4_release_level = envelope;
				if time_in_decay >= (f32(0.200000000)) {
					voice.adsr_4_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.900000000));
				voice.adsr_4_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_4_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.300000000)) > 0 do envelope = voice.adsr_4_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.300000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_4_stage = .Idle;
				}
			}
			vel_scale_4: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_4_out = ((node_3_out)) * envelope * (f32(1.000000000)) * vel_scale_4;
		}

		output_left += node_4_out
		output_right += node_4_out
		if voice.adsr_4_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	return output_left * f32(1.000000000), output_right * f32(1.000000000)
}
WUBBLE_process_sequence :: proc(p: ^WUBBLE_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "WUBBLE" (16 steps)
		switch p.current_step % 16 {
		case 0:
			WUBBLE_note_on(p, 60, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 2:
			WUBBLE_note_on(p, 60, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 4:
			WUBBLE_note_on(p, 60, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 6:
			WUBBLE_note_on(p, 60, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 10:
			WUBBLE_note_on(p, 60, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			WUBBLE_note_on(p, 60, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 14:
			WUBBLE_note_on(p, 60, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

