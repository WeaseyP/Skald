Tuba_set_param :: proc(p: ^Tuba_Processor, name: string, value: f32) -> bool {
	switch name {
	case "Amp_attack":
		Tuba_set_Amp_attack(p, value)
		return true
	case "Amp_decay":
		Tuba_set_Amp_decay(p, value)
		return true
	case "Amp_depth":
		Tuba_set_Amp_depth(p, value)
		return true
	case "Amp_release":
		Tuba_set_Amp_release(p, value)
		return true
	case "Amp_sustain":
		Tuba_set_Amp_sustain(p, value)
		return true
	case "Blow_attack":
		Tuba_set_Blow_attack(p, value)
		return true
	case "Blow_decay":
		Tuba_set_Blow_decay(p, value)
		return true
	case "Blow_depth":
		Tuba_set_Blow_depth(p, value)
		return true
	case "Blow_release":
		Tuba_set_Blow_release(p, value)
		return true
	case "Blow_sustain":
		Tuba_set_Blow_sustain(p, value)
		return true
	case "Buzz_amplitude":
		Tuba_set_Buzz_amplitude(p, value)
		return true
	case "Vibrato_amplitude":
		Tuba_set_Vibrato_amplitude(p, value)
		return true
	case "cutoff":
		Tuba_set_cutoff(p, value)
		return true
	case "frequency":
		Tuba_set_frequency(p, value)
		return true
	case "outMax":
		Tuba_set_outMax(p, value)
		return true
	case "resonance":
		Tuba_set_resonance(p, value)
		return true
	case "velocitySensitivity":
		Tuba_set_velocitySensitivity(p, value)
		return true
	}
	return false
}

Tuba_get_param :: proc(p: ^Tuba_Processor, name: string) -> (f32, bool) {
	switch name {
	case "Amp_attack":
		return p.Amp_attack, true
	case "Amp_decay":
		return p.Amp_decay, true
	case "Amp_depth":
		return p.Amp_depth, true
	case "Amp_release":
		return p.Amp_release, true
	case "Amp_sustain":
		return p.Amp_sustain, true
	case "Blow_attack":
		return p.Blow_attack, true
	case "Blow_decay":
		return p.Blow_decay, true
	case "Blow_depth":
		return p.Blow_depth, true
	case "Blow_release":
		return p.Blow_release, true
	case "Blow_sustain":
		return p.Blow_sustain, true
	case "Buzz_amplitude":
		return p.Buzz_amplitude, true
	case "Vibrato_amplitude":
		return p.Vibrato_amplitude, true
	case "cutoff":
		return p.cutoff, true
	case "frequency":
		return p.frequency, true
	case "outMax":
		return p.outMax, true
	case "resonance":
		return p.resonance, true
	case "velocitySensitivity":
		return p.velocitySensitivity, true
	}
	return 0.0, false
}

Tuba_process :: proc(p: ^Tuba_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	Tuba_process_sequence(p)
	p.total_samples += 1

	for v_idx in 0..<8 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.current_freq != voice.target_freq {
			glide_k := 1.0 / math.max(voice.glide_time * sample_rate, 1.0)
			if glide_k > 1.0 do glide_k = 1.0
			voice.current_freq += (voice.target_freq - voice.current_freq) * glide_k
			if abs(voice.target_freq - voice.current_freq) < 0.1 do voice.current_freq = voice.target_freq
		}
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_tuba_amp_stage != .Release && voice.adsr_tuba_amp_stage != .Idle {
				voice.adsr_tuba_amp_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_tuba_blow_stage != .Release && voice.adsr_tuba_blow_stage != .Idle {
				voice.adsr_tuba_blow_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_tuba_amp_out: f32 = 0.0
		node_tuba_blow_out: f32 = 0.0
		node_tuba_blow_map_out: f32 = 0.0
		node_tuba_filter_out: f32 = 0.0
		node_tuba_osc_out: f32 = 0.0
		node_tuba_output_out: f32 = 0.0
		node_tuba_vibrato_out: f32 = 0.0

		// --- ADSR Node tuba_blow ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_tuba_blow_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Blow_attack) > 0 do envelope = voice.age / math.max(f32(p.Blow_attack), 0.000001); else do envelope = 1.0;
				voice.adsr_tuba_blow_release_level = envelope;
				if voice.age >= (p.Blow_attack) {
					voice.adsr_tuba_blow_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Blow_attack);
				if (p.Blow_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Blow_decay), 0.000001)) * (1.0 - (p.Blow_sustain)); else do envelope = (p.Blow_sustain);
				voice.adsr_tuba_blow_release_level = envelope;
				if time_in_decay >= (p.Blow_decay) {
					voice.adsr_tuba_blow_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Blow_sustain);
				voice.adsr_tuba_blow_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_tuba_blow_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Blow_release) > 0 do envelope = voice.adsr_tuba_blow_release_level * (1.0 - (time_in_release / math.max(f32(p.Blow_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_tuba_blow_stage = .Idle;
				}
			}
			vel_scale_tuba_blow: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_tuba_blow_out = (1.0) * envelope * (p.Blow_depth) * vel_scale_tuba_blow;
		}

		// --- LFO Node tuba_vibrato ---
		voice.lfo_tuba_vibrato_phase = math.mod(voice.lfo_tuba_vibrato_phase + (2 * f32(math.PI) * (p.frequency) / sample_rate), 2 * f32(math.PI));
		if voice.lfo_tuba_vibrato_phase < 0.0 do voice.lfo_tuba_vibrato_phase += 2 * f32(math.PI);
		node_tuba_vibrato_out = math.sin(voice.lfo_tuba_vibrato_phase) * (p.Vibrato_amplitude);

		// --- Mapper Node tuba_blow_map ---
		{
			in_range_tuba_blow_map: f32 = f32(f32(1.000000000)) - f32(f32(0.000000000));
			if in_range_tuba_blow_map == 0.0 do in_range_tuba_blow_map = 1.0;
			node_tuba_blow_map_out = math.lerp(f32(f32(0.000000000)), f32(p.outMax), math.clamp((f32((node_tuba_blow_out)) - f32(f32(0.000000000))) / in_range_tuba_blow_map, 0.0, 1.0));
		}

		// --- Oscillator Node tuba_osc (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = ((voice.current_freq) * math.pow(2.0, math.clamp(f32(node_tuba_vibrato_out), -10.0, 10.0))) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_tuba_osc_phase[i] = math.mod(voice.osc_tuba_osc_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_tuba_osc_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += ((final_phase / f32(math.PI)) - 1.0);
			}
			if unison_count > 0 do node_tuba_osc_out = (unison_out / f32(unison_count)) * (p.Buzz_amplitude);
		}

		// --- Filter Node tuba_filter (SVF) ---
		{
			cutoff_c_tuba_filter: f32 = math.clamp(f32((p.cutoff) + (node_tuba_blow_map_out)), 10.0, sample_rate * 0.16);
			f_tuba_filter := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_tuba_filter / sample_rate));
			q_tuba_filter: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_tuba_filter);
			voice.filter_tuba_filter_low += f_tuba_filter * voice.filter_tuba_filter_band;
			high_tuba_filter := f32(((node_tuba_osc_out)) - voice.filter_tuba_filter_low - q_tuba_filter * voice.filter_tuba_filter_band);
			voice.filter_tuba_filter_band += f_tuba_filter * high_tuba_filter;
			node_tuba_filter_out = voice.filter_tuba_filter_low;
		}

		// --- ADSR Node tuba_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_tuba_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Amp_attack) > 0 do envelope = voice.age / math.max(f32(p.Amp_attack), 0.000001); else do envelope = 1.0;
				voice.adsr_tuba_amp_release_level = envelope;
				if voice.age >= (p.Amp_attack) {
					voice.adsr_tuba_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Amp_attack);
				if (p.Amp_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Amp_decay), 0.000001)) * (1.0 - (p.Amp_sustain)); else do envelope = (p.Amp_sustain);
				voice.adsr_tuba_amp_release_level = envelope;
				if time_in_decay >= (p.Amp_decay) {
					voice.adsr_tuba_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Amp_sustain);
				voice.adsr_tuba_amp_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_tuba_amp_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Amp_release) > 0 do envelope = voice.adsr_tuba_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.Amp_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_tuba_amp_stage = .Idle;
				}
			}
			vel_scale_tuba_amp: f32 = (1.0 - (p.velocitySensitivity)) + (p.velocitySensitivity) * voice.velocity;
			node_tuba_amp_out = ((node_tuba_filter_out)) * envelope * (p.Amp_depth) * vel_scale_tuba_amp;
		}

		output_left += node_tuba_amp_out
		output_right += node_tuba_amp_out
		if voice.adsr_tuba_amp_stage != .Idle do voice_busy = true
		if voice.adsr_tuba_blow_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	return output_left * f32(0.850000024), output_right * f32(0.850000024)
}
Tuba_process_sequence :: proc(p: ^Tuba_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "Tuba" (16 steps)
		switch p.current_step % 16 {
		case 0:
			Tuba_note_on(p, 36, 0.819999993, f32(3.000000000) * (60.0 / p.bpm / 4.0))
		case 4:
			Tuba_note_on(p, 31, 0.750000000, f32(3.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			Tuba_note_on(p, 34, 0.879999995, f32(3.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			Tuba_note_on(p, 29, 0.779999971, f32(3.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

Synth_Lead_Voice_State :: struct {
	active: bool,
	note: u8,
	velocity: f32,
	age: f32,
	time_released: f32,
	current_freq: f32,
	target_freq: f32,
	glide_time: f32,
	duration: f32,
	adsr_lead_amp_stage: ADSR_Stage,
	adsr_lead_amp_release_level: f32,
	filter_lead_filter_low: f32,
	filter_lead_filter_band: f32,
	osc_lead_osc_phase: [3]f32,
}

Synth_Lead_Processor :: struct {
	sample_rate: f32,
	bpm: f32,
	voices: [8]Synth_Lead_Voice_State,
	prng: PRNG_State,
	total_samples: u64,
	playing: bool,
	loop: bool,
	current_step: u64,
	samples_until_next_step: u64,
	step_frac_acc: f32,
	ext_in_l: f32,
	ext_in_r: f32,
	delay_lead_delay_buffer: [96000]f32,
	delay_lead_delay_write_index: int,
	amplitude: f32,
	attack: f32,
	cutoff: f32,
	decay: f32,
	depth: f32,
	feedback: f32,
	mix: f32,
	release: f32,
	resonance: f32,
	sustain: f32,
	velocitySensitivity: f32,
}

Synth_Lead_init :: proc(p: ^Synth_Lead_Processor, sr: f32) {
	p.sample_rate = sr
	p.bpm = 120.000000000
	p.prng.state = 12345
	p.loop = true
	p.amplitude = 0.500000000
	p.attack = 0.010000000
	p.cutoff = 1200.000000000
	p.decay = 0.200000003
	p.depth = 1.000000000
	p.feedback = 0.349999994
	p.mix = 0.250000000
	p.release = 0.250000000
	p.resonance = 2.500000000
	p.sustain = 0.600000024
	p.velocitySensitivity = 0.500000000
}

Synth_Lead_note_on :: proc(p: ^Synth_Lead_Processor, note: u8, velocity: f32, duration: f32) {
	voice_idx := -1
	for i in 0..<8 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_age: f32 = -1.0
		for i in 0..<8 {
			if p.voices[i].age > oldest_age {
				oldest_age = p.voices[i].age
				voice_idx = i
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.059999999
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	v.adsr_lead_amp_stage = .Attack
	v.adsr_lead_amp_release_level = 0.0
	v.filter_lead_filter_low = 0.0
	v.filter_lead_filter_band = 0.0
	v.osc_lead_osc_phase = {}
}

Synth_Lead_note_off :: proc(p: ^Synth_Lead_Processor, note: u8) {
	best := -1
	best_age: f32 = -1.0
	for i in 0..<8 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_lead_amp_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_lead_amp_stage = .Release
	}
}

Synth_Lead_trigger :: proc(p: ^Synth_Lead_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (p.attack) + (p.decay) > d do d = (p.attack) + (p.decay)
		if d <= 0.0 do d = 0.001
	}
	Synth_Lead_note_on(p, note, velocity, d)
}

Synth_Lead_feed_input :: proc(p: ^Synth_Lead_Processor, in_left: f32, in_right: f32) {
	p.ext_in_l = in_left
	p.ext_in_r = in_right
}

Synth_Lead_start :: proc(p: ^Synth_Lead_Processor) {
	p.playing = true
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
}

Synth_Lead_stop :: proc(p: ^Synth_Lead_Processor) {
	p.playing = false
}

Synth_Lead_set_loop :: proc(p: ^Synth_Lead_Processor, loop: bool) {
	p.loop = loop
}

Synth_Lead_is_playing :: proc(p: ^Synth_Lead_Processor) -> bool {
	if p.playing do return true
	for i in 0..<8 {
		if p.voices[i].active do return true
	}
	return false
}

Synth_Lead_set_amplitude :: proc(p: ^Synth_Lead_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 1.000000000 do v = 1.000000000
	p.amplitude = v
}

Synth_Lead_set_attack :: proc(p: ^Synth_Lead_Processor, value: f32) {
	v := value
	if v < 0.001000000 do v = 0.001000000
	if v > 10.000000000 do v = 10.000000000
	p.attack = v
}

Synth_Lead_set_cutoff :: proc(p: ^Synth_Lead_Processor, value: f32) {
	v := value
	if v < 20.000000000 do v = 20.000000000
	if v > 20000.000000000 do v = 20000.000000000
	p.cutoff = v
}

Synth_Lead_set_decay :: proc(p: ^Synth_Lead_Processor, value: f32) {
	v := value
	if v < 0.001000000 do v = 0.001000000
	if v > 10.000000000 do v = 10.000000000
	p.decay = v
}

Synth_Lead_set_depth :: proc(p: ^Synth_Lead_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 1.000000000 do v = 1.000000000
	p.depth = v
}

Synth_Lead_set_feedback :: proc(p: ^Synth_Lead_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 0.990000010 do v = 0.990000010
	p.feedback = v
}

Synth_Lead_set_mix :: proc(p: ^Synth_Lead_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 1.000000000 do v = 1.000000000
	p.mix = v
}

Synth_Lead_set_release :: proc(p: ^Synth_Lead_Processor, value: f32) {
	v := value
	if v < 0.001000000 do v = 0.001000000
	if v > 10.000000000 do v = 10.000000000
	p.release = v
}

Synth_Lead_set_resonance :: proc(p: ^Synth_Lead_Processor, value: f32) {
	v := value
	if v < 0.100000001 do v = 0.100000001
	if v > 20.000000000 do v = 20.000000000
	p.resonance = v
}

Synth_Lead_set_sustain :: proc(p: ^Synth_Lead_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 1.000000000 do v = 1.000000000
	p.sustain = v
}

Synth_Lead_set_velocitySensitivity :: proc(p: ^Synth_Lead_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 1.000000000 do v = 1.000000000
	p.velocitySensitivity = v
}

Synth_Lead_PARAMS := []Skald_Param_Info{
	{"amplitude", 0.000000000, 1.000000000, 0.500000000, ""},
	{"attack", 0.001000000, 10.000000000, 0.010000000, "s"},
	{"cutoff", 20.000000000, 20000.000000000, 1200.000000000, "Hz"},
	{"decay", 0.001000000, 10.000000000, 0.200000003, "s"},
	{"depth", 0.000000000, 1.000000000, 1.000000000, ""},
	{"feedback", 0.000000000, 0.990000010, 0.349999994, ""},
	{"mix", 0.000000000, 1.000000000, 0.250000000, ""},
	{"release", 0.001000000, 10.000000000, 0.250000000, "s"},
	{"resonance", 0.100000001, 20.000000000, 2.500000000, "Q"},
	{"sustain", 0.000000000, 1.000000000, 0.600000024, ""},
	{"velocitySensitivity", 0.000000000, 1.000000000, 0.500000000, ""},
}

Synth_Lead_set_param :: proc(p: ^Synth_Lead_Processor, name: string, value: f32) -> bool {
	switch name {
	case "amplitude":
		Synth_Lead_set_amplitude(p, value)
		return true
	case "attack":
		Synth_Lead_set_attack(p, value)
		return true
	case "cutoff":
		Synth_Lead_set_cutoff(p, value)
		return true
	case "decay":
		Synth_Lead_set_decay(p, value)
		return true
	case "depth":
		Synth_Lead_set_depth(p, value)
		return true
	case "feedback":
		Synth_Lead_set_feedback(p, value)
		return true
	case "mix":
		Synth_Lead_set_mix(p, value)
		return true
	case "release":
		Synth_Lead_set_release(p, value)
		return true
	case "resonance":
		Synth_Lead_set_resonance(p, value)
		return true
	case "sustain":
		Synth_Lead_set_sustain(p, value)
		return true
	case "velocitySensitivity":
		Synth_Lead_set_velocitySensitivity(p, value)
		return true
	}
	return false
}

Synth_Lead_get_param :: proc(p: ^Synth_Lead_Processor, name: string) -> (f32, bool) {
	switch name {
	case "amplitude":
		return p.amplitude, true
	case "attack":
		return p.attack, true
	case "cutoff":
		return p.cutoff, true
	case "decay":
		return p.decay, true
	case "depth":
		return p.depth, true
	case "feedback":
		return p.feedback, true
	case "mix":
		return p.mix, true
	case "release":
		return p.release, true
	case "resonance":
		return p.resonance, true
	case "sustain":
		return p.sustain, true
	case "velocitySensitivity":
		return p.velocitySensitivity, true
	}
	return 0.0, false
}

Synth_Lead_process :: proc(p: ^Synth_Lead_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	Synth_Lead_process_sequence(p)
	p.total_samples += 1

	node_lead_amp_out_vsum: f32 = 0.0
	for v_idx in 0..<8 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.current_freq != voice.target_freq {
			glide_k := 1.0 / math.max(voice.glide_time * sample_rate, 1.0)
			if glide_k > 1.0 do glide_k = 1.0
			voice.current_freq += (voice.target_freq - voice.current_freq) * glide_k
			if abs(voice.target_freq - voice.current_freq) < 0.1 do voice.current_freq = voice.target_freq
		}
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_lead_amp_stage != .Release && voice.adsr_lead_amp_stage != .Idle {
				voice.adsr_lead_amp_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_lead_amp_out: f32 = 0.0
		node_lead_filter_out: f32 = 0.0
		node_lead_osc_out: f32 = 0.0

		// --- Oscillator Node lead_osc (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 3;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (10.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_lead_osc_phase[i] = math.mod(voice.osc_lead_osc_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_lead_osc_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += ((final_phase / f32(math.PI)) - 1.0);
			}
			if unison_count > 0 do node_lead_osc_out = (unison_out / f32(unison_count)) * (p.amplitude);
		}

		// --- Filter Node lead_filter (SVF) ---
		{
			cutoff_c_lead_filter: f32 = math.clamp(f32(p.cutoff), 10.0, sample_rate * 0.16);
			f_lead_filter := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_lead_filter / sample_rate));
			q_lead_filter: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_lead_filter);
			voice.filter_lead_filter_low += f_lead_filter * voice.filter_lead_filter_band;
			high_lead_filter := f32(((node_lead_osc_out)) - voice.filter_lead_filter_low - q_lead_filter * voice.filter_lead_filter_band);
			voice.filter_lead_filter_band += f_lead_filter * high_lead_filter;
			node_lead_filter_out = voice.filter_lead_filter_low;
		}

		// --- ADSR Node lead_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_lead_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.attack) > 0 do envelope = voice.age / math.max(f32(p.attack), 0.000001); else do envelope = 1.0;
				voice.adsr_lead_amp_release_level = envelope;
				if voice.age >= (p.attack) {
					voice.adsr_lead_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.attack);
				if (p.decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.decay), 0.000001)) * (1.0 - (p.sustain)); else do envelope = (p.sustain);
				voice.adsr_lead_amp_release_level = envelope;
				if time_in_decay >= (p.decay) {
					voice.adsr_lead_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.sustain);
				voice.adsr_lead_amp_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_lead_amp_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.release) > 0 do envelope = voice.adsr_lead_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_lead_amp_stage = .Idle;
				}
			}
			vel_scale_lead_amp: f32 = (1.0 - (p.velocitySensitivity)) + (p.velocitySensitivity) * voice.velocity;
			node_lead_amp_out = ((node_lead_filter_out)) * envelope * (p.depth) * vel_scale_lead_amp;
		}

		node_lead_amp_out_vsum += node_lead_amp_out
		if voice.adsr_lead_amp_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}

	// --- Bus effects (once per sample, post voice sum) ---
	{
		node_lead_amp_out := node_lead_amp_out_vsum
		node_lead_delay_out: f32 = 0.0
		// --- Delay Node lead_delay ---
		{
			delay_samples_lead_delay := int(math.clamp((((60.0 / p.bpm) * 0.500000000)) * sample_rate, 1, 96000-1));
			read_index_lead_delay := (p.delay_lead_delay_write_index - delay_samples_lead_delay + len(p.delay_lead_delay_buffer)) % len(p.delay_lead_delay_buffer);
			delayed_sample_lead_delay := p.delay_lead_delay_buffer[read_index_lead_delay];
			p.delay_lead_delay_buffer[p.delay_lead_delay_write_index] = ((node_lead_amp_out)) + delayed_sample_lead_delay * math.clamp(f32(p.feedback), 0.0, 0.95);
			p.delay_lead_delay_write_index = (p.delay_lead_delay_write_index + 1) % len(p.delay_lead_delay_buffer);
			node_lead_delay_out = ((node_lead_amp_out)) * (1.0 - (p.mix)) + delayed_sample_lead_delay * (p.mix);
		}

		output_left += node_lead_delay_out
		output_right += node_lead_delay_out
	}
	return output_left * f32(0.750000000), output_right * f32(0.750000000)
}
Synth_Lead_process_sequence :: proc(p: ^Synth_Lead_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "Synth Lead" (16 steps)
		switch p.current_step % 16 {
		case 0:
			Synth_Lead_note_on(p, 60, 0.899999976, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 3:
			Synth_Lead_note_on(p, 63, 0.779999971, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 5:
			Synth_Lead_note_on(p, 67, 0.879999995, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			Synth_Lead_note_on(p, 70, 0.949999988, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 11:
			Synth_Lead_note_on(p, 67, 0.819999993, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 13:
			Synth_Lead_note_on(p, 63, 0.759999990, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	Snare: ^Snare_Processor,
	WUBBLE: ^WUBBLE_Processor,
	sadfsadf: ^sadfsadf_Processor,
	Growly_Sax: ^Growly_Sax_Processor,
	Kick: ^Kick_Processor,
	Tuba: ^Tuba_Processor,
	Synth_Lead: ^Synth_Lead_Processor,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.Snare = new(Snare_Processor)
	Snare_init(p.Snare, sr)
	Snare_start(p.Snare)
	p.WUBBLE = new(WUBBLE_Processor)
	WUBBLE_init(p.WUBBLE, sr)
	WUBBLE_start(p.WUBBLE)
	p.sadfsadf = new(sadfsadf_Processor)
	sadfsadf_init(p.sadfsadf, sr)
	p.Growly_Sax = new(Growly_Sax_Processor)
	Growly_Sax_init(p.Growly_Sax, sr)
	p.Kick = new(Kick_Processor)
	Kick_init(p.Kick, sr)
	Kick_start(p.Kick)
	p.Tuba = new(Tuba_Processor)
	Tuba_init(p.Tuba, sr)
	Tuba_start(p.Tuba)
	p.Synth_Lead = new(Synth_Lead_Processor)
	Synth_Lead_init(p.Synth_Lead, sr)
	Synth_Lead_start(p.Synth_Lead)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := Snare_process(p.Snare); mixed_left += l; mixed_right += r }
	{ l, r := WUBBLE_process(p.WUBBLE); mixed_left += l; mixed_right += r }
	{ l, r := sadfsadf_process(p.sadfsadf); mixed_left += l; mixed_right += r }
	{ l, r := Growly_Sax_process(p.Growly_Sax); mixed_left += l; mixed_right += r }
	{ l, r := Kick_process(p.Kick); mixed_left += l; mixed_right += r }
	{ l, r := Tuba_process(p.Tuba); mixed_left += l; mixed_right += r }
	{ l, r := Synth_Lead_process(p.Synth_Lead); mixed_left += l; mixed_right += r }
	mixed_left = math.tanh(mixed_left * 0.800000012)
	mixed_right = math.tanh(mixed_right * 0.800000012)
	return mixed_left, mixed_right
}

project_destroy :: proc(p: ^Project_State) {
	free(p.Snare)
	free(p.WUBBLE)
	free(p.sadfsadf)
	free(p.Growly_Sax)
	free(p.Kick)
	free(p.Tuba)
	free(p.Synth_Lead)
}

