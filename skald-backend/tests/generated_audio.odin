sadfsadf_trigger :: proc(p: ^sadfsadf_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (f32(3.000000000)) + (f32(2.500000000)) > d do d = (f32(3.000000000)) + (f32(2.500000000))
		if d <= 0.0 do d = 0.001
	}
	sadfsadf_note_on(p, note, velocity, d)
}

