Asset_process :: proc(p: ^Asset_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	p.total_samples += 1

	for v_idx in 0..<1 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
		}
		voice_gain: f32 = 1.0
		if voice.duration > 0.0 && voice.age > voice.duration {
			voice_gain = 1.0 - (voice.age - voice.duration) / f32(0.005000000)
			if voice_gain < 0.0 do voice_gain = 0.0
		}
		node_1_out: f32 = 0.0
		node_2_out: f32 = 0.0
		node_2_out_left: f32 = 0.0
		node_2_out_right: f32 = 0.0
		node_3_out: f32 = 0.0
		node_4_out: f32 = 0.0

		// --- Oscillator Node 1 (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_1_phase[i] = math.mod(voice.osc_1_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_1_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += math.sin(final_phase);
			}
			node_1_out = (unison_out / f32(unison_count)) * (f32(0.500000000));
		}

		// --- Panner Node 2 ---
		// Constant-power cos/sin law normalized by sqrt(2), so pan 0 is unity in
		// BOTH channels and a centred Panner is a transparent insert. Full
		// deflection therefore peaks at 1.4142 in one channel (+3dB).
		{
			pan_in_2: f32 = ((node_1_out));
			pan_angle_2: f32 = (math.clamp(f32(p.pan), -1.0, 1.0) * 0.5 + 0.5) * f32(math.PI) / 2.0;
			node_2_out_left = pan_in_2 * math.cos(pan_angle_2) * 1.4142136;
			node_2_out_right = pan_in_2 * math.sin(pan_angle_2) * 1.4142136;
			// Mono consumers get the input untouched: pan is not a level.
			node_2_out = pan_in_2;
		}

		// --- Gain Node 3 ---
		node_3_out = ((node_2_out)) * (f32(1.000000000));

		output_left += node_3_out * voice_gain
		output_right += node_3_out * voice_gain
		if voice.duration > 0.0 && voice.age >= voice.duration + f32(0.005000000) do voice.active = false
	}
	// limit: false authored on this instrument — output is deliberately unclamped.
	return output_left * p.volume, output_right * p.volume
}
