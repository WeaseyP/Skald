}

Asset_get_param :: proc(p: ^Asset_Processor, name: string) -> (f32, bool) {
	return 0.0, false
}

Asset_process :: proc(p: ^Asset_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	p.total_samples += 1

	node_6_out_vsum: f32 = 0.0
	for v_idx in 0..<8 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.current_freq != voice.target_freq {
			glide_k := 1.0 / math.max(voice.glide_time * sample_rate, 1.0)
			if glide_k > 1.0 do glide_k = 1.0
			voice.current_freq += (voice.target_freq - voice.current_freq) * glide_k
			if abs(voice.target_freq - voice.current_freq) < 0.1 do voice.current_freq = voice.target_freq
		}
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_6_stage != .Release && voice.adsr_6_stage != .Idle {
				voice.adsr_6_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_1_out: f32 = 0.0
		node_2_out: f32 = 0.0
		node_3_out: f32 = 0.0
		node_4_out: f32 = 0.0
		node_5_out: f32 = 0.0
		node_6_out: f32 = 0.0

		// --- LFO Node 2 ---
		voice.lfo_2_phase = math.mod(voice.lfo_2_phase + (2 * f32(math.PI) * (f32(6.000000000)) / sample_rate), 2 * f32(math.PI));
		if voice.lfo_2_phase < 0.0 do voice.lfo_2_phase += 2 * f32(math.PI);
		node_2_out = math.sin(voice.lfo_2_phase) * (f32(8.000000000));

		// --- LFO Node 3 ---
		voice.lfo_3_phase = math.mod(voice.lfo_3_phase + (2 * f32(math.PI) * (f32(3.000000000)) / sample_rate), 2 * f32(math.PI));
		if voice.lfo_3_phase < 0.0 do voice.lfo_3_phase += 2 * f32(math.PI);
		node_3_out = math.sin(voice.lfo_3_phase) * (f32(30000.000000000));

		// --- LFO Node 4 ---
		voice.lfo_4_phase = math.mod(voice.lfo_4_phase + (2 * f32(math.PI) * (f32(5.000000000)) / sample_rate), 2 * f32(math.PI));
		if voice.lfo_4_phase < 0.0 do voice.lfo_4_phase += 2 * f32(math.PI);
		node_4_out = math.sin(voice.lfo_4_phase) * (f32(40.000000000));

		// --- Oscillator Node 1 (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 3;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (25.000000000);
				detuned_freq: f32 = ((voice.current_freq) * math.pow(2.0, math.clamp(f32(node_2_out), -10.0, 10.0))) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_1_phase[i] = math.mod(voice.osc_1_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_1_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += ((final_phase / f32(math.PI)) - 1.0);
			}
			node_1_out = (unison_out / f32(unison_count)) * (f32(0.500000000));
		}

		// --- Filter Node 5 (SVF) ---
		{
			cutoff_c_5: f32 = math.clamp(f32((f32(1000.000000000)) + (node_3_out)), 10.0, sample_rate * 0.16);
			f_5 := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_5 / sample_rate));
			q_5: f32 = math.clamp(1.0 / math.max(f32((f32(0.300000000)) + (node_4_out)), 0.1), 0.05, 1.9 - f_5);
			voice.filter_5_low += f_5 * voice.filter_5_band;
			high_5 := f32(((node_1_out)) - voice.filter_5_low - q_5 * voice.filter_5_band);
			voice.filter_5_band += f_5 * high_5;
			node_5_out = voice.filter_5_low;
		}

		// --- ADSR Node 6 ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_6_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.010000000)) > 0 do envelope = voice.adsr_6_attack_start + (1.0 - voice.adsr_6_attack_start) * (voice.age / math.max(f32(f32(0.010000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_6_release_level = envelope;
				if voice.age >= (f32(0.010000000)) {
					voice.adsr_6_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.010000000));
				if (f32(0.100000000)) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(f32(0.100000000)), 0.000001)) * (1.0 - (f32(1.000000000))); else do envelope = (f32(1.000000000));
				voice.adsr_6_release_level = envelope;
				if time_in_decay >= (f32(0.100000000)) {
					voice.adsr_6_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(1.000000000));
				voice.adsr_6_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.200000000)) > 0 do envelope = voice.adsr_6_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.200000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_6_stage = .Idle;
				}
			}
			vel_scale_6: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_6_out = ((node_5_out)) * envelope * (f32(1.000000000)) * vel_scale_6;
		}

		node_6_out_vsum += node_6_out
		if voice.adsr_6_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}

	// --- Bus effects (once per sample, post voice sum) ---
	{
		node_6_out := node_6_out_vsum
		node_7_out: f32 = 0.0
		// --- Reverb Node 7 (pre-delay + feedback comb) ---
		{
			pre_delay_seconds_7: f32 = math.clamp(f32(f32(0.020000000)), 0.0, 0.25);
			pre_delay_samples_7 := int(math.clamp(pre_delay_seconds_7 * sample_rate, 0.0, f32(48000)));
			pre_write_index_7 := p.delay_7_write_index % len(p.reverb_7_pre_buffer)
			pre_delayed_input_7 := f32((node_6_out))
			if pre_delay_samples_7 > 0 {
				pre_read_index_7 := (pre_write_index_7 - pre_delay_samples_7 + len(p.reverb_7_pre_buffer)) % len(p.reverb_7_pre_buffer)
				pre_delayed_input_7 = p.reverb_7_pre_buffer[pre_read_index_7]
			}
			p.reverb_7_pre_buffer[pre_write_index_7] = f32((node_6_out))
			delay_samples_7 := int(math.clamp((0.075000000) * sample_rate, 0, 96000-1));
			read_index_7 := (p.delay_7_write_index - delay_samples_7 + len(p.delay_7_buffer)) % len(p.delay_7_buffer);
			delayed_sample_7 := p.delay_7_buffer[read_index_7];
			decay_gain_7: f32 = math.clamp(math.pow(f32(0.001), f32(0.075000000) / math.max(f32(f32(3.000000000)), 0.01)), 0.0, 0.95);
			p.delay_7_buffer[p.delay_7_write_index] = pre_delayed_input_7 + delayed_sample_7 * decay_gain_7;
			p.delay_7_write_index = (p.delay_7_write_index + 1) % len(p.delay_7_buffer);
			node_7_out = ((node_6_out)) * (1.0 - (f32(0.500000000))) + delayed_sample_7 * (f32(0.500000000));
		}

		output_left += node_7_out
		output_right += node_7_out
	}

	// B7-2-followup / SKB-016: a baked worst-case constant here held
	// is_playing true for minutes on real content (every exposed tail param
	// contributed its range maximum, so glassy-fm-pluck alone baked 202.5s
	// for a true tail under 2s). Arm on the FALLING EDGE instead, from the
	// live field values — that is one ln/pow per note-off rather than per
	// sample, which is what keeps this proc off the audio path.
	{
		voice_alive := false
		for i in 0..<8 {
			if p.voices[i].active {
				voice_alive = true
				break
			}
		}
		if voice_alive || p.playing {
			p.bus_tail_armed = false
			p.bus_tail_remaining = 0
		} else if !p.bus_tail_armed {
			p.bus_tail_armed = true
			p.bus_tail_remaining = u64(Asset_bus_tail_seconds(p) * sample_rate)
		} else if p.bus_tail_remaining > 0 {
			p.bus_tail_remaining -= 1
		}
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
