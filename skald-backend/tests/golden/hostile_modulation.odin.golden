Asset_note_on :: proc(p: ^Asset_Processor, note: u8, velocity: f32, duration: f32) {
	// note and velocity are clamped silently to their MIDI/normalized domains.
	note := note
	if note > 127 do note = 127
	velocity := math.clamp(velocity, 0.0, 1.0)
	voice_idx := -1
	for i in 0..<8 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_releasing_age: f32 = -1.0
		for i in 0..<8 {
			releasing := true
			if p.voices[i].adsr_6_stage != .Release && p.voices[i].adsr_6_stage != .Idle do releasing = false
			if releasing && p.voices[i].age > oldest_releasing_age {
				oldest_releasing_age = p.voices[i].age
				voice_idx = i
			}
		}
		if voice_idx == -1 {
			oldest_age: f32 = -1.0
			for i in 0..<8 {
				if p.voices[i].age > oldest_age {
					oldest_age = p.voices[i].age
					voice_idx = i
				}
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	adsr_6_prev_level: f32 = 0.0
	if stolen && v.adsr_6_stage != .Idle {
		adsr_6_prev_level = v.adsr_6_release_level
		if v.adsr_6_stage == .Release {
			rel_t_6: f32 = (f32(0.200000000));
			if rel_t_6 > 0.0 {
				rf_6 := 1.0 - (v.age - v.time_released) / math.max(rel_t_6, 0.000001)
				if rf_6 < 0.0 do rf_6 = 0.0
				adsr_6_prev_level *= rf_6
			} else {
				adsr_6_prev_level = 0.0
			}
		}
	}
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.050000001
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	v.adsr_6_stage = .Attack
	v.adsr_6_attack_start = adsr_6_prev_level
	v.adsr_6_release_level = adsr_6_prev_level
	if !stolen {
		v.osc_1_phase = {}
		v.lfo_2_phase = 0.0
		v.lfo_3_phase = 0.0
		v.lfo_4_phase = 0.0
		v.filter_5_low = 0.0
		v.filter_5_band = 0.0
	}
}

Asset_note_off :: proc(p: ^Asset_Processor, note: u8) {
	// Clamped to match _note_on: `note` is the voice key, so both must map it.
	note := note
	if note > 127 do note = 127
	best := -1
	best_age: f32 = -1.0
	for i in 0..<8 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_6_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_6_stage = .Release
	}
}

Asset_trigger :: proc(p: ^Asset_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (f32(0.010000000)) + (f32(0.100000000)) > d do d = (f32(0.010000000)) + (f32(0.100000000))
		if d <= 0.0 do d = 0.001
	}
	Asset_note_on(p, note, velocity, d)
}

Asset_feed_input :: proc(p: ^Asset_Processor, in_left: f32, in_right: f32) {
	p.ext_in_l = in_left
	p.ext_in_r = in_right
}

Asset_start :: proc(p: ^Asset_Processor) {
	p.playing = true
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
}

Asset_stop :: proc(p: ^Asset_Processor) {
	p.playing = false
}

Asset_set_loop :: proc(p: ^Asset_Processor, loop: bool) {
	p.loop = loop
}

Asset_set_volume :: proc(p: ^Asset_Processor, value: f32) {
	p.volume = math.clamp(value, 0.0, 1.0)
}

Asset_is_playing :: proc(p: ^Asset_Processor) -> bool {
	if p.playing do return true
	for i in 0..<8 {
		if p.voices[i].active do return true
	}
	// The effect tail counts as playing: it is still audible after every
	// voice went inactive, and reporting false here is what let a game free
	// the asset mid-echo.
	if p.bus_tail_remaining > 0 do return true
	return false
}

