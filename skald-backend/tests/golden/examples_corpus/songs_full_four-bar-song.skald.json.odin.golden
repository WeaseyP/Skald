Bass_process :: proc(p: ^Bass_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	Bass_process_sequence(p)
	p.total_samples += 1

	for v_idx in 0..<2 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_4_stage != .Release && voice.adsr_4_stage != .Idle {
				voice.adsr_4_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_6_stage != .Release && voice.adsr_6_stage != .Idle {
				voice.adsr_6_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_1_out: f32 = 0.0
		node_2_out: f32 = 0.0
		node_3_out: f32 = 0.0
		node_4_out: f32 = 0.0
		node_5_out: f32 = 0.0
		node_6_out: f32 = 0.0
		node_7_out: f32 = 0.0

		// --- MIDI Input Node 1 ---
		node_1_out_pitch := (f32(voice.note) - 69.0) / 12.0
		node_1_out_gate := f32(1.0)
		if voice.time_released > 0.0 do node_1_out_gate = 0.0
		node_1_out_velocity := voice.velocity

		// --- Oscillator Node 2 (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_2_phase[i] = math.mod(voice.osc_2_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_2_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += ((final_phase / f32(math.PI)) - 1.0);
			}
			node_2_out = (unison_out / f32(unison_count)) * (f32(0.700000000));
		}

		// --- ADSR Node 4 ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_4_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.005000000)) > 0 do envelope = voice.adsr_4_attack_start + (1.0 - voice.adsr_4_attack_start) * (voice.age / math.max(f32(f32(0.005000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_4_release_level = envelope;
				if voice.age >= (f32(0.005000000)) {
					voice.adsr_4_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.005000000));
				if (f32(0.180000000)) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(f32(0.180000000)), 0.000001)) * (1.0 - (f32(0.200000000))); else do envelope = (f32(0.200000000));
				voice.adsr_4_release_level = envelope;
				if time_in_decay >= (f32(0.180000000)) {
					voice.adsr_4_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.200000000));
				voice.adsr_4_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.100000000)) > 0 do envelope = voice.adsr_4_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.100000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_4_stage = .Idle;
				}
			}
			vel_scale_4: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_4_out = (1.0) * envelope * (f32(900.000000000)) * vel_scale_4;
		}

		// --- ADSR Node 6 ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_6_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.005000000)) > 0 do envelope = voice.adsr_6_attack_start + (1.0 - voice.adsr_6_attack_start) * (voice.age / math.max(f32(f32(0.005000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_6_release_level = envelope;
				if voice.age >= (f32(0.005000000)) {
					voice.adsr_6_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.005000000));
				if (f32(0.200000000)) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(f32(0.200000000)), 0.000001)) * (1.0 - (f32(0.600000000))); else do envelope = (f32(0.600000000));
				voice.adsr_6_release_level = envelope;
				if time_in_decay >= (f32(0.200000000)) {
					voice.adsr_6_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.600000000));
				voice.adsr_6_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.150000000)) > 0 do envelope = voice.adsr_6_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.150000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_6_stage = .Idle;
				}
			}
			vel_scale_6: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_6_out = (1.0) * envelope * (f32(1.000000000)) * vel_scale_6;
		}

		// --- Filter Node 3 (SVF) ---
		{
			cutoff_c_3: f32 = math.clamp(f32((f32(350.000000000)) + (node_4_out)), 10.0, sample_rate * 0.16);
			f_3 := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_3 / sample_rate));
			q_3: f32 = math.clamp(1.0 / math.max(f32(f32(3.000000000)), 0.1), 0.05, 1.9 - f_3);
			voice.filter_3_low += f_3 * voice.filter_3_band;
			high_3 := f32(((node_2_out)) - voice.filter_3_low - q_3 * voice.filter_3_band);
			voice.filter_3_band += f_3 * high_3;
			node_3_out = voice.filter_3_low;
		}

		// --- Gain Node 5 ---
		node_5_out = ((node_3_out)) * ((f32(0.000000000)) + (node_6_out));

		output_left += node_5_out
		output_right += node_5_out
		if voice.adsr_4_stage != .Idle do voice_busy = true
		if voice.adsr_6_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
Bass_process_sequence :: proc(p: ^Bass_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "Bass" (64 steps)
		switch p.current_step % 64 {
		case 0:
			Bass_note_on(p, 36, 0.899999976, f32(4.000000000) * (60.0 / p.bpm / 4.0))
		case 4:
			Bass_note_on(p, 43, 0.699999988, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 6:
			Bass_note_on(p, 39, 0.699999988, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			Bass_note_on(p, 36, 0.850000024, f32(4.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			Bass_note_on(p, 43, 0.750000000, f32(4.000000000) * (60.0 / p.bpm / 4.0))
		case 16:
			Bass_note_on(p, 32, 0.899999976, f32(4.000000000) * (60.0 / p.bpm / 4.0))
		case 20:
			Bass_note_on(p, 39, 0.699999988, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 22:
			Bass_note_on(p, 36, 0.699999988, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 24:
			Bass_note_on(p, 32, 0.850000024, f32(4.000000000) * (60.0 / p.bpm / 4.0))
		case 28:
			Bass_note_on(p, 39, 0.750000000, f32(4.000000000) * (60.0 / p.bpm / 4.0))
		case 32:
			Bass_note_on(p, 39, 0.899999976, f32(4.000000000) * (60.0 / p.bpm / 4.0))
		case 36:
			Bass_note_on(p, 46, 0.699999988, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 38:
			Bass_note_on(p, 43, 0.699999988, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 40:
			Bass_note_on(p, 39, 0.850000024, f32(4.000000000) * (60.0 / p.bpm / 4.0))
		case 44:
			Bass_note_on(p, 46, 0.750000000, f32(4.000000000) * (60.0 / p.bpm / 4.0))
		case 48:
			Bass_note_on(p, 31, 0.899999976, f32(4.000000000) * (60.0 / p.bpm / 4.0))
		case 52:
			Bass_note_on(p, 38, 0.699999988, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 54:
			Bass_note_on(p, 35, 0.699999988, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 56:
			Bass_note_on(p, 31, 0.850000024, f32(4.000000000) * (60.0 / p.bpm / 4.0))
		case 60:
			Bass_note_on(p, 38, 0.800000012, f32(4.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 64 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

HiHat_Voice_State :: struct {
	active: bool,
	note: u8,
	velocity: f32,
	age: f32,
	time_released: f32,
	current_freq: f32,
	target_freq: f32,
	glide_time: f32,
	duration: f32,
	noise_2_rng: PRNG_State,
	filter_3_low: f32,
	filter_3_band: f32,
	adsr_5_stage: ADSR_Stage,
	adsr_5_release_level: f32,
	adsr_5_attack_start: f32,
}

HiHat_Processor :: struct {
	sample_rate: f32,
	bpm: f32,
	voices: [2]HiHat_Voice_State,
	prng: PRNG_State,
	total_samples: u64,
	playing: bool,
	loop: bool,
	current_step: u64,
	samples_until_next_step: u64,
	step_frac_acc: f32,
	ext_in_l: f32,
	ext_in_r: f32,
	volume: f32,
}

HiHat_init :: proc(p: ^HiHat_Processor, sr: f32) {
	p.sample_rate = sr
	p.bpm = 100.000000000
	p.volume = 1.000000000
	p.prng.state = 12345
	p.loop = true
	p.voices = {}
	p.total_samples = 0
	p.playing = false
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
	p.ext_in_l = 0.0
	p.ext_in_r = 0.0
	for i in 0..<2 {
		v := &p.voices[i]
		v.noise_2_rng.state = u32(0xC0FFEE01) ~ u32(i + 1) * 2654435761
	}
}

HiHat_note_on :: proc(p: ^HiHat_Processor, note: u8, velocity: f32, duration: f32) {
	// note and velocity are clamped silently to their MIDI/normalized domains.
	note := note
	if note > 127 do note = 127
	velocity := math.clamp(velocity, 0.0, 1.0)
	voice_idx := -1
	for i in 0..<2 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_releasing_age: f32 = -1.0
		for i in 0..<2 {
			releasing := true
			if p.voices[i].adsr_5_stage != .Release && p.voices[i].adsr_5_stage != .Idle do releasing = false
			if releasing && p.voices[i].age > oldest_releasing_age {
				oldest_releasing_age = p.voices[i].age
				voice_idx = i
			}
		}
		if voice_idx == -1 {
			oldest_age: f32 = -1.0
			for i in 0..<2 {
				if p.voices[i].age > oldest_age {
					oldest_age = p.voices[i].age
					voice_idx = i
				}
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	adsr_5_prev_level: f32 = 0.0
	if stolen && v.adsr_5_stage != .Idle {
		adsr_5_prev_level = v.adsr_5_release_level
		if v.adsr_5_stage == .Release {
			rel_t_5: f32 = (f32(0.030000000));
			if rel_t_5 > 0.0 {
				rf_5 := 1.0 - (v.age - v.time_released) / math.max(rel_t_5, 0.000001)
				if rf_5 < 0.0 do rf_5 = 0.0
				adsr_5_prev_level *= rf_5
			} else {
				adsr_5_prev_level = 0.0
			}
		}
	}
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.000000000
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	v.adsr_5_stage = .Attack
	v.adsr_5_attack_start = adsr_5_prev_level
	v.adsr_5_release_level = adsr_5_prev_level
	if !stolen {
		v.filter_3_low = 0.0
		v.filter_3_band = 0.0
	}
}

HiHat_note_off :: proc(p: ^HiHat_Processor, note: u8) {
	// Clamped to match _note_on: `note` is the voice key, so both must map it.
	note := note
	if note > 127 do note = 127
	best := -1
	best_age: f32 = -1.0
	for i in 0..<2 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_5_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_5_stage = .Release
	}
}

HiHat_trigger :: proc(p: ^HiHat_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (f32(0.001000000)) + (f32(0.050000000)) > d do d = (f32(0.001000000)) + (f32(0.050000000))
		if d <= 0.0 do d = 0.001
	}
	HiHat_note_on(p, note, velocity, d)
}

HiHat_feed_input :: proc(p: ^HiHat_Processor, in_left: f32, in_right: f32) {
	p.ext_in_l = in_left
	p.ext_in_r = in_right
}

HiHat_start :: proc(p: ^HiHat_Processor) {
	p.playing = true
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
}

HiHat_stop :: proc(p: ^HiHat_Processor) {
	p.playing = false
}

HiHat_set_loop :: proc(p: ^HiHat_Processor, loop: bool) {
	p.loop = loop
}

HiHat_set_volume :: proc(p: ^HiHat_Processor, value: f32) {
	p.volume = math.clamp(value, 0.0, 1.0)
}

HiHat_is_playing :: proc(p: ^HiHat_Processor) -> bool {
	if p.playing do return true
	for i in 0..<2 {
		if p.voices[i].active do return true
	}
	return false
}

HiHat_PARAMS := []Skald_Param_Info{
}

HiHat_set_param :: proc(p: ^HiHat_Processor, name: string, value: f32) -> bool {
	return false
}

HiHat_get_param :: proc(p: ^HiHat_Processor, name: string) -> (f32, bool) {
	return 0.0, false
}

HiHat_process :: proc(p: ^HiHat_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	HiHat_process_sequence(p)
	p.total_samples += 1

	for v_idx in 0..<2 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_5_stage != .Release && voice.adsr_5_stage != .Idle {
				voice.adsr_5_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_1_out: f32 = 0.0
		node_2_out: f32 = 0.0
		node_3_out: f32 = 0.0
		node_4_out: f32 = 0.0
		node_5_out: f32 = 0.0
		node_6_out: f32 = 0.0

		// --- MIDI Input Node 1 ---
		node_1_out_pitch := (f32(voice.note) - 69.0) / 12.0
		node_1_out_gate := f32(1.0)
		if voice.time_released > 0.0 do node_1_out_gate = 0.0
		node_1_out_velocity := voice.velocity

		// --- Noise Node 2 ---
		node_2_out = (next_float32(&voice.noise_2_rng) * 2.0 - 1.0) * (f32(0.600000000));

		// --- ADSR Node 5 ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_5_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.001000000)) > 0 do envelope = voice.adsr_5_attack_start + (1.0 - voice.adsr_5_attack_start) * (voice.age / math.max(f32(f32(0.001000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_5_release_level = envelope;
				if voice.age >= (f32(0.001000000)) {
					voice.adsr_5_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.001000000));
				if (f32(0.050000000)) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(f32(0.050000000)), 0.000001)) * (1.0 - (f32(0.000000000))); else do envelope = (f32(0.000000000));
				voice.adsr_5_release_level = envelope;
				if time_in_decay >= (f32(0.050000000)) {
					voice.adsr_5_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.000000000));
				voice.adsr_5_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.030000000)) > 0 do envelope = voice.adsr_5_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.030000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_5_stage = .Idle;
				}
			}
			vel_scale_5: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_5_out = (1.0) * envelope * (f32(1.000000000)) * vel_scale_5;
		}

		// --- Filter Node 3 (SVF) ---
		{
			cutoff_c_3: f32 = math.clamp(f32(f32(7000.000000000)), 10.0, sample_rate * 0.16);
			f_3 := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_3 / sample_rate));
			q_3: f32 = math.clamp(1.0 / math.max(f32(f32(1.000000000)), 0.1), 0.05, 1.9 - f_3);
			voice.filter_3_low += f_3 * voice.filter_3_band;
			high_3 := f32(((node_2_out)) - voice.filter_3_low - q_3 * voice.filter_3_band);
			voice.filter_3_band += f_3 * high_3;
			node_3_out = high_3;
		}

		// --- Gain Node 4 ---
		node_4_out = ((node_3_out)) * ((f32(0.000000000)) + (node_5_out));

		output_left += node_4_out
		output_right += node_4_out
		if voice.adsr_5_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
HiHat_process_sequence :: proc(p: ^HiHat_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "HiHat" (64 steps)
		switch p.current_step % 64 {
		case 2:
			HiHat_note_on(p, 60, 0.550000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 6:
			HiHat_note_on(p, 60, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 10:
			HiHat_note_on(p, 60, 0.550000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 14:
			HiHat_note_on(p, 60, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 15:
			HiHat_note_on(p, 60, 0.500000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 18:
			HiHat_note_on(p, 60, 0.550000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 22:
			HiHat_note_on(p, 60, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 26:
			HiHat_note_on(p, 60, 0.550000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 30:
			HiHat_note_on(p, 60, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 31:
			HiHat_note_on(p, 60, 0.500000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 34:
			HiHat_note_on(p, 60, 0.550000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 38:
			HiHat_note_on(p, 60, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 42:
			HiHat_note_on(p, 60, 0.550000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 46:
			HiHat_note_on(p, 60, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 47:
			HiHat_note_on(p, 60, 0.500000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 50:
			HiHat_note_on(p, 60, 0.550000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 54:
			HiHat_note_on(p, 60, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 58:
			HiHat_note_on(p, 60, 0.550000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 61:
			HiHat_note_on(p, 60, 0.600000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 63:
			HiHat_note_on(p, 60, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 64 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

Kick_Voice_State :: struct {
	active: bool,
	note: u8,
	velocity: f32,
	age: f32,
	time_released: f32,
	current_freq: f32,
	target_freq: f32,
	glide_time: f32,
	duration: f32,
	osc_2_phase: [1]f32,
	adsr_3_stage: ADSR_Stage,
	adsr_3_release_level: f32,
	adsr_3_attack_start: f32,
	adsr_5_stage: ADSR_Stage,
	adsr_5_release_level: f32,
	adsr_5_attack_start: f32,
	dist_6_tone: f32,
}

Kick_Processor :: struct {
	sample_rate: f32,
	bpm: f32,
	voices: [1]Kick_Voice_State,
	prng: PRNG_State,
	total_samples: u64,
	playing: bool,
	loop: bool,
	current_step: u64,
	samples_until_next_step: u64,
	step_frac_acc: f32,
	ext_in_l: f32,
	ext_in_r: f32,
	volume: f32,
}

Kick_init :: proc(p: ^Kick_Processor, sr: f32) {
	p.sample_rate = sr
	p.bpm = 100.000000000
	p.volume = 1.000000000
	p.prng.state = 12345
	p.loop = true
	p.voices = {}
	p.total_samples = 0
	p.playing = false
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
	p.ext_in_l = 0.0
	p.ext_in_r = 0.0
}

Kick_note_on :: proc(p: ^Kick_Processor, note: u8, velocity: f32, duration: f32) {
	// note and velocity are clamped silently to their MIDI/normalized domains.
	note := note
	if note > 127 do note = 127
	velocity := math.clamp(velocity, 0.0, 1.0)
	voice_idx := -1
	for i in 0..<1 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_releasing_age: f32 = -1.0
		for i in 0..<1 {
			releasing := true
			if p.voices[i].adsr_3_stage != .Release && p.voices[i].adsr_3_stage != .Idle do releasing = false
			if p.voices[i].adsr_5_stage != .Release && p.voices[i].adsr_5_stage != .Idle do releasing = false
			if releasing && p.voices[i].age > oldest_releasing_age {
				oldest_releasing_age = p.voices[i].age
				voice_idx = i
			}
		}
		if voice_idx == -1 {
			oldest_age: f32 = -1.0
			for i in 0..<1 {
				if p.voices[i].age > oldest_age {
					oldest_age = p.voices[i].age
					voice_idx = i
				}
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	adsr_3_prev_level: f32 = 0.0
	if stolen && v.adsr_3_stage != .Idle {
		adsr_3_prev_level = v.adsr_3_release_level
		if v.adsr_3_stage == .Release {
			rel_t_3: f32 = (f32(0.050000000));
			if rel_t_3 > 0.0 {
				rf_3 := 1.0 - (v.age - v.time_released) / math.max(rel_t_3, 0.000001)
				if rf_3 < 0.0 do rf_3 = 0.0
				adsr_3_prev_level *= rf_3
			} else {
				adsr_3_prev_level = 0.0
			}
		}
	}
	adsr_5_prev_level: f32 = 0.0
	if stolen && v.adsr_5_stage != .Idle {
		adsr_5_prev_level = v.adsr_5_release_level
		if v.adsr_5_stage == .Release {
			rel_t_5: f32 = (f32(0.100000000));
			if rel_t_5 > 0.0 {
				rf_5 := 1.0 - (v.age - v.time_released) / math.max(rel_t_5, 0.000001)
				if rf_5 < 0.0 do rf_5 = 0.0
				adsr_5_prev_level *= rf_5
			} else {
				adsr_5_prev_level = 0.0
			}
		}
	}
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.000000000
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	v.adsr_3_stage = .Attack
	v.adsr_3_attack_start = adsr_3_prev_level
	v.adsr_3_release_level = adsr_3_prev_level
	v.adsr_5_stage = .Attack
	v.adsr_5_attack_start = adsr_5_prev_level
	v.adsr_5_release_level = adsr_5_prev_level
	if !stolen {
		v.osc_2_phase = {}
		v.dist_6_tone = 0.0
	}
}

Kick_note_off :: proc(p: ^Kick_Processor, note: u8) {
	// Clamped to match _note_on: `note` is the voice key, so both must map it.
	note := note
	if note > 127 do note = 127
	best := -1
	best_age: f32 = -1.0
	for i in 0..<1 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_3_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_3_stage = .Release
		p.voices[best].adsr_5_stage = .Release
	}
}

Kick_trigger :: proc(p: ^Kick_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (f32(0.001000000)) + (f32(0.080000000)) > d do d = (f32(0.001000000)) + (f32(0.080000000))
		if (f32(0.001000000)) + (f32(0.180000000)) > d do d = (f32(0.001000000)) + (f32(0.180000000))
		if d <= 0.0 do d = 0.001
	}
	Kick_note_on(p, note, velocity, d)
}

Kick_feed_input :: proc(p: ^Kick_Processor, in_left: f32, in_right: f32) {
	p.ext_in_l = in_left
	p.ext_in_r = in_right
}

Kick_start :: proc(p: ^Kick_Processor) {
	p.playing = true
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
}

Kick_stop :: proc(p: ^Kick_Processor) {
	p.playing = false
}

Kick_set_loop :: proc(p: ^Kick_Processor, loop: bool) {
	p.loop = loop
}

Kick_set_volume :: proc(p: ^Kick_Processor, value: f32) {
	p.volume = math.clamp(value, 0.0, 1.0)
}

Kick_is_playing :: proc(p: ^Kick_Processor) -> bool {
	if p.playing do return true
	for i in 0..<1 {
		if p.voices[i].active do return true
	}
	return false
}

Kick_PARAMS := []Skald_Param_Info{
}

Kick_set_param :: proc(p: ^Kick_Processor, name: string, value: f32) -> bool {
	return false
}

Kick_get_param :: proc(p: ^Kick_Processor, name: string) -> (f32, bool) {
	return 0.0, false
}

Kick_process :: proc(p: ^Kick_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	Kick_process_sequence(p)
	p.total_samples += 1

	for v_idx in 0..<1 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_3_stage != .Release && voice.adsr_3_stage != .Idle {
				voice.adsr_3_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_5_stage != .Release && voice.adsr_5_stage != .Idle {
				voice.adsr_5_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_1_out: f32 = 0.0
		node_2_out: f32 = 0.0
		node_3_out: f32 = 0.0
		node_4_out: f32 = 0.0
		node_5_out: f32 = 0.0
		node_6_out: f32 = 0.0
		node_7_out: f32 = 0.0

		// --- MIDI Input Node 1 ---
		node_1_out_pitch := (f32(voice.note) - 69.0) / 12.0
		node_1_out_gate := f32(1.0)
		if voice.time_released > 0.0 do node_1_out_gate = 0.0
		node_1_out_velocity := voice.velocity

		// --- ADSR Node 3 ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_3_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.001000000)) > 0 do envelope = voice.adsr_3_attack_start + (1.0 - voice.adsr_3_attack_start) * (voice.age / math.max(f32(f32(0.001000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_3_release_level = envelope;
				if voice.age >= (f32(0.001000000)) {
					voice.adsr_3_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.001000000));
				if (f32(0.080000000)) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(f32(0.080000000)), 0.000001)) * (1.0 - (f32(0.000000000))); else do envelope = (f32(0.000000000));
				voice.adsr_3_release_level = envelope;
				if time_in_decay >= (f32(0.080000000)) {
					voice.adsr_3_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.000000000));
				voice.adsr_3_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.050000000)) > 0 do envelope = voice.adsr_3_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.050000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_3_stage = .Idle;
				}
			}
			vel_scale_3: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_3_out = (1.0) * envelope * (f32(1.500000000)) * vel_scale_3;
		}

		// --- ADSR Node 5 ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_5_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.001000000)) > 0 do envelope = voice.adsr_5_attack_start + (1.0 - voice.adsr_5_attack_start) * (voice.age / math.max(f32(f32(0.001000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_5_release_level = envelope;
				if voice.age >= (f32(0.001000000)) {
					voice.adsr_5_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.001000000));
				if (f32(0.180000000)) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(f32(0.180000000)), 0.000001)) * (1.0 - (f32(0.000000000))); else do envelope = (f32(0.000000000));
				voice.adsr_5_release_level = envelope;
				if time_in_decay >= (f32(0.180000000)) {
					voice.adsr_5_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.000000000));
				voice.adsr_5_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.100000000)) > 0 do envelope = voice.adsr_5_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.100000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_5_stage = .Idle;
				}
			}
			vel_scale_5: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_5_out = (1.0) * envelope * (f32(1.000000000)) * vel_scale_5;
		}

		// --- Oscillator Node 2 (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = ((voice.current_freq) * math.pow(2.0, math.clamp(f32(node_3_out), -10.0, 10.0))) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_2_phase[i] = math.mod(voice.osc_2_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_2_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += math.sin(final_phase);
			}
			node_2_out = (unison_out / f32(unison_count)) * (f32(1.000000000));
		}

		// --- Gain Node 4 ---
		node_4_out = ((node_2_out)) * ((f32(0.000000000)) + (node_5_out));

		// --- Distortion Node 6 (classic) ---
		{
			dist_in_6: f32 = ((node_4_out));
			dist_k_6: f32 = math.max(f32(f32(4.000000000)), 1.0);
			dist_wet_6: f32 = (f32(math.PI) + dist_k_6) * dist_in_6 / (f32(math.PI) + dist_k_6 * abs(dist_in_6));
			tone_k_6: f32 = math.clamp(2.0 * f32(math.PI) * math.clamp(f32(f32(4000.000000000)), 100.0, 20000.0) / sample_rate, 0.001, 1.0);
			voice.dist_6_tone += tone_k_6 * (dist_wet_6 - voice.dist_6_tone);
			mix_6: f32 = math.clamp(f32(f32(0.300000000)), 0.0, 1.0);
			node_6_out = dist_in_6 * (1.0 - mix_6) + voice.dist_6_tone * mix_6;
		}

		output_left += node_6_out
		output_right += node_6_out
		if voice.adsr_3_stage != .Idle do voice_busy = true
		if voice.adsr_5_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
Kick_process_sequence :: proc(p: ^Kick_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "Kick" (64 steps)
		switch p.current_step % 64 {
		case 0:
			Kick_note_on(p, 24, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 4:
			Kick_note_on(p, 24, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			Kick_note_on(p, 24, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			Kick_note_on(p, 24, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 16:
			Kick_note_on(p, 24, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 20:
			Kick_note_on(p, 24, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 24:
			Kick_note_on(p, 24, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 28:
			Kick_note_on(p, 24, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 32:
			Kick_note_on(p, 24, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 36:
			Kick_note_on(p, 24, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 40:
			Kick_note_on(p, 24, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 44:
			Kick_note_on(p, 24, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 48:
			Kick_note_on(p, 24, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 52:
			Kick_note_on(p, 24, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 56:
			Kick_note_on(p, 24, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 62:
			Kick_note_on(p, 24, 0.850000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 64 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

Lead_Voice_State :: struct {
	active: bool,
	note: u8,
	velocity: f32,
	age: f32,
	time_released: f32,
	current_freq: f32,
	target_freq: f32,
	glide_time: f32,
	duration: f32,
	osc_2_phase: [1]f32,
	filter_3_low: f32,
	filter_3_band: f32,
	adsr_4_stage: ADSR_Stage,
	adsr_4_release_level: f32,
	adsr_4_attack_start: f32,
	dist_5_tone: f32,
	adsr_7_stage: ADSR_Stage,
	adsr_7_release_level: f32,
	adsr_7_attack_start: f32,
}

Lead_Processor :: struct {
	sample_rate: f32,
	bpm: f32,
	voices: [4]Lead_Voice_State,
	prng: PRNG_State,
	total_samples: u64,
	playing: bool,
	loop: bool,
	current_step: u64,
	samples_until_next_step: u64,
	step_frac_acc: f32,
	ext_in_l: f32,
	ext_in_r: f32,
	volume: f32,
}

Lead_init :: proc(p: ^Lead_Processor, sr: f32) {
	p.sample_rate = sr
	p.bpm = 100.000000000
	p.volume = 1.000000000
	p.prng.state = 12345
	p.loop = true
	p.voices = {}
	p.total_samples = 0
	p.playing = false
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
	p.ext_in_l = 0.0
	p.ext_in_r = 0.0
}

Lead_note_on :: proc(p: ^Lead_Processor, note: u8, velocity: f32, duration: f32) {
	// note and velocity are clamped silently to their MIDI/normalized domains.
	note := note
	if note > 127 do note = 127
	velocity := math.clamp(velocity, 0.0, 1.0)
	voice_idx := -1
	for i in 0..<4 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_releasing_age: f32 = -1.0
		for i in 0..<4 {
			releasing := true
			if p.voices[i].adsr_4_stage != .Release && p.voices[i].adsr_4_stage != .Idle do releasing = false
			if p.voices[i].adsr_7_stage != .Release && p.voices[i].adsr_7_stage != .Idle do releasing = false
			if releasing && p.voices[i].age > oldest_releasing_age {
				oldest_releasing_age = p.voices[i].age
				voice_idx = i
			}
		}
		if voice_idx == -1 {
			oldest_age: f32 = -1.0
			for i in 0..<4 {
				if p.voices[i].age > oldest_age {
					oldest_age = p.voices[i].age
					voice_idx = i
				}
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	adsr_4_prev_level: f32 = 0.0
	if stolen && v.adsr_4_stage != .Idle {
		adsr_4_prev_level = v.adsr_4_release_level
		if v.adsr_4_stage == .Release {
			rel_t_4: f32 = (f32(0.200000000));
			if rel_t_4 > 0.0 {
				rf_4 := 1.0 - (v.age - v.time_released) / math.max(rel_t_4, 0.000001)
				if rf_4 < 0.0 do rf_4 = 0.0
				adsr_4_prev_level *= rf_4
			} else {
				adsr_4_prev_level = 0.0
			}
		}
	}
	adsr_7_prev_level: f32 = 0.0
	if stolen && v.adsr_7_stage != .Idle {
		adsr_7_prev_level = v.adsr_7_release_level
		if v.adsr_7_stage == .Release {
			rel_t_7: f32 = (f32(0.250000000));
			if rel_t_7 > 0.0 {
				rf_7 := 1.0 - (v.age - v.time_released) / math.max(rel_t_7, 0.000001)
				if rf_7 < 0.0 do rf_7 = 0.0
				adsr_7_prev_level *= rf_7
			} else {
				adsr_7_prev_level = 0.0
			}
		}
	}
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.000000000
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	v.adsr_4_stage = .Attack
	v.adsr_4_attack_start = adsr_4_prev_level
	v.adsr_4_release_level = adsr_4_prev_level
	v.adsr_7_stage = .Attack
	v.adsr_7_attack_start = adsr_7_prev_level
	v.adsr_7_release_level = adsr_7_prev_level
	if !stolen {
		v.osc_2_phase = {}
		v.filter_3_low = 0.0
		v.filter_3_band = 0.0
		v.dist_5_tone = 0.0
	}
}

Lead_note_off :: proc(p: ^Lead_Processor, note: u8) {
	// Clamped to match _note_on: `note` is the voice key, so both must map it.
	note := note
	if note > 127 do note = 127
	best := -1
	best_age: f32 = -1.0
	for i in 0..<4 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_4_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_4_stage = .Release
		p.voices[best].adsr_7_stage = .Release
	}
}

Lead_trigger :: proc(p: ^Lead_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (f32(0.010000000)) + (f32(0.250000000)) > d do d = (f32(0.010000000)) + (f32(0.250000000))
		if (f32(0.020000000)) + (f32(0.150000000)) > d do d = (f32(0.020000000)) + (f32(0.150000000))
		if d <= 0.0 do d = 0.001
	}
	Lead_note_on(p, note, velocity, d)
}

Lead_feed_input :: proc(p: ^Lead_Processor, in_left: f32, in_right: f32) {
	p.ext_in_l = in_left
	p.ext_in_r = in_right
}

Lead_start :: proc(p: ^Lead_Processor) {
	p.playing = true
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
}

Lead_stop :: proc(p: ^Lead_Processor) {
	p.playing = false
}

Lead_set_loop :: proc(p: ^Lead_Processor, loop: bool) {
	p.loop = loop
}

Lead_set_volume :: proc(p: ^Lead_Processor, value: f32) {
	p.volume = math.clamp(value, 0.0, 1.0)
}

Lead_is_playing :: proc(p: ^Lead_Processor) -> bool {
	if p.playing do return true
	for i in 0..<4 {
		if p.voices[i].active do return true
	}
	return false
}

Lead_PARAMS := []Skald_Param_Info{
}

Lead_set_param :: proc(p: ^Lead_Processor, name: string, value: f32) -> bool {
	return false
}

Lead_get_param :: proc(p: ^Lead_Processor, name: string) -> (f32, bool) {
	return 0.0, false
}

Lead_process :: proc(p: ^Lead_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	Lead_process_sequence(p)
	p.total_samples += 1

	for v_idx in 0..<4 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_4_stage != .Release && voice.adsr_4_stage != .Idle {
				voice.adsr_4_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_7_stage != .Release && voice.adsr_7_stage != .Idle {
				voice.adsr_7_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_1_out: f32 = 0.0
		node_2_out: f32 = 0.0
		node_3_out: f32 = 0.0
		node_4_out: f32 = 0.0
		node_5_out: f32 = 0.0
		node_6_out: f32 = 0.0
		node_7_out: f32 = 0.0
		node_8_out: f32 = 0.0

		// --- MIDI Input Node 1 ---
		node_1_out_pitch := (f32(voice.note) - 69.0) / 12.0
		node_1_out_gate := f32(1.0)
		if voice.time_released > 0.0 do node_1_out_gate = 0.0
		node_1_out_velocity := voice.velocity

		// --- Oscillator Node 2 (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_2_phase[i] = math.mod(voice.osc_2_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_2_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += ((final_phase / f32(math.PI)) - 1.0);
			}
			node_2_out = (unison_out / f32(unison_count)) * (f32(0.550000000));
		}

		// --- ADSR Node 4 ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_4_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.010000000)) > 0 do envelope = voice.adsr_4_attack_start + (1.0 - voice.adsr_4_attack_start) * (voice.age / math.max(f32(f32(0.010000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_4_release_level = envelope;
				if voice.age >= (f32(0.010000000)) {
					voice.adsr_4_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.010000000));
				if (f32(0.250000000)) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(f32(0.250000000)), 0.000001)) * (1.0 - (f32(0.300000000))); else do envelope = (f32(0.300000000));
				voice.adsr_4_release_level = envelope;
				if time_in_decay >= (f32(0.250000000)) {
					voice.adsr_4_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.300000000));
				voice.adsr_4_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.200000000)) > 0 do envelope = voice.adsr_4_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.200000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_4_stage = .Idle;
				}
			}
			vel_scale_4: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_4_out = (1.0) * envelope * (f32(2200.000000000)) * vel_scale_4;
		}

		// --- ADSR Node 7 ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_7_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.020000000)) > 0 do envelope = voice.adsr_7_attack_start + (1.0 - voice.adsr_7_attack_start) * (voice.age / math.max(f32(f32(0.020000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_7_release_level = envelope;
				if voice.age >= (f32(0.020000000)) {
					voice.adsr_7_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.020000000));
				if (f32(0.150000000)) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(f32(0.150000000)), 0.000001)) * (1.0 - (f32(0.700000000))); else do envelope = (f32(0.700000000));
				voice.adsr_7_release_level = envelope;
				if time_in_decay >= (f32(0.150000000)) {
					voice.adsr_7_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.700000000));
				voice.adsr_7_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.250000000)) > 0 do envelope = voice.adsr_7_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.250000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_7_stage = .Idle;
				}
			}
			vel_scale_7: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_7_out = (1.0) * envelope * (f32(1.000000000)) * vel_scale_7;
		}

		// --- Filter Node 3 (SVF) ---
		{
			cutoff_c_3: f32 = math.clamp(f32((f32(600.000000000)) + (node_4_out)), 10.0, sample_rate * 0.16);
			f_3 := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_3 / sample_rate));
			q_3: f32 = math.clamp(1.0 / math.max(f32(f32(4.000000000)), 0.1), 0.05, 1.9 - f_3);
			voice.filter_3_low += f_3 * voice.filter_3_band;
			high_3 := f32(((node_2_out)) - voice.filter_3_low - q_3 * voice.filter_3_band);
			voice.filter_3_band += f_3 * high_3;
			node_3_out = voice.filter_3_low;
		}

		// --- Distortion Node 5 (classic) ---
		{
			dist_in_5: f32 = ((node_3_out));
			dist_k_5: f32 = math.max(f32(f32(8.000000000)), 1.0);
			dist_wet_5: f32 = (f32(math.PI) + dist_k_5) * dist_in_5 / (f32(math.PI) + dist_k_5 * abs(dist_in_5));
			tone_k_5: f32 = math.clamp(2.0 * f32(math.PI) * math.clamp(f32(f32(4000.000000000)), 100.0, 20000.0) / sample_rate, 0.001, 1.0);
			voice.dist_5_tone += tone_k_5 * (dist_wet_5 - voice.dist_5_tone);
			mix_5: f32 = math.clamp(f32(f32(0.350000000)), 0.0, 1.0);
			node_5_out = dist_in_5 * (1.0 - mix_5) + voice.dist_5_tone * mix_5;
		}

		// --- Gain Node 6 ---
		node_6_out = ((node_5_out)) * ((f32(0.000000000)) + (node_7_out));

		output_left += node_6_out
		output_right += node_6_out
		if voice.adsr_4_stage != .Idle do voice_busy = true
		if voice.adsr_7_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
Lead_process_sequence :: proc(p: ^Lead_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "Lead" (64 steps)
		switch p.current_step % 64 {
		case 0:
			Lead_note_on(p, 67, 0.850000024, f32(4.000000000) * (60.0 / p.bpm / 4.0))
		case 4:
			Lead_note_on(p, 75, 0.899999976, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 6:
			Lead_note_on(p, 74, 0.800000012, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			Lead_note_on(p, 72, 0.899999976, f32(4.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			Lead_note_on(p, 67, 0.750000000, f32(4.000000000) * (60.0 / p.bpm / 4.0))
		case 16:
			Lead_note_on(p, 68, 0.850000024, f32(4.000000000) * (60.0 / p.bpm / 4.0))
		case 20:
			Lead_note_on(p, 72, 0.800000012, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 22:
			Lead_note_on(p, 75, 0.850000024, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 24:
			Lead_note_on(p, 77, 0.949999988, f32(4.000000000) * (60.0 / p.bpm / 4.0))
		case 28:
			Lead_note_on(p, 75, 0.800000012, f32(4.000000000) * (60.0 / p.bpm / 4.0))
		case 32:
			Lead_note_on(p, 79, 1.000000000, f32(4.000000000) * (60.0 / p.bpm / 4.0))
		case 36:
			Lead_note_on(p, 77, 0.850000024, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 38:
			Lead_note_on(p, 75, 0.850000024, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 40:
			Lead_note_on(p, 74, 0.850000024, f32(4.000000000) * (60.0 / p.bpm / 4.0))
		case 44:
			Lead_note_on(p, 70, 0.800000012, f32(4.000000000) * (60.0 / p.bpm / 4.0))
		case 48:
			Lead_note_on(p, 74, 0.800000012, f32(4.000000000) * (60.0 / p.bpm / 4.0))
		case 52:
			Lead_note_on(p, 77, 0.850000024, f32(4.000000000) * (60.0 / p.bpm / 4.0))
		case 56:
			Lead_note_on(p, 79, 0.949999988, f32(4.000000000) * (60.0 / p.bpm / 4.0))
		case 60:
			Lead_note_on(p, 71, 0.899999976, f32(4.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 64 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

Pad_Voice_State :: struct {
	active: bool,
	note: u8,
	velocity: f32,
	age: f32,
	time_released: f32,
	current_freq: f32,
	target_freq: f32,
	glide_time: f32,
	duration: f32,
	osc_2_phase: [1]f32,
	filter_3_low: f32,
	filter_3_band: f32,
	adsr_5_stage: ADSR_Stage,
	adsr_5_release_level: f32,
	adsr_5_attack_start: f32,
}

Pad_Processor :: struct {
	sample_rate: f32,
	bpm: f32,
	voices: [6]Pad_Voice_State,
	prng: PRNG_State,
	total_samples: u64,
	playing: bool,
	loop: bool,
	current_step: u64,
	samples_until_next_step: u64,
	step_frac_acc: f32,
	ext_in_l: f32,
	ext_in_r: f32,
	volume: f32,
	bus_tail_remaining: u64,
	bus_tail_armed: bool,
	delay_6_buffer: [96000]f32,
	delay_6_write_index: int,
	delay_7_buffer: [96000]f32,
	delay_7_write_index: int,
	reverb_7_pre_buffer: [48000]f32,
}

Pad_BUS_TAIL_SECONDS :: f32(7.295000000)

// B7-2-followup / SKB-016: the LIVE counterpart to the worst-case constant
// above. Sums, over the same Delay/Reverb nodes compute_bus_tail_seconds
// analyzed, the same feedback_tail_seconds formula — but against each
// parameter's CURRENT value instead of its range maximum. Safe to call
// outside the audio path (once per note-off, not once per sample)
// because no Delay/Reverb parameter has a modulation port: get_f32_param
// resolves every one of them to either a plain field read or a literal,
// both valid wherever `p` is in scope.
Pad_bus_tail_seconds :: proc(p: ^Pad_Processor) -> f32 {
	total: f32 = 0.0
	mix_6: f32 = (f32(0.250000000));
	if mix_6 > 0.0 {
		period_6: f32 = (f32(0.375000000));
		fdbk_6: f32 = (f32(0.300000000));
		total += skald_feedback_tail_seconds(period_6, fdbk_6)
	}
	mix_7: f32 = (f32(0.500000000));
	if mix_7 > 0.0 {
		pre_7: f32 = math.clamp(f32(f32(0.020000000)), 0.0, 0.25);
		decay_gain_7: f32 = math.clamp(math.pow(f32(0.001), f32(0.075000000) / math.max(f32(f32(5.000000000)), 0.01)), 0.0, 0.95);
		total += pre_7 + skald_feedback_tail_seconds(f32(0.075000000), decay_gain_7)
	}
	return total
}

Pad_init :: proc(p: ^Pad_Processor, sr: f32) {
	p.sample_rate = sr
	p.bpm = 100.000000000
	p.volume = 1.000000000
	p.prng.state = 12345
	p.loop = true
	p.voices = {}
	p.total_samples = 0
	p.playing = false
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
	p.ext_in_l = 0.0
	p.ext_in_r = 0.0
	p.bus_tail_remaining = 0
	p.bus_tail_armed = false
	p.delay_6_buffer = {}
	p.delay_6_write_index = 0
	p.delay_7_buffer = {}
	p.delay_7_write_index = 0
	p.reverb_7_pre_buffer = {}
}

Pad_note_on :: proc(p: ^Pad_Processor, note: u8, velocity: f32, duration: f32) {
	// note and velocity are clamped silently to their MIDI/normalized domains.
	note := note
	if note > 127 do note = 127
	velocity := math.clamp(velocity, 0.0, 1.0)
	voice_idx := -1
	for i in 0..<6 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_releasing_age: f32 = -1.0
		for i in 0..<6 {
			releasing := true
			if p.voices[i].adsr_5_stage != .Release && p.voices[i].adsr_5_stage != .Idle do releasing = false
			if releasing && p.voices[i].age > oldest_releasing_age {
				oldest_releasing_age = p.voices[i].age
				voice_idx = i
			}
		}
		if voice_idx == -1 {
			oldest_age: f32 = -1.0
			for i in 0..<6 {
				if p.voices[i].age > oldest_age {
					oldest_age = p.voices[i].age
					voice_idx = i
				}
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	adsr_5_prev_level: f32 = 0.0
	if stolen && v.adsr_5_stage != .Idle {
		adsr_5_prev_level = v.adsr_5_release_level
		if v.adsr_5_stage == .Release {
			rel_t_5: f32 = (f32(2.500000000));
			if rel_t_5 > 0.0 {
				rf_5 := 1.0 - (v.age - v.time_released) / math.max(rel_t_5, 0.000001)
				if rf_5 < 0.0 do rf_5 = 0.0
				adsr_5_prev_level *= rf_5
			} else {
				adsr_5_prev_level = 0.0
			}
		}
	}
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.000000000
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	v.adsr_5_stage = .Attack
	v.adsr_5_attack_start = adsr_5_prev_level
	v.adsr_5_release_level = adsr_5_prev_level
	if !stolen {
		v.osc_2_phase = {}
		v.filter_3_low = 0.0
		v.filter_3_band = 0.0
	}
}

Pad_note_off :: proc(p: ^Pad_Processor, note: u8) {
	// Clamped to match _note_on: `note` is the voice key, so both must map it.
	note := note
	if note > 127 do note = 127
	best := -1
	best_age: f32 = -1.0
	for i in 0..<6 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_5_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_5_stage = .Release
	}
}

Pad_trigger :: proc(p: ^Pad_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (f32(1.200000000)) + (f32(0.800000000)) > d do d = (f32(1.200000000)) + (f32(0.800000000))
		if d <= 0.0 do d = 0.001
	}
	Pad_note_on(p, note, velocity, d)
}

Pad_feed_input :: proc(p: ^Pad_Processor, in_left: f32, in_right: f32) {
	p.ext_in_l = in_left
	p.ext_in_r = in_right
}

Pad_start :: proc(p: ^Pad_Processor) {
	p.playing = true
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
}

Pad_stop :: proc(p: ^Pad_Processor) {
	p.playing = false
}

Pad_set_loop :: proc(p: ^Pad_Processor, loop: bool) {
	p.loop = loop
}

Pad_set_volume :: proc(p: ^Pad_Processor, value: f32) {
	p.volume = math.clamp(value, 0.0, 1.0)
}

Pad_is_playing :: proc(p: ^Pad_Processor) -> bool {
	if p.playing do return true
	for i in 0..<6 {
		if p.voices[i].active do return true
	}
	// The effect tail counts as playing: it is still audible after every
	// voice went inactive, and reporting false here is what let a game free
	// the asset mid-echo.
	if p.bus_tail_remaining > 0 do return true
	return false
}

Pad_PARAMS := []Skald_Param_Info{
}

Pad_set_param :: proc(p: ^Pad_Processor, name: string, value: f32) -> bool {
	return false
}

Pad_get_param :: proc(p: ^Pad_Processor, name: string) -> (f32, bool) {
	return 0.0, false
}

Pad_process :: proc(p: ^Pad_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	Pad_process_sequence(p)
	p.total_samples += 1

	node_4_out_vsum: f32 = 0.0
	for v_idx in 0..<6 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_5_stage != .Release && voice.adsr_5_stage != .Idle {
				voice.adsr_5_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_1_out: f32 = 0.0
		node_2_out: f32 = 0.0
		node_3_out: f32 = 0.0
		node_4_out: f32 = 0.0
		node_5_out: f32 = 0.0

		// --- MIDI Input Node 1 ---
		node_1_out_pitch := (f32(voice.note) - 69.0) / 12.0
		node_1_out_gate := f32(1.0)
		if voice.time_released > 0.0 do node_1_out_gate = 0.0
		node_1_out_velocity := voice.velocity

		// --- Oscillator Node 2 (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_2_phase[i] = math.mod(voice.osc_2_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_2_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += (2.0 / f32(math.PI)) * math.asin(math.sin(final_phase));
			}
			node_2_out = (unison_out / f32(unison_count)) * (f32(0.450000000));
		}

		// --- ADSR Node 5 ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_5_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(1.200000000)) > 0 do envelope = voice.adsr_5_attack_start + (1.0 - voice.adsr_5_attack_start) * (voice.age / math.max(f32(f32(1.200000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_5_release_level = envelope;
				if voice.age >= (f32(1.200000000)) {
					voice.adsr_5_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(1.200000000));
				if (f32(0.800000000)) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(f32(0.800000000)), 0.000001)) * (1.0 - (f32(0.850000000))); else do envelope = (f32(0.850000000));
				voice.adsr_5_release_level = envelope;
				if time_in_decay >= (f32(0.800000000)) {
					voice.adsr_5_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.850000000));
				voice.adsr_5_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(2.500000000)) > 0 do envelope = voice.adsr_5_release_level * (1.0 - (time_in_release / math.max(f32(f32(2.500000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_5_stage = .Idle;
				}
			}
			vel_scale_5: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_5_out = (1.0) * envelope * (f32(1.000000000)) * vel_scale_5;
		}

		// --- Filter Node 3 (SVF) ---
		{
			cutoff_c_3: f32 = math.clamp(f32(f32(1200.000000000)), 10.0, sample_rate * 0.16);
			f_3 := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_3 / sample_rate));
			q_3: f32 = math.clamp(1.0 / math.max(f32(f32(1.000000000)), 0.1), 0.05, 1.9 - f_3);
			voice.filter_3_low += f_3 * voice.filter_3_band;
			high_3 := f32(((node_2_out)) - voice.filter_3_low - q_3 * voice.filter_3_band);
			voice.filter_3_band += f_3 * high_3;
			node_3_out = voice.filter_3_low;
		}

		// --- Gain Node 4 ---
		node_4_out = ((node_3_out)) * ((f32(0.000000000)) + (node_5_out));

		node_4_out_vsum += node_4_out
		if voice.adsr_5_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}

	// --- Bus effects (once per sample, post voice sum) ---
	{
		node_4_out := node_4_out_vsum
		node_6_out: f32 = 0.0
		node_7_out: f32 = 0.0
		// --- Delay Node 6 ---
		{
			delay_samples_6 := int(math.clamp((f32(0.375000000)) * sample_rate, 1, 96000-1));
			read_index_6 := (p.delay_6_write_index - delay_samples_6 + len(p.delay_6_buffer)) % len(p.delay_6_buffer);
			delayed_sample_6 := p.delay_6_buffer[read_index_6];
			p.delay_6_buffer[p.delay_6_write_index] = ((node_4_out)) + delayed_sample_6 * math.clamp(f32(f32(0.300000000)), 0.0, 0.95);
			p.delay_6_write_index = (p.delay_6_write_index + 1) % len(p.delay_6_buffer);
			node_6_out = ((node_4_out)) * (1.0 - (f32(0.250000000))) + delayed_sample_6 * (f32(0.250000000));
		}

		// --- Reverb Node 7 (pre-delay + feedback comb) ---
		{
			pre_delay_seconds_7: f32 = math.clamp(f32(f32(0.020000000)), 0.0, 0.25);
			pre_delay_samples_7 := int(math.clamp(pre_delay_seconds_7 * sample_rate, 0.0, f32(48000)));
			pre_write_index_7 := p.delay_7_write_index % len(p.reverb_7_pre_buffer)
			pre_delayed_input_7 := f32((node_6_out))
			if pre_delay_samples_7 > 0 {
				pre_read_index_7 := (pre_write_index_7 - pre_delay_samples_7 + len(p.reverb_7_pre_buffer)) % len(p.reverb_7_pre_buffer)
				pre_delayed_input_7 = p.reverb_7_pre_buffer[pre_read_index_7]
			}
			p.reverb_7_pre_buffer[pre_write_index_7] = f32((node_6_out))
			delay_samples_7 := int(math.clamp((0.075000000) * sample_rate, 0, 96000-1));
			read_index_7 := (p.delay_7_write_index - delay_samples_7 + len(p.delay_7_buffer)) % len(p.delay_7_buffer);
			delayed_sample_7 := p.delay_7_buffer[read_index_7];
			decay_gain_7: f32 = math.clamp(math.pow(f32(0.001), f32(0.075000000) / math.max(f32(f32(5.000000000)), 0.01)), 0.0, 0.95);
			p.delay_7_buffer[p.delay_7_write_index] = pre_delayed_input_7 + delayed_sample_7 * decay_gain_7;
			p.delay_7_write_index = (p.delay_7_write_index + 1) % len(p.delay_7_buffer);
			node_7_out = ((node_6_out)) * (1.0 - (f32(0.500000000))) + delayed_sample_7 * (f32(0.500000000));
		}

		output_left += node_7_out
		output_right += node_7_out
	}

	// B7-2-followup / SKB-016: a baked worst-case constant here held
	// is_playing true for minutes on real content (every exposed tail param
	// contributed its range maximum, so glassy-fm-pluck alone baked 202.5s
	// for a true tail under 2s). Arm on the FALLING EDGE instead, from the
	// live field values — that is one ln/pow per note-off rather than per
	// sample, which is what keeps this proc off the audio path.
	{
		voice_alive := false
		for i in 0..<6 {
			if p.voices[i].active {
				voice_alive = true
				break
			}
		}
		if voice_alive || p.playing {
			p.bus_tail_armed = false
			p.bus_tail_remaining = 0
		} else if !p.bus_tail_armed {
			p.bus_tail_armed = true
			p.bus_tail_remaining = u64(Pad_bus_tail_seconds(p) * sample_rate)
		} else if p.bus_tail_remaining > 0 {
			p.bus_tail_remaining -= 1
		}
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
Pad_process_sequence :: proc(p: ^Pad_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "Pad Root" (64 steps)
		switch p.current_step % 64 {
		case 0:
			Pad_note_on(p, 48, 0.550000012, f32(16.000000000) * (60.0 / p.bpm / 4.0))
		case 16:
			Pad_note_on(p, 44, 0.550000012, f32(16.000000000) * (60.0 / p.bpm / 4.0))
		case 32:
			Pad_note_on(p, 51, 0.550000012, f32(16.000000000) * (60.0 / p.bpm / 4.0))
		case 48:
			Pad_note_on(p, 43, 0.550000012, f32(16.000000000) * (60.0 / p.bpm / 4.0))
		}
		// Track "Pad Third" (64 steps)
		switch p.current_step % 64 {
		case 0:
			Pad_note_on(p, 51, 0.500000000, f32(16.000000000) * (60.0 / p.bpm / 4.0))
		case 16:
			Pad_note_on(p, 48, 0.500000000, f32(16.000000000) * (60.0 / p.bpm / 4.0))
		case 32:
			Pad_note_on(p, 55, 0.500000000, f32(16.000000000) * (60.0 / p.bpm / 4.0))
		case 48:
			Pad_note_on(p, 47, 0.500000000, f32(16.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 64 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	Bass: ^Bass_Processor,
	HiHat: ^HiHat_Processor,
	Kick: ^Kick_Processor,
	Lead: ^Lead_Processor,
	Pad: ^Pad_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.800000012
	p.Bass = new(Bass_Processor)
	Bass_init(p.Bass, sr)
	Bass_start(p.Bass)
	p.HiHat = new(HiHat_Processor)
	HiHat_init(p.HiHat, sr)
	HiHat_start(p.HiHat)
	p.Kick = new(Kick_Processor)
	Kick_init(p.Kick, sr)
	Kick_start(p.Kick)
	p.Lead = new(Lead_Processor)
	Lead_init(p.Lead, sr)
	Lead_start(p.Lead)
	p.Pad = new(Pad_Processor)
	Pad_init(p.Pad, sr)
	Pad_start(p.Pad)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := Bass_process(p.Bass); mixed_left += l; mixed_right += r }
	{ l, r := HiHat_process(p.HiHat); mixed_left += l; mixed_right += r }
	{ l, r := Kick_process(p.Kick); mixed_left += l; mixed_right += r }
	{ l, r := Lead_process(p.Lead); mixed_left += l; mixed_right += r }
	{ l, r := Pad_process(p.Pad); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.Bass)
	free(p.HiHat)
	free(p.Kick)
	free(p.Lead)
	free(p.Pad)
}

