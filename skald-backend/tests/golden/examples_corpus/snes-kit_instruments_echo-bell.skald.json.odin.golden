SNES_Echo_Bell_set_param :: proc(p: ^SNES_Echo_Bell_Processor, name: string, value: f32) -> bool {
	switch name {
	case "cutoff", "bell-tone::cutoff":
		SNES_Echo_Bell_set_cutoff(p, value)
		return true
	case "decay", "bell-amp::decay":
		SNES_Echo_Bell_set_decay(p, value)
		return true
	case "feedback", "bell-echo::feedback":
		SNES_Echo_Bell_set_feedback(p, value)
		return true
	case "frequency", "bell-fm::frequency":
		SNES_Echo_Bell_set_frequency(p, value)
		return true
	case "mix", "bell-echo::mix":
		SNES_Echo_Bell_set_mix(p, value)
		return true
	case "modIndex", "bell-fm::modIndex":
		SNES_Echo_Bell_set_modIndex(p, value)
		return true
	}
	return false
}

SNES_Echo_Bell_get_param :: proc(p: ^SNES_Echo_Bell_Processor, name: string) -> (f32, bool) {
	switch name {
	case "cutoff", "bell-tone::cutoff":
		return p.cutoff, true
	case "decay", "bell-amp::decay":
		return p.decay, true
	case "feedback", "bell-echo::feedback":
		return p.feedback, true
	case "frequency", "bell-fm::frequency":
		return p.frequency, true
	case "mix", "bell-echo::mix":
		return p.mix, true
	case "modIndex", "bell-fm::modIndex":
		return p.modIndex, true
	}
	return 0.0, false
}

SNES_Echo_Bell_process :: proc(p: ^SNES_Echo_Bell_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	SNES_Echo_Bell_process_sequence(p)
	p.total_samples += 1

	node_bell_tone_out_vsum: f32 = 0.0
	for v_idx in 0..<4 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_bell_amp_stage != .Release && voice.adsr_bell_amp_stage != .Idle {
				voice.adsr_bell_amp_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_bell_amp_out: f32 = 0.0
		node_bell_fm_out: f32 = 0.0
		node_bell_tone_out: f32 = 0.0

		// --- FM Operator Node bell_fm (Unison/Detune) ---
		{
			carrier_freq_bell_fm: f32 = voice.current_freq * math.clamp(f32(p.frequency), 0.01, 32.0);
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_carrier_freq_bell_fm: f32 = carrier_freq_bell_fm * math.pow(2.0, detune_amount / 1200.0);
				voice.fm_bell_fm_phase[i] = math.mod(voice.fm_bell_fm_phase[i] + (2 * f32(math.PI) * detuned_carrier_freq_bell_fm / sample_rate), 2 * f32(math.PI));
				unison_out += math.sin(voice.fm_bell_fm_phase[i] + (0.0) * (p.modIndex));
			}
			node_bell_fm_out = unison_out / f32(unison_count);
		}

		// --- ADSR Node bell_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_bell_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.001000000)) > 0 do envelope = voice.adsr_bell_amp_attack_start + (1.0 - voice.adsr_bell_amp_attack_start) * (voice.age / math.max(f32(f32(0.001000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_bell_amp_release_level = envelope;
				if voice.age >= (f32(0.001000000)) {
					voice.adsr_bell_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.001000000));
				if (p.decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.decay), 0.000001)) * (1.0 - (f32(0.000000000))); else do envelope = (f32(0.000000000));
				voice.adsr_bell_amp_release_level = envelope;
				if time_in_decay >= (p.decay) {
					voice.adsr_bell_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.000000000));
				voice.adsr_bell_amp_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.500000000)) > 0 do envelope = voice.adsr_bell_amp_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.500000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_bell_amp_stage = .Idle;
				}
			}
			vel_scale_bell_amp: f32 = (1.0 - (f32(0.600000000))) + (f32(0.600000000)) * voice.velocity;
			node_bell_amp_out = ((node_bell_fm_out)) * envelope * (f32(1.000000000)) * vel_scale_bell_amp;
		}

		// --- Filter Node bell_tone (SVF) ---
		{
			cutoff_c_bell_tone: f32 = math.clamp(f32(p.cutoff), 10.0, sample_rate * 0.16);
			f_bell_tone := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_bell_tone / sample_rate));
			q_bell_tone: f32 = math.clamp(1.0 / math.max(f32(f32(0.500000000)), 0.1), 0.05, 1.9 - f_bell_tone);
			voice.filter_bell_tone_low += f_bell_tone * voice.filter_bell_tone_band;
			high_bell_tone := f32(((node_bell_amp_out)) - voice.filter_bell_tone_low - q_bell_tone * voice.filter_bell_tone_band);
			voice.filter_bell_tone_band += f_bell_tone * high_bell_tone;
			node_bell_tone_out = voice.filter_bell_tone_low;
		}

		node_bell_tone_out_vsum += node_bell_tone_out
		if voice.adsr_bell_amp_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}

	// --- Bus effects (once per sample, post voice sum) ---
	{
		node_bell_tone_out := node_bell_tone_out_vsum
		node_bell_echo_out: f32 = 0.0
		// --- Delay Node bell_echo ---
		{
			delay_samples_bell_echo := int(math.clamp((((60.0 / p.bpm) * 0.500000000)) * sample_rate, 1, 96000-1));
			read_index_bell_echo := (p.delay_bell_echo_write_index - delay_samples_bell_echo + len(p.delay_bell_echo_buffer)) % len(p.delay_bell_echo_buffer);
			delayed_sample_bell_echo := p.delay_bell_echo_buffer[read_index_bell_echo];
			p.delay_bell_echo_buffer[p.delay_bell_echo_write_index] = ((node_bell_tone_out)) + delayed_sample_bell_echo * math.clamp(f32(p.feedback), 0.0, 0.95);
			p.delay_bell_echo_write_index = (p.delay_bell_echo_write_index + 1) % len(p.delay_bell_echo_buffer);
			node_bell_echo_out = ((node_bell_tone_out)) * (1.0 - (p.mix)) + delayed_sample_bell_echo * (p.mix);
		}

		output_left += node_bell_echo_out
		output_right += node_bell_echo_out
	}

	// B7-2-followup / SKB-016: a baked worst-case constant here held
	// is_playing true for minutes on real content (every exposed tail param
	// contributed its range maximum, so glassy-fm-pluck alone baked 202.5s
	// for a true tail under 2s). Arm on the FALLING EDGE instead, from the
	// live field values — that is one ln/pow per note-off rather than per
	// sample, which is what keeps this proc off the audio path.
	{
		voice_alive := false
		for i in 0..<4 {
			if p.voices[i].active {
				voice_alive = true
				break
			}
		}
		if voice_alive || p.playing {
			p.bus_tail_armed = false
			p.bus_tail_remaining = 0
		} else if !p.bus_tail_armed {
			p.bus_tail_armed = true
			p.bus_tail_remaining = u64(SNES_Echo_Bell_bus_tail_seconds(p) * sample_rate)
		} else if p.bus_tail_remaining > 0 {
			p.bus_tail_remaining -= 1
		}
	}
	if math.is_nan(output_left) || math.is_inf(output_left) || math.is_nan(output_right) || math.is_inf(output_right) {
		p.nonfinite_count += 1
		output_left, output_right = 0.0, 0.0
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
SNES_Echo_Bell_process_sequence :: proc(p: ^SNES_Echo_Bell_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "SNES Echo Bell" (16 steps)
		switch p.current_step % 16 {
		case 0:
			SNES_Echo_Bell_note_on(p, 81, 0.800000012, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 4:
			SNES_Echo_Bell_note_on(p, 76, 0.699999988, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			SNES_Echo_Bell_note_on(p, 84, 0.850000024, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			SNES_Echo_Bell_note_on(p, 79, 0.750000000, f32(4.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	SNES_Echo_Bell: ^SNES_Echo_Bell_Processor,
	master_volume: f32,
	dc: Skald_Dc_Block_State,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.750000000
	p.dc = {}
	p.SNES_Echo_Bell = new(SNES_Echo_Bell_Processor)
	SNES_Echo_Bell_init(p.SNES_Echo_Bell, sr)
	SNES_Echo_Bell_start(p.SNES_Echo_Bell)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := SNES_Echo_Bell_process(p.SNES_Echo_Bell); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	mixed_left, mixed_right = skald_dc_block(&p.dc, mixed_left, mixed_right)
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.SNES_Echo_Bell)
}

