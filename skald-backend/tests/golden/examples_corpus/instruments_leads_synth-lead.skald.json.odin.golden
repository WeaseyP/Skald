Synth_Lead_set_param :: proc(p: ^Synth_Lead_Processor, name: string, value: f32) -> bool {
	switch name {
	case "amplitude", "lead-osc::amplitude":
		Synth_Lead_set_amplitude(p, value)
		return true
	case "attack", "lead-amp::attack":
		Synth_Lead_set_attack(p, value)
		return true
	case "cutoff", "lead-filter::cutoff":
		Synth_Lead_set_cutoff(p, value)
		return true
	case "decay", "lead-amp::decay":
		Synth_Lead_set_decay(p, value)
		return true
	case "depth", "lead-amp::depth":
		Synth_Lead_set_depth(p, value)
		return true
	case "feedback", "lead-delay::feedback":
		Synth_Lead_set_feedback(p, value)
		return true
	case "mix", "lead-delay::mix":
		Synth_Lead_set_mix(p, value)
		return true
	case "release", "lead-amp::release":
		Synth_Lead_set_release(p, value)
		return true
	case "resonance", "lead-filter::resonance":
		Synth_Lead_set_resonance(p, value)
		return true
	case "sustain", "lead-amp::sustain":
		Synth_Lead_set_sustain(p, value)
		return true
	case "velocitySensitivity", "lead-amp::velocitySensitivity":
		Synth_Lead_set_velocitySensitivity(p, value)
		return true
	}
	return false
}

