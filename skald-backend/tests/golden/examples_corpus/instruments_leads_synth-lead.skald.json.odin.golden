	case "velocitySensitivity", "lead-amp::velocitySensitivity":
		return p.velocitySensitivity, true
	}
	return 0.0, false
}

Synth_Lead_process :: proc(p: ^Synth_Lead_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	Synth_Lead_process_sequence(p)
	p.total_samples += 1

	node_lead_amp_out_vsum: f32 = 0.0
	for v_idx in 0..<8 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.current_freq != voice.target_freq {
			glide_k := 1.0 / math.max(voice.glide_time * sample_rate, 1.0)
			if glide_k > 1.0 do glide_k = 1.0
			voice.current_freq += (voice.target_freq - voice.current_freq) * glide_k
			if abs(voice.target_freq - voice.current_freq) < 0.1 do voice.current_freq = voice.target_freq
		}
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_lead_amp_stage != .Release && voice.adsr_lead_amp_stage != .Idle {
				voice.adsr_lead_amp_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_lead_amp_out: f32 = 0.0
		node_lead_filter_out: f32 = 0.0
		node_lead_osc_out: f32 = 0.0

		// --- Oscillator Node lead_osc (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 3;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (10.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_lead_osc_phase[i] = math.mod(voice.osc_lead_osc_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_lead_osc_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += ((final_phase / f32(math.PI)) - 1.0);
			}
			node_lead_osc_out = (unison_out / f32(unison_count)) * (p.amplitude);
		}

		// --- Filter Node lead_filter (SVF) ---
		{
			cutoff_c_lead_filter: f32 = math.clamp(f32(p.cutoff), 10.0, sample_rate * 0.16);
			f_lead_filter := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_lead_filter / sample_rate));
			q_lead_filter: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_lead_filter);
			voice.filter_lead_filter_low += f_lead_filter * voice.filter_lead_filter_band;
			high_lead_filter := f32(((node_lead_osc_out)) - voice.filter_lead_filter_low - q_lead_filter * voice.filter_lead_filter_band);
			voice.filter_lead_filter_band += f_lead_filter * high_lead_filter;
			node_lead_filter_out = voice.filter_lead_filter_low;
		}

		// --- ADSR Node lead_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_lead_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.attack) > 0 do envelope = voice.adsr_lead_amp_attack_start + (1.0 - voice.adsr_lead_amp_attack_start) * (voice.age / math.max(f32(p.attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_lead_amp_release_level = envelope;
				if voice.age >= (p.attack) {
					voice.adsr_lead_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.attack);
				if (p.decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.decay), 0.000001)) * (1.0 - (p.sustain)); else do envelope = (p.sustain);
				voice.adsr_lead_amp_release_level = envelope;
				if time_in_decay >= (p.decay) {
					voice.adsr_lead_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.sustain);
				voice.adsr_lead_amp_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.release) > 0 do envelope = voice.adsr_lead_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_lead_amp_stage = .Idle;
				}
			}
			vel_scale_lead_amp: f32 = (1.0 - (p.velocitySensitivity)) + (p.velocitySensitivity) * voice.velocity;
			node_lead_amp_out = ((node_lead_filter_out)) * envelope * (p.depth) * vel_scale_lead_amp;
		}

		node_lead_amp_out_vsum += node_lead_amp_out
		if voice.adsr_lead_amp_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}

	// --- Bus effects (once per sample, post voice sum) ---
	{
		node_lead_amp_out := node_lead_amp_out_vsum
		node_lead_delay_out: f32 = 0.0
		// --- Delay Node lead_delay ---
		{
			delay_samples_lead_delay := int(math.clamp((((60.0 / p.bpm) * 0.500000000)) * sample_rate, 1, 96000-1));
			read_index_lead_delay := (p.delay_lead_delay_write_index - delay_samples_lead_delay + len(p.delay_lead_delay_buffer)) % len(p.delay_lead_delay_buffer);
			delayed_sample_lead_delay := p.delay_lead_delay_buffer[read_index_lead_delay];
			p.delay_lead_delay_buffer[p.delay_lead_delay_write_index] = ((node_lead_amp_out)) + delayed_sample_lead_delay * math.clamp(f32(p.feedback), 0.0, 0.95);
			p.delay_lead_delay_write_index = (p.delay_lead_delay_write_index + 1) % len(p.delay_lead_delay_buffer);
			node_lead_delay_out = ((node_lead_amp_out)) * (1.0 - (p.mix)) + delayed_sample_lead_delay * (p.mix);
		}

		output_left += node_lead_delay_out
		output_right += node_lead_delay_out
	}

	// B7-2-followup / SKB-016: a baked worst-case constant here held
	// is_playing true for minutes on real content (every exposed tail param
	// contributed its range maximum, so glassy-fm-pluck alone baked 202.5s
	// for a true tail under 2s). Arm on the FALLING EDGE instead, from the
	// live field values — that is one ln/pow per note-off rather than per
	// sample, which is what keeps this proc off the audio path.
	{
		voice_alive := false
		for i in 0..<8 {
			if p.voices[i].active {
				voice_alive = true
				break
			}
		}
		if voice_alive || p.playing {
			p.bus_tail_armed = false
			p.bus_tail_remaining = 0
		} else if !p.bus_tail_armed {
			p.bus_tail_armed = true
			p.bus_tail_remaining = u64(Synth_Lead_bus_tail_seconds(p) * sample_rate)
		} else if p.bus_tail_remaining > 0 {
			p.bus_tail_remaining -= 1
		}
	}
	if math.is_nan(output_left) || math.is_inf(output_left) || math.is_nan(output_right) || math.is_inf(output_right) {
		p.nonfinite_count += 1
		output_left, output_right = 0.0, 0.0
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
Synth_Lead_process_sequence :: proc(p: ^Synth_Lead_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "Synth Lead" (16 steps)
		switch p.current_step % 16 {
		case 0:
			Synth_Lead_note_on(p, 60, 0.899999976, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 3:
			Synth_Lead_note_on(p, 63, 0.779999971, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 5:
			Synth_Lead_note_on(p, 67, 0.879999995, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			Synth_Lead_note_on(p, 70, 0.949999988, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 11:
			Synth_Lead_note_on(p, 67, 0.819999993, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 13:
			Synth_Lead_note_on(p, 63, 0.759999990, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	Synth_Lead: ^Synth_Lead_Processor,
	master_volume: f32,
	dc: Skald_Dc_Block_State,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.800000012
	p.dc = {}
	p.Synth_Lead = new(Synth_Lead_Processor)
	Synth_Lead_init(p.Synth_Lead, sr)
	Synth_Lead_start(p.Synth_Lead)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := Synth_Lead_process(p.Synth_Lead); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	mixed_left, mixed_right = skald_dc_block(&p.dc, mixed_left, mixed_right)
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.Synth_Lead)
}

