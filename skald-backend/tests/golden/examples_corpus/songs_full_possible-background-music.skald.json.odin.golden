	{"ADSR_release_2", 0.000000000, 10.000000000, 0.150000006, "s"},
	{"ADSR_sustain", 0.000000000, 1.000000000, 0.850000024, ""},
	{"ADSR_sustain_2", 0.000000000, 1.000000000, 0.349999994, ""},
	{"LFO_amplitude", 0.000000000, 20000.000000000, 1.000000000, ""},
	{"Oscillator_amplitude", 0.000000000, 1.000000000, 1.000000000, ""},
	{"cutoff", 20.000000000, 20000.000000000, 220.000000000, "Hz"},
	{"frequency", 0.010000000, 100.000000000, 0.100000001, "Hz"},
	{"phase", 0.000000000, 360.000000000, 0.000000000, "deg"},
