	{"ADSR_attack", 0.000000000, 10.000000000, 0.079999998, "s"},
	{"ADSR_attack_2", 0.000000000, 10.000000000, 0.090000004, "s"},
	{"ADSR_decay", 0.000000000, 10.000000000, 0.100000001, "s"},
	{"ADSR_decay_2", 0.000000000, 10.000000000, 0.250000000, "s"},
