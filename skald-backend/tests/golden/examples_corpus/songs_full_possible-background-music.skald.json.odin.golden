Blaster_set_cutoff :: proc(p: ^Blaster_Processor, value: f32) {
	v := value
	if v < 20.000000000 do v = 20.000000000
	if v > 20000.000000000 do v = 20000.000000000
	p.cutoff = v
}

Blaster_set_frequency :: proc(p: ^Blaster_Processor, value: f32) {
	v := value
	if v < 0.010000000 do v = 0.010000000
	if v > 100.000000000 do v = 100.000000000
	p.frequency = v
}

Blaster_set_phase :: proc(p: ^Blaster_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 360.000000000 do v = 360.000000000
	p.phase = v
}

Blaster_set_pulseWidth :: proc(p: ^Blaster_Processor, value: f32) {
	v := value
	if v < 0.010000000 do v = 0.010000000
	if v > 0.990000010 do v = 0.990000010
	p.pulseWidth = v
}

Blaster_set_resonance :: proc(p: ^Blaster_Processor, value: f32) {
	v := value
	if v < 0.100000001 do v = 0.100000001
	if v > 20.000000000 do v = 20.000000000
	p.resonance = v
}

Blaster_PARAMS := []Skald_Param_Info{
	{"ADSR_attack", 0.000000000, 10.000000000, 0.079999998, "s"},
	{"ADSR_attack_2", 0.000000000, 10.000000000, 0.090000004, "s"},
	{"ADSR_decay", 0.000000000, 10.000000000, 0.100000001, "s"},
	{"ADSR_decay_2", 0.000000000, 10.000000000, 0.250000000, "s"},
	{"ADSR_depth", 0.000000000, 1.000000000, 1.000000000, ""},
	{"ADSR_depth_2", 0.000000000, 1.000000000, 1.000000000, ""},
	{"ADSR_release", 0.000000000, 10.000000000, 0.180000007, "s"},
	{"ADSR_release_2", 0.000000000, 10.000000000, 0.150000006, "s"},
	{"ADSR_sustain", 0.000000000, 1.000000000, 0.850000024, ""},
	{"ADSR_sustain_2", 0.000000000, 1.000000000, 0.349999994, ""},
	{"LFO_amplitude", 0.000000000, 20000.000000000, 1.000000000, ""},
	{"Oscillator_amplitude", 0.000000000, 1.000000000, 0.000000000, ""},
	{"cutoff", 20.000000000, 20000.000000000, 220.000000000, "Hz"},
	{"frequency", 0.010000000, 100.000000000, 50.000000000, "Hz"},
	{"phase", 0.000000000, 360.000000000, 0.000000000, "deg"},
	{"pulseWidth", 0.010000000, 0.990000010, 0.500000000, ""},
	{"resonance", 0.100000001, 20.000000000, 0.800000012, "Q"},
}

Blaster_set_param :: proc(p: ^Blaster_Processor, name: string, value: f32) -> bool {
	switch name {
	case "ADSR_attack", "3::attack":
		Blaster_set_ADSR_attack(p, value)
		return true
	case "ADSR_attack_2", "4::attack":
		Blaster_set_ADSR_attack_2(p, value)
		return true
	case "ADSR_decay", "3::decay":
		Blaster_set_ADSR_decay(p, value)
		return true
	case "ADSR_decay_2", "4::decay":
		Blaster_set_ADSR_decay_2(p, value)
		return true
	case "ADSR_depth", "3::depth":
		Blaster_set_ADSR_depth(p, value)
		return true
	case "ADSR_depth_2", "4::depth":
		Blaster_set_ADSR_depth_2(p, value)
		return true
	case "ADSR_release", "3::release":
		Blaster_set_ADSR_release(p, value)
		return true
	case "ADSR_release_2", "4::release":
		Blaster_set_ADSR_release_2(p, value)
		return true
	case "ADSR_sustain", "3::sustain":
		Blaster_set_ADSR_sustain(p, value)
		return true
	case "ADSR_sustain_2", "4::sustain":
		Blaster_set_ADSR_sustain_2(p, value)
		return true
	case "LFO_amplitude", "6::amplitude":
		Blaster_set_LFO_amplitude(p, value)
		return true
	case "Oscillator_amplitude", "1::amplitude":
		Blaster_set_Oscillator_amplitude(p, value)
		return true
	case "cutoff", "2::cutoff":
		Blaster_set_cutoff(p, value)
		return true
	case "frequency", "6::frequency":
		Blaster_set_frequency(p, value)
		return true
	case "phase", "1::phase":
		Blaster_set_phase(p, value)
		return true
	case "pulseWidth", "1::pulseWidth":
		Blaster_set_pulseWidth(p, value)
		return true
	case "resonance", "2::resonance":
		Blaster_set_resonance(p, value)
		return true
	}
	return false
}

Blaster_get_param :: proc(p: ^Blaster_Processor, name: string) -> (f32, bool) {
	switch name {
	case "ADSR_attack", "3::attack":
		return p.ADSR_attack, true
	case "ADSR_attack_2", "4::attack":
		return p.ADSR_attack_2, true
	case "ADSR_decay", "3::decay":
		return p.ADSR_decay, true
	case "ADSR_decay_2", "4::decay":
		return p.ADSR_decay_2, true
	case "ADSR_depth", "3::depth":
		return p.ADSR_depth, true
	case "ADSR_depth_2", "4::depth":
		return p.ADSR_depth_2, true
	case "ADSR_release", "3::release":
		return p.ADSR_release, true
	case "ADSR_release_2", "4::release":
		return p.ADSR_release_2, true
	case "ADSR_sustain", "3::sustain":
		return p.ADSR_sustain, true
	case "ADSR_sustain_2", "4::sustain":
		return p.ADSR_sustain_2, true
	case "LFO_amplitude", "6::amplitude":
		return p.LFO_amplitude, true
	case "Oscillator_amplitude", "1::amplitude":
		return p.Oscillator_amplitude, true
	case "cutoff", "2::cutoff":
		return p.cutoff, true
	case "frequency", "6::frequency":
		return p.frequency, true
	case "phase", "1::phase":
		return p.phase, true
	case "pulseWidth", "1::pulseWidth":
		return p.pulseWidth, true
	case "resonance", "2::resonance":
		return p.resonance, true
	}
	return 0.0, false
}

Blaster_process :: proc(p: ^Blaster_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	Blaster_process_sequence(p)
	p.total_samples += 1

	for v_idx in 0..<8 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.current_freq != voice.target_freq {
			glide_k := 1.0 / math.max(voice.glide_time * sample_rate, 1.0)
			if glide_k > 1.0 do glide_k = 1.0
			voice.current_freq += (voice.target_freq - voice.current_freq) * glide_k
			if abs(voice.target_freq - voice.current_freq) < 0.1 do voice.current_freq = voice.target_freq
		}
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_3_stage != .Release && voice.adsr_3_stage != .Idle {
				voice.adsr_3_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_4_stage != .Release && voice.adsr_4_stage != .Idle {
				voice.adsr_4_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_1_out: f32 = 0.0
		node_2_out: f32 = 0.0
		node_3_out: f32 = 0.0
		node_4_out: f32 = 0.0
		node_5_out: f32 = 0.0
		node_6_out: f32 = 0.0
		node_7_out: f32 = 0.0

		// --- ADSR Node 4 ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_4_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.ADSR_attack_2) > 0 do envelope = voice.adsr_4_attack_start + (1.0 - voice.adsr_4_attack_start) * (voice.age / math.max(f32(p.ADSR_attack_2), 0.000001)); else do envelope = 1.0;
				voice.adsr_4_release_level = envelope;
				if voice.age >= (p.ADSR_attack_2) {
					voice.adsr_4_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.ADSR_attack_2);
				if (p.ADSR_decay_2) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.ADSR_decay_2), 0.000001)) * (1.0 - (p.ADSR_sustain_2)); else do envelope = (p.ADSR_sustain_2);
				voice.adsr_4_release_level = envelope;
				if time_in_decay >= (p.ADSR_decay_2) {
					voice.adsr_4_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.ADSR_sustain_2);
				voice.adsr_4_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.ADSR_release_2) > 0 do envelope = voice.adsr_4_release_level * (1.0 - (time_in_release / math.max(f32(p.ADSR_release_2), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_4_stage = .Idle;
				}
			}
			vel_scale_4: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_4_out = (1.0) * envelope * (p.ADSR_depth_2) * vel_scale_4;
		}

		// --- LFO Node 6 ---
		voice.lfo_6_phase = math.mod(voice.lfo_6_phase + (2 * f32(math.PI) * (p.frequency) / sample_rate), 2 * f32(math.PI));
		if voice.lfo_6_phase < 0.0 do voice.lfo_6_phase += 2 * f32(math.PI);
		node_6_out = math.sin(voice.lfo_6_phase) * (p.LFO_amplitude);

		// --- Mapper Node 5 ---
		{
			in_range_5: f32 = f32(f32(1.000000000)) - f32(f32(0.000000000));
			if in_range_5 == 0.0 do in_range_5 = 1.0;
			node_5_out = math.lerp(f32(f32(0.000000000)), f32(f32(700.000000000)), math.clamp((f32((node_4_out)) - f32(f32(0.000000000))) / in_range_5, 0.0, 1.0));
		}

		// --- Oscillator Node 1 (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (5.000000000);
				detuned_freq: f32 = ((voice.current_freq) * math.pow(2.0, math.clamp(f32(node_6_out), -10.0, 10.0))) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(p.phase) * (f32(math.PI) / 180.0);
				voice.osc_1_phase[i] = math.mod(voice.osc_1_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_1_phase[i] + phase_rads, 2 * f32(math.PI));
				if final_phase < 2 * f32(math.PI) * math.clamp(f32(p.pulseWidth), 0.01, 0.99) do unison_out += 1.0; else do unison_out -= 1.0;
			}
			node_1_out = (unison_out / f32(unison_count)) * (p.Oscillator_amplitude);
		}

		// --- Filter Node 2 (SVF) ---
		{
			cutoff_c_2: f32 = math.clamp(f32((p.cutoff) + (node_5_out)), 10.0, sample_rate * 0.16);
			f_2 := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_2 / sample_rate));
			q_2: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_2);
			voice.filter_2_low += f_2 * voice.filter_2_band;
			high_2 := f32(((node_1_out)) - voice.filter_2_low - q_2 * voice.filter_2_band);
			voice.filter_2_band += f_2 * high_2;
			node_2_out = voice.filter_2_low;
		}

		// --- ADSR Node 3 ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_3_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.ADSR_attack) > 0 do envelope = voice.adsr_3_attack_start + (1.0 - voice.adsr_3_attack_start) * (voice.age / math.max(f32(p.ADSR_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_3_release_level = envelope;
				if voice.age >= (p.ADSR_attack) {
					voice.adsr_3_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.ADSR_attack);
				if (p.ADSR_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.ADSR_decay), 0.000001)) * (1.0 - (p.ADSR_sustain)); else do envelope = (p.ADSR_sustain);
				voice.adsr_3_release_level = envelope;
				if time_in_decay >= (p.ADSR_decay) {
					voice.adsr_3_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.ADSR_sustain);
				voice.adsr_3_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.ADSR_release) > 0 do envelope = voice.adsr_3_release_level * (1.0 - (time_in_release / math.max(f32(p.ADSR_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_3_stage = .Idle;
				}
			}
			vel_scale_3: f32 = (1.0 - (f32(0.700000000))) + (f32(0.700000000)) * voice.velocity;
			node_3_out = ((node_2_out)) * envelope * (p.ADSR_depth) * vel_scale_3;
		}

		output_left += node_3_out
		output_right += node_3_out
		if voice.adsr_3_stage != .Idle do voice_busy = true
		if voice.adsr_4_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	if math.is_nan(output_left) || math.is_inf(output_left) || math.is_nan(output_right) || math.is_inf(output_right) {
		p.nonfinite_count += 1
		output_left, output_right = 0.0, 0.0
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
Blaster_process_sequence :: proc(p: ^Blaster_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "Blaster" (16 steps)
		switch p.current_step % 16 {
		case 0:
			Blaster_note_on(p, 60, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 1:
			Blaster_note_on(p, 60, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 2:
			Blaster_note_on(p, 60, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 3:
			Blaster_note_on(p, 60, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 4:
			Blaster_note_on(p, 60, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 5:
			Blaster_note_on(p, 60, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 6:
			Blaster_note_on(p, 60, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 7:
			Blaster_note_on(p, 60, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 8 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

Blaster_2_Voice_State :: struct {
	active: bool,
	note: u8,
	velocity: f32,
	age: f32,
	time_released: f32,
	current_freq: f32,
	target_freq: f32,
	glide_time: f32,
	duration: f32,
	osc_1_phase: [1]f32,
	filter_2_low: f32,
	filter_2_band: f32,
	adsr_3_stage: ADSR_Stage,
	adsr_3_release_level: f32,
	adsr_3_attack_start: f32,
	adsr_4_stage: ADSR_Stage,
	adsr_4_release_level: f32,
	adsr_4_attack_start: f32,
	lfo_6_phase: f32,
}

Blaster_2_Processor :: struct {
	sample_rate: f32,
	bpm: f32,
	voices: [8]Blaster_2_Voice_State,
	prng: PRNG_State,
	total_samples: u64,
	playing: bool,
	loop: bool,
	current_step: u64,
	samples_until_next_step: u64,
	step_frac_acc: f32,
	ext_in_l: f32,
	ext_in_r: f32,
	volume: f32,
	nonfinite_count: i32,
	ADSR_attack: f32,
	ADSR_attack_2: f32,
	ADSR_decay: f32,
	ADSR_decay_2: f32,
	ADSR_depth: f32,
	ADSR_depth_2: f32,
	ADSR_release: f32,
	ADSR_release_2: f32,
	ADSR_sustain: f32,
	ADSR_sustain_2: f32,
	LFO_amplitude: f32,
	Oscillator_amplitude: f32,
	cutoff: f32,
	frequency: f32,
	phase: f32,
	pulseWidth: f32,
	resonance: f32,
}

Blaster_2_init :: proc(p: ^Blaster_2_Processor, sr: f32) {
	p.sample_rate = sr
	p.bpm = 120.000000000
	p.volume = 1.000000000
	p.prng.state = 12345
	p.loop = true
	p.voices = {}
	p.total_samples = 0
	p.playing = false
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
	p.ext_in_l = 0.0
	p.ext_in_r = 0.0
	p.nonfinite_count = 0
	p.ADSR_attack = 0.079999998
	p.ADSR_attack_2 = 0.090000004
	p.ADSR_decay = 0.100000001
	p.ADSR_decay_2 = 0.250000000
	p.ADSR_depth = 1.000000000
	p.ADSR_depth_2 = 1.000000000
	p.ADSR_release = 0.180000007
	p.ADSR_release_2 = 0.150000006
	p.ADSR_sustain = 0.850000024
	p.ADSR_sustain_2 = 0.349999994
	p.LFO_amplitude = 1.000000000
	p.Oscillator_amplitude = 1.000000000
	p.cutoff = 220.000000000
	p.frequency = 0.100000001
	p.phase = 0.000000000
	p.pulseWidth = 0.010000000
	p.resonance = 0.800000012
}

Blaster_2_note_on :: proc(p: ^Blaster_2_Processor, note: u8, velocity: f32, duration: f32) {
	// note and velocity are clamped silently to their MIDI/normalized domains.
	note := note
	if note > 127 do note = 127
	velocity := math.clamp(velocity, 0.0, 1.0)
	voice_idx := -1
	for i in 0..<8 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_releasing_age: f32 = -1.0
		for i in 0..<8 {
			releasing := true
			if p.voices[i].adsr_3_stage != .Release && p.voices[i].adsr_3_stage != .Idle do releasing = false
			if p.voices[i].adsr_4_stage != .Release && p.voices[i].adsr_4_stage != .Idle do releasing = false
			if releasing && p.voices[i].age > oldest_releasing_age {
				oldest_releasing_age = p.voices[i].age
				voice_idx = i
			}
		}
		if voice_idx == -1 {
			oldest_age: f32 = -1.0
			for i in 0..<8 {
				if p.voices[i].age > oldest_age {
					oldest_age = p.voices[i].age
					voice_idx = i
				}
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	adsr_3_prev_level: f32 = 0.0
	if stolen && v.adsr_3_stage != .Idle {
		adsr_3_prev_level = v.adsr_3_release_level
		if v.adsr_3_stage == .Release {
			rel_t_3: f32 = (p.ADSR_release);
			if rel_t_3 > 0.0 {
				rf_3 := 1.0 - (v.age - v.time_released) / math.max(rel_t_3, 0.000001)
				if rf_3 < 0.0 do rf_3 = 0.0
				adsr_3_prev_level *= rf_3
			} else {
				adsr_3_prev_level = 0.0
			}
		}
	}
	adsr_4_prev_level: f32 = 0.0
	if stolen && v.adsr_4_stage != .Idle {
		adsr_4_prev_level = v.adsr_4_release_level
		if v.adsr_4_stage == .Release {
			rel_t_4: f32 = (p.ADSR_release_2);
			if rel_t_4 > 0.0 {
				rf_4 := 1.0 - (v.age - v.time_released) / math.max(rel_t_4, 0.000001)
				if rf_4 < 0.0 do rf_4 = 0.0
				adsr_4_prev_level *= rf_4
			} else {
				adsr_4_prev_level = 0.0
			}
		}
	}
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.050000001
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	v.adsr_3_stage = .Attack
	v.adsr_3_attack_start = adsr_3_prev_level
	v.adsr_3_release_level = adsr_3_prev_level
	v.adsr_4_stage = .Attack
	v.adsr_4_attack_start = adsr_4_prev_level
	v.adsr_4_release_level = adsr_4_prev_level
	if !stolen {
		v.osc_1_phase = {}
		v.filter_2_low = 0.0
		v.filter_2_band = 0.0
		v.lfo_6_phase = 0.0
	}
}

Blaster_2_note_off :: proc(p: ^Blaster_2_Processor, note: u8) {
	// Clamped to match _note_on: `note` is the voice key, so both must map it.
	note := note
	if note > 127 do note = 127
	best := -1
	best_age: f32 = -1.0
	for i in 0..<8 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_3_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_3_stage = .Release
		p.voices[best].adsr_4_stage = .Release
	}
}

Blaster_2_trigger :: proc(p: ^Blaster_2_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (p.ADSR_attack) + (p.ADSR_decay) > d do d = (p.ADSR_attack) + (p.ADSR_decay)
		if (p.ADSR_attack_2) + (p.ADSR_decay_2) > d do d = (p.ADSR_attack_2) + (p.ADSR_decay_2)
		if d <= 0.0 do d = 0.001
	}
	Blaster_2_note_on(p, note, velocity, d)
}

Blaster_2_feed_input :: proc(p: ^Blaster_2_Processor, in_left: f32, in_right: f32) {
	p.ext_in_l = in_left
	p.ext_in_r = in_right
}

Blaster_2_start :: proc(p: ^Blaster_2_Processor) {
	p.playing = true
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
}

Blaster_2_stop :: proc(p: ^Blaster_2_Processor) {
	p.playing = false
}

Blaster_2_set_loop :: proc(p: ^Blaster_2_Processor, loop: bool) {
	p.loop = loop
}

Blaster_2_set_volume :: proc(p: ^Blaster_2_Processor, value: f32) {
	p.volume = math.clamp(value, 0.0, 1.0)
}

Blaster_2_is_playing :: proc(p: ^Blaster_2_Processor) -> bool {
	if p.playing do return true
	for i in 0..<8 {
		if p.voices[i].active do return true
	}
	return false
}

Blaster_2_set_ADSR_attack :: proc(p: ^Blaster_2_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 10.000000000 do v = 10.000000000
	p.ADSR_attack = v
}

