	if stolen && v.adsr_sync_filter_env_stage != .Idle {
		adsr_sync_filter_env_prev_level = v.adsr_sync_filter_env_release_level
		if v.adsr_sync_filter_env_stage == .Release {
			rel_t_sync_filter_env: f32 = (p.Sync_Env_release);
			if rel_t_sync_filter_env > 0.0 {
