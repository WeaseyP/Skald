			if p.voices[i].adsr_sync_filter_env_stage != .Release && p.voices[i].adsr_sync_filter_env_stage != .Idle do releasing = false
			if releasing && p.voices[i].age > oldest_releasing_age {
				oldest_releasing_age = p.voices[i].age
				voice_idx = i
			}
		}
		if voice_idx == -1 {
			oldest_age: f32 = -1.0
			for i in 0..<6 {
				if p.voices[i].age > oldest_age {
