	{"Sync_Env_depth", 0.000000000, 1.000000000, 1.000000000, ""},
	{"Sync_Env_release", 0.000000000, 10.000000000, 0.200000003, "s"},
	{"Sync_Env_sustain", 0.000000000, 1.000000000, 0.250000000, ""},
	{"Sync_Saw_amplitude", 0.000000000, 1.000000000, 0.280000001, ""},
	{"Sync_Square_amplitude", 0.000000000, 1.000000000, 0.300000012, ""},
	{"cutoff", 20.000000000, 20000.000000000, 400.000000000, "Hz"},
	{"drive", 1.000000000, 100.000000000, 16.000000000, "x"},
	{"frequency", 0.010000000, 100.000000000, 0.899999976, "Hz"},
	{"mix", 0.000000000, 1.000000000, 0.400000006, ""},
	{"outMax", -1000000.000000000, 1000000.000000000, 4200.000000000, ""},
	{"pulseWidth", 0.010000000, 0.990000010, 0.349999994, ""},
	{"resonance", 0.100000001, 20.000000000, 1.899999976, "Q"},
	{"tone", 100.000000000, 20000.000000000, 4200.000000000, "Hz"},
}

Sync_Aggro_Lead_set_param :: proc(p: ^Sync_Aggro_Lead_Processor, name: string, value: f32) -> bool {
	switch name {
	case "Amp_attack", "sync-amp::attack":
		Sync_Aggro_Lead_set_Amp_attack(p, value)
		return true
	case "Amp_decay", "sync-amp::decay":
		Sync_Aggro_Lead_set_Amp_decay(p, value)
		return true
	case "Amp_depth", "sync-amp::depth":
		Sync_Aggro_Lead_set_Amp_depth(p, value)
		return true
	case "Amp_release", "sync-amp::release":
		Sync_Aggro_Lead_set_Amp_release(p, value)
		return true
	case "Amp_sustain", "sync-amp::sustain":
		Sync_Aggro_Lead_set_Amp_sustain(p, value)
		return true
	case "Sweep_Motion_amplitude", "sync-sweep-lfo::amplitude":
		Sync_Aggro_Lead_set_Sweep_Motion_amplitude(p, value)
		return true
	case "Sync_Env_attack", "sync-filter-env::attack":
		Sync_Aggro_Lead_set_Sync_Env_attack(p, value)
		return true
	case "Sync_Env_decay", "sync-filter-env::decay":
		Sync_Aggro_Lead_set_Sync_Env_decay(p, value)
		return true
	case "Sync_Env_depth", "sync-filter-env::depth":
		Sync_Aggro_Lead_set_Sync_Env_depth(p, value)
		return true
	case "Sync_Env_release", "sync-filter-env::release":
		Sync_Aggro_Lead_set_Sync_Env_release(p, value)
		return true
	case "Sync_Env_sustain", "sync-filter-env::sustain":
		Sync_Aggro_Lead_set_Sync_Env_sustain(p, value)
		return true
	case "Sync_Saw_amplitude", "sync-osc-b::amplitude":
		Sync_Aggro_Lead_set_Sync_Saw_amplitude(p, value)
		return true
	case "Sync_Square_amplitude", "sync-osc-a::amplitude":
		Sync_Aggro_Lead_set_Sync_Square_amplitude(p, value)
		return true
	case "cutoff", "sync-filter::cutoff":
		Sync_Aggro_Lead_set_cutoff(p, value)
		return true
	case "drive", "sync-drive::drive":
		Sync_Aggro_Lead_set_drive(p, value)
		return true
	case "frequency", "sync-sweep-lfo::frequency":
		Sync_Aggro_Lead_set_frequency(p, value)
		return true
	case "mix", "sync-drive::mix":
		Sync_Aggro_Lead_set_mix(p, value)
		return true
	case "outMax", "sync-env-map::outMax":
		Sync_Aggro_Lead_set_outMax(p, value)
		return true
	case "pulseWidth", "sync-osc-a::pulseWidth":
		Sync_Aggro_Lead_set_pulseWidth(p, value)
		return true
	case "resonance", "sync-filter::resonance":
		Sync_Aggro_Lead_set_resonance(p, value)
		return true
	case "tone", "sync-drive::tone":
		Sync_Aggro_Lead_set_tone(p, value)
		return true
	}
	return false
}

Sync_Aggro_Lead_get_param :: proc(p: ^Sync_Aggro_Lead_Processor, name: string) -> (f32, bool) {
	switch name {
	case "Amp_attack", "sync-amp::attack":
		return p.Amp_attack, true
	case "Amp_decay", "sync-amp::decay":
		return p.Amp_decay, true
	case "Amp_depth", "sync-amp::depth":
		return p.Amp_depth, true
	case "Amp_release", "sync-amp::release":
		return p.Amp_release, true
	case "Amp_sustain", "sync-amp::sustain":
		return p.Amp_sustain, true
	case "Sweep_Motion_amplitude", "sync-sweep-lfo::amplitude":
		return p.Sweep_Motion_amplitude, true
	case "Sync_Env_attack", "sync-filter-env::attack":
		return p.Sync_Env_attack, true
	case "Sync_Env_decay", "sync-filter-env::decay":
		return p.Sync_Env_decay, true
	case "Sync_Env_depth", "sync-filter-env::depth":
		return p.Sync_Env_depth, true
	case "Sync_Env_release", "sync-filter-env::release":
		return p.Sync_Env_release, true
	case "Sync_Env_sustain", "sync-filter-env::sustain":
		return p.Sync_Env_sustain, true
	case "Sync_Saw_amplitude", "sync-osc-b::amplitude":
		return p.Sync_Saw_amplitude, true
	case "Sync_Square_amplitude", "sync-osc-a::amplitude":
		return p.Sync_Square_amplitude, true
	case "cutoff", "sync-filter::cutoff":
		return p.cutoff, true
	case "drive", "sync-drive::drive":
		return p.drive, true
	case "frequency", "sync-sweep-lfo::frequency":
		return p.frequency, true
	case "mix", "sync-drive::mix":
		return p.mix, true
	case "outMax", "sync-env-map::outMax":
		return p.outMax, true
	case "pulseWidth", "sync-osc-a::pulseWidth":
		return p.pulseWidth, true
	case "resonance", "sync-filter::resonance":
		return p.resonance, true
	case "tone", "sync-drive::tone":
		return p.tone, true
	}
	return 0.0, false
}

Sync_Aggro_Lead_process :: proc(p: ^Sync_Aggro_Lead_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	Sync_Aggro_Lead_process_sequence(p)
	p.total_samples += 1

	for v_idx in 0..<6 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.current_freq != voice.target_freq {
			glide_k := 1.0 / math.max(voice.glide_time * sample_rate, 1.0)
			if glide_k > 1.0 do glide_k = 1.0
			voice.current_freq += (voice.target_freq - voice.current_freq) * glide_k
			if abs(voice.target_freq - voice.current_freq) < 0.1 do voice.current_freq = voice.target_freq
		}
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_sync_amp_stage != .Release && voice.adsr_sync_amp_stage != .Idle {
				voice.adsr_sync_amp_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_sync_filter_env_stage != .Release && voice.adsr_sync_filter_env_stage != .Idle {
				voice.adsr_sync_filter_env_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_sync_amp_out: f32 = 0.0
		node_sync_drive_out: f32 = 0.0
		node_sync_env_map_out: f32 = 0.0
		node_sync_filter_out: f32 = 0.0
		node_sync_filter_env_out: f32 = 0.0
		node_sync_osc_a_out: f32 = 0.0
		node_sync_osc_b_out: f32 = 0.0
		node_sync_output_out: f32 = 0.0
		node_sync_sweep_lfo_out: f32 = 0.0

		// --- ADSR Node sync_filter_env ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_sync_filter_env_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Sync_Env_attack) > 0 do envelope = voice.adsr_sync_filter_env_attack_start + (1.0 - voice.adsr_sync_filter_env_attack_start) * (voice.age / math.max(f32(p.Sync_Env_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_sync_filter_env_release_level = envelope;
				if voice.age >= (p.Sync_Env_attack) {
					voice.adsr_sync_filter_env_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Sync_Env_attack);
				if (p.Sync_Env_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Sync_Env_decay), 0.000001)) * (1.0 - (p.Sync_Env_sustain)); else do envelope = (p.Sync_Env_sustain);
				voice.adsr_sync_filter_env_release_level = envelope;
				if time_in_decay >= (p.Sync_Env_decay) {
					voice.adsr_sync_filter_env_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Sync_Env_sustain);
				voice.adsr_sync_filter_env_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Sync_Env_release) > 0 do envelope = voice.adsr_sync_filter_env_release_level * (1.0 - (time_in_release / math.max(f32(p.Sync_Env_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_sync_filter_env_stage = .Idle;
				}
			}
			vel_scale_sync_filter_env: f32 = (1.0 - (f32(0.600000000))) + (f32(0.600000000)) * voice.velocity;
			node_sync_filter_env_out = (1.0) * envelope * (p.Sync_Env_depth) * vel_scale_sync_filter_env;
		}

		// --- Oscillator Node sync_osc_a (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 2;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (16.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_sync_osc_a_phase[i] = math.mod(voice.osc_sync_osc_a_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_sync_osc_a_phase[i] + phase_rads, 2 * f32(math.PI));
				if final_phase < 2 * f32(math.PI) * math.clamp(f32(p.pulseWidth), 0.01, 0.99) do unison_out += 1.0; else do unison_out -= 1.0;
			}
			node_sync_osc_a_out = (unison_out / f32(unison_count)) * (p.Sync_Square_amplitude);
		}

		// --- Oscillator Node sync_osc_b (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 2;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (16.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_sync_osc_b_phase[i] = math.mod(voice.osc_sync_osc_b_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_sync_osc_b_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += ((final_phase / f32(math.PI)) - 1.0);
			}
			node_sync_osc_b_out = (unison_out / f32(unison_count)) * (p.Sync_Saw_amplitude);
		}

		// --- LFO Node sync_sweep_lfo ---
		voice.lfo_sync_sweep_lfo_phase = math.mod(voice.lfo_sync_sweep_lfo_phase + (2 * f32(math.PI) * (p.frequency) / sample_rate), 2 * f32(math.PI));
		if voice.lfo_sync_sweep_lfo_phase < 0.0 do voice.lfo_sync_sweep_lfo_phase += 2 * f32(math.PI);
		node_sync_sweep_lfo_out = (2.0 / f32(math.PI)) * math.asin(math.sin(voice.lfo_sync_sweep_lfo_phase)) * (p.Sweep_Motion_amplitude);

		// --- Mapper Node sync_env_map ---
		{
			in_range_sync_env_map: f32 = f32(f32(1.000000000)) - f32(f32(0.000000000));
			if in_range_sync_env_map == 0.0 do in_range_sync_env_map = 1.0;
			node_sync_env_map_out = math.lerp(f32(f32(0.000000000)), f32(p.outMax), math.clamp((f32((node_sync_filter_env_out)) - f32(f32(0.000000000))) / in_range_sync_env_map, 0.0, 1.0));
		}

		// --- Filter Node sync_filter (SVF) ---
		{
			cutoff_c_sync_filter: f32 = math.clamp(f32((p.cutoff) + (node_sync_env_map_out) + (node_sync_sweep_lfo_out)), 10.0, sample_rate * 0.16);
			f_sync_filter := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_sync_filter / sample_rate));
			q_sync_filter: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_sync_filter);
			voice.filter_sync_filter_low += f_sync_filter * voice.filter_sync_filter_band;
			high_sync_filter := f32(((node_sync_osc_a_out + node_sync_osc_b_out)) - voice.filter_sync_filter_low - q_sync_filter * voice.filter_sync_filter_band);
			voice.filter_sync_filter_band += f_sync_filter * high_sync_filter;
			node_sync_filter_out = voice.filter_sync_filter_low;
		}

		// --- ADSR Node sync_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_sync_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Amp_attack) > 0 do envelope = voice.adsr_sync_amp_attack_start + (1.0 - voice.adsr_sync_amp_attack_start) * (voice.age / math.max(f32(p.Amp_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_sync_amp_release_level = envelope;
				if voice.age >= (p.Amp_attack) {
					voice.adsr_sync_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Amp_attack);
				if (p.Amp_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Amp_decay), 0.000001)) * (1.0 - (p.Amp_sustain)); else do envelope = (p.Amp_sustain);
				voice.adsr_sync_amp_release_level = envelope;
				if time_in_decay >= (p.Amp_decay) {
					voice.adsr_sync_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Amp_sustain);
				voice.adsr_sync_amp_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Amp_release) > 0 do envelope = voice.adsr_sync_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.Amp_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_sync_amp_stage = .Idle;
				}
			}
			vel_scale_sync_amp: f32 = (1.0 - (f32(0.600000000))) + (f32(0.600000000)) * voice.velocity;
			node_sync_amp_out = ((node_sync_filter_out)) * envelope * (p.Amp_depth) * vel_scale_sync_amp;
		}

		// --- Distortion Node sync_drive (classic) ---
		{
			dist_in_sync_drive: f32 = ((node_sync_amp_out));
			dist_k_sync_drive: f32 = math.max(f32(p.drive), 1.0);
			dist_wet_sync_drive: f32 = (f32(math.PI) + dist_k_sync_drive) * dist_in_sync_drive / (f32(math.PI) + dist_k_sync_drive * abs(dist_in_sync_drive));
			tone_k_sync_drive: f32 = math.clamp(2.0 * f32(math.PI) * math.clamp(f32(p.tone), 100.0, 20000.0) / sample_rate, 0.001, 1.0);
			voice.dist_sync_drive_tone += tone_k_sync_drive * (dist_wet_sync_drive - voice.dist_sync_drive_tone);
			mix_sync_drive: f32 = math.clamp(f32(p.mix), 0.0, 1.0);
			node_sync_drive_out = dist_in_sync_drive * (1.0 - mix_sync_drive) + voice.dist_sync_drive_tone * mix_sync_drive;
		}

		output_left += node_sync_drive_out
		output_right += node_sync_drive_out
		if voice.adsr_sync_amp_stage != .Idle do voice_busy = true
		if voice.adsr_sync_filter_env_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
Sync_Aggro_Lead_process_sequence :: proc(p: ^Sync_Aggro_Lead_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "Sync Aggro Lead" (16 steps)
		switch p.current_step % 16 {
		case 0:
			Sync_Aggro_Lead_note_on(p, 52, 0.949999988, f32(3.000000000) * (60.0 / p.bpm / 4.0))
		case 3:
			Sync_Aggro_Lead_note_on(p, 59, 0.819999993, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 4:
			Sync_Aggro_Lead_note_on(p, 64, 0.899999976, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 6:
			Sync_Aggro_Lead_note_on(p, 62, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 7:
			Sync_Aggro_Lead_note_on(p, 59, 0.779999971, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			Sync_Aggro_Lead_note_on(p, 52, 0.949999988, f32(3.000000000) * (60.0 / p.bpm / 4.0))
		case 11:
			Sync_Aggro_Lead_note_on(p, 62, 0.819999993, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			Sync_Aggro_Lead_note_on(p, 67, 0.920000017, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 14:
			Sync_Aggro_Lead_note_on(p, 64, 0.850000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 15:
			Sync_Aggro_Lead_note_on(p, 71, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	Sync_Aggro_Lead: ^Sync_Aggro_Lead_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.800000012
	p.Sync_Aggro_Lead = new(Sync_Aggro_Lead_Processor)
	Sync_Aggro_Lead_init(p.Sync_Aggro_Lead, sr)
	Sync_Aggro_Lead_start(p.Sync_Aggro_Lead)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := Sync_Aggro_Lead_process(p.Sync_Aggro_Lead); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.Sync_Aggro_Lead)
}

