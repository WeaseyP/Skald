package generated_audio

// =====================================================================
// Generated by Skald.
//
// SFX assets: Asset
// Music Layer assets: (none)
//
// Game integration: import this package and use the per-asset APIs.
//   SFX:         <Foo>_init, <Foo>_trigger, <Foo>_process, <Foo>_is_playing
//   Music Layer: <Bar>_init, <Bar>_start, <Bar>_stop, <Bar>_process,
//                <Bar>_set_loop
//
// <Foo>_trigger with duration<=0 (the default) plays a natural one-shot:
// the envelope holds through attack+decay, then releases (a patch with no
// envelope plays 1s). Pass an explicit duration in seconds to hold longer,
// or drive <Foo>_note_on / <Foo>_note_off yourself for full control.
//
// <Foo>_note_on clamps `note` to 0..127 and `velocity` to 0..1 SILENTLY —
// it is called at audio rate, so an out-of-range argument cannot afford a
// diagnostic. Check your own values if you need to know they were wrong.
// <Foo>_note_off clamps `note` the same way, because `note` is the key it
// matches voices on: if only one side clamped, note_off(200) would fail to
// release the voice note_on(200) parked at 127, and that voice would never
// free.
//
// project_init/process/destroy is a convenience wrapper for the test
// harness only — game code should consume per-asset procs directly.
// =====================================================================

import "core:math"
import "core:math/rand"

PRNG_State :: struct {
	state: u32,
}

next_float32 :: proc(rng: ^PRNG_State) -> f32 {
	x := rng.state
	x ~= x << 13
	x ~= x >> 17
	x ~= x << 5
	if x == 0 do x = 0xDEADBEEF
	rng.state = x
	return f32(x) / 4294967296.0
}

ADSR_Stage :: enum { Idle, Attack, Decay, Sustain, Release }

skald_wavetable_shape :: proc(idx: int, ph: f32) -> f32 {
	switch idx {
	case 1: return abs(ph * 4.0 - 2.0) - 1.0
	case 2: return ph * 2.0 - 1.0
	case 3: return ph < 0.5 ? 1.0 : -1.0
	}
	return math.sin(ph * 2.0 * f32(math.PI))
}

skald_wavetable_sample :: proc(ph: f32, pos: f32) -> f32 {
	p := math.clamp(pos, 0.0, 3.0)
	i1 := int(p)
	i2 := (i1 + 1) % 4
	frac := p - f32(i1)
	s1 := skald_wavetable_shape(i1, ph)
	s2 := skald_wavetable_shape(i2, ph)
	return s1 + (s2 - s1) * frac
}

// Soft limiter with a ceiling that really is 1.0 — plain tanh, not
// tanh(x*k)/k, which topped out above 1 and still clipped the device.
// Transparent for small signals (tanh(x) ~= x below ~0.3), saturating
// smoothly instead of clipping as the mix gets hot.
skald_soft_limit :: proc(l: f32, r: f32) -> (f32, f32) {
	return math.tanh(l), math.tanh(r)
}

skald_feedback_tail_seconds :: proc(period: f32, gain: f32) -> f32 {
	if math.is_nan(period) || period <= 0.0 do return 0.0
	// 0.95 is the DSP's own feedback ceiling (see generate_delay_code /
	// generate_reverb_code), so no live value can ring longer than this.
	g := math.clamp(gain, 0.0, 0.95)
	if g <= 0.0 do return period
	passes := math.ceil(math.ln(f32(0.001)) / math.ln(g))
	result := period * passes
	if math.is_nan(result) || math.is_inf(result) || result < 0.0 do return period
	return result
}

Note_Event :: struct {
	note: u8,
	velocity: f32,
	start_time: f32,
	step: int,
	duration: f32,
}

Skald_Param_Info :: struct {
	name:    string,
	min:     f32,
	max:     f32,
	default: f32,
	unit:    string,
}

Asset_Voice_State :: struct {
	active: bool,
	note: u8,
	velocity: f32,
	age: f32,
	time_released: f32,
	current_freq: f32,
	target_freq: f32,
	glide_time: f32,
	duration: f32,
	adsr_adsr_1_stage: ADSR_Stage,
	adsr_adsr_1_release_level: f32,
	adsr_adsr_1_attack_start: f32,
	lfo_lfo_1_phase: f32,
	osc_osc_1_phase: [1]f32,
}

Asset_Processor :: struct {
	sample_rate: f32,
	bpm: f32,
	voices: [1]Asset_Voice_State,
	prng: PRNG_State,
	total_samples: u64,
	playing: bool,
	loop: bool,
	current_step: u64,
	samples_until_next_step: u64,
	step_frac_acc: f32,
	ext_in_l: f32,
	ext_in_r: f32,
	volume: f32,
	bus_tail_remaining: u64,
	bus_tail_armed: bool,
	delay_reverb_1_buffer: [96000]f32,
	delay_reverb_1_write_index: int,
	reverb_reverb_1_pre_buffer: [48000]f32,
}

Asset_BUS_TAIL_SECONDS :: f32(3.095000000)

// B7-2-followup / SKB-016: the LIVE counterpart to the worst-case constant
// above. Sums, over the same Delay/Reverb nodes compute_bus_tail_seconds
// analyzed, the same feedback_tail_seconds formula — but against each
// parameter's CURRENT value instead of its range maximum. Safe to call
// outside the audio path (once per note-off, not once per sample)
// because no Delay/Reverb parameter has a modulation port: get_f32_param
// resolves every one of them to either a plain field read or a literal,
// both valid wherever `p` is in scope.
Asset_bus_tail_seconds :: proc(p: ^Asset_Processor) -> f32 {
	total: f32 = 0.0
	mix_reverb_1: f32 = (f32(0.400000000));
	if mix_reverb_1 > 0.0 {
		pre_reverb_1: f32 = math.clamp(f32(f32(0.020000000)), 0.0, 0.25);
		decay_gain_reverb_1: f32 = math.clamp(math.pow(f32(0.001), f32(0.075000000) / math.max(f32(f32(3.000000000)), 0.01)), 0.0, 0.95);
		total += pre_reverb_1 + skald_feedback_tail_seconds(f32(0.075000000), decay_gain_reverb_1)
	}
	return total
}

Asset_init :: proc(p: ^Asset_Processor, sr: f32) {
	p.sample_rate = sr
	p.bpm = 120.000000000
	p.volume = 1.000000000
	p.prng.state = 12345
	p.loop = true
	p.voices = {}
	p.total_samples = 0
	p.playing = false
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
	p.ext_in_l = 0.0
	p.ext_in_r = 0.0
	p.bus_tail_remaining = 0
	p.bus_tail_armed = false
	p.delay_reverb_1_buffer = {}
	p.delay_reverb_1_write_index = 0
	p.reverb_reverb_1_pre_buffer = {}
}

Asset_note_on :: proc(p: ^Asset_Processor, note: u8, velocity: f32, duration: f32) {
	// note and velocity are clamped silently to their MIDI/normalized domains.
	note := note
	if note > 127 do note = 127
	velocity := math.clamp(velocity, 0.0, 1.0)
	voice_idx := -1
	for i in 0..<1 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_age: f32 = -1.0
		for i in 0..<1 {
			if p.voices[i].age > oldest_age {
				oldest_age = p.voices[i].age
				voice_idx = i
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	adsr_adsr_1_prev_level: f32 = 0.0
	if stolen && v.adsr_adsr_1_stage != .Idle {
		adsr_adsr_1_prev_level = v.adsr_adsr_1_release_level
		if v.adsr_adsr_1_stage == .Release {
			rel_t_adsr_1: f32 = (f32(1.800000000));
			if rel_t_adsr_1 > 0.0 {
				rf_adsr_1 := 1.0 - (v.age - v.time_released) / math.max(rel_t_adsr_1, 0.000001)
				if rf_adsr_1 < 0.0 do rf_adsr_1 = 0.0
				adsr_adsr_1_prev_level *= rf_adsr_1
			} else {
				adsr_adsr_1_prev_level = 0.0
			}
		}
	}
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.000000000
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	v.adsr_adsr_1_stage = .Attack
	v.adsr_adsr_1_attack_start = adsr_adsr_1_prev_level
	v.adsr_adsr_1_release_level = adsr_adsr_1_prev_level
	if !stolen {
		v.osc_osc_1_phase = {}
	}
}

Asset_note_off :: proc(p: ^Asset_Processor, note: u8) {
	// Clamped to match _note_on: `note` is the voice key, so both must map it.
	note := note
	if note > 127 do note = 127
	best := -1
	best_age: f32 = -1.0
	for i in 0..<1 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_adsr_1_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_adsr_1_stage = .Release
	}
}

Asset_trigger :: proc(p: ^Asset_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (f32(1.500000000)) + (f32(2.000000000)) > d do d = (f32(1.500000000)) + (f32(2.000000000))
		if d <= 0.0 do d = 0.001
	}
	Asset_note_on(p, note, velocity, d)
}

Asset_feed_input :: proc(p: ^Asset_Processor, in_left: f32, in_right: f32) {
	p.ext_in_l = in_left
	p.ext_in_r = in_right
}

Asset_start :: proc(p: ^Asset_Processor) {
	p.playing = true
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
}

Asset_stop :: proc(p: ^Asset_Processor) {
	p.playing = false
}

Asset_set_loop :: proc(p: ^Asset_Processor, loop: bool) {
	p.loop = loop
}

Asset_set_volume :: proc(p: ^Asset_Processor, value: f32) {
	p.volume = math.clamp(value, 0.0, 1.0)
}

Asset_is_playing :: proc(p: ^Asset_Processor) -> bool {
	if p.playing do return true
	for i in 0..<1 {
		if p.voices[i].active do return true
	}
	// The effect tail counts as playing: it is still audible after every
	// voice went inactive, and reporting false here is what let a game free
	// the asset mid-echo.
	if p.bus_tail_remaining > 0 do return true
	return false
}

Asset_PARAMS := []Skald_Param_Info{
}

Asset_set_param :: proc(p: ^Asset_Processor, name: string, value: f32) -> bool {
	return false
}

Asset_get_param :: proc(p: ^Asset_Processor, name: string) -> (f32, bool) {
	return 0.0, false
}

Asset_process :: proc(p: ^Asset_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	p.total_samples += 1

	node_adsr_1_out_vsum: f32 = 0.0
	for v_idx in 0..<1 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_adsr_1_stage != .Release && voice.adsr_adsr_1_stage != .Idle {
				voice.adsr_adsr_1_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_adsr_1_out: f32 = 0.0
		node_lfo_1_out: f32 = 0.0
		node_osc_1_out: f32 = 0.0

		// --- LFO Node lfo_1 ---
		voice.lfo_lfo_1_phase = math.mod(voice.lfo_lfo_1_phase + (2 * f32(math.PI) * (f32(0.500000000)) / sample_rate), 2 * f32(math.PI));
		if voice.lfo_lfo_1_phase < 0.0 do voice.lfo_lfo_1_phase += 2 * f32(math.PI);
		node_lfo_1_out = math.sin(voice.lfo_lfo_1_phase) * (f32(1.000000000));

		// --- Oscillator Node osc_1 (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_osc_1_phase[i] = math.mod(voice.osc_osc_1_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_osc_1_phase[i] + phase_rads, 2 * f32(math.PI));
				if final_phase < 2 * f32(math.PI) * math.clamp(f32((f32(0.500000000)) + (node_lfo_1_out)), 0.01, 0.99) do unison_out += 1.0; else do unison_out -= 1.0;
			}
			node_osc_1_out = (unison_out / f32(unison_count)) * (f32(0.500000000));
		}

		// --- ADSR Node adsr_1 ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_adsr_1_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(1.500000000)) > 0 do envelope = voice.adsr_adsr_1_attack_start + (1.0 - voice.adsr_adsr_1_attack_start) * (voice.age / math.max(f32(f32(1.500000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_adsr_1_release_level = envelope;
				if voice.age >= (f32(1.500000000)) {
					voice.adsr_adsr_1_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(1.500000000));
				if (f32(2.000000000)) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(f32(2.000000000)), 0.000001)) * (1.0 - (f32(0.800000000))); else do envelope = (f32(0.800000000));
				voice.adsr_adsr_1_release_level = envelope;
				if time_in_decay >= (f32(2.000000000)) {
					voice.adsr_adsr_1_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.800000000));
				voice.adsr_adsr_1_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_adsr_1_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(1.800000000)) > 0 do envelope = voice.adsr_adsr_1_release_level * (1.0 - (time_in_release / math.max(f32(f32(1.800000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_adsr_1_stage = .Idle;
				}
			}
			vel_scale_adsr_1: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_adsr_1_out = ((node_osc_1_out)) * envelope * (f32(1.000000000)) * vel_scale_adsr_1;
		}

		node_adsr_1_out_vsum += node_adsr_1_out
		if voice.adsr_adsr_1_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}

	// --- Bus effects (once per sample, post voice sum) ---
	{
		node_adsr_1_out := node_adsr_1_out_vsum
		node_reverb_1_out: f32 = 0.0
		// --- Reverb Node reverb_1 (pre-delay + feedback comb) ---
		{
			pre_delay_seconds_reverb_1: f32 = math.clamp(f32(f32(0.020000000)), 0.0, 0.25);
			pre_delay_samples_reverb_1 := int(math.clamp(pre_delay_seconds_reverb_1 * sample_rate, 0.0, f32(48000)));
			pre_write_index_reverb_1 := p.delay_reverb_1_write_index % len(p.reverb_reverb_1_pre_buffer)
			pre_delayed_input_reverb_1 := f32((node_adsr_1_out))
			if pre_delay_samples_reverb_1 > 0 {
				pre_read_index_reverb_1 := (pre_write_index_reverb_1 - pre_delay_samples_reverb_1 + len(p.reverb_reverb_1_pre_buffer)) % len(p.reverb_reverb_1_pre_buffer)
				pre_delayed_input_reverb_1 = p.reverb_reverb_1_pre_buffer[pre_read_index_reverb_1]
			}
			p.reverb_reverb_1_pre_buffer[pre_write_index_reverb_1] = f32((node_adsr_1_out))
			delay_samples_reverb_1 := int(math.clamp((0.075000000) * sample_rate, 0, 96000-1));
			read_index_reverb_1 := (p.delay_reverb_1_write_index - delay_samples_reverb_1 + len(p.delay_reverb_1_buffer)) % len(p.delay_reverb_1_buffer);
			delayed_sample_reverb_1 := p.delay_reverb_1_buffer[read_index_reverb_1];
			decay_gain_reverb_1: f32 = math.clamp(math.pow(f32(0.001), f32(0.075000000) / math.max(f32(f32(3.000000000)), 0.01)), 0.0, 0.95);
			p.delay_reverb_1_buffer[p.delay_reverb_1_write_index] = pre_delayed_input_reverb_1 + delayed_sample_reverb_1 * decay_gain_reverb_1;
			p.delay_reverb_1_write_index = (p.delay_reverb_1_write_index + 1) % len(p.delay_reverb_1_buffer);
			node_reverb_1_out = ((node_adsr_1_out)) * (1.0 - (f32(0.400000000))) + delayed_sample_reverb_1 * (f32(0.400000000));
		}

		output_left += node_reverb_1_out
		output_right += node_reverb_1_out
	}

	// B7-2-followup / SKB-016: a baked worst-case constant here held
	// is_playing true for minutes on real content (every exposed tail param
	// contributed its range maximum, so glassy-fm-pluck alone baked 202.5s
	// for a true tail under 2s). Arm on the FALLING EDGE instead, from the
	// live field values — that is one ln/pow per note-off rather than per
	// sample, which is what keeps this proc off the audio path.
	{
		voice_alive := false
		for i in 0..<1 {
			if p.voices[i].active {
				voice_alive = true
				break
			}
		}
		if voice_alive || p.playing {
			p.bus_tail_armed = false
			p.bus_tail_remaining = 0
		} else if !p.bus_tail_armed {
			p.bus_tail_armed = true
			p.bus_tail_remaining = u64(Asset_bus_tail_seconds(p) * sample_rate)
		} else if p.bus_tail_remaining > 0 {
			p.bus_tail_remaining -= 1
		}
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
Asset_process_sequence :: proc(p: ^Asset_Processor) {
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	Asset: ^Asset_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 1.000000000
	p.Asset = new(Asset_Processor)
	Asset_init(p.Asset, sr)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := Asset_process(p.Asset); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.Asset)
}

