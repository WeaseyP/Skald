				adsr_chrome_amp_prev_level *= rf_chrome_amp
			} else {
				adsr_chrome_amp_prev_level = 0.0
			}
		}
	}
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
