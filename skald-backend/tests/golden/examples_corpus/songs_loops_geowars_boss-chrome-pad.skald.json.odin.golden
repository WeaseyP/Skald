GW_Boss_Chrome_Pad_process :: proc(p: ^GW_Boss_Chrome_Pad_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	GW_Boss_Chrome_Pad_process_sequence(p)
	p.total_samples += 1

	node_chrome_amp_out_vsum: f32 = 0.0
	for v_idx in 0..<6 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_chrome_amp_stage != .Release && voice.adsr_chrome_amp_stage != .Idle {
				voice.adsr_chrome_amp_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_chrome_amp_out: f32 = 0.0
		node_chrome_filter_out: f32 = 0.0
		node_chrome_shimmer_out: f32 = 0.0
		node_chrome_wave_out: f32 = 0.0

		// --- LFO Node chrome_shimmer ---
		voice.lfo_chrome_shimmer_phase = math.mod(voice.lfo_chrome_shimmer_phase + (2 * f32(math.PI) * (p.frequency) / sample_rate), 2 * f32(math.PI));
		if voice.lfo_chrome_shimmer_phase < 0.0 do voice.lfo_chrome_shimmer_phase += 2 * f32(math.PI);
		node_chrome_shimmer_out = math.sin(voice.lfo_chrome_shimmer_phase) * (p.Shimmer_amplitude);

		// --- Wavetable Node chrome_wave (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				voice.wavetable_chrome_wave_phase[i] = math.mod(voice.wavetable_chrome_wave_phase[i] + (detuned_freq / sample_rate), 1.0);
				if voice.wavetable_chrome_wave_phase[i] < 0.0 do voice.wavetable_chrome_wave_phase[i] += 1.0;
				unison_out += skald_wavetable_sample(voice.wavetable_chrome_wave_phase[i], f32((p.position) + (node_chrome_shimmer_out)));
			}
			node_chrome_wave_out = (unison_out / f32(unison_count)) * (p.Chrome_amplitude);
		}

		// --- Filter Node chrome_filter (SVF) ---
		{
			cutoff_c_chrome_filter: f32 = math.clamp(f32(p.cutoff), 10.0, sample_rate * 0.16);
			f_chrome_filter := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_chrome_filter / sample_rate));
			q_chrome_filter: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_chrome_filter);
			voice.filter_chrome_filter_low += f_chrome_filter * voice.filter_chrome_filter_band;
			high_chrome_filter := f32(((node_chrome_wave_out)) - voice.filter_chrome_filter_low - q_chrome_filter * voice.filter_chrome_filter_band);
			voice.filter_chrome_filter_band += f_chrome_filter * high_chrome_filter;
			node_chrome_filter_out = voice.filter_chrome_filter_low;
		}

		// --- ADSR Node chrome_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_chrome_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.attack) > 0 do envelope = voice.adsr_chrome_amp_attack_start + (1.0 - voice.adsr_chrome_amp_attack_start) * (voice.age / math.max(f32(p.attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_chrome_amp_release_level = envelope;
				if voice.age >= (p.attack) {
					voice.adsr_chrome_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.attack);
				if (f32(0.500000000)) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(f32(0.500000000)), 0.000001)) * (1.0 - (f32(0.800000000))); else do envelope = (f32(0.800000000));
				voice.adsr_chrome_amp_release_level = envelope;
				if time_in_decay >= (f32(0.500000000)) {
					voice.adsr_chrome_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.800000000));
				voice.adsr_chrome_amp_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.release) > 0 do envelope = voice.adsr_chrome_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_chrome_amp_stage = .Idle;
				}
			}
			vel_scale_chrome_amp: f32 = (1.0 - (f32(0.400000000))) + (f32(0.400000000)) * voice.velocity;
			node_chrome_amp_out = ((node_chrome_filter_out)) * envelope * (f32(1.000000000)) * vel_scale_chrome_amp;
		}

		node_chrome_amp_out_vsum += node_chrome_amp_out
		if voice.adsr_chrome_amp_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}

	// --- Bus effects (once per sample, post voice sum) ---
	{
		node_chrome_amp_out := node_chrome_amp_out_vsum
		node_chrome_reverb_out: f32 = 0.0
		// --- Reverb Node chrome_reverb (pre-delay + feedback comb) ---
		{
			pre_delay_seconds_chrome_reverb: f32 = math.clamp(f32(f32(0.010000000)), 0.0, 0.25);
			pre_delay_samples_chrome_reverb := int(math.clamp(pre_delay_seconds_chrome_reverb * sample_rate, 0.0, f32(48000)));
			pre_write_index_chrome_reverb := p.delay_chrome_reverb_write_index % len(p.reverb_chrome_reverb_pre_buffer)
			pre_delayed_input_chrome_reverb := f32((node_chrome_amp_out))
			if pre_delay_samples_chrome_reverb > 0 {
				pre_read_index_chrome_reverb := (pre_write_index_chrome_reverb - pre_delay_samples_chrome_reverb + len(p.reverb_chrome_reverb_pre_buffer)) % len(p.reverb_chrome_reverb_pre_buffer)
				pre_delayed_input_chrome_reverb = p.reverb_chrome_reverb_pre_buffer[pre_read_index_chrome_reverb]
			}
			p.reverb_chrome_reverb_pre_buffer[pre_write_index_chrome_reverb] = f32((node_chrome_amp_out))
			delay_samples_chrome_reverb := int(math.clamp((0.075000000) * sample_rate, 0, 96000-1));
			read_index_chrome_reverb := (p.delay_chrome_reverb_write_index - delay_samples_chrome_reverb + len(p.delay_chrome_reverb_buffer)) % len(p.delay_chrome_reverb_buffer);
			delayed_sample_chrome_reverb := p.delay_chrome_reverb_buffer[read_index_chrome_reverb];
			decay_gain_chrome_reverb: f32 = math.clamp(math.pow(f32(0.001), f32(0.075000000) / math.max(f32(p.decay), 0.01)), 0.0, 0.95);
			p.delay_chrome_reverb_buffer[p.delay_chrome_reverb_write_index] = pre_delayed_input_chrome_reverb + delayed_sample_chrome_reverb * decay_gain_chrome_reverb;
			p.delay_chrome_reverb_write_index = (p.delay_chrome_reverb_write_index + 1) % len(p.delay_chrome_reverb_buffer);
			node_chrome_reverb_out = ((node_chrome_amp_out)) * (1.0 - (p.mix)) + delayed_sample_chrome_reverb * (p.mix);
		}

		output_left += node_chrome_reverb_out
		output_right += node_chrome_reverb_out
	}

	// B7-2-followup / SKB-016: a baked worst-case constant here held
	// is_playing true for minutes on real content (every exposed tail param
	// contributed its range maximum, so glassy-fm-pluck alone baked 202.5s
	// for a true tail under 2s). Arm on the FALLING EDGE instead, from the
	// live field values — that is one ln/pow per note-off rather than per
	// sample, which is what keeps this proc off the audio path.
	{
		voice_alive := false
		for i in 0..<6 {
			if p.voices[i].active {
				voice_alive = true
				break
			}
		}
		if voice_alive || p.playing {
			p.bus_tail_armed = false
			p.bus_tail_remaining = 0
		} else if !p.bus_tail_armed {
			p.bus_tail_armed = true
			p.bus_tail_remaining = u64(GW_Boss_Chrome_Pad_bus_tail_seconds(p) * sample_rate)
		} else if p.bus_tail_remaining > 0 {
			p.bus_tail_remaining -= 1
		}
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
GW_Boss_Chrome_Pad_process_sequence :: proc(p: ^GW_Boss_Chrome_Pad_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "GW Boss Chrome Pad" (16 steps)
		switch p.current_step % 16 {
		case 0:
			GW_Boss_Chrome_Pad_note_on(p, 50, 0.800000012, f32(8.000000000) * (60.0 / p.bpm / 4.0))
			GW_Boss_Chrome_Pad_note_on(p, 57, 0.750000000, f32(8.000000000) * (60.0 / p.bpm / 4.0))
			GW_Boss_Chrome_Pad_note_on(p, 62, 0.699999988, f32(8.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			GW_Boss_Chrome_Pad_note_on(p, 46, 0.800000012, f32(8.000000000) * (60.0 / p.bpm / 4.0))
			GW_Boss_Chrome_Pad_note_on(p, 53, 0.750000000, f32(8.000000000) * (60.0 / p.bpm / 4.0))
			GW_Boss_Chrome_Pad_note_on(p, 58, 0.699999988, f32(8.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	GW_Boss_Chrome_Pad: ^GW_Boss_Chrome_Pad_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.750000000
	p.GW_Boss_Chrome_Pad = new(GW_Boss_Chrome_Pad_Processor)
	GW_Boss_Chrome_Pad_init(p.GW_Boss_Chrome_Pad, sr)
	GW_Boss_Chrome_Pad_start(p.GW_Boss_Chrome_Pad)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := GW_Boss_Chrome_Pad_process(p.GW_Boss_Chrome_Pad); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.GW_Boss_Chrome_Pad)
}

