GW_Boss_Chrome_Pad_note_on :: proc(p: ^GW_Boss_Chrome_Pad_Processor, note: u8, velocity: f32, duration: f32) {
	// note and velocity are clamped silently to their MIDI/normalized domains.
	note := note
	if note > 127 do note = 127
	velocity := math.clamp(velocity, 0.0, 1.0)
	voice_idx := -1
	for i in 0..<6 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_releasing_age: f32 = -1.0
		for i in 0..<6 {
