GW_SFX_Gold_Chime_set_param :: proc(p: ^GW_SFX_Gold_Chime_Processor, name: string, value: f32) -> bool {
	switch name {
	case "Carrier_frequency", "chime-carrier::frequency":
		GW_SFX_Gold_Chime_set_Carrier_frequency(p, value)
		return true
	case "Halo_decay", "chime-reverb::decay":
		GW_SFX_Gold_Chime_set_Halo_decay(p, value)
		return true
	case "Mod_frequency", "chime-mod::frequency":
		GW_SFX_Gold_Chime_set_Mod_frequency(p, value)
		return true
	case "Strike_decay", "chime-strike::decay":
		GW_SFX_Gold_Chime_set_Strike_decay(p, value)
		return true
	case "mix", "chime-reverb::mix":
		GW_SFX_Gold_Chime_set_mix(p, value)
		return true
	case "modIndex", "chime-carrier::modIndex":
		GW_SFX_Gold_Chime_set_modIndex(p, value)
		return true
	case "release", "chime-strike::release":
		GW_SFX_Gold_Chime_set_release(p, value)
		return true
	}
	return false
}

GW_SFX_Gold_Chime_get_param :: proc(p: ^GW_SFX_Gold_Chime_Processor, name: string) -> (f32, bool) {
	switch name {
	case "Carrier_frequency", "chime-carrier::frequency":
		return p.Carrier_frequency, true
	case "Halo_decay", "chime-reverb::decay":
		return p.Halo_decay, true
	case "Mod_frequency", "chime-mod::frequency":
		return p.Mod_frequency, true
	case "Strike_decay", "chime-strike::decay":
		return p.Strike_decay, true
	case "mix", "chime-reverb::mix":
		return p.mix, true
	case "modIndex", "chime-carrier::modIndex":
		return p.modIndex, true
	case "release", "chime-strike::release":
		return p.release, true
	}
	return 0.0, false
}

GW_SFX_Gold_Chime_process :: proc(p: ^GW_SFX_Gold_Chime_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	p.total_samples += 1

	node_chime_strike_out_vsum: f32 = 0.0
	for v_idx in 0..<6 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_chime_strike_stage != .Release && voice.adsr_chime_strike_stage != .Idle {
				voice.adsr_chime_strike_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_chime_carrier_out: f32 = 0.0
		node_chime_mod_out: f32 = 0.0
		node_chime_strike_out: f32 = 0.0

		// --- FM Operator Node chime_mod (Unison/Detune) ---
		{
			carrier_freq_chime_mod: f32 = voice.current_freq * math.clamp(f32(p.Mod_frequency), 0.01, 32.0);
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_carrier_freq_chime_mod: f32 = carrier_freq_chime_mod * math.pow(2.0, detune_amount / 1200.0);
				voice.fm_chime_mod_phase[i] = math.mod(voice.fm_chime_mod_phase[i] + (2 * f32(math.PI) * detuned_carrier_freq_chime_mod / sample_rate), 2 * f32(math.PI));
				unison_out += math.sin(voice.fm_chime_mod_phase[i] + (0.0) * (f32(0.000000000)));
			}
			node_chime_mod_out = unison_out / f32(unison_count);
		}

		// --- FM Operator Node chime_carrier (Unison/Detune) ---
		{
			carrier_freq_chime_carrier: f32 = voice.current_freq * math.clamp(f32(p.Carrier_frequency), 0.01, 32.0);
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_carrier_freq_chime_carrier: f32 = carrier_freq_chime_carrier * math.pow(2.0, detune_amount / 1200.0);
				voice.fm_chime_carrier_phase[i] = math.mod(voice.fm_chime_carrier_phase[i] + (2 * f32(math.PI) * detuned_carrier_freq_chime_carrier / sample_rate), 2 * f32(math.PI));
				unison_out += math.sin(voice.fm_chime_carrier_phase[i] + ((node_chime_mod_out)) * (p.modIndex));
			}
			node_chime_carrier_out = unison_out / f32(unison_count);
		}

		// --- ADSR Node chime_strike ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_chime_strike_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.001000000)) > 0 do envelope = voice.adsr_chime_strike_attack_start + (1.0 - voice.adsr_chime_strike_attack_start) * (voice.age / math.max(f32(f32(0.001000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_chime_strike_release_level = envelope;
				if voice.age >= (f32(0.001000000)) {
					voice.adsr_chime_strike_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.001000000));
				if (p.Strike_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Strike_decay), 0.000001)) * (1.0 - (f32(0.000000000))); else do envelope = (f32(0.000000000));
				voice.adsr_chime_strike_release_level = envelope;
				if time_in_decay >= (p.Strike_decay) {
					voice.adsr_chime_strike_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.000000000));
				voice.adsr_chime_strike_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_chime_strike_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.release) > 0 do envelope = voice.adsr_chime_strike_release_level * (1.0 - (time_in_release / math.max(f32(p.release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_chime_strike_stage = .Idle;
				}
			}
			vel_scale_chime_strike: f32 = (1.0 - (f32(0.800000000))) + (f32(0.800000000)) * voice.velocity;
			node_chime_strike_out = ((node_chime_carrier_out)) * envelope * (f32(1.000000000)) * vel_scale_chime_strike;
		}

		node_chime_strike_out_vsum += node_chime_strike_out
		if voice.adsr_chime_strike_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}

	// --- Bus effects (once per sample, post voice sum) ---
	{
		node_chime_strike_out := node_chime_strike_out_vsum
		node_chime_reverb_out: f32 = 0.0
		// --- Reverb Node chime_reverb (pre-delay + feedback comb) ---
		{
			pre_delay_seconds_chime_reverb: f32 = math.clamp(f32(f32(0.010000000)), 0.0, 0.25);
			pre_delay_samples_chime_reverb := int(math.clamp(pre_delay_seconds_chime_reverb * sample_rate, 0.0, f32(48000)));
			pre_write_index_chime_reverb := p.delay_chime_reverb_write_index % len(p.reverb_chime_reverb_pre_buffer)
			pre_delayed_input_chime_reverb := f32((node_chime_strike_out))
			if pre_delay_samples_chime_reverb > 0 {
				pre_read_index_chime_reverb := (pre_write_index_chime_reverb - pre_delay_samples_chime_reverb + len(p.reverb_chime_reverb_pre_buffer)) % len(p.reverb_chime_reverb_pre_buffer)
				pre_delayed_input_chime_reverb = p.reverb_chime_reverb_pre_buffer[pre_read_index_chime_reverb]
			}
			p.reverb_chime_reverb_pre_buffer[pre_write_index_chime_reverb] = f32((node_chime_strike_out))
			delay_samples_chime_reverb := int(math.clamp((0.075000000) * sample_rate, 0, 96000-1));
			read_index_chime_reverb := (p.delay_chime_reverb_write_index - delay_samples_chime_reverb + len(p.delay_chime_reverb_buffer)) % len(p.delay_chime_reverb_buffer);
			delayed_sample_chime_reverb := p.delay_chime_reverb_buffer[read_index_chime_reverb];
			decay_gain_chime_reverb: f32 = math.clamp(math.pow(f32(0.001), f32(0.075000000) / math.max(f32(p.Halo_decay), 0.01)), 0.0, 0.95);
			p.delay_chime_reverb_buffer[p.delay_chime_reverb_write_index] = pre_delayed_input_chime_reverb + delayed_sample_chime_reverb * decay_gain_chime_reverb;
			p.delay_chime_reverb_write_index = (p.delay_chime_reverb_write_index + 1) % len(p.delay_chime_reverb_buffer);
			node_chime_reverb_out = ((node_chime_strike_out)) * (1.0 - (p.mix)) + delayed_sample_chime_reverb * (p.mix);
		}

		output_left += node_chime_reverb_out
		output_right += node_chime_reverb_out
	}

	// B7-2-followup / SKB-016: a baked worst-case constant here held
	// is_playing true for minutes on real content (every exposed tail param
	// contributed its range maximum, so glassy-fm-pluck alone baked 202.5s
	// for a true tail under 2s). Arm on the FALLING EDGE instead, from the
	// live field values — that is one ln/pow per note-off rather than per
	// sample, which is what keeps this proc off the audio path.
	{
		voice_alive := false
		for i in 0..<6 {
			if p.voices[i].active {
				voice_alive = true
				break
			}
		}
		if voice_alive || p.playing {
			p.bus_tail_armed = false
			p.bus_tail_remaining = 0
		} else if !p.bus_tail_armed {
			p.bus_tail_armed = true
			p.bus_tail_remaining = u64(GW_SFX_Gold_Chime_bus_tail_seconds(p) * sample_rate)
		} else if p.bus_tail_remaining > 0 {
			p.bus_tail_remaining -= 1
		}
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
GW_SFX_Gold_Chime_process_sequence :: proc(p: ^GW_SFX_Gold_Chime_Processor) {
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	GW_SFX_Gold_Chime: ^GW_SFX_Gold_Chime_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.750000000
	p.GW_SFX_Gold_Chime = new(GW_SFX_Gold_Chime_Processor)
	GW_SFX_Gold_Chime_init(p.GW_SFX_Gold_Chime, sr)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := GW_SFX_Gold_Chime_process(p.GW_SFX_Gold_Chime); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.GW_SFX_Gold_Chime)
}

