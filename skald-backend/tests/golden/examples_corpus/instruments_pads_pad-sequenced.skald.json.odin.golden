Pad_set_param :: proc(p: ^Pad_Processor, name: string, value: f32) -> bool {
	switch name {
	case "Amp_decay", "pad-amp-envelope::decay":
		Pad_set_Amp_decay(p, value)
		return true
	case "Reverb_decay", "pad-reverb::decay":
		Pad_set_Reverb_decay(p, value)
		return true
	case "amplitude", "pad-morph-lfo::amplitude":
		Pad_set_amplitude(p, value)
		return true
	case "attack", "pad-amp-envelope::attack":
		Pad_set_attack(p, value)
		return true
	case "cutoff", "pad-filter::cutoff":
		Pad_set_cutoff(p, value)
		return true
	case "depth", "pad-amp-envelope::depth":
		Pad_set_depth(p, value)
		return true
	case "frequency", "pad-morph-lfo::frequency":
		Pad_set_frequency(p, value)
		return true
	case "mix", "pad-reverb::mix":
		Pad_set_mix(p, value)
		return true
	case "position", "pad-wavetable::position":
		Pad_set_position(p, value)
		return true
	case "release", "pad-amp-envelope::release":
		Pad_set_release(p, value)
		return true
	case "resonance", "pad-filter::resonance":
		Pad_set_resonance(p, value)
		return true
	case "sustain", "pad-amp-envelope::sustain":
		Pad_set_sustain(p, value)
		return true
	}
	return false
}

Pad_get_param :: proc(p: ^Pad_Processor, name: string) -> (f32, bool) {
	switch name {
	case "Amp_decay", "pad-amp-envelope::decay":
		return p.Amp_decay, true
	case "Reverb_decay", "pad-reverb::decay":
		return p.Reverb_decay, true
	case "amplitude", "pad-morph-lfo::amplitude":
		return p.amplitude, true
	case "attack", "pad-amp-envelope::attack":
		return p.attack, true
	case "cutoff", "pad-filter::cutoff":
		return p.cutoff, true
	case "depth", "pad-amp-envelope::depth":
		return p.depth, true
	case "frequency", "pad-morph-lfo::frequency":
		return p.frequency, true
	case "mix", "pad-reverb::mix":
		return p.mix, true
	case "position", "pad-wavetable::position":
		return p.position, true
	case "release", "pad-amp-envelope::release":
		return p.release, true
	case "resonance", "pad-filter::resonance":
		return p.resonance, true
	case "sustain", "pad-amp-envelope::sustain":
		return p.sustain, true
	}
	return 0.0, false
}

Pad_process :: proc(p: ^Pad_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	Pad_process_sequence(p)
	p.total_samples += 1

	node_pad_amp_envelope_out_vsum: f32 = 0.0
	for v_idx in 0..<8 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.current_freq != voice.target_freq {
			glide_k := 1.0 / math.max(voice.glide_time * sample_rate, 1.0)
			if glide_k > 1.0 do glide_k = 1.0
			voice.current_freq += (voice.target_freq - voice.current_freq) * glide_k
			if abs(voice.target_freq - voice.current_freq) < 0.1 do voice.current_freq = voice.target_freq
		}
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_pad_amp_envelope_stage != .Release && voice.adsr_pad_amp_envelope_stage != .Idle {
				voice.adsr_pad_amp_envelope_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_pad_amp_envelope_out: f32 = 0.0
		node_pad_filter_out: f32 = 0.0
		node_pad_morph_lfo_out: f32 = 0.0
		node_pad_wavetable_out: f32 = 0.0

		// --- LFO Node pad_morph_lfo ---
		voice.lfo_pad_morph_lfo_phase = math.mod(voice.lfo_pad_morph_lfo_phase + (2 * f32(math.PI) * (p.frequency) / sample_rate), 2 * f32(math.PI));
		if voice.lfo_pad_morph_lfo_phase < 0.0 do voice.lfo_pad_morph_lfo_phase += 2 * f32(math.PI);
		node_pad_morph_lfo_out = math.sin(voice.lfo_pad_morph_lfo_phase) * (p.amplitude);

		// --- Wavetable Node pad_wavetable (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 3;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (12.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				voice.wavetable_pad_wavetable_phase[i] = math.mod(voice.wavetable_pad_wavetable_phase[i] + (detuned_freq / sample_rate), 1.0);
				if voice.wavetable_pad_wavetable_phase[i] < 0.0 do voice.wavetable_pad_wavetable_phase[i] += 1.0;
				unison_out += skald_wavetable_sample(voice.wavetable_pad_wavetable_phase[i], f32((p.position) + (node_pad_morph_lfo_out)));
			}
			node_pad_wavetable_out = (unison_out / f32(unison_count)) * (f32(1.000000000));
		}

		// --- Filter Node pad_filter (SVF) ---
		{
			cutoff_c_pad_filter: f32 = math.clamp(f32(p.cutoff), 10.0, sample_rate * 0.16);
			f_pad_filter := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_pad_filter / sample_rate));
			q_pad_filter: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_pad_filter);
			voice.filter_pad_filter_low += f_pad_filter * voice.filter_pad_filter_band;
			high_pad_filter := f32(((node_pad_wavetable_out)) - voice.filter_pad_filter_low - q_pad_filter * voice.filter_pad_filter_band);
			voice.filter_pad_filter_band += f_pad_filter * high_pad_filter;
			node_pad_filter_out = voice.filter_pad_filter_low;
		}

		// --- ADSR Node pad_amp_envelope ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_pad_amp_envelope_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.attack) > 0 do envelope = voice.adsr_pad_amp_envelope_attack_start + (1.0 - voice.adsr_pad_amp_envelope_attack_start) * (voice.age / math.max(f32(p.attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_pad_amp_envelope_release_level = envelope;
				if voice.age >= (p.attack) {
					voice.adsr_pad_amp_envelope_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.attack);
				if (p.Amp_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Amp_decay), 0.000001)) * (1.0 - (p.sustain)); else do envelope = (p.sustain);
				voice.adsr_pad_amp_envelope_release_level = envelope;
				if time_in_decay >= (p.Amp_decay) {
					voice.adsr_pad_amp_envelope_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.sustain);
				voice.adsr_pad_amp_envelope_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.release) > 0 do envelope = voice.adsr_pad_amp_envelope_release_level * (1.0 - (time_in_release / math.max(f32(p.release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_pad_amp_envelope_stage = .Idle;
				}
			}
			vel_scale_pad_amp_envelope: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_pad_amp_envelope_out = ((node_pad_filter_out)) * envelope * (p.depth) * vel_scale_pad_amp_envelope;
		}

		node_pad_amp_envelope_out_vsum += node_pad_amp_envelope_out
		if voice.adsr_pad_amp_envelope_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}

	// --- Bus effects (once per sample, post voice sum) ---
	{
		node_pad_amp_envelope_out := node_pad_amp_envelope_out_vsum
		node_pad_reverb_out: f32 = 0.0
		// --- Reverb Node pad_reverb (pre-delay + feedback comb) ---
		{
			pre_delay_seconds_pad_reverb: f32 = math.clamp(f32(f32(0.010000000)), 0.0, 0.25);
			pre_delay_samples_pad_reverb := int(math.clamp(pre_delay_seconds_pad_reverb * sample_rate, 0.0, f32(48000)));
			pre_write_index_pad_reverb := p.delay_pad_reverb_write_index % len(p.reverb_pad_reverb_pre_buffer)
			pre_delayed_input_pad_reverb := f32((node_pad_amp_envelope_out))
			if pre_delay_samples_pad_reverb > 0 {
				pre_read_index_pad_reverb := (pre_write_index_pad_reverb - pre_delay_samples_pad_reverb + len(p.reverb_pad_reverb_pre_buffer)) % len(p.reverb_pad_reverb_pre_buffer)
				pre_delayed_input_pad_reverb = p.reverb_pad_reverb_pre_buffer[pre_read_index_pad_reverb]
			}
			p.reverb_pad_reverb_pre_buffer[pre_write_index_pad_reverb] = f32((node_pad_amp_envelope_out))
			delay_samples_pad_reverb := int(math.clamp((0.075000000) * sample_rate, 0, 96000-1));
			read_index_pad_reverb := (p.delay_pad_reverb_write_index - delay_samples_pad_reverb + len(p.delay_pad_reverb_buffer)) % len(p.delay_pad_reverb_buffer);
			delayed_sample_pad_reverb := p.delay_pad_reverb_buffer[read_index_pad_reverb];
			decay_gain_pad_reverb: f32 = math.clamp(math.pow(f32(0.001), f32(0.075000000) / math.max(f32(p.Reverb_decay), 0.01)), 0.0, 0.95);
			p.delay_pad_reverb_buffer[p.delay_pad_reverb_write_index] = pre_delayed_input_pad_reverb + delayed_sample_pad_reverb * decay_gain_pad_reverb;
			p.delay_pad_reverb_write_index = (p.delay_pad_reverb_write_index + 1) % len(p.delay_pad_reverb_buffer);
			node_pad_reverb_out = ((node_pad_amp_envelope_out)) * (1.0 - (p.mix)) + delayed_sample_pad_reverb * (p.mix);
		}

		output_left += node_pad_reverb_out
		output_right += node_pad_reverb_out
	}

	// B7-2-followup / SKB-016: a baked worst-case constant here held
	// is_playing true for minutes on real content (every exposed tail param
	// contributed its range maximum, so glassy-fm-pluck alone baked 202.5s
	// for a true tail under 2s). Arm on the FALLING EDGE instead, from the
	// live field values — that is one ln/pow per note-off rather than per
	// sample, which is what keeps this proc off the audio path.
	{
		voice_alive := false
		for i in 0..<8 {
			if p.voices[i].active {
				voice_alive = true
				break
			}
		}
		if voice_alive || p.playing {
			p.bus_tail_armed = false
			p.bus_tail_remaining = 0
		} else if !p.bus_tail_armed {
			p.bus_tail_armed = true
			p.bus_tail_remaining = u64(Pad_bus_tail_seconds(p) * sample_rate)
		} else if p.bus_tail_remaining > 0 {
			p.bus_tail_remaining -= 1
		}
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
Pad_process_sequence :: proc(p: ^Pad_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "Pad" (16 steps)
		switch p.current_step % 16 {
		case 0:
			Pad_note_on(p, 48, 0.720000029, f32(8.000000000) * (60.0 / p.bpm / 4.0))
			Pad_note_on(p, 55, 0.680000007, f32(8.000000000) * (60.0 / p.bpm / 4.0))
			Pad_note_on(p, 60, 0.649999976, f32(8.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			Pad_note_on(p, 53, 0.720000029, f32(8.000000000) * (60.0 / p.bpm / 4.0))
			Pad_note_on(p, 60, 0.680000007, f32(8.000000000) * (60.0 / p.bpm / 4.0))
			Pad_note_on(p, 64, 0.649999976, f32(8.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	Pad: ^Pad_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.800000012
	p.Pad = new(Pad_Processor)
	Pad_init(p.Pad, sr)
	Pad_start(p.Pad)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := Pad_process(p.Pad); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.Pad)
}

