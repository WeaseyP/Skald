GW_Disruptor_Alarm_process :: proc(p: ^GW_Disruptor_Alarm_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	GW_Disruptor_Alarm_process_sequence(p)
	p.total_samples += 1

	node_alarm_grit_out_vsum: f32 = 0.0
	for v_idx in 0..<4 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_alarm_amp_stage != .Release && voice.adsr_alarm_amp_stage != .Idle {
				voice.adsr_alarm_amp_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_alarm_amp_out: f32 = 0.0
		node_alarm_filter_out: f32 = 0.0
		node_alarm_grit_out: f32 = 0.0
		node_alarm_osc_out: f32 = 0.0

		// --- Oscillator Node alarm_osc (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_alarm_osc_phase[i] = math.mod(voice.osc_alarm_osc_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_alarm_osc_phase[i] + phase_rads, 2 * f32(math.PI));
				if final_phase < 2 * f32(math.PI) * math.clamp(f32(f32(0.500000000)), 0.01, 0.99) do unison_out += 1.0; else do unison_out -= 1.0;
			}
			node_alarm_osc_out = (unison_out / f32(unison_count)) * (p.amplitude);
		}

		// --- Filter Node alarm_filter (SVF) ---
		{
			cutoff_c_alarm_filter: f32 = math.clamp(f32(p.cutoff), 10.0, sample_rate * 0.16);
			f_alarm_filter := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_alarm_filter / sample_rate));
			q_alarm_filter: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_alarm_filter);
			voice.filter_alarm_filter_low += f_alarm_filter * voice.filter_alarm_filter_band;
			high_alarm_filter := f32(((node_alarm_osc_out)) - voice.filter_alarm_filter_low - q_alarm_filter * voice.filter_alarm_filter_band);
			voice.filter_alarm_filter_band += f_alarm_filter * high_alarm_filter;
			node_alarm_filter_out = voice.filter_alarm_filter_band;
		}

		// --- ADSR Node alarm_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_alarm_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.002000000)) > 0 do envelope = voice.adsr_alarm_amp_attack_start + (1.0 - voice.adsr_alarm_amp_attack_start) * (voice.age / math.max(f32(f32(0.002000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_alarm_amp_release_level = envelope;
				if voice.age >= (f32(0.002000000)) {
					voice.adsr_alarm_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.002000000));
				if (p.decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.decay), 0.000001)) * (1.0 - (p.sustain)); else do envelope = (p.sustain);
				voice.adsr_alarm_amp_release_level = envelope;
				if time_in_decay >= (p.decay) {
					voice.adsr_alarm_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.sustain);
				voice.adsr_alarm_amp_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.040000000)) > 0 do envelope = voice.adsr_alarm_amp_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.040000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_alarm_amp_stage = .Idle;
				}
			}
			vel_scale_alarm_amp: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_alarm_amp_out = ((node_alarm_filter_out)) * envelope * (f32(1.000000000)) * vel_scale_alarm_amp;
		}

		// --- Distortion Node alarm_grit (classic) ---
		{
			dist_in_alarm_grit: f32 = ((node_alarm_amp_out));
			dist_k_alarm_grit: f32 = math.max(f32(p.drive), 1.0);
			dist_wet_alarm_grit: f32 = (f32(math.PI) + dist_k_alarm_grit) * dist_in_alarm_grit / (f32(math.PI) + dist_k_alarm_grit * abs(dist_in_alarm_grit));
			tone_k_alarm_grit: f32 = math.clamp(2.0 * f32(math.PI) * math.clamp(f32(f32(3800.000000000)), 100.0, 20000.0) / sample_rate, 0.001, 1.0);
			voice.dist_alarm_grit_tone += tone_k_alarm_grit * (dist_wet_alarm_grit - voice.dist_alarm_grit_tone);
			mix_alarm_grit: f32 = math.clamp(f32(p.Grit_mix), 0.0, 1.0);
			node_alarm_grit_out = dist_in_alarm_grit * (1.0 - mix_alarm_grit) + voice.dist_alarm_grit_tone * mix_alarm_grit;
		}

		node_alarm_grit_out_vsum += node_alarm_grit_out
		if voice.adsr_alarm_amp_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}

	// --- Bus effects (once per sample, post voice sum) ---
	{
		node_alarm_grit_out := node_alarm_grit_out_vsum
		node_alarm_panic_out: f32 = 0.0
		// --- Delay Node alarm_panic ---
		{
			delay_samples_alarm_panic := int(math.clamp((((60.0 / p.bpm) * 0.500000000)) * sample_rate, 1, 96000-1));
			read_index_alarm_panic := (p.delay_alarm_panic_write_index - delay_samples_alarm_panic + len(p.delay_alarm_panic_buffer)) % len(p.delay_alarm_panic_buffer);
			delayed_sample_alarm_panic := p.delay_alarm_panic_buffer[read_index_alarm_panic];
			p.delay_alarm_panic_buffer[p.delay_alarm_panic_write_index] = ((node_alarm_grit_out)) + delayed_sample_alarm_panic * math.clamp(f32(p.feedback), 0.0, 0.95);
			p.delay_alarm_panic_write_index = (p.delay_alarm_panic_write_index + 1) % len(p.delay_alarm_panic_buffer);
			node_alarm_panic_out = ((node_alarm_grit_out)) * (1.0 - (p.Panic_Echo_mix)) + delayed_sample_alarm_panic * (p.Panic_Echo_mix);
		}

		output_left += node_alarm_panic_out
		output_right += node_alarm_panic_out
	}

	// B7-2-followup / SKB-016: a baked worst-case constant here held
	// is_playing true for minutes on real content (every exposed tail param
	// contributed its range maximum, so glassy-fm-pluck alone baked 202.5s
	// for a true tail under 2s). Arm on the FALLING EDGE instead, from the
	// live field values — that is one ln/pow per note-off rather than per
	// sample, which is what keeps this proc off the audio path.
	{
		voice_alive := false
		for i in 0..<4 {
			if p.voices[i].active {
				voice_alive = true
				break
			}
		}
		if voice_alive || p.playing {
			p.bus_tail_armed = false
			p.bus_tail_remaining = 0
		} else if !p.bus_tail_armed {
			p.bus_tail_armed = true
			p.bus_tail_remaining = u64(GW_Disruptor_Alarm_bus_tail_seconds(p) * sample_rate)
		} else if p.bus_tail_remaining > 0 {
			p.bus_tail_remaining -= 1
		}
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
GW_Disruptor_Alarm_process_sequence :: proc(p: ^GW_Disruptor_Alarm_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "GW Disruptor Alarm" (16 steps)
		switch p.current_step % 16 {
		case 0:
			GW_Disruptor_Alarm_note_on(p, 64, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 2:
			GW_Disruptor_Alarm_note_on(p, 65, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 4:
			GW_Disruptor_Alarm_note_on(p, 64, 0.850000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 6:
			GW_Disruptor_Alarm_note_on(p, 65, 0.850000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			GW_Disruptor_Alarm_note_on(p, 64, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 10:
			GW_Disruptor_Alarm_note_on(p, 65, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			GW_Disruptor_Alarm_note_on(p, 64, 0.850000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 13:
			if next_float32(&p.prng) <= 0.699999988 {
				GW_Disruptor_Alarm_note_on(p, 64, 0.600000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
			}
		case 14:
			GW_Disruptor_Alarm_note_on(p, 65, 0.949999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 15:
			if next_float32(&p.prng) <= 0.699999988 {
				GW_Disruptor_Alarm_note_on(p, 65, 0.600000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
			}
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	GW_Disruptor_Alarm: ^GW_Disruptor_Alarm_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.750000000
	p.GW_Disruptor_Alarm = new(GW_Disruptor_Alarm_Processor)
	GW_Disruptor_Alarm_init(p.GW_Disruptor_Alarm, sr)
	GW_Disruptor_Alarm_start(p.GW_Disruptor_Alarm)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := GW_Disruptor_Alarm_process(p.GW_Disruptor_Alarm); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.GW_Disruptor_Alarm)
}

