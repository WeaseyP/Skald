Snare_set_param :: proc(p: ^Snare_Processor, name: string, value: f32) -> bool {
	switch name {
	case "Rattle_attack", "snare-rattle-envelope::attack":
		Snare_set_Rattle_attack(p, value)
		return true
	case "Rattle_decay", "snare-rattle-envelope::decay":
		Snare_set_Rattle_decay(p, value)
		return true
	case "Rattle_depth", "snare-rattle-envelope::depth":
		Snare_set_Rattle_depth(p, value)
		return true
	case "Rattle_release", "snare-rattle-envelope::release":
		Snare_set_Rattle_release(p, value)
		return true
	case "Rattle_sustain", "snare-rattle-envelope::sustain":
		Snare_set_Rattle_sustain(p, value)
		return true
	case "Thump_Oscillator_amplitude", "snare-oscillator::amplitude":
		Snare_set_Thump_Oscillator_amplitude(p, value)
		return true
	case "Thump_attack", "snare-thump-envelope::attack":
		Snare_set_Thump_attack(p, value)
		return true
	case "Thump_decay", "snare-thump-envelope::decay":
		Snare_set_Thump_decay(p, value)
		return true
	case "Thump_depth", "snare-thump-envelope::depth":
		Snare_set_Thump_depth(p, value)
		return true
	case "Thump_release", "snare-thump-envelope::release":
		Snare_set_Thump_release(p, value)
		return true
	case "Thump_sustain", "snare-thump-envelope::sustain":
		Snare_set_Thump_sustain(p, value)
		return true
	case "White_Noise_amplitude", "snare-noise::amplitude":
		Snare_set_White_Noise_amplitude(p, value)
		return true
	case "cutoff", "snare-highpass::cutoff":
		Snare_set_cutoff(p, value)
		return true
	case "frequency", "snare-oscillator::frequency":
		Snare_set_frequency(p, value)
		return true
	case "phase", "snare-oscillator::phase":
		Snare_set_phase(p, value)
		return true
	case "pulseWidth", "snare-oscillator::pulseWidth":
		Snare_set_pulseWidth(p, value)
		return true
	case "resonance", "snare-highpass::resonance":
		Snare_set_resonance(p, value)
		return true
	}
	return false
}

Snare_get_param :: proc(p: ^Snare_Processor, name: string) -> (f32, bool) {
	switch name {
	case "Rattle_attack", "snare-rattle-envelope::attack":
		return p.Rattle_attack, true
	case "Rattle_decay", "snare-rattle-envelope::decay":
		return p.Rattle_decay, true
	case "Rattle_depth", "snare-rattle-envelope::depth":
		return p.Rattle_depth, true
	case "Rattle_release", "snare-rattle-envelope::release":
		return p.Rattle_release, true
	case "Rattle_sustain", "snare-rattle-envelope::sustain":
		return p.Rattle_sustain, true
	case "Thump_Oscillator_amplitude", "snare-oscillator::amplitude":
		return p.Thump_Oscillator_amplitude, true
	case "Thump_attack", "snare-thump-envelope::attack":
		return p.Thump_attack, true
	case "Thump_decay", "snare-thump-envelope::decay":
		return p.Thump_decay, true
	case "Thump_depth", "snare-thump-envelope::depth":
		return p.Thump_depth, true
	case "Thump_release", "snare-thump-envelope::release":
		return p.Thump_release, true
	case "Thump_sustain", "snare-thump-envelope::sustain":
		return p.Thump_sustain, true
	case "White_Noise_amplitude", "snare-noise::amplitude":
		return p.White_Noise_amplitude, true
	case "cutoff", "snare-highpass::cutoff":
		return p.cutoff, true
	case "frequency", "snare-oscillator::frequency":
		return p.frequency, true
	case "phase", "snare-oscillator::phase":
		return p.phase, true
	case "pulseWidth", "snare-oscillator::pulseWidth":
		return p.pulseWidth, true
	case "resonance", "snare-highpass::resonance":
		return p.resonance, true
	}
	return 0.0, false
}

Snare_process :: proc(p: ^Snare_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	Snare_process_sequence(p)
	p.total_samples += 1

	for v_idx in 0..<8 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.current_freq != voice.target_freq {
			glide_k := 1.0 / math.max(voice.glide_time * sample_rate, 1.0)
			if glide_k > 1.0 do glide_k = 1.0
			voice.current_freq += (voice.target_freq - voice.current_freq) * glide_k
			if abs(voice.target_freq - voice.current_freq) < 0.1 do voice.current_freq = voice.target_freq
		}
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_snare_rattle_envelope_stage != .Release && voice.adsr_snare_rattle_envelope_stage != .Idle {
				voice.adsr_snare_rattle_envelope_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_snare_thump_envelope_stage != .Release && voice.adsr_snare_thump_envelope_stage != .Idle {
				voice.adsr_snare_thump_envelope_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_snare_highpass_out: f32 = 0.0
		node_snare_mixer_out: f32 = 0.0
		node_snare_noise_out: f32 = 0.0
		node_snare_oscillator_out: f32 = 0.0
		node_snare_output_out: f32 = 0.0
		node_snare_rattle_envelope_out: f32 = 0.0
		node_snare_thump_envelope_out: f32 = 0.0

		// --- Noise Node snare_noise ---
		node_snare_noise_out = (next_float32(&voice.noise_snare_noise_rng) * 2.0 - 1.0) * (p.White_Noise_amplitude);

		// --- Oscillator Node snare_oscillator (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (5.000000000);
				detuned_freq: f32 = (p.frequency) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(p.phase) * (f32(math.PI) / 180.0);
				voice.osc_snare_oscillator_phase[i] = math.mod(voice.osc_snare_oscillator_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_snare_oscillator_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += math.sin(final_phase);
			}
			node_snare_oscillator_out = (unison_out / f32(unison_count)) * (p.Thump_Oscillator_amplitude);
		}

		// --- Filter Node snare_highpass (SVF) ---
		{
			cutoff_c_snare_highpass: f32 = math.clamp(f32(p.cutoff), 10.0, sample_rate * 0.16);
			f_snare_highpass := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_snare_highpass / sample_rate));
			q_snare_highpass: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_snare_highpass);
			voice.filter_snare_highpass_low += f_snare_highpass * voice.filter_snare_highpass_band;
			high_snare_highpass := f32(((node_snare_noise_out)) - voice.filter_snare_highpass_low - q_snare_highpass * voice.filter_snare_highpass_band);
			voice.filter_snare_highpass_band += f_snare_highpass * high_snare_highpass;
			node_snare_highpass_out = high_snare_highpass;
		}

		// --- ADSR Node snare_thump_envelope ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_snare_thump_envelope_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Thump_attack) > 0 do envelope = voice.adsr_snare_thump_envelope_attack_start + (1.0 - voice.adsr_snare_thump_envelope_attack_start) * (voice.age / math.max(f32(p.Thump_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_snare_thump_envelope_release_level = envelope;
				if voice.age >= (p.Thump_attack) {
					voice.adsr_snare_thump_envelope_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Thump_attack);
				if (p.Thump_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Thump_decay), 0.000001)) * (1.0 - (p.Thump_sustain)); else do envelope = (p.Thump_sustain);
				voice.adsr_snare_thump_envelope_release_level = envelope;
				if time_in_decay >= (p.Thump_decay) {
					voice.adsr_snare_thump_envelope_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Thump_sustain);
				voice.adsr_snare_thump_envelope_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_snare_thump_envelope_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Thump_release) > 0 do envelope = voice.adsr_snare_thump_envelope_release_level * (1.0 - (time_in_release / math.max(f32(p.Thump_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_snare_thump_envelope_stage = .Idle;
				}
			}
			vel_scale_snare_thump_envelope: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_snare_thump_envelope_out = ((node_snare_oscillator_out)) * envelope * (p.Thump_depth) * vel_scale_snare_thump_envelope;
		}

		// --- ADSR Node snare_rattle_envelope ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_snare_rattle_envelope_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Rattle_attack) > 0 do envelope = voice.adsr_snare_rattle_envelope_attack_start + (1.0 - voice.adsr_snare_rattle_envelope_attack_start) * (voice.age / math.max(f32(p.Rattle_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_snare_rattle_envelope_release_level = envelope;
				if voice.age >= (p.Rattle_attack) {
					voice.adsr_snare_rattle_envelope_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Rattle_attack);
				if (p.Rattle_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Rattle_decay), 0.000001)) * (1.0 - (p.Rattle_sustain)); else do envelope = (p.Rattle_sustain);
				voice.adsr_snare_rattle_envelope_release_level = envelope;
				if time_in_decay >= (p.Rattle_decay) {
					voice.adsr_snare_rattle_envelope_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Rattle_sustain);
				voice.adsr_snare_rattle_envelope_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_snare_rattle_envelope_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Rattle_release) > 0 do envelope = voice.adsr_snare_rattle_envelope_release_level * (1.0 - (time_in_release / math.max(f32(p.Rattle_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_snare_rattle_envelope_stage = .Idle;
				}
			}
			vel_scale_snare_rattle_envelope: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_snare_rattle_envelope_out = ((node_snare_highpass_out)) * envelope * (p.Rattle_depth) * vel_scale_snare_rattle_envelope;
		}

		// --- Mixer Node snare_mixer (2 inputs) ---
		{
			mix_sum_snare_mixer: f32 = 0.0;
			mix_sum_snare_mixer += node_snare_rattle_envelope_out * (f32(0.800000012));
			mix_sum_snare_mixer += node_snare_thump_envelope_out * (f32(0.600000024));
		node_snare_mixer_out = mix_sum_snare_mixer;
		}

		output_left += node_snare_mixer_out
		output_right += node_snare_mixer_out
		if voice.adsr_snare_rattle_envelope_stage != .Idle do voice_busy = true
		if voice.adsr_snare_thump_envelope_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
Snare_process_sequence :: proc(p: ^Snare_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "Snare" (16 steps)
		switch p.current_step % 16 {
		case 4:
			Snare_note_on(p, 38, 1.000000000, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			Snare_note_on(p, 38, 0.949999988, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	Snare: ^Snare_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.800000012
	p.Snare = new(Snare_Processor)
	Snare_init(p.Snare, sr)
	Snare_start(p.Snare)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := Snare_process(p.Snare); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.Snare)
}

