		return true
	case "Thump_Env_decay", "pm-thump-env::decay":
		Palm_Mute_Electric_set_Thump_Env_decay(p, value)
		return true
	case "Thump_Env_depth", "pm-thump-env::depth":
		Palm_Mute_Electric_set_Thump_Env_depth(p, value)
		return true
	case "Thump_Env_release", "pm-thump-env::release":
		Palm_Mute_Electric_set_Thump_Env_release(p, value)
		return true
	case "Thump_Env_sustain", "pm-thump-env::sustain":
		Palm_Mute_Electric_set_Thump_Env_sustain(p, value)
		return true
	case "drive", "pm-drive::drive":
