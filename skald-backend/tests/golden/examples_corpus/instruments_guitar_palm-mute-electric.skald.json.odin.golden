		return p.Thump_Env_release, true
	case "Thump_Env_sustain", "pm-thump-env::sustain":
		return p.Thump_Env_sustain, true
	case "drive", "pm-drive::drive":
		return p.drive, true
	case "mix", "pm-drive::mix":
		return p.mix, true
	case "outMax", "pm-chug-map::outMax":
		return p.outMax, true
	case "tone", "pm-drive::tone":
		return p.tone, true
	case "velocitySensitivity", "pm-amp::velocitySensitivity":
