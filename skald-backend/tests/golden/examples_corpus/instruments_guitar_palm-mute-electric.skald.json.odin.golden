	if v > 20000.000000000 do v = 20000.000000000
	p.Palm_Damp_cutoff = v
}

Palm_Mute_Electric_set_Palm_Damp_resonance :: proc(p: ^Palm_Mute_Electric_Processor, value: f32) {
	v := value
