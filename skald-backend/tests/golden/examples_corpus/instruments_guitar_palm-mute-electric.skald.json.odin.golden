	}
	return 0.0, false
}

Palm_Mute_Electric_process :: proc(p: ^Palm_Mute_Electric_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	Palm_Mute_Electric_process_sequence(p)
	p.total_samples += 1

	for v_idx in 0..<4 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_pm_amp_stage != .Release && voice.adsr_pm_amp_stage != .Idle {
				voice.adsr_pm_amp_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_pm_chug_env_stage != .Release && voice.adsr_pm_chug_env_stage != .Idle {
				voice.adsr_pm_chug_env_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_pm_thump_env_stage != .Release && voice.adsr_pm_thump_env_stage != .Idle {
				voice.adsr_pm_thump_env_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_pm_amp_out: f32 = 0.0
		node_pm_chug_env_out: f32 = 0.0
		node_pm_chug_map_out: f32 = 0.0
		node_pm_drive_out: f32 = 0.0
		node_pm_mute_filter_out: f32 = 0.0
		node_pm_output_out: f32 = 0.0
		node_pm_string_out: f32 = 0.0
		node_pm_thump_bp_out: f32 = 0.0
		node_pm_thump_env_out: f32 = 0.0
		node_pm_thump_noise_out: f32 = 0.0

		// --- ADSR Node pm_chug_env ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_pm_chug_env_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Chug_Env_attack) > 0 do envelope = voice.adsr_pm_chug_env_attack_start + (1.0 - voice.adsr_pm_chug_env_attack_start) * (voice.age / math.max(f32(p.Chug_Env_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_pm_chug_env_release_level = envelope;
				if voice.age >= (p.Chug_Env_attack) {
					voice.adsr_pm_chug_env_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Chug_Env_attack);
				if (p.Chug_Env_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Chug_Env_decay), 0.000001)) * (1.0 - (p.Chug_Env_sustain)); else do envelope = (p.Chug_Env_sustain);
				voice.adsr_pm_chug_env_release_level = envelope;
				if time_in_decay >= (p.Chug_Env_decay) {
					voice.adsr_pm_chug_env_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Chug_Env_sustain);
				voice.adsr_pm_chug_env_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Chug_Env_release) > 0 do envelope = voice.adsr_pm_chug_env_release_level * (1.0 - (time_in_release / math.max(f32(p.Chug_Env_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_pm_chug_env_stage = .Idle;
				}
			}
			vel_scale_pm_chug_env: f32 = (1.0 - (f32(0.700000000))) + (f32(0.700000000)) * voice.velocity;
			node_pm_chug_env_out = (1.0) * envelope * (p.Chug_Env_depth) * vel_scale_pm_chug_env;
		}

		// --- Oscillator Node pm_string (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_pm_string_phase[i] = math.mod(voice.osc_pm_string_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_pm_string_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += ((final_phase / f32(math.PI)) - 1.0);
			}
			node_pm_string_out = (unison_out / f32(unison_count)) * (p.String_amplitude);
		}

		// --- Noise Node pm_thump_noise ---
		node_pm_thump_noise_out = (next_float32(&voice.noise_pm_thump_noise_rng) * 2.0 - 1.0) * (p.Palm_Thump_amplitude);

		// --- Mapper Node pm_chug_map ---
		{
			in_range_pm_chug_map: f32 = f32(f32(1.000000000)) - f32(f32(0.000000000));
			if in_range_pm_chug_map == 0.0 do in_range_pm_chug_map = 1.0;
			node_pm_chug_map_out = math.lerp(f32(f32(0.000000000)), f32(p.outMax), math.clamp((f32((node_pm_chug_env_out)) - f32(f32(0.000000000))) / in_range_pm_chug_map, 0.0, 1.0));
		}

		// --- Filter Node pm_thump_bp (SVF) ---
		{
			cutoff_c_pm_thump_bp: f32 = math.clamp(f32(p.Thump_Body_cutoff), 10.0, sample_rate * 0.16);
			f_pm_thump_bp := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_pm_thump_bp / sample_rate));
			q_pm_thump_bp: f32 = math.clamp(1.0 / math.max(f32(p.Thump_Body_resonance), 0.1), 0.05, 1.9 - f_pm_thump_bp);
			voice.filter_pm_thump_bp_low += f_pm_thump_bp * voice.filter_pm_thump_bp_band;
			high_pm_thump_bp := f32(((node_pm_thump_noise_out)) - voice.filter_pm_thump_bp_low - q_pm_thump_bp * voice.filter_pm_thump_bp_band);
			voice.filter_pm_thump_bp_band += f_pm_thump_bp * high_pm_thump_bp;
			node_pm_thump_bp_out = voice.filter_pm_thump_bp_band;
		}

		// --- Filter Node pm_mute_filter (SVF) ---
		{
			cutoff_c_pm_mute_filter: f32 = math.clamp(f32((p.Palm_Damp_cutoff) + (node_pm_chug_map_out)), 10.0, sample_rate * 0.16);
			f_pm_mute_filter := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_pm_mute_filter / sample_rate));
			q_pm_mute_filter: f32 = math.clamp(1.0 / math.max(f32(p.Palm_Damp_resonance), 0.1), 0.05, 1.9 - f_pm_mute_filter);
			voice.filter_pm_mute_filter_low += f_pm_mute_filter * voice.filter_pm_mute_filter_band;
			high_pm_mute_filter := f32(((node_pm_string_out)) - voice.filter_pm_mute_filter_low - q_pm_mute_filter * voice.filter_pm_mute_filter_band);
			voice.filter_pm_mute_filter_band += f_pm_mute_filter * high_pm_mute_filter;
			node_pm_mute_filter_out = voice.filter_pm_mute_filter_low;
		}

		// --- ADSR Node pm_thump_env ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_pm_thump_env_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Thump_Env_attack) > 0 do envelope = voice.adsr_pm_thump_env_attack_start + (1.0 - voice.adsr_pm_thump_env_attack_start) * (voice.age / math.max(f32(p.Thump_Env_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_pm_thump_env_release_level = envelope;
				if voice.age >= (p.Thump_Env_attack) {
					voice.adsr_pm_thump_env_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Thump_Env_attack);
				if (p.Thump_Env_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Thump_Env_decay), 0.000001)) * (1.0 - (p.Thump_Env_sustain)); else do envelope = (p.Thump_Env_sustain);
				voice.adsr_pm_thump_env_release_level = envelope;
				if time_in_decay >= (p.Thump_Env_decay) {
					voice.adsr_pm_thump_env_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Thump_Env_sustain);
				voice.adsr_pm_thump_env_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Thump_Env_release) > 0 do envelope = voice.adsr_pm_thump_env_release_level * (1.0 - (time_in_release / math.max(f32(p.Thump_Env_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_pm_thump_env_stage = .Idle;
				}
			}
			vel_scale_pm_thump_env: f32 = (1.0 - (f32(0.800000000))) + (f32(0.800000000)) * voice.velocity;
			node_pm_thump_env_out = ((node_pm_thump_bp_out)) * envelope * (p.Thump_Env_depth) * vel_scale_pm_thump_env;
		}

		// --- Distortion Node pm_drive (classic) ---
		{
			dist_in_pm_drive: f32 = ((node_pm_mute_filter_out + node_pm_thump_env_out));
			dist_k_pm_drive: f32 = math.max(f32(p.drive), 1.0);
			dist_wet_pm_drive: f32 = (f32(math.PI) + dist_k_pm_drive) * dist_in_pm_drive / (f32(math.PI) + dist_k_pm_drive * abs(dist_in_pm_drive));
			tone_k_pm_drive: f32 = math.clamp(2.0 * f32(math.PI) * math.clamp(f32(p.tone), 100.0, 20000.0) / sample_rate, 0.001, 1.0);
			voice.dist_pm_drive_tone += tone_k_pm_drive * (dist_wet_pm_drive - voice.dist_pm_drive_tone);
			mix_pm_drive: f32 = math.clamp(f32(p.mix), 0.0, 1.0);
			node_pm_drive_out = dist_in_pm_drive * (1.0 - mix_pm_drive) + voice.dist_pm_drive_tone * mix_pm_drive;
		}

		// --- ADSR Node pm_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_pm_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Amp_attack) > 0 do envelope = voice.adsr_pm_amp_attack_start + (1.0 - voice.adsr_pm_amp_attack_start) * (voice.age / math.max(f32(p.Amp_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_pm_amp_release_level = envelope;
				if voice.age >= (p.Amp_attack) {
					voice.adsr_pm_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Amp_attack);
				if (p.Amp_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Amp_decay), 0.000001)) * (1.0 - (p.Amp_sustain)); else do envelope = (p.Amp_sustain);
				voice.adsr_pm_amp_release_level = envelope;
				if time_in_decay >= (p.Amp_decay) {
					voice.adsr_pm_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Amp_sustain);
				voice.adsr_pm_amp_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Amp_release) > 0 do envelope = voice.adsr_pm_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.Amp_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_pm_amp_stage = .Idle;
				}
			}
			vel_scale_pm_amp: f32 = (1.0 - (p.velocitySensitivity)) + (p.velocitySensitivity) * voice.velocity;
			node_pm_amp_out = ((node_pm_drive_out)) * envelope * (p.Amp_depth) * vel_scale_pm_amp;
		}

		output_left += node_pm_amp_out
		output_right += node_pm_amp_out
		if voice.adsr_pm_amp_stage != .Idle do voice_busy = true
		if voice.adsr_pm_chug_env_stage != .Idle do voice_busy = true
		if voice.adsr_pm_thump_env_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
Palm_Mute_Electric_process_sequence :: proc(p: ^Palm_Mute_Electric_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "Palm Mute Electric" (16 steps)
		switch p.current_step % 16 {
		case 0:
			Palm_Mute_Electric_note_on(p, 40, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 2:
			Palm_Mute_Electric_note_on(p, 40, 0.620000005, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 4:
			Palm_Mute_Electric_note_on(p, 40, 0.850000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 6:
			Palm_Mute_Electric_note_on(p, 43, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			Palm_Mute_Electric_note_on(p, 40, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 10:
			Palm_Mute_Electric_note_on(p, 40, 0.620000005, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			Palm_Mute_Electric_note_on(p, 45, 0.850000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 14:
			Palm_Mute_Electric_note_on(p, 43, 0.720000029, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	Palm_Mute_Electric: ^Palm_Mute_Electric_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.779999971
	p.Palm_Mute_Electric = new(Palm_Mute_Electric_Processor)
	Palm_Mute_Electric_init(p.Palm_Mute_Electric, sr)
	Palm_Mute_Electric_start(p.Palm_Mute_Electric)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := Palm_Mute_Electric_process(p.Palm_Mute_Electric); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.Palm_Mute_Electric)
}

