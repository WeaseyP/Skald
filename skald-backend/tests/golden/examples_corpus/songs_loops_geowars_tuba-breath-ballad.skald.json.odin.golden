	case "Vibrato_amplitude", "ballad-vibrato::amplitude":
		GW_Tuba_Breath_Ballad_set_Vibrato_amplitude(p, value)
		return true
	case "Warm_Body_cutoff", "ballad-body::cutoff":
		GW_Tuba_Breath_Ballad_set_Warm_Body_cutoff(p, value)
		return true
	case "attack", "ballad-amp::attack":
		GW_Tuba_Breath_Ballad_set_attack(p, value)
		return true
	case "decay", "ballad-reverb::decay":
		GW_Tuba_Breath_Ballad_set_decay(p, value)
		return true
	case "frequency", "ballad-vibrato::frequency":
		GW_Tuba_Breath_Ballad_set_frequency(p, value)
		return true
	case "mix", "ballad-reverb::mix":
		GW_Tuba_Breath_Ballad_set_mix(p, value)
		return true
	case "release", "ballad-amp::release":
		GW_Tuba_Breath_Ballad_set_release(p, value)
		return true
	case "resonance", "ballad-body::resonance":
		GW_Tuba_Breath_Ballad_set_resonance(p, value)
		return true
	case "sustain", "ballad-puff::sustain":
		GW_Tuba_Breath_Ballad_set_sustain(p, value)
		return true
	}
	return false
}

GW_Tuba_Breath_Ballad_get_param :: proc(p: ^GW_Tuba_Breath_Ballad_Processor, name: string) -> (f32, bool) {
	switch name {
	case "Air_cutoff", "ballad-air::cutoff":
		return p.Air_cutoff, true
	case "Breath_amplitude", "ballad-breath::amplitude":
		return p.Breath_amplitude, true
	case "Soft_Reed_amplitude", "ballad-osc::amplitude":
		return p.Soft_Reed_amplitude, true
	case "Vibrato_amplitude", "ballad-vibrato::amplitude":
		return p.Vibrato_amplitude, true
	case "Warm_Body_cutoff", "ballad-body::cutoff":
		return p.Warm_Body_cutoff, true
	case "attack", "ballad-amp::attack":
		return p.attack, true
	case "decay", "ballad-reverb::decay":
		return p.decay, true
	case "frequency", "ballad-vibrato::frequency":
		return p.frequency, true
	case "mix", "ballad-reverb::mix":
		return p.mix, true
	case "release", "ballad-amp::release":
		return p.release, true
	case "resonance", "ballad-body::resonance":
		return p.resonance, true
	case "sustain", "ballad-puff::sustain":
		return p.sustain, true
	}
	return 0.0, false
}

GW_Tuba_Breath_Ballad_process :: proc(p: ^GW_Tuba_Breath_Ballad_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	GW_Tuba_Breath_Ballad_process_sequence(p)
	p.total_samples += 1

	node_ballad_amp_out_vsum: f32 = 0.0
	for v_idx in 0..<3 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.current_freq != voice.target_freq {
			glide_k := 1.0 / math.max(voice.glide_time * sample_rate, 1.0)
			if glide_k > 1.0 do glide_k = 1.0
			voice.current_freq += (voice.target_freq - voice.current_freq) * glide_k
			if abs(voice.target_freq - voice.current_freq) < 0.1 do voice.current_freq = voice.target_freq
		}
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_ballad_amp_stage != .Release && voice.adsr_ballad_amp_stage != .Idle {
				voice.adsr_ballad_amp_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_ballad_puff_stage != .Release && voice.adsr_ballad_puff_stage != .Idle {
				voice.adsr_ballad_puff_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_ballad_air_out: f32 = 0.0
		node_ballad_amp_out: f32 = 0.0
		node_ballad_body_out: f32 = 0.0
		node_ballad_breath_out: f32 = 0.0
		node_ballad_mixer_out: f32 = 0.0
		node_ballad_osc_out: f32 = 0.0
		node_ballad_puff_out: f32 = 0.0
		node_ballad_vibrato_out: f32 = 0.0

		// --- Noise Node ballad_breath ---
		{
			white_ballad_breath := next_float32(&voice.noise_ballad_breath_rng) * 2.0 - 1.0;
			voice.noise_ballad_breath_p0 = 0.99765 * voice.noise_ballad_breath_p0 + white_ballad_breath * 0.0990460;
			voice.noise_ballad_breath_p1 = 0.96300 * voice.noise_ballad_breath_p1 + white_ballad_breath * 0.2965164;
			voice.noise_ballad_breath_p2 = 0.57000 * voice.noise_ballad_breath_p2 + white_ballad_breath * 1.0526913;
			node_ballad_breath_out = (voice.noise_ballad_breath_p0 + voice.noise_ballad_breath_p1 + voice.noise_ballad_breath_p2 + white_ballad_breath * 0.1848) * 0.25 * (p.Breath_amplitude);
		}

		// --- LFO Node ballad_vibrato ---
		voice.lfo_ballad_vibrato_phase = math.mod(voice.lfo_ballad_vibrato_phase + (2 * f32(math.PI) * (p.frequency) / sample_rate), 2 * f32(math.PI));
		if voice.lfo_ballad_vibrato_phase < 0.0 do voice.lfo_ballad_vibrato_phase += 2 * f32(math.PI);
		node_ballad_vibrato_out = math.sin(voice.lfo_ballad_vibrato_phase) * (p.Vibrato_amplitude);

		// --- Filter Node ballad_air (SVF) ---
		{
			cutoff_c_ballad_air: f32 = math.clamp(f32(p.Air_cutoff), 10.0, sample_rate * 0.16);
			f_ballad_air := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_ballad_air / sample_rate));
			q_ballad_air: f32 = math.clamp(1.0 / math.max(f32(f32(1.000000000)), 0.1), 0.05, 1.9 - f_ballad_air);
			voice.filter_ballad_air_low += f_ballad_air * voice.filter_ballad_air_band;
			high_ballad_air := f32(((node_ballad_breath_out)) - voice.filter_ballad_air_low - q_ballad_air * voice.filter_ballad_air_band);
			voice.filter_ballad_air_band += f_ballad_air * high_ballad_air;
			node_ballad_air_out = voice.filter_ballad_air_band;
		}

		// --- Oscillator Node ballad_osc (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = ((voice.current_freq) * math.pow(2.0, math.clamp(f32(node_ballad_vibrato_out), -10.0, 10.0))) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_ballad_osc_phase[i] = math.mod(voice.osc_ballad_osc_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_ballad_osc_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += ((final_phase / f32(math.PI)) - 1.0);
			}
			node_ballad_osc_out = (unison_out / f32(unison_count)) * (p.Soft_Reed_amplitude);
		}

		// --- ADSR Node ballad_puff ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_ballad_puff_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.100000000)) > 0 do envelope = voice.adsr_ballad_puff_attack_start + (1.0 - voice.adsr_ballad_puff_attack_start) * (voice.age / math.max(f32(f32(0.100000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_ballad_puff_release_level = envelope;
				if voice.age >= (f32(0.100000000)) {
					voice.adsr_ballad_puff_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.100000000));
				if (f32(0.200000000)) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(f32(0.200000000)), 0.000001)) * (1.0 - (p.sustain)); else do envelope = (p.sustain);
				voice.adsr_ballad_puff_release_level = envelope;
				if time_in_decay >= (f32(0.200000000)) {
					voice.adsr_ballad_puff_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.sustain);
				voice.adsr_ballad_puff_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.300000000)) > 0 do envelope = voice.adsr_ballad_puff_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.300000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_ballad_puff_stage = .Idle;
				}
			}
			vel_scale_ballad_puff: f32 = (1.0 - (f32(0.400000000))) + (f32(0.400000000)) * voice.velocity;
			node_ballad_puff_out = ((node_ballad_air_out)) * envelope * (f32(1.000000000)) * vel_scale_ballad_puff;
		}

		// --- Filter Node ballad_body (SVF) ---
		{
			cutoff_c_ballad_body: f32 = math.clamp(f32(p.Warm_Body_cutoff), 10.0, sample_rate * 0.16);
			f_ballad_body := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_ballad_body / sample_rate));
			q_ballad_body: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_ballad_body);
			voice.filter_ballad_body_low += f_ballad_body * voice.filter_ballad_body_band;
			high_ballad_body := f32(((node_ballad_osc_out)) - voice.filter_ballad_body_low - q_ballad_body * voice.filter_ballad_body_band);
			voice.filter_ballad_body_band += f_ballad_body * high_ballad_body;
			node_ballad_body_out = voice.filter_ballad_body_low;
		}

		// --- Mixer Node ballad_mixer (2 inputs) ---
		{
			mix_sum_ballad_mixer: f32 = 0.0;
			mix_sum_ballad_mixer += node_ballad_body_out * (f32(0.899999976));
			mix_sum_ballad_mixer += node_ballad_puff_out * (f32(0.349999994));
		node_ballad_mixer_out = mix_sum_ballad_mixer;
		}

		// --- ADSR Node ballad_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_ballad_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.attack) > 0 do envelope = voice.adsr_ballad_amp_attack_start + (1.0 - voice.adsr_ballad_amp_attack_start) * (voice.age / math.max(f32(p.attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_ballad_amp_release_level = envelope;
				if voice.age >= (p.attack) {
					voice.adsr_ballad_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.attack);
				if (f32(0.200000000)) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(f32(0.200000000)), 0.000001)) * (1.0 - (f32(0.800000000))); else do envelope = (f32(0.800000000));
				voice.adsr_ballad_amp_release_level = envelope;
				if time_in_decay >= (f32(0.200000000)) {
					voice.adsr_ballad_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.800000000));
				voice.adsr_ballad_amp_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.release) > 0 do envelope = voice.adsr_ballad_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_ballad_amp_stage = .Idle;
				}
			}
			vel_scale_ballad_amp: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_ballad_amp_out = ((node_ballad_mixer_out)) * envelope * (f32(1.000000000)) * vel_scale_ballad_amp;
		}

		node_ballad_amp_out_vsum += node_ballad_amp_out
		if voice.adsr_ballad_amp_stage != .Idle do voice_busy = true
		if voice.adsr_ballad_puff_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}

	// --- Bus effects (once per sample, post voice sum) ---
	{
		node_ballad_amp_out := node_ballad_amp_out_vsum
		node_ballad_reverb_out: f32 = 0.0
		// --- Reverb Node ballad_reverb (pre-delay + feedback comb) ---
		{
			pre_delay_seconds_ballad_reverb: f32 = math.clamp(f32(f32(0.010000000)), 0.0, 0.25);
			pre_delay_samples_ballad_reverb := int(math.clamp(pre_delay_seconds_ballad_reverb * sample_rate, 0.0, f32(48000)));
			pre_write_index_ballad_reverb := p.delay_ballad_reverb_write_index % len(p.reverb_ballad_reverb_pre_buffer)
			pre_delayed_input_ballad_reverb := f32((node_ballad_amp_out))
			if pre_delay_samples_ballad_reverb > 0 {
				pre_read_index_ballad_reverb := (pre_write_index_ballad_reverb - pre_delay_samples_ballad_reverb + len(p.reverb_ballad_reverb_pre_buffer)) % len(p.reverb_ballad_reverb_pre_buffer)
				pre_delayed_input_ballad_reverb = p.reverb_ballad_reverb_pre_buffer[pre_read_index_ballad_reverb]
			}
			p.reverb_ballad_reverb_pre_buffer[pre_write_index_ballad_reverb] = f32((node_ballad_amp_out))
			delay_samples_ballad_reverb := int(math.clamp((0.075000000) * sample_rate, 0, 96000-1));
			read_index_ballad_reverb := (p.delay_ballad_reverb_write_index - delay_samples_ballad_reverb + len(p.delay_ballad_reverb_buffer)) % len(p.delay_ballad_reverb_buffer);
			delayed_sample_ballad_reverb := p.delay_ballad_reverb_buffer[read_index_ballad_reverb];
			decay_gain_ballad_reverb: f32 = math.clamp(math.pow(f32(0.001), f32(0.075000000) / math.max(f32(p.decay), 0.01)), 0.0, 0.95);
			p.delay_ballad_reverb_buffer[p.delay_ballad_reverb_write_index] = pre_delayed_input_ballad_reverb + delayed_sample_ballad_reverb * decay_gain_ballad_reverb;
			p.delay_ballad_reverb_write_index = (p.delay_ballad_reverb_write_index + 1) % len(p.delay_ballad_reverb_buffer);
			node_ballad_reverb_out = ((node_ballad_amp_out)) * (1.0 - (p.mix)) + delayed_sample_ballad_reverb * (p.mix);
		}

		output_left += node_ballad_reverb_out
		output_right += node_ballad_reverb_out
	}

	// B7-2-followup / SKB-016: a baked worst-case constant here held
	// is_playing true for minutes on real content (every exposed tail param
	// contributed its range maximum, so glassy-fm-pluck alone baked 202.5s
	// for a true tail under 2s). Arm on the FALLING EDGE instead, from the
	// live field values — that is one ln/pow per note-off rather than per
	// sample, which is what keeps this proc off the audio path.
	{
		voice_alive := false
		for i in 0..<3 {
			if p.voices[i].active {
				voice_alive = true
				break
			}
		}
		if voice_alive || p.playing {
			p.bus_tail_armed = false
			p.bus_tail_remaining = 0
		} else if !p.bus_tail_armed {
			p.bus_tail_armed = true
			p.bus_tail_remaining = u64(GW_Tuba_Breath_Ballad_bus_tail_seconds(p) * sample_rate)
		} else if p.bus_tail_remaining > 0 {
			p.bus_tail_remaining -= 1
		}
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
GW_Tuba_Breath_Ballad_process_sequence :: proc(p: ^GW_Tuba_Breath_Ballad_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "GW Tuba Breath Ballad" (16 steps)
		switch p.current_step % 16 {
		case 0:
			GW_Tuba_Breath_Ballad_note_on(p, 38, 0.800000012, f32(5.000000000) * (60.0 / p.bpm / 4.0))
		case 6:
			GW_Tuba_Breath_Ballad_note_on(p, 41, 0.699999988, f32(3.000000000) * (60.0 / p.bpm / 4.0))
		case 10:
			GW_Tuba_Breath_Ballad_note_on(p, 33, 0.750000000, f32(5.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	GW_Tuba_Breath_Ballad: ^GW_Tuba_Breath_Ballad_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.699999988
	p.GW_Tuba_Breath_Ballad = new(GW_Tuba_Breath_Ballad_Processor)
	GW_Tuba_Breath_Ballad_init(p.GW_Tuba_Breath_Ballad, sr)
	GW_Tuba_Breath_Ballad_start(p.GW_Tuba_Breath_Ballad)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := GW_Tuba_Breath_Ballad_process(p.GW_Tuba_Breath_Ballad); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.GW_Tuba_Breath_Ballad)
}

