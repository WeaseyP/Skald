		Clean_Electric_set_Pluck_Env_release(p, value)
		return true
	case "Pluck_Env_sustain", "cl-pluck-env::sustain":
		Clean_Electric_set_Pluck_Env_sustain(p, value)
		return true
	case "String_Edge_amplitude", "cl-edge::amplitude":
		Clean_Electric_set_String_Edge_amplitude(p, value)
		return true
	case "drive", "cl-amp-warmth::drive":
