SNES_Snare_set_param :: proc(p: ^SNES_Snare_Processor, name: string, value: f32) -> bool {
	switch name {
	case "Rattle_Env_decay", "snare-noise-env::decay":
		SNES_Snare_set_Rattle_Env_decay(p, value)
		return true
	case "Rattle_amplitude", "snare-noise::amplitude":
		SNES_Snare_set_Rattle_amplitude(p, value)
		return true
	case "SNES_Room_decay", "snare-room::decay":
		SNES_Snare_set_SNES_Room_decay(p, value)
		return true
	case "Shell_Env_decay", "snare-tone-env::decay":
		SNES_Snare_set_Shell_Env_decay(p, value)
		return true
	case "Shell_amplitude", "snare-tone-osc::amplitude":
		SNES_Snare_set_Shell_amplitude(p, value)
		return true
	case "cutoff", "snare-band::cutoff":
		SNES_Snare_set_cutoff(p, value)
		return true
	case "frequency", "snare-tone-osc::frequency":
		SNES_Snare_set_frequency(p, value)
		return true
	case "mix", "snare-room::mix":
		SNES_Snare_set_mix(p, value)
		return true
	case "resonance", "snare-band::resonance":
		SNES_Snare_set_resonance(p, value)
		return true
	}
	return false
}

SNES_Snare_get_param :: proc(p: ^SNES_Snare_Processor, name: string) -> (f32, bool) {
	switch name {
	case "Rattle_Env_decay", "snare-noise-env::decay":
		return p.Rattle_Env_decay, true
	case "Rattle_amplitude", "snare-noise::amplitude":
		return p.Rattle_amplitude, true
	case "SNES_Room_decay", "snare-room::decay":
		return p.SNES_Room_decay, true
	case "Shell_Env_decay", "snare-tone-env::decay":
		return p.Shell_Env_decay, true
	case "Shell_amplitude", "snare-tone-osc::amplitude":
		return p.Shell_amplitude, true
	case "cutoff", "snare-band::cutoff":
		return p.cutoff, true
	case "frequency", "snare-tone-osc::frequency":
		return p.frequency, true
	case "mix", "snare-room::mix":
		return p.mix, true
	case "resonance", "snare-band::resonance":
		return p.resonance, true
	}
	return 0.0, false
}

SNES_Snare_process :: proc(p: ^SNES_Snare_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	SNES_Snare_process_sequence(p)
	p.total_samples += 1

	node_snare_mix_out_vsum: f32 = 0.0
	for v_idx in 0..<3 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_snare_noise_env_stage != .Release && voice.adsr_snare_noise_env_stage != .Idle {
				voice.adsr_snare_noise_env_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_snare_tone_env_stage != .Release && voice.adsr_snare_tone_env_stage != .Idle {
				voice.adsr_snare_tone_env_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_snare_band_out: f32 = 0.0
		node_snare_mix_out: f32 = 0.0
		node_snare_noise_out: f32 = 0.0
		node_snare_noise_env_out: f32 = 0.0
		node_snare_tone_env_out: f32 = 0.0
		node_snare_tone_osc_out: f32 = 0.0

		// --- Noise Node snare_noise ---
		node_snare_noise_out = (next_float32(&voice.noise_snare_noise_rng) * 2.0 - 1.0) * (p.Rattle_amplitude);

		// --- Oscillator Node snare_tone_osc (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = (p.frequency) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_snare_tone_osc_phase[i] = math.mod(voice.osc_snare_tone_osc_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_snare_tone_osc_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += (2.0 / f32(math.PI)) * math.asin(math.sin(final_phase));
			}
			node_snare_tone_osc_out = (unison_out / f32(unison_count)) * (p.Shell_amplitude);
		}

		// --- Filter Node snare_band (SVF) ---
		{
			cutoff_c_snare_band: f32 = math.clamp(f32(p.cutoff), 10.0, sample_rate * 0.16);
			f_snare_band := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_snare_band / sample_rate));
			q_snare_band: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_snare_band);
			voice.filter_snare_band_low += f_snare_band * voice.filter_snare_band_band;
			high_snare_band := f32(((node_snare_noise_out)) - voice.filter_snare_band_low - q_snare_band * voice.filter_snare_band_band);
			voice.filter_snare_band_band += f_snare_band * high_snare_band;
			node_snare_band_out = voice.filter_snare_band_band;
		}

		// --- ADSR Node snare_tone_env ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_snare_tone_env_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.001000000)) > 0 do envelope = voice.adsr_snare_tone_env_attack_start + (1.0 - voice.adsr_snare_tone_env_attack_start) * (voice.age / math.max(f32(f32(0.001000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_snare_tone_env_release_level = envelope;
				if voice.age >= (f32(0.001000000)) {
					voice.adsr_snare_tone_env_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.001000000));
				if (p.Shell_Env_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Shell_Env_decay), 0.000001)) * (1.0 - (f32(0.000000000))); else do envelope = (f32(0.000000000));
				voice.adsr_snare_tone_env_release_level = envelope;
				if time_in_decay >= (p.Shell_Env_decay) {
					voice.adsr_snare_tone_env_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.000000000));
				voice.adsr_snare_tone_env_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.030000000)) > 0 do envelope = voice.adsr_snare_tone_env_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.030000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_snare_tone_env_stage = .Idle;
				}
			}
			vel_scale_snare_tone_env: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_snare_tone_env_out = ((node_snare_tone_osc_out)) * envelope * (f32(1.000000000)) * vel_scale_snare_tone_env;
		}

		// --- ADSR Node snare_noise_env ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_snare_noise_env_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.001000000)) > 0 do envelope = voice.adsr_snare_noise_env_attack_start + (1.0 - voice.adsr_snare_noise_env_attack_start) * (voice.age / math.max(f32(f32(0.001000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_snare_noise_env_release_level = envelope;
				if voice.age >= (f32(0.001000000)) {
					voice.adsr_snare_noise_env_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.001000000));
				if (p.Rattle_Env_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Rattle_Env_decay), 0.000001)) * (1.0 - (f32(0.000000000))); else do envelope = (f32(0.000000000));
				voice.adsr_snare_noise_env_release_level = envelope;
				if time_in_decay >= (p.Rattle_Env_decay) {
					voice.adsr_snare_noise_env_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.000000000));
				voice.adsr_snare_noise_env_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.050000000)) > 0 do envelope = voice.adsr_snare_noise_env_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.050000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_snare_noise_env_stage = .Idle;
				}
			}
			vel_scale_snare_noise_env: f32 = (1.0 - (f32(0.600000000))) + (f32(0.600000000)) * voice.velocity;
			node_snare_noise_env_out = ((node_snare_band_out)) * envelope * (f32(1.000000000)) * vel_scale_snare_noise_env;
		}

		// --- Mixer Node snare_mix (2 inputs) ---
		{
			mix_sum_snare_mix: f32 = 0.0;
			mix_sum_snare_mix += node_snare_noise_env_out * (f32(0.850000024));
			mix_sum_snare_mix += node_snare_tone_env_out * (f32(0.600000024));
		node_snare_mix_out = mix_sum_snare_mix;
		}

		node_snare_mix_out_vsum += node_snare_mix_out
		if voice.adsr_snare_noise_env_stage != .Idle do voice_busy = true
		if voice.adsr_snare_tone_env_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}

	// --- Bus effects (once per sample, post voice sum) ---
	{
		node_snare_mix_out := node_snare_mix_out_vsum
		node_snare_room_out: f32 = 0.0
		// --- Reverb Node snare_room (pre-delay + feedback comb) ---
		{
			pre_delay_seconds_snare_room: f32 = math.clamp(f32(f32(0.008000000)), 0.0, 0.25);
			pre_delay_samples_snare_room := int(math.clamp(pre_delay_seconds_snare_room * sample_rate, 0.0, f32(48000)));
			pre_write_index_snare_room := p.delay_snare_room_write_index % len(p.reverb_snare_room_pre_buffer)
			pre_delayed_input_snare_room := f32((node_snare_mix_out))
			if pre_delay_samples_snare_room > 0 {
				pre_read_index_snare_room := (pre_write_index_snare_room - pre_delay_samples_snare_room + len(p.reverb_snare_room_pre_buffer)) % len(p.reverb_snare_room_pre_buffer)
				pre_delayed_input_snare_room = p.reverb_snare_room_pre_buffer[pre_read_index_snare_room]
			}
			p.reverb_snare_room_pre_buffer[pre_write_index_snare_room] = f32((node_snare_mix_out))
			delay_samples_snare_room := int(math.clamp((0.075000000) * sample_rate, 0, 96000-1));
			read_index_snare_room := (p.delay_snare_room_write_index - delay_samples_snare_room + len(p.delay_snare_room_buffer)) % len(p.delay_snare_room_buffer);
			delayed_sample_snare_room := p.delay_snare_room_buffer[read_index_snare_room];
			decay_gain_snare_room: f32 = math.clamp(math.pow(f32(0.001), f32(0.075000000) / math.max(f32(p.SNES_Room_decay), 0.01)), 0.0, 0.95);
			p.delay_snare_room_buffer[p.delay_snare_room_write_index] = pre_delayed_input_snare_room + delayed_sample_snare_room * decay_gain_snare_room;
			p.delay_snare_room_write_index = (p.delay_snare_room_write_index + 1) % len(p.delay_snare_room_buffer);
			node_snare_room_out = ((node_snare_mix_out)) * (1.0 - (p.mix)) + delayed_sample_snare_room * (p.mix);
		}

		output_left += node_snare_room_out
		output_right += node_snare_room_out
	}

	// B7-2-followup / SKB-016: a baked worst-case constant here held
	// is_playing true for minutes on real content (every exposed tail param
	// contributed its range maximum, so glassy-fm-pluck alone baked 202.5s
	// for a true tail under 2s). Arm on the FALLING EDGE instead, from the
	// live field values — that is one ln/pow per note-off rather than per
	// sample, which is what keeps this proc off the audio path.
	{
		voice_alive := false
		for i in 0..<3 {
			if p.voices[i].active {
				voice_alive = true
				break
			}
		}
		if voice_alive || p.playing {
			p.bus_tail_armed = false
			p.bus_tail_remaining = 0
		} else if !p.bus_tail_armed {
			p.bus_tail_armed = true
			p.bus_tail_remaining = u64(SNES_Snare_bus_tail_seconds(p) * sample_rate)
		} else if p.bus_tail_remaining > 0 {
			p.bus_tail_remaining -= 1
		}
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
SNES_Snare_process_sequence :: proc(p: ^SNES_Snare_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "SNES Snare" (16 steps)
		switch p.current_step % 16 {
		case 4:
			SNES_Snare_note_on(p, 38, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 11:
			SNES_Snare_note_on(p, 38, 0.449999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			SNES_Snare_note_on(p, 38, 0.949999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	SNES_Snare: ^SNES_Snare_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.750000000
	p.SNES_Snare = new(SNES_Snare_Processor)
	SNES_Snare_init(p.SNES_Snare, sr)
	SNES_Snare_start(p.SNES_Snare)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := SNES_Snare_process(p.SNES_Snare); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.SNES_Snare)
}

