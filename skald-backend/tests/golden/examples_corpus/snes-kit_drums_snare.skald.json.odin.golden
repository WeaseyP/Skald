SNES_Snare_note_on :: proc(p: ^SNES_Snare_Processor, note: u8, velocity: f32, duration: f32) {
	// note and velocity are clamped silently to their MIDI/normalized domains.
	note := note
	if note > 127 do note = 127
	velocity := math.clamp(velocity, 0.0, 1.0)
	voice_idx := -1
	for i in 0..<3 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_releasing_age: f32 = -1.0
		for i in 0..<3 {
			releasing := true
			if p.voices[i].adsr_snare_noise_env_stage != .Release && p.voices[i].adsr_snare_noise_env_stage != .Idle do releasing = false
			if p.voices[i].adsr_snare_tone_env_stage != .Release && p.voices[i].adsr_snare_tone_env_stage != .Idle do releasing = false
			if releasing && p.voices[i].age > oldest_releasing_age {
				oldest_releasing_age = p.voices[i].age
				voice_idx = i
			}
		}
		if voice_idx == -1 {
			oldest_age: f32 = -1.0
			for i in 0..<3 {
				if p.voices[i].age > oldest_age {
					oldest_age = p.voices[i].age
					voice_idx = i
				}
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	adsr_snare_noise_env_prev_level: f32 = 0.0
	if stolen && v.adsr_snare_noise_env_stage != .Idle {
		adsr_snare_noise_env_prev_level = v.adsr_snare_noise_env_release_level
		if v.adsr_snare_noise_env_stage == .Release {
			rel_t_snare_noise_env: f32 = (f32(0.050000000));
			if rel_t_snare_noise_env > 0.0 {
				rf_snare_noise_env := 1.0 - (v.age - v.time_released) / math.max(rel_t_snare_noise_env, 0.000001)
				if rf_snare_noise_env < 0.0 do rf_snare_noise_env = 0.0
				adsr_snare_noise_env_prev_level *= rf_snare_noise_env
			} else {
				adsr_snare_noise_env_prev_level = 0.0
			}
		}
	}
	adsr_snare_tone_env_prev_level: f32 = 0.0
	if stolen && v.adsr_snare_tone_env_stage != .Idle {
		adsr_snare_tone_env_prev_level = v.adsr_snare_tone_env_release_level
		if v.adsr_snare_tone_env_stage == .Release {
			rel_t_snare_tone_env: f32 = (f32(0.030000000));
			if rel_t_snare_tone_env > 0.0 {
				rf_snare_tone_env := 1.0 - (v.age - v.time_released) / math.max(rel_t_snare_tone_env, 0.000001)
				if rf_snare_tone_env < 0.0 do rf_snare_tone_env = 0.0
				adsr_snare_tone_env_prev_level *= rf_snare_tone_env
			} else {
				adsr_snare_tone_env_prev_level = 0.0
			}
		}
	}
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.000000000
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	v.adsr_snare_noise_env_stage = .Attack
	v.adsr_snare_noise_env_attack_start = adsr_snare_noise_env_prev_level
	v.adsr_snare_noise_env_release_level = adsr_snare_noise_env_prev_level
	v.adsr_snare_tone_env_stage = .Attack
	v.adsr_snare_tone_env_attack_start = adsr_snare_tone_env_prev_level
	v.adsr_snare_tone_env_release_level = adsr_snare_tone_env_prev_level
	if !stolen {
		v.filter_snare_band_low = 0.0
		v.filter_snare_band_band = 0.0
		v.osc_snare_tone_osc_phase = {}
	}
}

SNES_Snare_note_off :: proc(p: ^SNES_Snare_Processor, note: u8) {
	// Clamped to match _note_on: `note` is the voice key, so both must map it.
	note := note
	if note > 127 do note = 127
	best := -1
	best_age: f32 = -1.0
	for i in 0..<3 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_snare_noise_env_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_snare_noise_env_stage = .Release
		p.voices[best].adsr_snare_tone_env_stage = .Release
	}
}

SNES_Snare_trigger :: proc(p: ^SNES_Snare_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (f32(0.001000000)) + (p.Rattle_Env_decay) > d do d = (f32(0.001000000)) + (p.Rattle_Env_decay)
		if (f32(0.001000000)) + (p.Shell_Env_decay) > d do d = (f32(0.001000000)) + (p.Shell_Env_decay)
		if d <= 0.0 do d = 0.001
	}
	SNES_Snare_note_on(p, note, velocity, d)
}

