GW_Boss_War_Tuba_set_param :: proc(p: ^GW_Boss_War_Tuba_Processor, name: string, value: f32) -> bool {
	switch name {
	case "Air_cutoff", "war-air::cutoff":
		GW_Boss_War_Tuba_set_Air_cutoff(p, value)
		return true
	case "Amp_attack", "war-amp::attack":
		GW_Boss_War_Tuba_set_Amp_attack(p, value)
		return true
	case "Amp_decay", "war-amp::decay":
		GW_Boss_War_Tuba_set_Amp_decay(p, value)
		return true
	case "Amp_sustain", "war-amp::sustain":
		GW_Boss_War_Tuba_set_Amp_sustain(p, value)
		return true
	case "Arena_decay", "war-reverb::decay":
		GW_Boss_War_Tuba_set_Arena_decay(p, value)
		return true
	case "Arena_mix", "war-reverb::mix":
		GW_Boss_War_Tuba_set_Arena_mix(p, value)
		return true
	case "Body_cutoff", "war-body::cutoff":
		GW_Boss_War_Tuba_set_Body_cutoff(p, value)
		return true
	case "Body_resonance", "war-body::resonance":
		GW_Boss_War_Tuba_set_Body_resonance(p, value)
		return true
	case "Breath_amplitude", "war-breath::amplitude":
		GW_Boss_War_Tuba_set_Breath_amplitude(p, value)
		return true
	case "Formant_cutoff", "war-formant::cutoff":
		GW_Boss_War_Tuba_set_Formant_cutoff(p, value)
		return true
	case "Formant_resonance", "war-formant::resonance":
		GW_Boss_War_Tuba_set_Formant_resonance(p, value)
		return true
	case "Puff_sustain", "war-puff::sustain":
		GW_Boss_War_Tuba_set_Puff_sustain(p, value)
		return true
	case "Rage_mix", "war-drive::mix":
		GW_Boss_War_Tuba_set_Rage_mix(p, value)
		return true
	case "Reed_amplitude", "war-reed::amplitude":
		GW_Boss_War_Tuba_set_Reed_amplitude(p, value)
		return true
	case "Scoop_attack", "war-scoop::attack":
		GW_Boss_War_Tuba_set_Scoop_attack(p, value)
		return true
	case "Vibrato_amplitude", "war-vibrato::amplitude":
		GW_Boss_War_Tuba_set_Vibrato_amplitude(p, value)
		return true
	case "drive", "war-drive::drive":
		GW_Boss_War_Tuba_set_drive(p, value)
		return true
	case "frequency", "war-vibrato::frequency":
		GW_Boss_War_Tuba_set_frequency(p, value)
		return true
	case "outMin", "war-scoop-map::outMin":
		GW_Boss_War_Tuba_set_outMin(p, value)
		return true
	case "release", "war-amp::release":
		GW_Boss_War_Tuba_set_release(p, value)
		return true
	case "tone", "war-drive::tone":
		GW_Boss_War_Tuba_set_tone(p, value)
		return true
	}
	return false
}

GW_Boss_War_Tuba_get_param :: proc(p: ^GW_Boss_War_Tuba_Processor, name: string) -> (f32, bool) {
	switch name {
	case "Air_cutoff", "war-air::cutoff":
		return p.Air_cutoff, true
	case "Amp_attack", "war-amp::attack":
		return p.Amp_attack, true
	case "Amp_decay", "war-amp::decay":
		return p.Amp_decay, true
	case "Amp_sustain", "war-amp::sustain":
		return p.Amp_sustain, true
	case "Arena_decay", "war-reverb::decay":
		return p.Arena_decay, true
	case "Arena_mix", "war-reverb::mix":
		return p.Arena_mix, true
	case "Body_cutoff", "war-body::cutoff":
		return p.Body_cutoff, true
	case "Body_resonance", "war-body::resonance":
		return p.Body_resonance, true
	case "Breath_amplitude", "war-breath::amplitude":
		return p.Breath_amplitude, true
	case "Formant_cutoff", "war-formant::cutoff":
		return p.Formant_cutoff, true
	case "Formant_resonance", "war-formant::resonance":
		return p.Formant_resonance, true
	case "Puff_sustain", "war-puff::sustain":
		return p.Puff_sustain, true
	case "Rage_mix", "war-drive::mix":
		return p.Rage_mix, true
	case "Reed_amplitude", "war-reed::amplitude":
		return p.Reed_amplitude, true
	case "Scoop_attack", "war-scoop::attack":
		return p.Scoop_attack, true
	case "Vibrato_amplitude", "war-vibrato::amplitude":
		return p.Vibrato_amplitude, true
	case "drive", "war-drive::drive":
		return p.drive, true
	case "frequency", "war-vibrato::frequency":
		return p.frequency, true
	case "outMin", "war-scoop-map::outMin":
		return p.outMin, true
	case "release", "war-amp::release":
		return p.release, true
	case "tone", "war-drive::tone":
		return p.tone, true
	}
	return 0.0, false
}

GW_Boss_War_Tuba_process :: proc(p: ^GW_Boss_War_Tuba_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	GW_Boss_War_Tuba_process_sequence(p)
	p.total_samples += 1

	node_war_amp_out_vsum: f32 = 0.0
	for v_idx in 0..<4 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.current_freq != voice.target_freq {
			glide_k := 1.0 / math.max(voice.glide_time * sample_rate, 1.0)
			if glide_k > 1.0 do glide_k = 1.0
			voice.current_freq += (voice.target_freq - voice.current_freq) * glide_k
			if abs(voice.target_freq - voice.current_freq) < 0.1 do voice.current_freq = voice.target_freq
		}
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_war_amp_stage != .Release && voice.adsr_war_amp_stage != .Idle {
				voice.adsr_war_amp_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_war_puff_stage != .Release && voice.adsr_war_puff_stage != .Idle {
				voice.adsr_war_puff_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_war_scoop_stage != .Release && voice.adsr_war_scoop_stage != .Idle {
				voice.adsr_war_scoop_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_war_air_out: f32 = 0.0
		node_war_amp_out: f32 = 0.0
		node_war_body_out: f32 = 0.0
		node_war_breath_out: f32 = 0.0
		node_war_drive_out: f32 = 0.0
		node_war_formant_out: f32 = 0.0
		node_war_mixer_out: f32 = 0.0
		node_war_puff_out: f32 = 0.0
		node_war_reed_out: f32 = 0.0
		node_war_scoop_out: f32 = 0.0
		node_war_scoop_map_out: f32 = 0.0
		node_war_vibrato_out: f32 = 0.0

		// --- Noise Node war_breath ---
		{
			white_war_breath := next_float32(&voice.noise_war_breath_rng) * 2.0 - 1.0;
			voice.noise_war_breath_p0 = 0.99765 * voice.noise_war_breath_p0 + white_war_breath * 0.0990460;
			voice.noise_war_breath_p1 = 0.96300 * voice.noise_war_breath_p1 + white_war_breath * 0.2965164;
			voice.noise_war_breath_p2 = 0.57000 * voice.noise_war_breath_p2 + white_war_breath * 1.0526913;
			node_war_breath_out = (voice.noise_war_breath_p0 + voice.noise_war_breath_p1 + voice.noise_war_breath_p2 + white_war_breath * 0.1848) * 0.25 * (p.Breath_amplitude);
		}

		// --- ADSR Node war_scoop ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_war_scoop_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Scoop_attack) > 0 do envelope = voice.adsr_war_scoop_attack_start + (1.0 - voice.adsr_war_scoop_attack_start) * (voice.age / math.max(f32(p.Scoop_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_war_scoop_release_level = envelope;
				if voice.age >= (p.Scoop_attack) {
					voice.adsr_war_scoop_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Scoop_attack);
				if (f32(0.200000000)) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(f32(0.200000000)), 0.000001)) * (1.0 - (f32(1.000000000))); else do envelope = (f32(1.000000000));
				voice.adsr_war_scoop_release_level = envelope;
				if time_in_decay >= (f32(0.200000000)) {
					voice.adsr_war_scoop_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(1.000000000));
				voice.adsr_war_scoop_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.050000000)) > 0 do envelope = voice.adsr_war_scoop_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.050000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_war_scoop_stage = .Idle;
				}
			}
			vel_scale_war_scoop: f32 = (1.0 - (f32(0.000000000))) + (f32(0.000000000)) * voice.velocity;
			node_war_scoop_out = (1.0) * envelope * (f32(1.000000000)) * vel_scale_war_scoop;
		}

		// --- LFO Node war_vibrato ---
		voice.lfo_war_vibrato_phase = math.mod(voice.lfo_war_vibrato_phase + (2 * f32(math.PI) * (p.frequency) / sample_rate), 2 * f32(math.PI));
		if voice.lfo_war_vibrato_phase < 0.0 do voice.lfo_war_vibrato_phase += 2 * f32(math.PI);
		node_war_vibrato_out = math.sin(voice.lfo_war_vibrato_phase) * (p.Vibrato_amplitude);

		// --- Filter Node war_air (SVF) ---
		{
			cutoff_c_war_air: f32 = math.clamp(f32(p.Air_cutoff), 10.0, sample_rate * 0.16);
			f_war_air := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_war_air / sample_rate));
			q_war_air: f32 = math.clamp(1.0 / math.max(f32(f32(1.000000000)), 0.1), 0.05, 1.9 - f_war_air);
			voice.filter_war_air_low += f_war_air * voice.filter_war_air_band;
			high_war_air := f32(((node_war_breath_out)) - voice.filter_war_air_low - q_war_air * voice.filter_war_air_band);
			voice.filter_war_air_band += f_war_air * high_war_air;
			node_war_air_out = voice.filter_war_air_band;
		}

		// --- Mapper Node war_scoop_map ---
		{
			in_range_war_scoop_map: f32 = f32(f32(1.000000000)) - f32(f32(0.000000000));
			if in_range_war_scoop_map == 0.0 do in_range_war_scoop_map = 1.0;
			node_war_scoop_map_out = math.lerp(f32(p.outMin), f32(f32(0.000000000)), math.clamp((f32((node_war_scoop_out)) - f32(f32(0.000000000))) / in_range_war_scoop_map, 0.0, 1.0));
		}

		// --- ADSR Node war_puff ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_war_puff_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.015000000)) > 0 do envelope = voice.adsr_war_puff_attack_start + (1.0 - voice.adsr_war_puff_attack_start) * (voice.age / math.max(f32(f32(0.015000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_war_puff_release_level = envelope;
				if voice.age >= (f32(0.015000000)) {
					voice.adsr_war_puff_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.015000000));
				if (f32(0.120000000)) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(f32(0.120000000)), 0.000001)) * (1.0 - (p.Puff_sustain)); else do envelope = (p.Puff_sustain);
				voice.adsr_war_puff_release_level = envelope;
				if time_in_decay >= (f32(0.120000000)) {
					voice.adsr_war_puff_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Puff_sustain);
				voice.adsr_war_puff_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.100000000)) > 0 do envelope = voice.adsr_war_puff_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.100000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_war_puff_stage = .Idle;
				}
			}
			vel_scale_war_puff: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_war_puff_out = ((node_war_air_out)) * envelope * (f32(1.000000000)) * vel_scale_war_puff;
		}

		// --- Oscillator Node war_reed (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = ((voice.current_freq) * math.pow(2.0, math.clamp(f32(node_war_scoop_map_out + node_war_vibrato_out), -10.0, 10.0))) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_war_reed_phase[i] = math.mod(voice.osc_war_reed_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_war_reed_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += ((final_phase / f32(math.PI)) - 1.0);
			}
			node_war_reed_out = (unison_out / f32(unison_count)) * (p.Reed_amplitude);
		}

		// --- Filter Node war_body (SVF) ---
		{
			cutoff_c_war_body: f32 = math.clamp(f32(p.Body_cutoff), 10.0, sample_rate * 0.16);
			f_war_body := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_war_body / sample_rate));
			q_war_body: f32 = math.clamp(1.0 / math.max(f32(p.Body_resonance), 0.1), 0.05, 1.9 - f_war_body);
			voice.filter_war_body_low += f_war_body * voice.filter_war_body_band;
			high_war_body := f32(((node_war_reed_out)) - voice.filter_war_body_low - q_war_body * voice.filter_war_body_band);
			voice.filter_war_body_band += f_war_body * high_war_body;
			node_war_body_out = voice.filter_war_body_low;
		}

		// --- Filter Node war_formant (SVF) ---
		{
			cutoff_c_war_formant: f32 = math.clamp(f32(p.Formant_cutoff), 10.0, sample_rate * 0.16);
			f_war_formant := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_war_formant / sample_rate));
			q_war_formant: f32 = math.clamp(1.0 / math.max(f32(p.Formant_resonance), 0.1), 0.05, 1.9 - f_war_formant);
			voice.filter_war_formant_low += f_war_formant * voice.filter_war_formant_band;
			high_war_formant := f32(((node_war_reed_out)) - voice.filter_war_formant_low - q_war_formant * voice.filter_war_formant_band);
			voice.filter_war_formant_band += f_war_formant * high_war_formant;
			node_war_formant_out = voice.filter_war_formant_band;
		}

		// --- Mixer Node war_mixer (3 inputs) ---
		{
			mix_sum_war_mixer: f32 = 0.0;
			mix_sum_war_mixer += node_war_body_out * (f32(0.850000024));
			mix_sum_war_mixer += node_war_formant_out * (f32(0.449999988));
			mix_sum_war_mixer += node_war_puff_out * (f32(0.300000012));
		node_war_mixer_out = mix_sum_war_mixer;
		}

		// --- Distortion Node war_drive (soft) ---
		{
			dist_in_war_drive: f32 = ((node_war_mixer_out));
			dist_k_war_drive: f32 = math.max(f32(p.drive), 1.0);
			dist_wet_war_drive: f32 = math.tanh(dist_in_war_drive * dist_k_war_drive);
			tone_k_war_drive: f32 = math.clamp(2.0 * f32(math.PI) * math.clamp(f32(p.tone), 100.0, 20000.0) / sample_rate, 0.001, 1.0);
			voice.dist_war_drive_tone += tone_k_war_drive * (dist_wet_war_drive - voice.dist_war_drive_tone);
			mix_war_drive: f32 = math.clamp(f32(p.Rage_mix), 0.0, 1.0);
			node_war_drive_out = dist_in_war_drive * (1.0 - mix_war_drive) + voice.dist_war_drive_tone * mix_war_drive;
		}

		// --- ADSR Node war_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_war_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Amp_attack) > 0 do envelope = voice.adsr_war_amp_attack_start + (1.0 - voice.adsr_war_amp_attack_start) * (voice.age / math.max(f32(p.Amp_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_war_amp_release_level = envelope;
				if voice.age >= (p.Amp_attack) {
					voice.adsr_war_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Amp_attack);
				if (p.Amp_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Amp_decay), 0.000001)) * (1.0 - (p.Amp_sustain)); else do envelope = (p.Amp_sustain);
				voice.adsr_war_amp_release_level = envelope;
				if time_in_decay >= (p.Amp_decay) {
					voice.adsr_war_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Amp_sustain);
				voice.adsr_war_amp_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.release) > 0 do envelope = voice.adsr_war_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_war_amp_stage = .Idle;
				}
			}
			vel_scale_war_amp: f32 = (1.0 - (f32(0.700000000))) + (f32(0.700000000)) * voice.velocity;
			node_war_amp_out = ((node_war_drive_out)) * envelope * (f32(1.000000000)) * vel_scale_war_amp;
		}

		node_war_amp_out_vsum += node_war_amp_out
		if voice.adsr_war_amp_stage != .Idle do voice_busy = true
		if voice.adsr_war_puff_stage != .Idle do voice_busy = true
		if voice.adsr_war_scoop_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}

	// --- Bus effects (once per sample, post voice sum) ---
	{
		node_war_amp_out := node_war_amp_out_vsum
		node_war_reverb_out: f32 = 0.0
		// --- Reverb Node war_reverb (pre-delay + feedback comb) ---
		{
			pre_delay_seconds_war_reverb: f32 = math.clamp(f32(f32(0.010000000)), 0.0, 0.25);
			pre_delay_samples_war_reverb := int(math.clamp(pre_delay_seconds_war_reverb * sample_rate, 0.0, f32(48000)));
			pre_write_index_war_reverb := p.delay_war_reverb_write_index % len(p.reverb_war_reverb_pre_buffer)
			pre_delayed_input_war_reverb := f32((node_war_amp_out))
			if pre_delay_samples_war_reverb > 0 {
				pre_read_index_war_reverb := (pre_write_index_war_reverb - pre_delay_samples_war_reverb + len(p.reverb_war_reverb_pre_buffer)) % len(p.reverb_war_reverb_pre_buffer)
				pre_delayed_input_war_reverb = p.reverb_war_reverb_pre_buffer[pre_read_index_war_reverb]
			}
			p.reverb_war_reverb_pre_buffer[pre_write_index_war_reverb] = f32((node_war_amp_out))
			delay_samples_war_reverb := int(math.clamp((0.075000000) * sample_rate, 0, 96000-1));
			read_index_war_reverb := (p.delay_war_reverb_write_index - delay_samples_war_reverb + len(p.delay_war_reverb_buffer)) % len(p.delay_war_reverb_buffer);
			delayed_sample_war_reverb := p.delay_war_reverb_buffer[read_index_war_reverb];
			decay_gain_war_reverb: f32 = math.clamp(math.pow(f32(0.001), f32(0.075000000) / math.max(f32(p.Arena_decay), 0.01)), 0.0, 0.95);
			p.delay_war_reverb_buffer[p.delay_war_reverb_write_index] = pre_delayed_input_war_reverb + delayed_sample_war_reverb * decay_gain_war_reverb;
			p.delay_war_reverb_write_index = (p.delay_war_reverb_write_index + 1) % len(p.delay_war_reverb_buffer);
			node_war_reverb_out = ((node_war_amp_out)) * (1.0 - (p.Arena_mix)) + delayed_sample_war_reverb * (p.Arena_mix);
		}

		output_left += node_war_reverb_out
		output_right += node_war_reverb_out
	}

	// B7-2-followup / SKB-016: a baked worst-case constant here held
	// is_playing true for minutes on real content (every exposed tail param
	// contributed its range maximum, so glassy-fm-pluck alone baked 202.5s
	// for a true tail under 2s). Arm on the FALLING EDGE instead, from the
	// live field values — that is one ln/pow per note-off rather than per
	// sample, which is what keeps this proc off the audio path.
	{
		voice_alive := false
		for i in 0..<4 {
			if p.voices[i].active {
				voice_alive = true
				break
			}
		}
		if voice_alive || p.playing {
			p.bus_tail_armed = false
			p.bus_tail_remaining = 0
		} else if !p.bus_tail_armed {
			p.bus_tail_armed = true
			p.bus_tail_remaining = u64(GW_Boss_War_Tuba_bus_tail_seconds(p) * sample_rate)
		} else if p.bus_tail_remaining > 0 {
			p.bus_tail_remaining -= 1
		}
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
GW_Boss_War_Tuba_process_sequence :: proc(p: ^GW_Boss_War_Tuba_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "GW Boss War Tuba" (16 steps)
		switch p.current_step % 16 {
		case 0:
			GW_Boss_War_Tuba_note_on(p, 50, 0.949999988, f32(3.000000000) * (60.0 / p.bpm / 4.0))
		case 4:
			GW_Boss_War_Tuba_note_on(p, 53, 0.850000024, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 6:
			GW_Boss_War_Tuba_note_on(p, 55, 0.800000012, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			GW_Boss_War_Tuba_note_on(p, 57, 1.000000000, f32(3.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			GW_Boss_War_Tuba_note_on(p, 55, 0.750000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 13:
			GW_Boss_War_Tuba_note_on(p, 53, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 14:
			GW_Boss_War_Tuba_note_on(p, 50, 0.899999976, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	GW_Boss_War_Tuba: ^GW_Boss_War_Tuba_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.750000000
	p.GW_Boss_War_Tuba = new(GW_Boss_War_Tuba_Processor)
	GW_Boss_War_Tuba_init(p.GW_Boss_War_Tuba, sr)
	GW_Boss_War_Tuba_start(p.GW_Boss_War_Tuba)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := GW_Boss_War_Tuba_process(p.GW_Boss_War_Tuba); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.GW_Boss_War_Tuba)
}

