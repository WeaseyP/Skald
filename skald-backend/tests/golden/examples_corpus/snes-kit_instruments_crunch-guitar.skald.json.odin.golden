			mix_gtr_drive: f32 = math.clamp(f32(p.mix), 0.0, 1.0);
			node_gtr_drive_out = dist_in_gtr_drive * (1.0 - mix_gtr_drive) + voice.dist_gtr_drive_tone * mix_gtr_drive;
		}

		// --- Filter Node gtr_cab (SVF) ---
		{
			cutoff_c_gtr_cab: f32 = math.clamp(f32(p.cutoff), 10.0, sample_rate * 0.16);
			f_gtr_cab := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_gtr_cab / sample_rate));
			q_gtr_cab: f32 = math.clamp(1.0 / math.max(f32(f32(0.700000000)), 0.1), 0.05, 1.9 - f_gtr_cab);
			voice.filter_gtr_cab_low += f_gtr_cab * voice.filter_gtr_cab_band;
			high_gtr_cab := f32(((node_gtr_drive_out)) - voice.filter_gtr_cab_low - q_gtr_cab * voice.filter_gtr_cab_band);
			voice.filter_gtr_cab_band += f_gtr_cab * high_gtr_cab;
