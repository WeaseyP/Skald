		node_gtr_osc_out: f32 = 0.0
		node_gtr_output_out: f32 = 0.0

		// --- Oscillator Node gtr_osc (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 2;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (12.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_gtr_osc_phase[i] = math.mod(voice.osc_gtr_osc_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
