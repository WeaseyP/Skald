				unison_out += ((final_phase / f32(math.PI)) - 1.0);
			}
			node_gtr_osc_out = (unison_out / f32(unison_count)) * (p.amplitude);
		}

		// --- Distortion Node gtr_drive (classic) ---
		{
			dist_in_gtr_drive: f32 = ((node_gtr_osc_out));
			dist_k_gtr_drive: f32 = math.max(f32(p.drive), 1.0);
			dist_wet_gtr_drive: f32 = (f32(math.PI) + dist_k_gtr_drive) * dist_in_gtr_drive / (f32(math.PI) + dist_k_gtr_drive * abs(dist_in_gtr_drive));
			tone_k_gtr_drive: f32 = math.clamp(2.0 * f32(math.PI) * math.clamp(f32(p.tone), 100.0, 20000.0) / sample_rate, 0.001, 1.0);
