SNES_Crunch_Guitar_process_sequence :: proc(p: ^SNES_Crunch_Guitar_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "SNES Crunch Guitar" (16 steps)
		switch p.current_step % 16 {
		case 0:
			SNES_Crunch_Guitar_note_on(p, 45, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
			SNES_Crunch_Guitar_note_on(p, 52, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 2:
			SNES_Crunch_Guitar_note_on(p, 45, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
			SNES_Crunch_Guitar_note_on(p, 52, 0.600000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 4:
			SNES_Crunch_Guitar_note_on(p, 45, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
			SNES_Crunch_Guitar_note_on(p, 52, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 6:
			SNES_Crunch_Guitar_note_on(p, 45, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
			SNES_Crunch_Guitar_note_on(p, 52, 0.600000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			SNES_Crunch_Guitar_note_on(p, 45, 0.850000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
			SNES_Crunch_Guitar_note_on(p, 52, 0.750000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 10:
			SNES_Crunch_Guitar_note_on(p, 45, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
			SNES_Crunch_Guitar_note_on(p, 52, 0.600000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			SNES_Crunch_Guitar_note_on(p, 45, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
			SNES_Crunch_Guitar_note_on(p, 52, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 14:
			SNES_Crunch_Guitar_note_on(p, 45, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
			SNES_Crunch_Guitar_note_on(p, 52, 0.600000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	SNES_Crunch_Guitar: ^SNES_Crunch_Guitar_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.750000000
	p.SNES_Crunch_Guitar = new(SNES_Crunch_Guitar_Processor)
	SNES_Crunch_Guitar_init(p.SNES_Crunch_Guitar, sr)
	SNES_Crunch_Guitar_start(p.SNES_Crunch_Guitar)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := SNES_Crunch_Guitar_process(p.SNES_Crunch_Guitar); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.SNES_Crunch_Guitar)
}

