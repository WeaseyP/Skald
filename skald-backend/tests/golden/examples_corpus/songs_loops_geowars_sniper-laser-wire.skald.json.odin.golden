GW_Sniper_Laser_Wire_process :: proc(p: ^GW_Sniper_Laser_Wire_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	GW_Sniper_Laser_Wire_process_sequence(p)
	p.total_samples += 1

	for v_idx in 0..<4 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_wire_amp_stage != .Release && voice.adsr_wire_amp_stage != .Idle {
				voice.adsr_wire_amp_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_wire_aim_out: f32 = 0.0
		node_wire_amp_out: f32 = 0.0
		node_wire_jitter_out: f32 = 0.0
		node_wire_jitter_map_out: f32 = 0.0
		node_wire_osc_out: f32 = 0.0
		node_wire_output_out: f32 = 0.0

		// --- Sample & Hold Node wire_jitter ---
		voice.sh_wire_jitter_counter += 1;
		update_interval_wire_jitter := u64(sample_rate / math.max(f32((1.0 / ((60.0 / p.bpm) * 0.250000000))), 0.1));
		if voice.sh_wire_jitter_counter >= update_interval_wire_jitter {
			voice.sh_wire_jitter_current_value = next_float32(&voice.sh_wire_jitter_rng) * 2.0 - 1.0;
			voice.sh_wire_jitter_counter = 0;
		}
		node_wire_jitter_out = voice.sh_wire_jitter_current_value * (p.Nerves_amplitude);

		// --- Mapper Node wire_jitter_map ---
		{
			in_range_wire_jitter_map: f32 = f32(f32(1.000000000)) - f32(f32(-1.000000000));
			if in_range_wire_jitter_map == 0.0 do in_range_wire_jitter_map = 1.0;
			node_wire_jitter_map_out = math.lerp(f32(f32(0.000000000)), f32(p.outMax), math.clamp((f32((node_wire_jitter_out)) - f32(f32(-1.000000000))) / in_range_wire_jitter_map, 0.0, 1.0));
		}

		// --- Oscillator Node wire_osc (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = ((voice.current_freq) * math.pow(2.0, math.clamp(f32(node_wire_jitter_map_out), -10.0, 10.0))) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_wire_osc_phase[i] = math.mod(voice.osc_wire_osc_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_wire_osc_phase[i] + phase_rads, 2 * f32(math.PI));
				if final_phase < 2 * f32(math.PI) * math.clamp(f32(p.pulseWidth), 0.01, 0.99) do unison_out += 1.0; else do unison_out -= 1.0;
			}
			node_wire_osc_out = (unison_out / f32(unison_count)) * (p.Wire_amplitude);
		}

		// --- Filter Node wire_aim (SVF) ---
		{
			cutoff_c_wire_aim: f32 = math.clamp(f32(p.cutoff), 10.0, sample_rate * 0.16);
			f_wire_aim := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_wire_aim / sample_rate));
			q_wire_aim: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_wire_aim);
			voice.filter_wire_aim_low += f_wire_aim * voice.filter_wire_aim_band;
			high_wire_aim := f32(((node_wire_osc_out)) - voice.filter_wire_aim_low - q_wire_aim * voice.filter_wire_aim_band);
			voice.filter_wire_aim_band += f_wire_aim * high_wire_aim;
			node_wire_aim_out = voice.filter_wire_aim_band;
		}

		// --- ADSR Node wire_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_wire_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.001000000)) > 0 do envelope = voice.adsr_wire_amp_attack_start + (1.0 - voice.adsr_wire_amp_attack_start) * (voice.age / math.max(f32(f32(0.001000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_wire_amp_release_level = envelope;
				if voice.age >= (f32(0.001000000)) {
					voice.adsr_wire_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.001000000));
				if (p.decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.decay), 0.000001)) * (1.0 - (p.sustain)); else do envelope = (p.sustain);
				voice.adsr_wire_amp_release_level = envelope;
				if time_in_decay >= (p.decay) {
					voice.adsr_wire_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.sustain);
				voice.adsr_wire_amp_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.050000000)) > 0 do envelope = voice.adsr_wire_amp_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.050000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_wire_amp_stage = .Idle;
				}
			}
			vel_scale_wire_amp: f32 = (1.0 - (f32(0.600000000))) + (f32(0.600000000)) * voice.velocity;
			node_wire_amp_out = ((node_wire_aim_out)) * envelope * (f32(1.000000000)) * vel_scale_wire_amp;
		}

		output_left += node_wire_amp_out
		output_right += node_wire_amp_out
		if voice.adsr_wire_amp_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
GW_Sniper_Laser_Wire_process_sequence :: proc(p: ^GW_Sniper_Laser_Wire_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "GW Sniper Laser Wire" (16 steps)
		switch p.current_step % 16 {
		case 0:
			GW_Sniper_Laser_Wire_note_on(p, 69, 0.850000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 2:
			if next_float32(&p.prng) <= 0.699999988 {
				GW_Sniper_Laser_Wire_note_on(p, 69, 0.500000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
			}
		case 4:
			GW_Sniper_Laser_Wire_note_on(p, 74, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 7:
			if next_float32(&p.prng) <= 0.600000024 {
				GW_Sniper_Laser_Wire_note_on(p, 69, 0.600000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
			}
		case 8:
			GW_Sniper_Laser_Wire_note_on(p, 69, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 11:
			if next_float32(&p.prng) <= 0.800000012 {
				GW_Sniper_Laser_Wire_note_on(p, 76, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
			}
		case 12:
			GW_Sniper_Laser_Wire_note_on(p, 74, 0.850000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 14:
			if next_float32(&p.prng) <= 0.500000000 {
				GW_Sniper_Laser_Wire_note_on(p, 69, 0.500000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
			}
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	GW_Sniper_Laser_Wire: ^GW_Sniper_Laser_Wire_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.750000000
	p.GW_Sniper_Laser_Wire = new(GW_Sniper_Laser_Wire_Processor)
	GW_Sniper_Laser_Wire_init(p.GW_Sniper_Laser_Wire, sr)
	GW_Sniper_Laser_Wire_start(p.GW_Sniper_Laser_Wire)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := GW_Sniper_Laser_Wire_process(p.GW_Sniper_Laser_Wire); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.GW_Sniper_Laser_Wire)
}

