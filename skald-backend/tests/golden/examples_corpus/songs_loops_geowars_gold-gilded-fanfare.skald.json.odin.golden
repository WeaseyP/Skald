GW_Gold_Gilded_Fanfare_process :: proc(p: ^GW_Gold_Gilded_Fanfare_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	GW_Gold_Gilded_Fanfare_process_sequence(p)
	p.total_samples += 1

	node_fanfare_shine_out_vsum: f32 = 0.0
	for v_idx in 0..<4 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_fanfare_amp_stage != .Release && voice.adsr_fanfare_amp_stage != .Idle {
				voice.adsr_fanfare_amp_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_fanfare_amp_out: f32 = 0.0
		node_fanfare_filter_out: f32 = 0.0
		node_fanfare_osc_out: f32 = 0.0
		node_fanfare_shine_out: f32 = 0.0

		// --- Oscillator Node fanfare_osc (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 2;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (12.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_fanfare_osc_phase[i] = math.mod(voice.osc_fanfare_osc_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_fanfare_osc_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += ((final_phase / f32(math.PI)) - 1.0);
			}
			node_fanfare_osc_out = (unison_out / f32(unison_count)) * (p.amplitude);
		}

		// --- Filter Node fanfare_filter (SVF) ---
		{
			cutoff_c_fanfare_filter: f32 = math.clamp(f32(p.cutoff), 10.0, sample_rate * 0.16);
			f_fanfare_filter := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_fanfare_filter / sample_rate));
			q_fanfare_filter: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_fanfare_filter);
			voice.filter_fanfare_filter_low += f_fanfare_filter * voice.filter_fanfare_filter_band;
			high_fanfare_filter := f32(((node_fanfare_osc_out)) - voice.filter_fanfare_filter_low - q_fanfare_filter * voice.filter_fanfare_filter_band);
			voice.filter_fanfare_filter_band += f_fanfare_filter * high_fanfare_filter;
			node_fanfare_filter_out = voice.filter_fanfare_filter_low;
		}

		// --- ADSR Node fanfare_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_fanfare_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.attack) > 0 do envelope = voice.adsr_fanfare_amp_attack_start + (1.0 - voice.adsr_fanfare_amp_attack_start) * (voice.age / math.max(f32(p.attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_fanfare_amp_release_level = envelope;
				if voice.age >= (p.attack) {
					voice.adsr_fanfare_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.attack);
				if (f32(0.120000000)) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(f32(0.120000000)), 0.000001)) * (1.0 - (p.sustain)); else do envelope = (p.sustain);
				voice.adsr_fanfare_amp_release_level = envelope;
				if time_in_decay >= (f32(0.120000000)) {
					voice.adsr_fanfare_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.sustain);
				voice.adsr_fanfare_amp_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.release) > 0 do envelope = voice.adsr_fanfare_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_fanfare_amp_stage = .Idle;
				}
			}
			vel_scale_fanfare_amp: f32 = (1.0 - (f32(0.800000000))) + (f32(0.800000000)) * voice.velocity;
			node_fanfare_amp_out = ((node_fanfare_filter_out)) * envelope * (f32(1.000000000)) * vel_scale_fanfare_amp;
		}

		// --- Distortion Node fanfare_shine (soft) ---
		{
			dist_in_fanfare_shine: f32 = ((node_fanfare_amp_out));
			dist_k_fanfare_shine: f32 = math.max(f32(p.drive), 1.0);
			dist_wet_fanfare_shine: f32 = math.tanh(dist_in_fanfare_shine * dist_k_fanfare_shine);
			tone_k_fanfare_shine: f32 = math.clamp(2.0 * f32(math.PI) * math.clamp(f32(f32(4000.000000000)), 100.0, 20000.0) / sample_rate, 0.001, 1.0);
			voice.dist_fanfare_shine_tone += tone_k_fanfare_shine * (dist_wet_fanfare_shine - voice.dist_fanfare_shine_tone);
			mix_fanfare_shine: f32 = math.clamp(f32(p.Shine_mix), 0.0, 1.0);
			node_fanfare_shine_out = dist_in_fanfare_shine * (1.0 - mix_fanfare_shine) + voice.dist_fanfare_shine_tone * mix_fanfare_shine;
		}

		node_fanfare_shine_out_vsum += node_fanfare_shine_out
		if voice.adsr_fanfare_amp_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}

	// --- Bus effects (once per sample, post voice sum) ---
	{
		node_fanfare_shine_out := node_fanfare_shine_out_vsum
		node_fanfare_reverb_out: f32 = 0.0
		// --- Reverb Node fanfare_reverb (pre-delay + feedback comb) ---
		{
			pre_delay_seconds_fanfare_reverb: f32 = math.clamp(f32(f32(0.010000000)), 0.0, 0.25);
			pre_delay_samples_fanfare_reverb := int(math.clamp(pre_delay_seconds_fanfare_reverb * sample_rate, 0.0, f32(48000)));
			pre_write_index_fanfare_reverb := p.delay_fanfare_reverb_write_index % len(p.reverb_fanfare_reverb_pre_buffer)
			pre_delayed_input_fanfare_reverb := f32((node_fanfare_shine_out))
			if pre_delay_samples_fanfare_reverb > 0 {
				pre_read_index_fanfare_reverb := (pre_write_index_fanfare_reverb - pre_delay_samples_fanfare_reverb + len(p.reverb_fanfare_reverb_pre_buffer)) % len(p.reverb_fanfare_reverb_pre_buffer)
				pre_delayed_input_fanfare_reverb = p.reverb_fanfare_reverb_pre_buffer[pre_read_index_fanfare_reverb]
			}
			p.reverb_fanfare_reverb_pre_buffer[pre_write_index_fanfare_reverb] = f32((node_fanfare_shine_out))
			delay_samples_fanfare_reverb := int(math.clamp((0.075000000) * sample_rate, 0, 96000-1));
			read_index_fanfare_reverb := (p.delay_fanfare_reverb_write_index - delay_samples_fanfare_reverb + len(p.delay_fanfare_reverb_buffer)) % len(p.delay_fanfare_reverb_buffer);
			delayed_sample_fanfare_reverb := p.delay_fanfare_reverb_buffer[read_index_fanfare_reverb];
			decay_gain_fanfare_reverb: f32 = math.clamp(math.pow(f32(0.001), f32(0.075000000) / math.max(f32(p.decay), 0.01)), 0.0, 0.95);
			p.delay_fanfare_reverb_buffer[p.delay_fanfare_reverb_write_index] = pre_delayed_input_fanfare_reverb + delayed_sample_fanfare_reverb * decay_gain_fanfare_reverb;
			p.delay_fanfare_reverb_write_index = (p.delay_fanfare_reverb_write_index + 1) % len(p.delay_fanfare_reverb_buffer);
			node_fanfare_reverb_out = ((node_fanfare_shine_out)) * (1.0 - (p.Stage_mix)) + delayed_sample_fanfare_reverb * (p.Stage_mix);
		}

		output_left += node_fanfare_reverb_out
		output_right += node_fanfare_reverb_out
	}

	// B7-2-followup / SKB-016: a baked worst-case constant here held
	// is_playing true for minutes on real content (every exposed tail param
	// contributed its range maximum, so glassy-fm-pluck alone baked 202.5s
	// for a true tail under 2s). Arm on the FALLING EDGE instead, from the
	// live field values — that is one ln/pow per note-off rather than per
	// sample, which is what keeps this proc off the audio path.
	{
		voice_alive := false
		for i in 0..<4 {
			if p.voices[i].active {
				voice_alive = true
				break
			}
		}
		if voice_alive || p.playing {
			p.bus_tail_armed = false
			p.bus_tail_remaining = 0
		} else if !p.bus_tail_armed {
			p.bus_tail_armed = true
			p.bus_tail_remaining = u64(GW_Gold_Gilded_Fanfare_bus_tail_seconds(p) * sample_rate)
		} else if p.bus_tail_remaining > 0 {
			p.bus_tail_remaining -= 1
		}
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
GW_Gold_Gilded_Fanfare_process_sequence :: proc(p: ^GW_Gold_Gilded_Fanfare_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "GW Gold Gilded Fanfare" (16 steps)
		switch p.current_step % 16 {
		case 0:
			GW_Gold_Gilded_Fanfare_note_on(p, 62, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 2:
			GW_Gold_Gilded_Fanfare_note_on(p, 62, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 4:
			GW_Gold_Gilded_Fanfare_note_on(p, 62, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 6:
			GW_Gold_Gilded_Fanfare_note_on(p, 66, 0.899999976, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			GW_Gold_Gilded_Fanfare_note_on(p, 69, 1.000000000, f32(4.000000000) * (60.0 / p.bpm / 4.0))
		case 13:
			GW_Gold_Gilded_Fanfare_note_on(p, 71, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 14:
			GW_Gold_Gilded_Fanfare_note_on(p, 69, 0.899999976, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	GW_Gold_Gilded_Fanfare: ^GW_Gold_Gilded_Fanfare_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.750000000
	p.GW_Gold_Gilded_Fanfare = new(GW_Gold_Gilded_Fanfare_Processor)
	GW_Gold_Gilded_Fanfare_init(p.GW_Gold_Gilded_Fanfare, sr)
	GW_Gold_Gilded_Fanfare_start(p.GW_Gold_Gilded_Fanfare)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := GW_Gold_Gilded_Fanfare_process(p.GW_Gold_Gilded_Fanfare); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.GW_Gold_Gilded_Fanfare)
}

