SNES_Brass_Stabs_process :: proc(p: ^SNES_Brass_Stabs_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	SNES_Brass_Stabs_process_sequence(p)
	p.total_samples += 1

	for v_idx in 0..<6 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_brass_amp_stage != .Release && voice.adsr_brass_amp_stage != .Idle {
				voice.adsr_brass_amp_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_brass_fenv_stage != .Release && voice.adsr_brass_fenv_stage != .Idle {
				voice.adsr_brass_fenv_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_brass_amp_out: f32 = 0.0
		node_brass_fenv_out: f32 = 0.0
		node_brass_filter_out: f32 = 0.0
		node_brass_fmap_out: f32 = 0.0
		node_brass_mix_out: f32 = 0.0
		node_brass_output_out: f32 = 0.0
		node_brass_saw_out: f32 = 0.0
		node_brass_square_out: f32 = 0.0

		// --- ADSR Node brass_fenv ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_brass_fenv_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.008000000)) > 0 do envelope = voice.adsr_brass_fenv_attack_start + (1.0 - voice.adsr_brass_fenv_attack_start) * (voice.age / math.max(f32(f32(0.008000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_brass_fenv_release_level = envelope;
				if voice.age >= (f32(0.008000000)) {
					voice.adsr_brass_fenv_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.008000000));
				if (p.decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.decay), 0.000001)) * (1.0 - (p.sustain)); else do envelope = (p.sustain);
				voice.adsr_brass_fenv_release_level = envelope;
				if time_in_decay >= (p.decay) {
					voice.adsr_brass_fenv_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.sustain);
				voice.adsr_brass_fenv_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.080000000)) > 0 do envelope = voice.adsr_brass_fenv_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.080000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_brass_fenv_stage = .Idle;
				}
			}
			vel_scale_brass_fenv: f32 = (1.0 - (f32(0.600000000))) + (f32(0.600000000)) * voice.velocity;
			node_brass_fenv_out = (1.0) * envelope * (f32(1.000000000)) * vel_scale_brass_fenv;
		}

		// --- Oscillator Node brass_saw (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 2;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (8.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_brass_saw_phase[i] = math.mod(voice.osc_brass_saw_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_brass_saw_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += ((final_phase / f32(math.PI)) - 1.0);
			}
			node_brass_saw_out = (unison_out / f32(unison_count)) * (p.Saw_Layer_amplitude);
		}

		// --- Oscillator Node brass_square (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 2;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (8.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_brass_square_phase[i] = math.mod(voice.osc_brass_square_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_brass_square_phase[i] + phase_rads, 2 * f32(math.PI));
				if final_phase < 2 * f32(math.PI) * math.clamp(f32(f32(0.500000000)), 0.01, 0.99) do unison_out += 1.0; else do unison_out -= 1.0;
			}
			node_brass_square_out = (unison_out / f32(unison_count)) * (p.Square_Layer_amplitude);
		}

		// --- Mapper Node brass_fmap ---
		{
			in_range_brass_fmap: f32 = f32(f32(1.000000000)) - f32(f32(0.000000000));
			if in_range_brass_fmap == 0.0 do in_range_brass_fmap = 1.0;
			node_brass_fmap_out = math.lerp(f32(f32(400.000000000)), f32(f32(4200.000000000)), math.clamp((f32((node_brass_fenv_out)) - f32(f32(0.000000000))) / in_range_brass_fmap, 0.0, 1.0));
		}

		// --- Mixer Node brass_mix (2 inputs) ---
		{
			mix_sum_brass_mix: f32 = 0.0;
			mix_sum_brass_mix += node_brass_saw_out * (f32(0.800000012));
			mix_sum_brass_mix += node_brass_square_out * (f32(0.550000012));
		node_brass_mix_out = mix_sum_brass_mix;
		}

		// --- ADSR Node brass_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_brass_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.attack) > 0 do envelope = voice.adsr_brass_amp_attack_start + (1.0 - voice.adsr_brass_amp_attack_start) * (voice.age / math.max(f32(p.attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_brass_amp_release_level = envelope;
				if voice.age >= (p.attack) {
					voice.adsr_brass_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.attack);
				if (f32(0.100000000)) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(f32(0.100000000)), 0.000001)) * (1.0 - (f32(0.650000000))); else do envelope = (f32(0.650000000));
				voice.adsr_brass_amp_release_level = envelope;
				if time_in_decay >= (f32(0.100000000)) {
					voice.adsr_brass_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.650000000));
				voice.adsr_brass_amp_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.release) > 0 do envelope = voice.adsr_brass_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_brass_amp_stage = .Idle;
				}
			}
			vel_scale_brass_amp: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_brass_amp_out = ((node_brass_mix_out)) * envelope * (f32(1.000000000)) * vel_scale_brass_amp;
		}

		// --- Filter Node brass_filter (SVF) ---
		{
			cutoff_c_brass_filter: f32 = math.clamp(f32((p.cutoff) + (node_brass_fmap_out)), 10.0, sample_rate * 0.16);
			f_brass_filter := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_brass_filter / sample_rate));
			q_brass_filter: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_brass_filter);
			voice.filter_brass_filter_low += f_brass_filter * voice.filter_brass_filter_band;
			high_brass_filter := f32(((node_brass_amp_out)) - voice.filter_brass_filter_low - q_brass_filter * voice.filter_brass_filter_band);
			voice.filter_brass_filter_band += f_brass_filter * high_brass_filter;
			node_brass_filter_out = voice.filter_brass_filter_low;
		}

		output_left += node_brass_filter_out
		output_right += node_brass_filter_out
		if voice.adsr_brass_amp_stage != .Idle do voice_busy = true
		if voice.adsr_brass_fenv_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
SNES_Brass_Stabs_process_sequence :: proc(p: ^SNES_Brass_Stabs_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "SNES Brass Stabs" (16 steps)
		switch p.current_step % 16 {
		case 6:
			SNES_Brass_Stabs_note_on(p, 57, 0.899999976, f32(2.000000000) * (60.0 / p.bpm / 4.0))
			SNES_Brass_Stabs_note_on(p, 60, 0.850000024, f32(2.000000000) * (60.0 / p.bpm / 4.0))
			SNES_Brass_Stabs_note_on(p, 64, 0.850000024, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 14:
			SNES_Brass_Stabs_note_on(p, 57, 0.800000012, f32(2.000000000) * (60.0 / p.bpm / 4.0))
			SNES_Brass_Stabs_note_on(p, 60, 0.750000000, f32(2.000000000) * (60.0 / p.bpm / 4.0))
			SNES_Brass_Stabs_note_on(p, 64, 0.750000000, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	SNES_Brass_Stabs: ^SNES_Brass_Stabs_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.750000000
	p.SNES_Brass_Stabs = new(SNES_Brass_Stabs_Processor)
	SNES_Brass_Stabs_init(p.SNES_Brass_Stabs, sr)
	SNES_Brass_Stabs_start(p.SNES_Brass_Stabs)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := SNES_Brass_Stabs_process(p.SNES_Brass_Stabs); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.SNES_Brass_Stabs)
}

