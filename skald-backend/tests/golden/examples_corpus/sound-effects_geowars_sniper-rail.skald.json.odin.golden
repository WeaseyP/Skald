		return true
	case "frequency", "rail-osc::frequency":
		GW_SFX_Sniper_Rail_set_frequency(p, value)
		return true
	case "mix", "rail-comb::mix":
		GW_SFX_Sniper_Rail_set_mix(p, value)
		return true
	case "resonance", "rail-ring::resonance":
		GW_SFX_Sniper_Rail_set_resonance(p, value)
