GW_SFX_Sniper_Rail_process :: proc(p: ^GW_SFX_Sniper_Rail_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	p.total_samples += 1

	node_rail_amp_out_vsum: f32 = 0.0
	for v_idx in 0..<4 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_rail_amp_stage != .Release && voice.adsr_rail_amp_stage != .Idle {
				voice.adsr_rail_amp_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_rail_pitch_stage != .Release && voice.adsr_rail_pitch_stage != .Idle {
				voice.adsr_rail_pitch_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_rail_amp_out: f32 = 0.0
		node_rail_osc_out: f32 = 0.0
		node_rail_pitch_out: f32 = 0.0
		node_rail_pitch_map_out: f32 = 0.0
		node_rail_ring_out: f32 = 0.0

		// --- ADSR Node rail_pitch ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_rail_pitch_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.001000000)) > 0 do envelope = voice.adsr_rail_pitch_attack_start + (1.0 - voice.adsr_rail_pitch_attack_start) * (voice.age / math.max(f32(f32(0.001000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_rail_pitch_release_level = envelope;
				if voice.age >= (f32(0.001000000)) {
					voice.adsr_rail_pitch_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.001000000));
				if (p.Crack_Sweep_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Crack_Sweep_decay), 0.000001)) * (1.0 - (f32(0.000000000))); else do envelope = (f32(0.000000000));
				voice.adsr_rail_pitch_release_level = envelope;
				if time_in_decay >= (p.Crack_Sweep_decay) {
					voice.adsr_rail_pitch_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.000000000));
				voice.adsr_rail_pitch_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.010000000)) > 0 do envelope = voice.adsr_rail_pitch_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.010000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_rail_pitch_stage = .Idle;
				}
			}
			vel_scale_rail_pitch: f32 = (1.0 - (f32(0.000000000))) + (f32(0.000000000)) * voice.velocity;
			node_rail_pitch_out = (1.0) * envelope * (f32(1.000000000)) * vel_scale_rail_pitch;
		}

		// --- Mapper Node rail_pitch_map ---
		{
			in_range_rail_pitch_map: f32 = f32(f32(1.000000000)) - f32(f32(0.000000000));
			if in_range_rail_pitch_map == 0.0 do in_range_rail_pitch_map = 1.0;
			node_rail_pitch_map_out = math.lerp(f32(f32(0.000000000)), f32(f32(3.000000000)), math.clamp((f32((node_rail_pitch_out)) - f32(f32(0.000000000))) / in_range_rail_pitch_map, 0.0, 1.0));
		}

		// --- Oscillator Node rail_osc (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = ((p.frequency) * math.pow(2.0, math.clamp(f32(node_rail_pitch_map_out), -10.0, 10.0))) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_rail_osc_phase[i] = math.mod(voice.osc_rail_osc_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_rail_osc_phase[i] + phase_rads, 2 * f32(math.PI));
				if final_phase < 2 * f32(math.PI) * math.clamp(f32(f32(0.300000000)), 0.01, 0.99) do unison_out += 1.0; else do unison_out -= 1.0;
			}
			node_rail_osc_out = (unison_out / f32(unison_count)) * (p.amplitude);
		}

		// --- Filter Node rail_ring (SVF) ---
		{
			cutoff_c_rail_ring: f32 = math.clamp(f32(p.cutoff), 10.0, sample_rate * 0.16);
			f_rail_ring := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_rail_ring / sample_rate));
			q_rail_ring: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_rail_ring);
			voice.filter_rail_ring_low += f_rail_ring * voice.filter_rail_ring_band;
			high_rail_ring := f32(((node_rail_osc_out)) - voice.filter_rail_ring_low - q_rail_ring * voice.filter_rail_ring_band);
			voice.filter_rail_ring_band += f_rail_ring * high_rail_ring;
			node_rail_ring_out = voice.filter_rail_ring_band;
		}

		// --- ADSR Node rail_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_rail_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.001000000)) > 0 do envelope = voice.adsr_rail_amp_attack_start + (1.0 - voice.adsr_rail_amp_attack_start) * (voice.age / math.max(f32(f32(0.001000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_rail_amp_release_level = envelope;
				if voice.age >= (f32(0.001000000)) {
					voice.adsr_rail_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.001000000));
				if (p.Amp_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Amp_decay), 0.000001)) * (1.0 - (f32(0.000000000))); else do envelope = (f32(0.000000000));
				voice.adsr_rail_amp_release_level = envelope;
				if time_in_decay >= (p.Amp_decay) {
					voice.adsr_rail_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.000000000));
				voice.adsr_rail_amp_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.050000000)) > 0 do envelope = voice.adsr_rail_amp_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.050000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_rail_amp_stage = .Idle;
				}
			}
			vel_scale_rail_amp: f32 = (1.0 - (f32(0.400000000))) + (f32(0.400000000)) * voice.velocity;
			node_rail_amp_out = ((node_rail_ring_out)) * envelope * (f32(1.000000000)) * vel_scale_rail_amp;
		}

		node_rail_amp_out_vsum += node_rail_amp_out
		if voice.adsr_rail_amp_stage != .Idle do voice_busy = true
		if voice.adsr_rail_pitch_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}

	// --- Bus effects (once per sample, post voice sum) ---
	{
		node_rail_amp_out := node_rail_amp_out_vsum
		node_rail_comb_out: f32 = 0.0
		// --- Delay Node rail_comb ---
		{
			delay_samples_rail_comb := int(math.clamp((f32(0.045000000)) * sample_rate, 1, 96000-1));
			read_index_rail_comb := (p.delay_rail_comb_write_index - delay_samples_rail_comb + len(p.delay_rail_comb_buffer)) % len(p.delay_rail_comb_buffer);
			delayed_sample_rail_comb := p.delay_rail_comb_buffer[read_index_rail_comb];
			p.delay_rail_comb_buffer[p.delay_rail_comb_write_index] = ((node_rail_amp_out)) + delayed_sample_rail_comb * math.clamp(f32(p.feedback), 0.0, 0.95);
			p.delay_rail_comb_write_index = (p.delay_rail_comb_write_index + 1) % len(p.delay_rail_comb_buffer);
			node_rail_comb_out = ((node_rail_amp_out)) * (1.0 - (p.mix)) + delayed_sample_rail_comb * (p.mix);
		}

		output_left += node_rail_comb_out
		output_right += node_rail_comb_out
	}

	// B7-2-followup / SKB-016: a baked worst-case constant here held
	// is_playing true for minutes on real content (every exposed tail param
	// contributed its range maximum, so glassy-fm-pluck alone baked 202.5s
	// for a true tail under 2s). Arm on the FALLING EDGE instead, from the
	// live field values — that is one ln/pow per note-off rather than per
	// sample, which is what keeps this proc off the audio path.
	{
		voice_alive := false
		for i in 0..<4 {
			if p.voices[i].active {
				voice_alive = true
				break
			}
		}
		if voice_alive || p.playing {
			p.bus_tail_armed = false
			p.bus_tail_remaining = 0
		} else if !p.bus_tail_armed {
			p.bus_tail_armed = true
			p.bus_tail_remaining = u64(GW_SFX_Sniper_Rail_bus_tail_seconds(p) * sample_rate)
		} else if p.bus_tail_remaining > 0 {
			p.bus_tail_remaining -= 1
		}
	}
	if math.is_nan(output_left) || math.is_inf(output_left) || math.is_nan(output_right) || math.is_inf(output_right) {
		p.nonfinite_count += 1
		output_left, output_right = 0.0, 0.0
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
GW_SFX_Sniper_Rail_process_sequence :: proc(p: ^GW_SFX_Sniper_Rail_Processor) {
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	GW_SFX_Sniper_Rail: ^GW_SFX_Sniper_Rail_Processor,
	master_volume: f32,
	dc: Skald_Dc_Block_State,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.750000000
	p.dc = {}
	p.GW_SFX_Sniper_Rail = new(GW_SFX_Sniper_Rail_Processor)
	GW_SFX_Sniper_Rail_init(p.GW_SFX_Sniper_Rail, sr)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := GW_SFX_Sniper_Rail_process(p.GW_SFX_Sniper_Rail); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	mixed_left, mixed_right = skald_dc_block(&p.dc, mixed_left, mixed_right)
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.GW_SFX_Sniper_Rail)
}

