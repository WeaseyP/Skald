SNES_Slap_Bass_set_param :: proc(p: ^SNES_Slap_Bass_Processor, name: string, value: f32) -> bool {
	switch name {
	case "Amp_decay", "bass-amp::decay":
		SNES_Slap_Bass_set_Amp_decay(p, value)
		return true
	case "Slap_Env_decay", "bass-fenv::decay":
		SNES_Slap_Bass_set_Slap_Env_decay(p, value)
		return true
	case "amplitude", "bass-osc::amplitude":
		SNES_Slap_Bass_set_amplitude(p, value)
		return true
	case "cutoff", "bass-filter::cutoff":
		SNES_Slap_Bass_set_cutoff(p, value)
		return true
	case "drive", "bass-grit::drive":
		SNES_Slap_Bass_set_drive(p, value)
		return true
	case "mix", "bass-grit::mix":
		SNES_Slap_Bass_set_mix(p, value)
		return true
	case "resonance", "bass-filter::resonance":
		SNES_Slap_Bass_set_resonance(p, value)
		return true
	case "sustain", "bass-amp::sustain":
		SNES_Slap_Bass_set_sustain(p, value)
		return true
	}
	return false
}

SNES_Slap_Bass_get_param :: proc(p: ^SNES_Slap_Bass_Processor, name: string) -> (f32, bool) {
	switch name {
	case "Amp_decay", "bass-amp::decay":
		return p.Amp_decay, true
	case "Slap_Env_decay", "bass-fenv::decay":
		return p.Slap_Env_decay, true
	case "amplitude", "bass-osc::amplitude":
		return p.amplitude, true
	case "cutoff", "bass-filter::cutoff":
		return p.cutoff, true
	case "drive", "bass-grit::drive":
		return p.drive, true
	case "mix", "bass-grit::mix":
		return p.mix, true
	case "resonance", "bass-filter::resonance":
		return p.resonance, true
	case "sustain", "bass-amp::sustain":
		return p.sustain, true
	}
	return 0.0, false
}

SNES_Slap_Bass_process :: proc(p: ^SNES_Slap_Bass_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	SNES_Slap_Bass_process_sequence(p)
	p.total_samples += 1

	for v_idx in 0..<1 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.current_freq != voice.target_freq {
			glide_k := 1.0 / math.max(voice.glide_time * sample_rate, 1.0)
			if glide_k > 1.0 do glide_k = 1.0
			voice.current_freq += (voice.target_freq - voice.current_freq) * glide_k
			if abs(voice.target_freq - voice.current_freq) < 0.1 do voice.current_freq = voice.target_freq
		}
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_bass_amp_stage != .Release && voice.adsr_bass_amp_stage != .Idle {
				voice.adsr_bass_amp_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_bass_fenv_stage != .Release && voice.adsr_bass_fenv_stage != .Idle {
				voice.adsr_bass_fenv_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_bass_amp_out: f32 = 0.0
		node_bass_fenv_out: f32 = 0.0
		node_bass_filter_out: f32 = 0.0
		node_bass_fmap_out: f32 = 0.0
		node_bass_grit_out: f32 = 0.0
		node_bass_osc_out: f32 = 0.0
		node_bass_output_out: f32 = 0.0

		// --- ADSR Node bass_fenv ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_bass_fenv_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.001000000)) > 0 do envelope = voice.adsr_bass_fenv_attack_start + (1.0 - voice.adsr_bass_fenv_attack_start) * (voice.age / math.max(f32(f32(0.001000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_bass_fenv_release_level = envelope;
				if voice.age >= (f32(0.001000000)) {
					voice.adsr_bass_fenv_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.001000000));
				if (p.Slap_Env_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Slap_Env_decay), 0.000001)) * (1.0 - (f32(0.100000000))); else do envelope = (f32(0.100000000));
				voice.adsr_bass_fenv_release_level = envelope;
				if time_in_decay >= (p.Slap_Env_decay) {
					voice.adsr_bass_fenv_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.100000000));
				voice.adsr_bass_fenv_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.050000000)) > 0 do envelope = voice.adsr_bass_fenv_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.050000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_bass_fenv_stage = .Idle;
				}
			}
			vel_scale_bass_fenv: f32 = (1.0 - (f32(0.700000000))) + (f32(0.700000000)) * voice.velocity;
			node_bass_fenv_out = (1.0) * envelope * (f32(1.000000000)) * vel_scale_bass_fenv;
		}

		// --- Oscillator Node bass_osc (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_bass_osc_phase[i] = math.mod(voice.osc_bass_osc_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_bass_osc_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += ((final_phase / f32(math.PI)) - 1.0);
			}
			node_bass_osc_out = (unison_out / f32(unison_count)) * (p.amplitude);
		}

		// --- Mapper Node bass_fmap ---
		{
			in_range_bass_fmap: f32 = f32(f32(1.000000000)) - f32(f32(0.000000000));
			if in_range_bass_fmap == 0.0 do in_range_bass_fmap = 1.0;
			node_bass_fmap_out = math.lerp(f32(f32(200.000000000)), f32(f32(3600.000000000)), math.clamp((f32((node_bass_fenv_out)) - f32(f32(0.000000000))) / in_range_bass_fmap, 0.0, 1.0));
		}

		// --- ADSR Node bass_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_bass_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.002000000)) > 0 do envelope = voice.adsr_bass_amp_attack_start + (1.0 - voice.adsr_bass_amp_attack_start) * (voice.age / math.max(f32(f32(0.002000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_bass_amp_release_level = envelope;
				if voice.age >= (f32(0.002000000)) {
					voice.adsr_bass_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.002000000));
				if (p.Amp_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Amp_decay), 0.000001)) * (1.0 - (p.sustain)); else do envelope = (p.sustain);
				voice.adsr_bass_amp_release_level = envelope;
				if time_in_decay >= (p.Amp_decay) {
					voice.adsr_bass_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.sustain);
				voice.adsr_bass_amp_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.080000000)) > 0 do envelope = voice.adsr_bass_amp_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.080000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_bass_amp_stage = .Idle;
				}
			}
			vel_scale_bass_amp: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_bass_amp_out = ((node_bass_osc_out)) * envelope * (f32(1.000000000)) * vel_scale_bass_amp;
		}

		// --- Filter Node bass_filter (SVF) ---
		{
			cutoff_c_bass_filter: f32 = math.clamp(f32((p.cutoff) + (node_bass_fmap_out)), 10.0, sample_rate * 0.16);
			f_bass_filter := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_bass_filter / sample_rate));
			q_bass_filter: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_bass_filter);
			voice.filter_bass_filter_low += f_bass_filter * voice.filter_bass_filter_band;
			high_bass_filter := f32(((node_bass_amp_out)) - voice.filter_bass_filter_low - q_bass_filter * voice.filter_bass_filter_band);
			voice.filter_bass_filter_band += f_bass_filter * high_bass_filter;
			node_bass_filter_out = voice.filter_bass_filter_low;
		}

		// --- Distortion Node bass_grit (soft) ---
		{
			dist_in_bass_grit: f32 = ((node_bass_filter_out));
			dist_k_bass_grit: f32 = math.max(f32(p.drive), 1.0);
			dist_wet_bass_grit: f32 = math.tanh(dist_in_bass_grit * dist_k_bass_grit);
			tone_k_bass_grit: f32 = math.clamp(2.0 * f32(math.PI) * math.clamp(f32(f32(2600.000000000)), 100.0, 20000.0) / sample_rate, 0.001, 1.0);
			voice.dist_bass_grit_tone += tone_k_bass_grit * (dist_wet_bass_grit - voice.dist_bass_grit_tone);
			mix_bass_grit: f32 = math.clamp(f32(p.mix), 0.0, 1.0);
			node_bass_grit_out = dist_in_bass_grit * (1.0 - mix_bass_grit) + voice.dist_bass_grit_tone * mix_bass_grit;
		}

		output_left += node_bass_grit_out
		output_right += node_bass_grit_out
		if voice.adsr_bass_amp_stage != .Idle do voice_busy = true
		if voice.adsr_bass_fenv_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	if math.is_nan(output_left) || math.is_inf(output_left) || math.is_nan(output_right) || math.is_inf(output_right) {
		p.nonfinite_count += 1
		output_left, output_right = 0.0, 0.0
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
SNES_Slap_Bass_process_sequence :: proc(p: ^SNES_Slap_Bass_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "SNES Slap Bass" (16 steps)
		switch p.current_step % 16 {
		case 0:
			SNES_Slap_Bass_note_on(p, 33, 1.000000000, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 2:
			SNES_Slap_Bass_note_on(p, 33, 0.750000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 3:
			SNES_Slap_Bass_note_on(p, 45, 0.850000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 6:
			SNES_Slap_Bass_note_on(p, 33, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			SNES_Slap_Bass_note_on(p, 33, 0.949999988, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 11:
			SNES_Slap_Bass_note_on(p, 40, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			SNES_Slap_Bass_note_on(p, 45, 0.850000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 14:
			SNES_Slap_Bass_note_on(p, 43, 0.800000012, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	SNES_Slap_Bass: ^SNES_Slap_Bass_Processor,
	master_volume: f32,
	dc: Skald_Dc_Block_State,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.750000000
	p.dc = {}
	p.SNES_Slap_Bass = new(SNES_Slap_Bass_Processor)
	SNES_Slap_Bass_init(p.SNES_Slap_Bass, sr)
	SNES_Slap_Bass_start(p.SNES_Slap_Bass)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := SNES_Slap_Bass_process(p.SNES_Slap_Bass); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	mixed_left, mixed_right = skald_dc_block(&p.dc, mixed_left, mixed_right)
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.SNES_Slap_Bass)
}

