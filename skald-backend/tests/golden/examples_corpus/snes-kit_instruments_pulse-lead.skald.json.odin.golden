SNES_Pulse_Lead_process :: proc(p: ^SNES_Pulse_Lead_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	SNES_Pulse_Lead_process_sequence(p)
	p.total_samples += 1

	node_lead_tone_out_vsum: f32 = 0.0
	for v_idx in 0..<2 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.current_freq != voice.target_freq {
			glide_k := 1.0 / math.max(voice.glide_time * sample_rate, 1.0)
			if glide_k > 1.0 do glide_k = 1.0
			voice.current_freq += (voice.target_freq - voice.current_freq) * glide_k
			if abs(voice.target_freq - voice.current_freq) < 0.1 do voice.current_freq = voice.target_freq
		}
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_lead_amp_stage != .Release && voice.adsr_lead_amp_stage != .Idle {
				voice.adsr_lead_amp_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_lead_amp_out: f32 = 0.0
		node_lead_osc_out: f32 = 0.0
		node_lead_pwm_lfo_out: f32 = 0.0
		node_lead_pwm_map_out: f32 = 0.0
		node_lead_tone_out: f32 = 0.0
		node_lead_vib_lfo_out: f32 = 0.0
		node_lead_vib_map_out: f32 = 0.0

		// --- LFO Node lead_pwm_lfo ---
		voice.lfo_lead_pwm_lfo_phase = math.mod(voice.lfo_lead_pwm_lfo_phase + (2 * f32(math.PI) * (p.PWM_Drift_frequency) / sample_rate), 2 * f32(math.PI));
		if voice.lfo_lead_pwm_lfo_phase < 0.0 do voice.lfo_lead_pwm_lfo_phase += 2 * f32(math.PI);
		node_lead_pwm_lfo_out = math.sin(voice.lfo_lead_pwm_lfo_phase) * (p.PWM_Drift_amplitude);

		// --- LFO Node lead_vib_lfo ---
		voice.lfo_lead_vib_lfo_phase = math.mod(voice.lfo_lead_vib_lfo_phase + (2 * f32(math.PI) * (p.Vibrato_frequency) / sample_rate), 2 * f32(math.PI));
		if voice.lfo_lead_vib_lfo_phase < 0.0 do voice.lfo_lead_vib_lfo_phase += 2 * f32(math.PI);
		node_lead_vib_lfo_out = math.sin(voice.lfo_lead_vib_lfo_phase) * (p.Vibrato_amplitude);

		// --- Mapper Node lead_pwm_map ---
		{
			in_range_lead_pwm_map: f32 = f32(f32(1.000000000)) - f32(f32(-1.000000000));
			if in_range_lead_pwm_map == 0.0 do in_range_lead_pwm_map = 1.0;
			node_lead_pwm_map_out = math.lerp(f32(f32(-0.120000000)), f32(f32(0.120000000)), math.clamp((f32((node_lead_pwm_lfo_out)) - f32(f32(-1.000000000))) / in_range_lead_pwm_map, 0.0, 1.0));
		}

		// --- Mapper Node lead_vib_map ---
		{
			in_range_lead_vib_map: f32 = f32(f32(1.000000000)) - f32(f32(-1.000000000));
			if in_range_lead_vib_map == 0.0 do in_range_lead_vib_map = 1.0;
			node_lead_vib_map_out = math.lerp(f32(f32(-0.012000000)), f32(f32(0.012000000)), math.clamp((f32((node_lead_vib_lfo_out)) - f32(f32(-1.000000000))) / in_range_lead_vib_map, 0.0, 1.0));
		}

		// --- Oscillator Node lead_osc (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = ((voice.current_freq) * math.pow(2.0, math.clamp(f32(node_lead_vib_map_out), -10.0, 10.0))) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_lead_osc_phase[i] = math.mod(voice.osc_lead_osc_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_lead_osc_phase[i] + phase_rads, 2 * f32(math.PI));
				if final_phase < 2 * f32(math.PI) * math.clamp(f32((p.pulseWidth) + (node_lead_pwm_map_out)), 0.01, 0.99) do unison_out += 1.0; else do unison_out -= 1.0;
			}
			node_lead_osc_out = (unison_out / f32(unison_count)) * (p.Pulse_amplitude);
		}

		// --- ADSR Node lead_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_lead_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.attack) > 0 do envelope = voice.adsr_lead_amp_attack_start + (1.0 - voice.adsr_lead_amp_attack_start) * (voice.age / math.max(f32(p.attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_lead_amp_release_level = envelope;
				if voice.age >= (p.attack) {
					voice.adsr_lead_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.attack);
				if (f32(0.080000000)) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(f32(0.080000000)), 0.000001)) * (1.0 - (f32(0.750000000))); else do envelope = (f32(0.750000000));
				voice.adsr_lead_amp_release_level = envelope;
				if time_in_decay >= (f32(0.080000000)) {
					voice.adsr_lead_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.750000000));
				voice.adsr_lead_amp_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.release) > 0 do envelope = voice.adsr_lead_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_lead_amp_stage = .Idle;
				}
			}
			vel_scale_lead_amp: f32 = (1.0 - (f32(0.400000000))) + (f32(0.400000000)) * voice.velocity;
			node_lead_amp_out = ((node_lead_osc_out)) * envelope * (f32(1.000000000)) * vel_scale_lead_amp;
		}

		// --- Filter Node lead_tone (SVF) ---
		{
			cutoff_c_lead_tone: f32 = math.clamp(f32(p.cutoff), 10.0, sample_rate * 0.16);
			f_lead_tone := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_lead_tone / sample_rate));
			q_lead_tone: f32 = math.clamp(1.0 / math.max(f32(f32(0.800000000)), 0.1), 0.05, 1.9 - f_lead_tone);
			voice.filter_lead_tone_low += f_lead_tone * voice.filter_lead_tone_band;
			high_lead_tone := f32(((node_lead_amp_out)) - voice.filter_lead_tone_low - q_lead_tone * voice.filter_lead_tone_band);
			voice.filter_lead_tone_band += f_lead_tone * high_lead_tone;
			node_lead_tone_out = voice.filter_lead_tone_low;
		}

		node_lead_tone_out_vsum += node_lead_tone_out
		if voice.adsr_lead_amp_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}

	// --- Bus effects (once per sample, post voice sum) ---
	{
		node_lead_tone_out := node_lead_tone_out_vsum
		node_lead_echo_out: f32 = 0.0
		// --- Delay Node lead_echo ---
		{
			delay_samples_lead_echo := int(math.clamp((((60.0 / p.bpm) * 0.500000000)) * sample_rate, 1, 96000-1));
			read_index_lead_echo := (p.delay_lead_echo_write_index - delay_samples_lead_echo + len(p.delay_lead_echo_buffer)) % len(p.delay_lead_echo_buffer);
			delayed_sample_lead_echo := p.delay_lead_echo_buffer[read_index_lead_echo];
			p.delay_lead_echo_buffer[p.delay_lead_echo_write_index] = ((node_lead_tone_out)) + delayed_sample_lead_echo * math.clamp(f32(p.feedback), 0.0, 0.95);
			p.delay_lead_echo_write_index = (p.delay_lead_echo_write_index + 1) % len(p.delay_lead_echo_buffer);
			node_lead_echo_out = ((node_lead_tone_out)) * (1.0 - (p.mix)) + delayed_sample_lead_echo * (p.mix);
		}

		output_left += node_lead_echo_out
		output_right += node_lead_echo_out
	}

	// B7-2-followup / SKB-016: a baked worst-case constant here held
	// is_playing true for minutes on real content (every exposed tail param
	// contributed its range maximum, so glassy-fm-pluck alone baked 202.5s
	// for a true tail under 2s). Arm on the FALLING EDGE instead, from the
	// live field values — that is one ln/pow per note-off rather than per
	// sample, which is what keeps this proc off the audio path.
	{
		voice_alive := false
		for i in 0..<2 {
			if p.voices[i].active {
				voice_alive = true
				break
			}
		}
		if voice_alive || p.playing {
			p.bus_tail_armed = false
			p.bus_tail_remaining = 0
		} else if !p.bus_tail_armed {
			p.bus_tail_armed = true
			p.bus_tail_remaining = u64(SNES_Pulse_Lead_bus_tail_seconds(p) * sample_rate)
		} else if p.bus_tail_remaining > 0 {
			p.bus_tail_remaining -= 1
		}
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
SNES_Pulse_Lead_process_sequence :: proc(p: ^SNES_Pulse_Lead_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "SNES Pulse Lead" (16 steps)
		switch p.current_step % 16 {
		case 0:
			SNES_Pulse_Lead_note_on(p, 69, 0.899999976, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 2:
			SNES_Pulse_Lead_note_on(p, 72, 0.800000012, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 4:
			SNES_Pulse_Lead_note_on(p, 76, 0.949999988, f32(4.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			SNES_Pulse_Lead_note_on(p, 74, 0.800000012, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 10:
			SNES_Pulse_Lead_note_on(p, 72, 0.800000012, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			SNES_Pulse_Lead_note_on(p, 69, 0.850000024, f32(4.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	SNES_Pulse_Lead: ^SNES_Pulse_Lead_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.750000000
	p.SNES_Pulse_Lead = new(SNES_Pulse_Lead_Processor)
	SNES_Pulse_Lead_init(p.SNES_Pulse_Lead, sr)
	SNES_Pulse_Lead_start(p.SNES_Pulse_Lead)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := SNES_Pulse_Lead_process(p.SNES_Pulse_Lead); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.SNES_Pulse_Lead)
}

