SNES_Starfield_Arp_set_param :: proc(p: ^SNES_Starfield_Arp_Processor, name: string, value: f32) -> bool {
	switch name {
	case "Glass_amplitude", "arp-osc::amplitude":
		SNES_Starfield_Arp_set_Glass_amplitude(p, value)
		return true
	case "Random_Steps_amplitude", "arp-sh::amplitude":
		SNES_Starfield_Arp_set_Random_Steps_amplitude(p, value)
		return true
	case "cutoff", "arp-filter::cutoff":
		SNES_Starfield_Arp_set_cutoff(p, value)
		return true
	case "decay", "arp-amp::decay":
		SNES_Starfield_Arp_set_decay(p, value)
		return true
	case "feedback", "arp-echo::feedback":
		SNES_Starfield_Arp_set_feedback(p, value)
		return true
	case "mix", "arp-echo::mix":
		SNES_Starfield_Arp_set_mix(p, value)
		return true
	case "release", "arp-amp::release":
		SNES_Starfield_Arp_set_release(p, value)
		return true
	case "resonance", "arp-filter::resonance":
		SNES_Starfield_Arp_set_resonance(p, value)
		return true
	}
	return false
}

SNES_Starfield_Arp_get_param :: proc(p: ^SNES_Starfield_Arp_Processor, name: string) -> (f32, bool) {
	switch name {
	case "Glass_amplitude", "arp-osc::amplitude":
		return p.Glass_amplitude, true
	case "Random_Steps_amplitude", "arp-sh::amplitude":
		return p.Random_Steps_amplitude, true
	case "cutoff", "arp-filter::cutoff":
		return p.cutoff, true
	case "decay", "arp-amp::decay":
		return p.decay, true
	case "feedback", "arp-echo::feedback":
		return p.feedback, true
	case "mix", "arp-echo::mix":
		return p.mix, true
	case "release", "arp-amp::release":
		return p.release, true
	case "resonance", "arp-filter::resonance":
		return p.resonance, true
	}
	return 0.0, false
}

SNES_Starfield_Arp_process :: proc(p: ^SNES_Starfield_Arp_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	SNES_Starfield_Arp_process_sequence(p)
	p.total_samples += 1

	node_arp_filter_out_vsum: f32 = 0.0
	for v_idx in 0..<4 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_arp_amp_stage != .Release && voice.adsr_arp_amp_stage != .Idle {
				voice.adsr_arp_amp_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_arp_amp_out: f32 = 0.0
		node_arp_filter_out: f32 = 0.0
		node_arp_osc_out: f32 = 0.0
		node_arp_sh_out: f32 = 0.0
		node_arp_sh_map_out: f32 = 0.0

		// --- Oscillator Node arp_osc (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_arp_osc_phase[i] = math.mod(voice.osc_arp_osc_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_arp_osc_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += (2.0 / f32(math.PI)) * math.asin(math.sin(final_phase));
			}
			node_arp_osc_out = (unison_out / f32(unison_count)) * (p.Glass_amplitude);
		}

		// --- Sample & Hold Node arp_sh ---
		voice.sh_arp_sh_counter += 1;
		update_interval_arp_sh := u64(sample_rate / math.max(f32((1.0 / ((60.0 / p.bpm) * 0.250000000))), 0.1));
		if voice.sh_arp_sh_counter >= update_interval_arp_sh {
			voice.sh_arp_sh_current_value = next_float32(&voice.sh_arp_sh_rng) * 2.0 - 1.0;
			voice.sh_arp_sh_counter = 0;
		}
		node_arp_sh_out = voice.sh_arp_sh_current_value * (p.Random_Steps_amplitude);

		// --- ADSR Node arp_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_arp_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.001000000)) > 0 do envelope = voice.adsr_arp_amp_attack_start + (1.0 - voice.adsr_arp_amp_attack_start) * (voice.age / math.max(f32(f32(0.001000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_arp_amp_release_level = envelope;
				if voice.age >= (f32(0.001000000)) {
					voice.adsr_arp_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.001000000));
				if (p.decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.decay), 0.000001)) * (1.0 - (f32(0.000000000))); else do envelope = (f32(0.000000000));
				voice.adsr_arp_amp_release_level = envelope;
				if time_in_decay >= (p.decay) {
					voice.adsr_arp_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.000000000));
				voice.adsr_arp_amp_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.release) > 0 do envelope = voice.adsr_arp_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_arp_amp_stage = .Idle;
				}
			}
			vel_scale_arp_amp: f32 = (1.0 - (f32(0.700000000))) + (f32(0.700000000)) * voice.velocity;
			node_arp_amp_out = ((node_arp_osc_out)) * envelope * (f32(1.000000000)) * vel_scale_arp_amp;
		}

		// --- Mapper Node arp_sh_map ---
		{
			in_range_arp_sh_map: f32 = f32(f32(1.000000000)) - f32(f32(-1.000000000));
			if in_range_arp_sh_map == 0.0 do in_range_arp_sh_map = 1.0;
			node_arp_sh_map_out = math.lerp(f32(f32(-700.000000000)), f32(f32(1800.000000000)), math.clamp((f32((node_arp_sh_out)) - f32(f32(-1.000000000))) / in_range_arp_sh_map, 0.0, 1.0));
		}

		// --- Filter Node arp_filter (SVF) ---
		{
			cutoff_c_arp_filter: f32 = math.clamp(f32((p.cutoff) + (node_arp_sh_map_out)), 10.0, sample_rate * 0.16);
			f_arp_filter := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_arp_filter / sample_rate));
			q_arp_filter: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_arp_filter);
			voice.filter_arp_filter_low += f_arp_filter * voice.filter_arp_filter_band;
			high_arp_filter := f32(((node_arp_amp_out)) - voice.filter_arp_filter_low - q_arp_filter * voice.filter_arp_filter_band);
			voice.filter_arp_filter_band += f_arp_filter * high_arp_filter;
			node_arp_filter_out = voice.filter_arp_filter_low;
		}

		node_arp_filter_out_vsum += node_arp_filter_out
		if voice.adsr_arp_amp_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}

	// --- Bus effects (once per sample, post voice sum) ---
	{
		node_arp_filter_out := node_arp_filter_out_vsum
		node_arp_echo_out: f32 = 0.0
		// --- Delay Node arp_echo ---
		{
			delay_samples_arp_echo := int(math.clamp((((60.0 / p.bpm) * 0.500000000)) * sample_rate, 1, 96000-1));
			read_index_arp_echo := (p.delay_arp_echo_write_index - delay_samples_arp_echo + len(p.delay_arp_echo_buffer)) % len(p.delay_arp_echo_buffer);
			delayed_sample_arp_echo := p.delay_arp_echo_buffer[read_index_arp_echo];
			p.delay_arp_echo_buffer[p.delay_arp_echo_write_index] = ((node_arp_filter_out)) + delayed_sample_arp_echo * math.clamp(f32(p.feedback), 0.0, 0.95);
			p.delay_arp_echo_write_index = (p.delay_arp_echo_write_index + 1) % len(p.delay_arp_echo_buffer);
			node_arp_echo_out = ((node_arp_filter_out)) * (1.0 - (p.mix)) + delayed_sample_arp_echo * (p.mix);
		}

		output_left += node_arp_echo_out
		output_right += node_arp_echo_out
	}

	// B7-2-followup / SKB-016: a baked worst-case constant here held
	// is_playing true for minutes on real content (every exposed tail param
	// contributed its range maximum, so glassy-fm-pluck alone baked 202.5s
	// for a true tail under 2s). Arm on the FALLING EDGE instead, from the
	// live field values — that is one ln/pow per note-off rather than per
	// sample, which is what keeps this proc off the audio path.
	{
		voice_alive := false
		for i in 0..<4 {
			if p.voices[i].active {
				voice_alive = true
				break
			}
		}
		if voice_alive || p.playing {
			p.bus_tail_armed = false
			p.bus_tail_remaining = 0
		} else if !p.bus_tail_armed {
			p.bus_tail_armed = true
			p.bus_tail_remaining = u64(SNES_Starfield_Arp_bus_tail_seconds(p) * sample_rate)
		} else if p.bus_tail_remaining > 0 {
			p.bus_tail_remaining -= 1
		}
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
SNES_Starfield_Arp_process_sequence :: proc(p: ^SNES_Starfield_Arp_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "SNES Starfield Arp" (16 steps)
		switch p.current_step % 16 {
		case 0:
			SNES_Starfield_Arp_note_on(p, 74, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 1:
			SNES_Starfield_Arp_note_on(p, 77, 0.600000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 2:
			SNES_Starfield_Arp_note_on(p, 81, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 3:
			SNES_Starfield_Arp_note_on(p, 84, 0.600000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 4:
			SNES_Starfield_Arp_note_on(p, 81, 0.750000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 5:
			SNES_Starfield_Arp_note_on(p, 77, 0.600000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 6:
			SNES_Starfield_Arp_note_on(p, 74, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 7:
			SNES_Starfield_Arp_note_on(p, 72, 0.600000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			SNES_Starfield_Arp_note_on(p, 74, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 9:
			SNES_Starfield_Arp_note_on(p, 77, 0.600000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 10:
			SNES_Starfield_Arp_note_on(p, 81, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 11:
			SNES_Starfield_Arp_note_on(p, 84, 0.600000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			SNES_Starfield_Arp_note_on(p, 81, 0.750000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 13:
			SNES_Starfield_Arp_note_on(p, 77, 0.600000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 14:
			SNES_Starfield_Arp_note_on(p, 74, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 15:
			SNES_Starfield_Arp_note_on(p, 72, 0.550000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	SNES_Starfield_Arp: ^SNES_Starfield_Arp_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.750000000
	p.SNES_Starfield_Arp = new(SNES_Starfield_Arp_Processor)
	SNES_Starfield_Arp_init(p.SNES_Starfield_Arp, sr)
	SNES_Starfield_Arp_start(p.SNES_Starfield_Arp)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := SNES_Starfield_Arp_process(p.SNES_Starfield_Arp); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.SNES_Starfield_Arp)
}

