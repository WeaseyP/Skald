House_Pluck_Bass_set_param :: proc(p: ^House_Pluck_Bass_Processor, name: string, value: f32) -> bool {
	switch name {
	case "Filter_Env_attack", "pluck-fenv::attack":
		House_Pluck_Bass_set_Filter_Env_attack(p, value)
		return true
	case "Filter_Env_decay", "pluck-fenv::decay":
		House_Pluck_Bass_set_Filter_Env_decay(p, value)
		return true
	case "Filter_Env_depth", "pluck-fenv::depth":
		House_Pluck_Bass_set_Filter_Env_depth(p, value)
		return true
	case "Filter_Env_release", "pluck-fenv::release":
		House_Pluck_Bass_set_Filter_Env_release(p, value)
		return true
	case "Filter_Env_sustain", "pluck-fenv::sustain":
		House_Pluck_Bass_set_Filter_Env_sustain(p, value)
		return true
	case "Punch_Amp_attack", "pluck-amp::attack":
		House_Pluck_Bass_set_Punch_Amp_attack(p, value)
		return true
	case "Punch_Amp_decay", "pluck-amp::decay":
		House_Pluck_Bass_set_Punch_Amp_decay(p, value)
		return true
	case "Punch_Amp_depth", "pluck-amp::depth":
		House_Pluck_Bass_set_Punch_Amp_depth(p, value)
		return true
	case "Punch_Amp_release", "pluck-amp::release":
		House_Pluck_Bass_set_Punch_Amp_release(p, value)
		return true
	case "Punch_Amp_sustain", "pluck-amp::sustain":
		House_Pluck_Bass_set_Punch_Amp_sustain(p, value)
		return true
	case "Saw_amplitude", "pluck-osc::amplitude":
		House_Pluck_Bass_set_Saw_amplitude(p, value)
		return true
	case "Sub_Sine_amplitude", "pluck-sub::amplitude":
		House_Pluck_Bass_set_Sub_Sine_amplitude(p, value)
		return true
	case "cutoff", "pluck-filter::cutoff":
		House_Pluck_Bass_set_cutoff(p, value)
		return true
	case "drive", "pluck-drive::drive":
		House_Pluck_Bass_set_drive(p, value)
		return true
	case "mix", "pluck-drive::mix":
		House_Pluck_Bass_set_mix(p, value)
		return true
	case "outMax", "pluck-fenv-map::outMax":
		House_Pluck_Bass_set_outMax(p, value)
		return true
	case "resonance", "pluck-filter::resonance":
		House_Pluck_Bass_set_resonance(p, value)
		return true
	case "tone", "pluck-drive::tone":
		House_Pluck_Bass_set_tone(p, value)
		return true
	case "velocitySensitivity", "pluck-amp::velocitySensitivity":
		House_Pluck_Bass_set_velocitySensitivity(p, value)
		return true
	}
	return false
}

House_Pluck_Bass_get_param :: proc(p: ^House_Pluck_Bass_Processor, name: string) -> (f32, bool) {
	switch name {
	case "Filter_Env_attack", "pluck-fenv::attack":
		return p.Filter_Env_attack, true
	case "Filter_Env_decay", "pluck-fenv::decay":
		return p.Filter_Env_decay, true
	case "Filter_Env_depth", "pluck-fenv::depth":
		return p.Filter_Env_depth, true
	case "Filter_Env_release", "pluck-fenv::release":
		return p.Filter_Env_release, true
	case "Filter_Env_sustain", "pluck-fenv::sustain":
		return p.Filter_Env_sustain, true
	case "Punch_Amp_attack", "pluck-amp::attack":
		return p.Punch_Amp_attack, true
	case "Punch_Amp_decay", "pluck-amp::decay":
		return p.Punch_Amp_decay, true
	case "Punch_Amp_depth", "pluck-amp::depth":
		return p.Punch_Amp_depth, true
	case "Punch_Amp_release", "pluck-amp::release":
		return p.Punch_Amp_release, true
	case "Punch_Amp_sustain", "pluck-amp::sustain":
		return p.Punch_Amp_sustain, true
	case "Saw_amplitude", "pluck-osc::amplitude":
		return p.Saw_amplitude, true
	case "Sub_Sine_amplitude", "pluck-sub::amplitude":
		return p.Sub_Sine_amplitude, true
	case "cutoff", "pluck-filter::cutoff":
		return p.cutoff, true
	case "drive", "pluck-drive::drive":
		return p.drive, true
	case "mix", "pluck-drive::mix":
		return p.mix, true
	case "outMax", "pluck-fenv-map::outMax":
		return p.outMax, true
	case "resonance", "pluck-filter::resonance":
		return p.resonance, true
	case "tone", "pluck-drive::tone":
		return p.tone, true
	case "velocitySensitivity", "pluck-amp::velocitySensitivity":
		return p.velocitySensitivity, true
	}
	return 0.0, false
}

House_Pluck_Bass_process :: proc(p: ^House_Pluck_Bass_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	House_Pluck_Bass_process_sequence(p)
	p.total_samples += 1

	for v_idx in 0..<6 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_pluck_amp_stage != .Release && voice.adsr_pluck_amp_stage != .Idle {
				voice.adsr_pluck_amp_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_pluck_fenv_stage != .Release && voice.adsr_pluck_fenv_stage != .Idle {
				voice.adsr_pluck_fenv_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_pluck_amp_out: f32 = 0.0
		node_pluck_drive_out: f32 = 0.0
		node_pluck_fenv_out: f32 = 0.0
		node_pluck_fenv_map_out: f32 = 0.0
		node_pluck_filter_out: f32 = 0.0
		node_pluck_osc_out: f32 = 0.0
		node_pluck_output_out: f32 = 0.0
		node_pluck_sub_out: f32 = 0.0

		// --- ADSR Node pluck_fenv ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_pluck_fenv_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Filter_Env_attack) > 0 do envelope = voice.adsr_pluck_fenv_attack_start + (1.0 - voice.adsr_pluck_fenv_attack_start) * (voice.age / math.max(f32(p.Filter_Env_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_pluck_fenv_release_level = envelope;
				if voice.age >= (p.Filter_Env_attack) {
					voice.adsr_pluck_fenv_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Filter_Env_attack);
				if (p.Filter_Env_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Filter_Env_decay), 0.000001)) * (1.0 - (p.Filter_Env_sustain)); else do envelope = (p.Filter_Env_sustain);
				voice.adsr_pluck_fenv_release_level = envelope;
				if time_in_decay >= (p.Filter_Env_decay) {
					voice.adsr_pluck_fenv_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Filter_Env_sustain);
				voice.adsr_pluck_fenv_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_pluck_fenv_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Filter_Env_release) > 0 do envelope = voice.adsr_pluck_fenv_release_level * (1.0 - (time_in_release / math.max(f32(p.Filter_Env_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_pluck_fenv_stage = .Idle;
				}
			}
			vel_scale_pluck_fenv: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_pluck_fenv_out = (1.0) * envelope * (p.Filter_Env_depth) * vel_scale_pluck_fenv;
		}

		// --- Oscillator Node pluck_osc (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_pluck_osc_phase[i] = math.mod(voice.osc_pluck_osc_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_pluck_osc_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += ((final_phase / f32(math.PI)) - 1.0);
			}
			node_pluck_osc_out = (unison_out / f32(unison_count)) * (p.Saw_amplitude);
		}

		// --- Oscillator Node pluck_sub (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_pluck_sub_phase[i] = math.mod(voice.osc_pluck_sub_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_pluck_sub_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += math.sin(final_phase);
			}
			node_pluck_sub_out = (unison_out / f32(unison_count)) * (p.Sub_Sine_amplitude);
		}

		// --- Mapper Node pluck_fenv_map ---
		{
			in_range_pluck_fenv_map: f32 = f32(f32(1.000000000)) - f32(f32(0.000000000));
			if in_range_pluck_fenv_map == 0.0 do in_range_pluck_fenv_map = 1.0;
			node_pluck_fenv_map_out = math.lerp(f32(f32(0.000000000)), f32(p.outMax), math.clamp((f32((node_pluck_fenv_out)) - f32(f32(0.000000000))) / in_range_pluck_fenv_map, 0.0, 1.0));
		}

		// --- Filter Node pluck_filter (SVF) ---
		{
			cutoff_c_pluck_filter: f32 = math.clamp(f32((p.cutoff) + (node_pluck_fenv_map_out)), 10.0, sample_rate * 0.16);
			f_pluck_filter := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_pluck_filter / sample_rate));
			q_pluck_filter: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_pluck_filter);
			voice.filter_pluck_filter_low += f_pluck_filter * voice.filter_pluck_filter_band;
			high_pluck_filter := f32(((node_pluck_osc_out + node_pluck_sub_out)) - voice.filter_pluck_filter_low - q_pluck_filter * voice.filter_pluck_filter_band);
			voice.filter_pluck_filter_band += f_pluck_filter * high_pluck_filter;
			node_pluck_filter_out = voice.filter_pluck_filter_low;
		}

		// --- ADSR Node pluck_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_pluck_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Punch_Amp_attack) > 0 do envelope = voice.adsr_pluck_amp_attack_start + (1.0 - voice.adsr_pluck_amp_attack_start) * (voice.age / math.max(f32(p.Punch_Amp_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_pluck_amp_release_level = envelope;
				if voice.age >= (p.Punch_Amp_attack) {
					voice.adsr_pluck_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Punch_Amp_attack);
				if (p.Punch_Amp_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Punch_Amp_decay), 0.000001)) * (1.0 - (p.Punch_Amp_sustain)); else do envelope = (p.Punch_Amp_sustain);
				voice.adsr_pluck_amp_release_level = envelope;
				if time_in_decay >= (p.Punch_Amp_decay) {
					voice.adsr_pluck_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Punch_Amp_sustain);
				voice.adsr_pluck_amp_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_pluck_amp_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Punch_Amp_release) > 0 do envelope = voice.adsr_pluck_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.Punch_Amp_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_pluck_amp_stage = .Idle;
				}
			}
			vel_scale_pluck_amp: f32 = (1.0 - (p.velocitySensitivity)) + (p.velocitySensitivity) * voice.velocity;
			node_pluck_amp_out = ((node_pluck_filter_out)) * envelope * (p.Punch_Amp_depth) * vel_scale_pluck_amp;
		}

		// --- Distortion Node pluck_drive (soft) ---
		{
			dist_in_pluck_drive: f32 = ((node_pluck_amp_out));
			dist_k_pluck_drive: f32 = math.max(f32(p.drive), 1.0);
			dist_wet_pluck_drive: f32 = math.tanh(dist_in_pluck_drive * dist_k_pluck_drive);
			tone_k_pluck_drive: f32 = math.clamp(2.0 * f32(math.PI) * math.clamp(f32(p.tone), 100.0, 20000.0) / sample_rate, 0.001, 1.0);
			voice.dist_pluck_drive_tone += tone_k_pluck_drive * (dist_wet_pluck_drive - voice.dist_pluck_drive_tone);
			mix_pluck_drive: f32 = math.clamp(f32(p.mix), 0.0, 1.0);
			node_pluck_drive_out = dist_in_pluck_drive * (1.0 - mix_pluck_drive) + voice.dist_pluck_drive_tone * mix_pluck_drive;
		}

		output_left += node_pluck_drive_out
		output_right += node_pluck_drive_out
		if voice.adsr_pluck_amp_stage != .Idle do voice_busy = true
		if voice.adsr_pluck_fenv_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
House_Pluck_Bass_process_sequence :: proc(p: ^House_Pluck_Bass_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "House Pluck Bass" (16 steps)
		switch p.current_step % 16 {
		case 2:
			House_Pluck_Bass_note_on(p, 40, 0.879999995, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 4:
			House_Pluck_Bass_note_on(p, 40, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 6:
			House_Pluck_Bass_note_on(p, 43, 0.850000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			House_Pluck_Bass_note_on(p, 40, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 10:
			House_Pluck_Bass_note_on(p, 35, 0.819999993, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			House_Pluck_Bass_note_on(p, 38, 0.860000014, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 14:
			House_Pluck_Bass_note_on(p, 40, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	House_Pluck_Bass: ^House_Pluck_Bass_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.740000010
	p.House_Pluck_Bass = new(House_Pluck_Bass_Processor)
	House_Pluck_Bass_init(p.House_Pluck_Bass, sr)
	House_Pluck_Bass_start(p.House_Pluck_Bass)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := House_Pluck_Bass_process(p.House_Pluck_Bass); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.House_Pluck_Bass)
}

