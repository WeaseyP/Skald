Supersaw_Lead_note_on :: proc(p: ^Supersaw_Lead_Processor, note: u8, velocity: f32, duration: f32) {
	// note and velocity are clamped silently to their MIDI/normalized domains.
	note := note
	if note > 127 do note = 127
	velocity := math.clamp(velocity, 0.0, 1.0)
	voice_idx := -1
	for i in 0..<8 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_age: f32 = -1.0
		for i in 0..<8 {
			if p.voices[i].age > oldest_age {
				oldest_age = p.voices[i].age
				voice_idx = i
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	adsr_saw_amp_prev_level: f32 = 0.0
	if stolen && v.adsr_saw_amp_stage != .Idle {
		adsr_saw_amp_prev_level = v.adsr_saw_amp_release_level
		if v.adsr_saw_amp_stage == .Release {
			rel_t_saw_amp: f32 = (p.Amp_release);
			if rel_t_saw_amp > 0.0 {
				rf_saw_amp := 1.0 - (v.age - v.time_released) / math.max(rel_t_saw_amp, 0.000001)
				if rf_saw_amp < 0.0 do rf_saw_amp = 0.0
				adsr_saw_amp_prev_level *= rf_saw_amp
			} else {
				adsr_saw_amp_prev_level = 0.0
			}
		}
	}
	adsr_saw_filter_env_prev_level: f32 = 0.0
	if stolen && v.adsr_saw_filter_env_stage != .Idle {
		adsr_saw_filter_env_prev_level = v.adsr_saw_filter_env_release_level
		if v.adsr_saw_filter_env_stage == .Release {
			rel_t_saw_filter_env: f32 = (p.Filter_Env_release);
			if rel_t_saw_filter_env > 0.0 {
				rf_saw_filter_env := 1.0 - (v.age - v.time_released) / math.max(rel_t_saw_filter_env, 0.000001)
				if rf_saw_filter_env < 0.0 do rf_saw_filter_env = 0.0
				adsr_saw_filter_env_prev_level *= rf_saw_filter_env
			} else {
				adsr_saw_filter_env_prev_level = 0.0
			}
		}
	}
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.020000000
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	v.adsr_saw_amp_stage = .Attack
	v.adsr_saw_amp_attack_start = adsr_saw_amp_prev_level
	v.adsr_saw_amp_release_level = adsr_saw_amp_prev_level
	v.adsr_saw_filter_env_stage = .Attack
	v.adsr_saw_filter_env_attack_start = adsr_saw_filter_env_prev_level
	v.adsr_saw_filter_env_release_level = adsr_saw_filter_env_prev_level
