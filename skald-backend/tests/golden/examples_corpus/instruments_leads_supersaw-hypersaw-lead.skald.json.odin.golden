}

Supersaw_Lead_note_off :: proc(p: ^Supersaw_Lead_Processor, note: u8) {
	// Clamped to match _note_on: `note` is the voice key, so both must map it.
	note := note
	if note > 127 do note = 127
	best := -1
	best_age: f32 = -1.0
	for i in 0..<8 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_saw_amp_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_saw_amp_stage = .Release
		p.voices[best].adsr_saw_filter_env_stage = .Release
	}
}

Supersaw_Lead_trigger :: proc(p: ^Supersaw_Lead_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (p.Amp_attack) + (p.Amp_decay) > d do d = (p.Amp_attack) + (p.Amp_decay)
		if (p.Filter_Env_attack) + (p.Filter_Env_decay) > d do d = (p.Filter_Env_attack) + (p.Filter_Env_decay)
		if d <= 0.0 do d = 0.001
	}
	Supersaw_Lead_note_on(p, note, velocity, d)
}

