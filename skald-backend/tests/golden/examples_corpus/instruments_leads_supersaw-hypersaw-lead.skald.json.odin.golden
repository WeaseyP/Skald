	case "Filter_Env_depth", "saw-filter-env::depth":
		return p.Filter_Env_depth, true
	case "Filter_Env_release", "saw-filter-env::release":
		return p.Filter_Env_release, true
	case "Filter_Env_sustain", "saw-filter-env::sustain":
		return p.Filter_Env_sustain, true
	case "Saws_amplitude", "saw-osc::amplitude":
		return p.Saws_amplitude, true
	case "Vibrato_amplitude", "saw-vibrato::amplitude":
		return p.Vibrato_amplitude, true
	case "cutoff", "saw-filter::cutoff":
		return p.cutoff, true
	case "frequency", "saw-vibrato::frequency":
		return p.frequency, true
	case "outMax", "saw-env-map::outMax":
		return p.outMax, true
	case "resonance", "saw-filter::resonance":
		return p.resonance, true
	}
	return 0.0, false
}

Supersaw_Lead_process :: proc(p: ^Supersaw_Lead_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	Supersaw_Lead_process_sequence(p)
	p.total_samples += 1

	for v_idx in 0..<8 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.current_freq != voice.target_freq {
			glide_k := 1.0 / math.max(voice.glide_time * sample_rate, 1.0)
			if glide_k > 1.0 do glide_k = 1.0
			voice.current_freq += (voice.target_freq - voice.current_freq) * glide_k
			if abs(voice.target_freq - voice.current_freq) < 0.1 do voice.current_freq = voice.target_freq
		}
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_saw_amp_stage != .Release && voice.adsr_saw_amp_stage != .Idle {
				voice.adsr_saw_amp_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_saw_filter_env_stage != .Release && voice.adsr_saw_filter_env_stage != .Idle {
				voice.adsr_saw_filter_env_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_saw_amp_out: f32 = 0.0
		node_saw_env_map_out: f32 = 0.0
		node_saw_filter_out: f32 = 0.0
		node_saw_filter_env_out: f32 = 0.0
		node_saw_osc_out: f32 = 0.0
		node_saw_output_out: f32 = 0.0
		node_saw_vibrato_out: f32 = 0.0

		// --- ADSR Node saw_filter_env ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_saw_filter_env_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Filter_Env_attack) > 0 do envelope = voice.adsr_saw_filter_env_attack_start + (1.0 - voice.adsr_saw_filter_env_attack_start) * (voice.age / math.max(f32(p.Filter_Env_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_saw_filter_env_release_level = envelope;
				if voice.age >= (p.Filter_Env_attack) {
					voice.adsr_saw_filter_env_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Filter_Env_attack);
				if (p.Filter_Env_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Filter_Env_decay), 0.000001)) * (1.0 - (p.Filter_Env_sustain)); else do envelope = (p.Filter_Env_sustain);
				voice.adsr_saw_filter_env_release_level = envelope;
				if time_in_decay >= (p.Filter_Env_decay) {
					voice.adsr_saw_filter_env_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Filter_Env_sustain);
				voice.adsr_saw_filter_env_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_saw_filter_env_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Filter_Env_release) > 0 do envelope = voice.adsr_saw_filter_env_release_level * (1.0 - (time_in_release / math.max(f32(p.Filter_Env_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_saw_filter_env_stage = .Idle;
				}
			}
			vel_scale_saw_filter_env: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_saw_filter_env_out = (1.0) * envelope * (p.Filter_Env_depth) * vel_scale_saw_filter_env;
		}

		// --- LFO Node saw_vibrato ---
		voice.lfo_saw_vibrato_phase = math.mod(voice.lfo_saw_vibrato_phase + (2 * f32(math.PI) * (p.frequency) / sample_rate), 2 * f32(math.PI));
		if voice.lfo_saw_vibrato_phase < 0.0 do voice.lfo_saw_vibrato_phase += 2 * f32(math.PI);
		node_saw_vibrato_out = math.sin(voice.lfo_saw_vibrato_phase) * (p.Vibrato_amplitude);

		// --- Mapper Node saw_env_map ---
		{
			in_range_saw_env_map: f32 = f32(f32(1.000000000)) - f32(f32(0.000000000));
			if in_range_saw_env_map == 0.0 do in_range_saw_env_map = 1.0;
			node_saw_env_map_out = math.lerp(f32(f32(0.000000000)), f32(p.outMax), math.clamp((f32((node_saw_filter_env_out)) - f32(f32(0.000000000))) / in_range_saw_env_map, 0.0, 1.0));
		}

		// --- Oscillator Node saw_osc (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 7;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (30.000000000);
				detuned_freq: f32 = ((voice.current_freq) * math.pow(2.0, math.clamp(f32(node_saw_vibrato_out), -10.0, 10.0))) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_saw_osc_phase[i] = math.mod(voice.osc_saw_osc_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_saw_osc_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += ((final_phase / f32(math.PI)) - 1.0);
			}
			node_saw_osc_out = (unison_out / f32(unison_count)) * (p.Saws_amplitude);
		}

		// --- Filter Node saw_filter (SVF) ---
		{
			cutoff_c_saw_filter: f32 = math.clamp(f32((p.cutoff) + (node_saw_env_map_out)), 10.0, sample_rate * 0.16);
			f_saw_filter := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_saw_filter / sample_rate));
			q_saw_filter: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_saw_filter);
			voice.filter_saw_filter_low += f_saw_filter * voice.filter_saw_filter_band;
			high_saw_filter := f32(((node_saw_osc_out)) - voice.filter_saw_filter_low - q_saw_filter * voice.filter_saw_filter_band);
			voice.filter_saw_filter_band += f_saw_filter * high_saw_filter;
			node_saw_filter_out = voice.filter_saw_filter_low;
		}

		// --- ADSR Node saw_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_saw_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Amp_attack) > 0 do envelope = voice.adsr_saw_amp_attack_start + (1.0 - voice.adsr_saw_amp_attack_start) * (voice.age / math.max(f32(p.Amp_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_saw_amp_release_level = envelope;
				if voice.age >= (p.Amp_attack) {
					voice.adsr_saw_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Amp_attack);
				if (p.Amp_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Amp_decay), 0.000001)) * (1.0 - (p.Amp_sustain)); else do envelope = (p.Amp_sustain);
				voice.adsr_saw_amp_release_level = envelope;
				if time_in_decay >= (p.Amp_decay) {
					voice.adsr_saw_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Amp_sustain);
				voice.adsr_saw_amp_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_saw_amp_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Amp_release) > 0 do envelope = voice.adsr_saw_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.Amp_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_saw_amp_stage = .Idle;
				}
			}
			vel_scale_saw_amp: f32 = (1.0 - (f32(0.600000000))) + (f32(0.600000000)) * voice.velocity;
			node_saw_amp_out = ((node_saw_filter_out)) * envelope * (p.Amp_depth) * vel_scale_saw_amp;
		}

		output_left += node_saw_amp_out
		output_right += node_saw_amp_out
		if voice.adsr_saw_amp_stage != .Idle do voice_busy = true
		if voice.adsr_saw_filter_env_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
Supersaw_Lead_process_sequence :: proc(p: ^Supersaw_Lead_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "Supersaw Lead" (16 steps)
		switch p.current_step % 16 {
		case 0:
			Supersaw_Lead_note_on(p, 69, 0.899999976, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 2:
			Supersaw_Lead_note_on(p, 64, 0.779999971, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 4:
			Supersaw_Lead_note_on(p, 67, 0.819999993, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 6:
			Supersaw_Lead_note_on(p, 69, 0.850000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 7:
			Supersaw_Lead_note_on(p, 72, 0.879999995, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			Supersaw_Lead_note_on(p, 71, 0.860000014, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 10:
			Supersaw_Lead_note_on(p, 64, 0.759999990, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			Supersaw_Lead_note_on(p, 74, 0.920000017, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 14:
			Supersaw_Lead_note_on(p, 69, 0.800000012, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	Supersaw_Lead: ^Supersaw_Lead_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.800000012
	p.Supersaw_Lead = new(Supersaw_Lead_Processor)
	Supersaw_Lead_init(p.Supersaw_Lead, sr)
	Supersaw_Lead_start(p.Supersaw_Lead)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := Supersaw_Lead_process(p.Supersaw_Lead); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.Supersaw_Lead)
}

