Crunch_Rhythm_note_on :: proc(p: ^Crunch_Rhythm_Processor, note: u8, velocity: f32, duration: f32) {
	// note and velocity are clamped silently to their MIDI/normalized domains.
	note := note
	if note > 127 do note = 127
	velocity := math.clamp(velocity, 0.0, 1.0)
	voice_idx := -1
	for i in 0..<8 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_age: f32 = -1.0
		for i in 0..<8 {
			if p.voices[i].age > oldest_age {
				oldest_age = p.voices[i].age
				voice_idx = i
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	adsr_cr_amp_prev_level: f32 = 0.0
	if stolen && v.adsr_cr_amp_stage != .Idle {
		adsr_cr_amp_prev_level = v.adsr_cr_amp_release_level
		if v.adsr_cr_amp_stage == .Release {
			rel_t_cr_amp: f32 = (p.Amp_release);
			if rel_t_cr_amp > 0.0 {
				rf_cr_amp := 1.0 - (v.age - v.time_released) / math.max(rel_t_cr_amp, 0.000001)
				if rf_cr_amp < 0.0 do rf_cr_amp = 0.0
				adsr_cr_amp_prev_level *= rf_cr_amp
			} else {
				adsr_cr_amp_prev_level = 0.0
			}
		}
	}
	adsr_cr_atk_env_prev_level: f32 = 0.0
	if stolen && v.adsr_cr_atk_env_stage != .Idle {
		adsr_cr_atk_env_prev_level = v.adsr_cr_atk_env_release_level
		if v.adsr_cr_atk_env_stage == .Release {
			rel_t_cr_atk_env: f32 = (p.Attack_Env_release);
			if rel_t_cr_atk_env > 0.0 {
				rf_cr_atk_env := 1.0 - (v.age - v.time_released) / math.max(rel_t_cr_atk_env, 0.000001)
				if rf_cr_atk_env < 0.0 do rf_cr_atk_env = 0.0
				adsr_cr_atk_env_prev_level *= rf_cr_atk_env
			} else {
				adsr_cr_atk_env_prev_level = 0.0
			}
		}
	}
	adsr_cr_grit_env_prev_level: f32 = 0.0
	if stolen && v.adsr_cr_grit_env_stage != .Idle {
		adsr_cr_grit_env_prev_level = v.adsr_cr_grit_env_release_level
		if v.adsr_cr_grit_env_stage == .Release {
			rel_t_cr_grit_env: f32 = (p.Grit_Env_release);
			if rel_t_cr_grit_env > 0.0 {
				rf_cr_grit_env := 1.0 - (v.age - v.time_released) / math.max(rel_t_cr_grit_env, 0.000001)
				if rf_cr_grit_env < 0.0 do rf_cr_grit_env = 0.0
				adsr_cr_grit_env_prev_level *= rf_cr_grit_env
			} else {
				adsr_cr_grit_env_prev_level = 0.0
			}
		}
	}
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.000000000
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	v.adsr_cr_amp_stage = .Attack
	v.adsr_cr_amp_attack_start = adsr_cr_amp_prev_level
	v.adsr_cr_amp_release_level = adsr_cr_amp_prev_level
	v.adsr_cr_atk_env_stage = .Attack
	v.adsr_cr_atk_env_attack_start = adsr_cr_atk_env_prev_level
	v.adsr_cr_atk_env_release_level = adsr_cr_atk_env_prev_level
	v.adsr_cr_grit_env_stage = .Attack
	v.adsr_cr_grit_env_attack_start = adsr_cr_grit_env_prev_level
	v.adsr_cr_grit_env_release_level = adsr_cr_grit_env_prev_level
	if !stolen {
		v.dist_cr_drive_tone = 0.0
		v.fm_cr_grit_phase = {}
		v.filter_cr_pre_filter_low = 0.0
		v.filter_cr_pre_filter_band = 0.0
		v.osc_cr_string_phase = {}
	}
}

Crunch_Rhythm_note_off :: proc(p: ^Crunch_Rhythm_Processor, note: u8) {
	// Clamped to match _note_on: `note` is the voice key, so both must map it.
	note := note
	if note > 127 do note = 127
	best := -1
	best_age: f32 = -1.0
	for i in 0..<8 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_cr_amp_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_cr_amp_stage = .Release
		p.voices[best].adsr_cr_atk_env_stage = .Release
		p.voices[best].adsr_cr_grit_env_stage = .Release
	}
}

Crunch_Rhythm_trigger :: proc(p: ^Crunch_Rhythm_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (p.Amp_attack) + (p.Amp_decay) > d do d = (p.Amp_attack) + (p.Amp_decay)
		if (p.Attack_Env_attack) + (p.Attack_Env_decay) > d do d = (p.Attack_Env_attack) + (p.Attack_Env_decay)
		if (p.Grit_Env_attack) + (p.Grit_Env_decay) > d do d = (p.Grit_Env_attack) + (p.Grit_Env_decay)
		if d <= 0.0 do d = 0.001
	}
	Crunch_Rhythm_note_on(p, note, velocity, d)
}

