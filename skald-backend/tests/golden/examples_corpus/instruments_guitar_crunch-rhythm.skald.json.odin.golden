Crunch_Rhythm_set_drive :: proc(p: ^Crunch_Rhythm_Processor, value: f32) {
	v := value
	if v < 1.000000000 do v = 1.000000000
	if v > 100.000000000 do v = 100.000000000
	p.drive = v
}

Crunch_Rhythm_set_frequency :: proc(p: ^Crunch_Rhythm_Processor, value: f32) {
	v := value
	if v < 0.010000000 do v = 0.010000000
	if v > 32.000000000 do v = 32.000000000
	p.frequency = v
}

Crunch_Rhythm_set_mix :: proc(p: ^Crunch_Rhythm_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 1.000000000 do v = 1.000000000
	p.mix = v
}

Crunch_Rhythm_set_modIndex :: proc(p: ^Crunch_Rhythm_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 1000.000000000 do v = 1000.000000000
	p.modIndex = v
}

Crunch_Rhythm_set_outMax :: proc(p: ^Crunch_Rhythm_Processor, value: f32) {
	v := value
	if v < -1000000.000000000 do v = -1000000.000000000
	if v > 1000000.000000000 do v = 1000000.000000000
	p.outMax = v
}

Crunch_Rhythm_set_resonance :: proc(p: ^Crunch_Rhythm_Processor, value: f32) {
	v := value
	if v < 0.100000001 do v = 0.100000001
	if v > 20.000000000 do v = 20.000000000
	p.resonance = v
}

Crunch_Rhythm_set_tone :: proc(p: ^Crunch_Rhythm_Processor, value: f32) {
	v := value
	if v < 100.000000000 do v = 100.000000000
	if v > 20000.000000000 do v = 20000.000000000
	p.tone = v
}

Crunch_Rhythm_set_velocitySensitivity :: proc(p: ^Crunch_Rhythm_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 1.000000000 do v = 1.000000000
	p.velocitySensitivity = v
}

Crunch_Rhythm_PARAMS := []Skald_Param_Info{
	{"Amp_attack", 0.000000000, 10.000000000, 0.004000000, "s"},
	{"Amp_decay", 0.000000000, 10.000000000, 0.250000000, "s"},
	{"Amp_depth", 0.000000000, 1.000000000, 0.800000012, ""},
	{"Amp_release", 0.000000000, 10.000000000, 0.119999997, "s"},
	{"Amp_sustain", 0.000000000, 1.000000000, 0.600000024, ""},
	{"Attack_Env_attack", 0.000000000, 10.000000000, 0.002000000, "s"},
	{"Attack_Env_decay", 0.000000000, 10.000000000, 0.250000000, "s"},
	{"Attack_Env_depth", 0.000000000, 1.000000000, 1.000000000, ""},
	{"Attack_Env_release", 0.000000000, 10.000000000, 0.150000006, "s"},
	{"Attack_Env_sustain", 0.000000000, 1.000000000, 0.449999988, ""},
	{"Grit_Env_attack", 0.000000000, 10.000000000, 0.001000000, "s"},
	{"Grit_Env_decay", 0.000000000, 10.000000000, 0.059999999, "s"},
	{"Grit_Env_depth", 0.000000000, 1.000000000, 0.200000003, ""},
	{"Grit_Env_release", 0.000000000, 10.000000000, 0.029999999, "s"},
	{"Grit_Env_sustain", 0.000000000, 1.000000000, 0.000000000, ""},
	{"amplitude", 0.000000000, 1.000000000, 0.500000000, ""},
	{"cutoff", 20.000000000, 20000.000000000, 900.000000000, "Hz"},
	{"drive", 1.000000000, 100.000000000, 35.000000000, "x"},
	{"frequency", 0.010000000, 32.000000000, 3.000000000, "ratio"},
	{"mix", 0.000000000, 1.000000000, 0.850000024, ""},
	{"modIndex", 0.000000000, 1000.000000000, 0.000000000, ""},
	{"outMax", -1000000.000000000, 1000000.000000000, 1600.000000000, ""},
	{"resonance", 0.100000001, 20.000000000, 0.899999976, "Q"},
	{"tone", 100.000000000, 20000.000000000, 3200.000000000, "Hz"},
	{"velocitySensitivity", 0.000000000, 1.000000000, 0.600000024, ""},
}

Crunch_Rhythm_set_param :: proc(p: ^Crunch_Rhythm_Processor, name: string, value: f32) -> bool {
	switch name {
	case "Amp_attack", "cr-amp::attack":
		Crunch_Rhythm_set_Amp_attack(p, value)
		return true
	case "Amp_decay", "cr-amp::decay":
		Crunch_Rhythm_set_Amp_decay(p, value)
		return true
	case "Amp_depth", "cr-amp::depth":
		Crunch_Rhythm_set_Amp_depth(p, value)
		return true
	case "Amp_release", "cr-amp::release":
		Crunch_Rhythm_set_Amp_release(p, value)
		return true
	case "Amp_sustain", "cr-amp::sustain":
		Crunch_Rhythm_set_Amp_sustain(p, value)
		return true
	case "Attack_Env_attack", "cr-atk-env::attack":
		Crunch_Rhythm_set_Attack_Env_attack(p, value)
		return true
	case "Attack_Env_decay", "cr-atk-env::decay":
		Crunch_Rhythm_set_Attack_Env_decay(p, value)
		return true
	case "Attack_Env_depth", "cr-atk-env::depth":
		Crunch_Rhythm_set_Attack_Env_depth(p, value)
		return true
	case "Attack_Env_release", "cr-atk-env::release":
		Crunch_Rhythm_set_Attack_Env_release(p, value)
		return true
	case "Attack_Env_sustain", "cr-atk-env::sustain":
		Crunch_Rhythm_set_Attack_Env_sustain(p, value)
		return true
	case "Grit_Env_attack", "cr-grit-env::attack":
		Crunch_Rhythm_set_Grit_Env_attack(p, value)
		return true
	case "Grit_Env_decay", "cr-grit-env::decay":
		Crunch_Rhythm_set_Grit_Env_decay(p, value)
		return true
	case "Grit_Env_depth", "cr-grit-env::depth":
		Crunch_Rhythm_set_Grit_Env_depth(p, value)
		return true
	case "Grit_Env_release", "cr-grit-env::release":
		Crunch_Rhythm_set_Grit_Env_release(p, value)
		return true
	case "Grit_Env_sustain", "cr-grit-env::sustain":
		Crunch_Rhythm_set_Grit_Env_sustain(p, value)
		return true
	case "amplitude", "cr-string::amplitude":
		Crunch_Rhythm_set_amplitude(p, value)
		return true
	case "cutoff", "cr-pre-filter::cutoff":
		Crunch_Rhythm_set_cutoff(p, value)
		return true
	case "drive", "cr-drive::drive":
		Crunch_Rhythm_set_drive(p, value)
		return true
	case "frequency", "cr-grit::frequency":
		Crunch_Rhythm_set_frequency(p, value)
		return true
	case "mix", "cr-drive::mix":
		Crunch_Rhythm_set_mix(p, value)
		return true
	case "modIndex", "cr-grit::modIndex":
		Crunch_Rhythm_set_modIndex(p, value)
		return true
	case "outMax", "cr-atk-map::outMax":
		Crunch_Rhythm_set_outMax(p, value)
		return true
	case "resonance", "cr-pre-filter::resonance":
		Crunch_Rhythm_set_resonance(p, value)
		return true
	case "tone", "cr-drive::tone":
		Crunch_Rhythm_set_tone(p, value)
		return true
	case "velocitySensitivity", "cr-amp::velocitySensitivity":
		Crunch_Rhythm_set_velocitySensitivity(p, value)
		return true
	}
	return false
}

Crunch_Rhythm_get_param :: proc(p: ^Crunch_Rhythm_Processor, name: string) -> (f32, bool) {
	switch name {
	case "Amp_attack", "cr-amp::attack":
		return p.Amp_attack, true
	case "Amp_decay", "cr-amp::decay":
		return p.Amp_decay, true
	case "Amp_depth", "cr-amp::depth":
		return p.Amp_depth, true
	case "Amp_release", "cr-amp::release":
		return p.Amp_release, true
	case "Amp_sustain", "cr-amp::sustain":
		return p.Amp_sustain, true
	case "Attack_Env_attack", "cr-atk-env::attack":
		return p.Attack_Env_attack, true
	case "Attack_Env_decay", "cr-atk-env::decay":
		return p.Attack_Env_decay, true
	case "Attack_Env_depth", "cr-atk-env::depth":
		return p.Attack_Env_depth, true
	case "Attack_Env_release", "cr-atk-env::release":
		return p.Attack_Env_release, true
	case "Attack_Env_sustain", "cr-atk-env::sustain":
		return p.Attack_Env_sustain, true
	case "Grit_Env_attack", "cr-grit-env::attack":
		return p.Grit_Env_attack, true
	case "Grit_Env_decay", "cr-grit-env::decay":
		return p.Grit_Env_decay, true
	case "Grit_Env_depth", "cr-grit-env::depth":
		return p.Grit_Env_depth, true
	case "Grit_Env_release", "cr-grit-env::release":
		return p.Grit_Env_release, true
	case "Grit_Env_sustain", "cr-grit-env::sustain":
		return p.Grit_Env_sustain, true
	case "amplitude", "cr-string::amplitude":
		return p.amplitude, true
	case "cutoff", "cr-pre-filter::cutoff":
		return p.cutoff, true
	case "drive", "cr-drive::drive":
		return p.drive, true
	case "frequency", "cr-grit::frequency":
		return p.frequency, true
	case "mix", "cr-drive::mix":
		return p.mix, true
	case "modIndex", "cr-grit::modIndex":
		return p.modIndex, true
	case "outMax", "cr-atk-map::outMax":
		return p.outMax, true
	case "resonance", "cr-pre-filter::resonance":
		return p.resonance, true
	case "tone", "cr-drive::tone":
		return p.tone, true
	case "velocitySensitivity", "cr-amp::velocitySensitivity":
		return p.velocitySensitivity, true
	}
	return 0.0, false
}

Crunch_Rhythm_process :: proc(p: ^Crunch_Rhythm_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	Crunch_Rhythm_process_sequence(p)
	p.total_samples += 1

	for v_idx in 0..<8 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_cr_amp_stage != .Release && voice.adsr_cr_amp_stage != .Idle {
				voice.adsr_cr_amp_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_cr_atk_env_stage != .Release && voice.adsr_cr_atk_env_stage != .Idle {
				voice.adsr_cr_atk_env_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_cr_grit_env_stage != .Release && voice.adsr_cr_grit_env_stage != .Idle {
				voice.adsr_cr_grit_env_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_cr_amp_out: f32 = 0.0
		node_cr_atk_env_out: f32 = 0.0
		node_cr_atk_map_out: f32 = 0.0
		node_cr_drive_out: f32 = 0.0
		node_cr_grit_out: f32 = 0.0
		node_cr_grit_env_out: f32 = 0.0
		node_cr_mixer_out: f32 = 0.0
		node_cr_output_out: f32 = 0.0
		node_cr_pre_filter_out: f32 = 0.0
		node_cr_string_out: f32 = 0.0

		// --- ADSR Node cr_atk_env ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_cr_atk_env_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Attack_Env_attack) > 0 do envelope = voice.adsr_cr_atk_env_attack_start + (1.0 - voice.adsr_cr_atk_env_attack_start) * (voice.age / math.max(f32(p.Attack_Env_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_cr_atk_env_release_level = envelope;
				if voice.age >= (p.Attack_Env_attack) {
					voice.adsr_cr_atk_env_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Attack_Env_attack);
				if (p.Attack_Env_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Attack_Env_decay), 0.000001)) * (1.0 - (p.Attack_Env_sustain)); else do envelope = (p.Attack_Env_sustain);
				voice.adsr_cr_atk_env_release_level = envelope;
				if time_in_decay >= (p.Attack_Env_decay) {
					voice.adsr_cr_atk_env_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Attack_Env_sustain);
				voice.adsr_cr_atk_env_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_cr_atk_env_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Attack_Env_release) > 0 do envelope = voice.adsr_cr_atk_env_release_level * (1.0 - (time_in_release / math.max(f32(p.Attack_Env_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_cr_atk_env_stage = .Idle;
				}
			}
			vel_scale_cr_atk_env: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_cr_atk_env_out = (1.0) * envelope * (p.Attack_Env_depth) * vel_scale_cr_atk_env;
		}

		// --- FM Operator Node cr_grit (Unison/Detune) ---
		{
			carrier_freq_cr_grit: f32 = voice.current_freq * math.clamp(f32(p.frequency), 0.01, 32.0);
			unison_out: f32 = 0.0;
			unison_count := 2;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (9.000000000);
				detuned_carrier_freq_cr_grit: f32 = carrier_freq_cr_grit * math.pow(2.0, detune_amount / 1200.0);
				voice.fm_cr_grit_phase[i] = math.mod(voice.fm_cr_grit_phase[i] + (2 * f32(math.PI) * detuned_carrier_freq_cr_grit / sample_rate), 2 * f32(math.PI));
				unison_out += math.sin(voice.fm_cr_grit_phase[i] + (0.0) * (p.modIndex));
			}
			node_cr_grit_out = unison_out / f32(unison_count);
		}

		// --- Oscillator Node cr_string (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 2;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (9.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_cr_string_phase[i] = math.mod(voice.osc_cr_string_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_cr_string_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += ((final_phase / f32(math.PI)) - 1.0);
			}
			node_cr_string_out = (unison_out / f32(unison_count)) * (p.amplitude);
		}

		// --- Mapper Node cr_atk_map ---
		{
			in_range_cr_atk_map: f32 = f32(f32(1.000000000)) - f32(f32(0.000000000));
			if in_range_cr_atk_map == 0.0 do in_range_cr_atk_map = 1.0;
			node_cr_atk_map_out = math.lerp(f32(f32(0.000000000)), f32(p.outMax), math.clamp((f32((node_cr_atk_env_out)) - f32(f32(0.000000000))) / in_range_cr_atk_map, 0.0, 1.0));
		}

		// --- ADSR Node cr_grit_env ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_cr_grit_env_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Grit_Env_attack) > 0 do envelope = voice.adsr_cr_grit_env_attack_start + (1.0 - voice.adsr_cr_grit_env_attack_start) * (voice.age / math.max(f32(p.Grit_Env_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_cr_grit_env_release_level = envelope;
				if voice.age >= (p.Grit_Env_attack) {
					voice.adsr_cr_grit_env_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Grit_Env_attack);
				if (p.Grit_Env_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Grit_Env_decay), 0.000001)) * (1.0 - (p.Grit_Env_sustain)); else do envelope = (p.Grit_Env_sustain);
				voice.adsr_cr_grit_env_release_level = envelope;
				if time_in_decay >= (p.Grit_Env_decay) {
					voice.adsr_cr_grit_env_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Grit_Env_sustain);
				voice.adsr_cr_grit_env_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_cr_grit_env_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Grit_Env_release) > 0 do envelope = voice.adsr_cr_grit_env_release_level * (1.0 - (time_in_release / math.max(f32(p.Grit_Env_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_cr_grit_env_stage = .Idle;
				}
			}
			vel_scale_cr_grit_env: f32 = (1.0 - (f32(0.700000000))) + (f32(0.700000000)) * voice.velocity;
			node_cr_grit_env_out = ((node_cr_grit_out)) * envelope * (p.Grit_Env_depth) * vel_scale_cr_grit_env;
		}

		// --- Filter Node cr_pre_filter (SVF) ---
		{
			cutoff_c_cr_pre_filter: f32 = math.clamp(f32((p.cutoff) + (node_cr_atk_map_out)), 10.0, sample_rate * 0.16);
			f_cr_pre_filter := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_cr_pre_filter / sample_rate));
			q_cr_pre_filter: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_cr_pre_filter);
			voice.filter_cr_pre_filter_low += f_cr_pre_filter * voice.filter_cr_pre_filter_band;
			high_cr_pre_filter := f32(((node_cr_string_out)) - voice.filter_cr_pre_filter_low - q_cr_pre_filter * voice.filter_cr_pre_filter_band);
			voice.filter_cr_pre_filter_band += f_cr_pre_filter * high_cr_pre_filter;
			node_cr_pre_filter_out = voice.filter_cr_pre_filter_low;
		}

		// --- Mixer Node cr_mixer (2 inputs) ---
		{
			mix_sum_cr_mixer: f32 = 0.0;
			mix_sum_cr_mixer += node_cr_pre_filter_out * (f32(0.850000024));
			mix_sum_cr_mixer += node_cr_grit_env_out * (f32(0.600000024));
		node_cr_mixer_out = mix_sum_cr_mixer;
		}

		// --- Distortion Node cr_drive (classic) ---
		{
			dist_in_cr_drive: f32 = ((node_cr_mixer_out));
			dist_k_cr_drive: f32 = math.max(f32(p.drive), 1.0);
			dist_wet_cr_drive: f32 = (f32(math.PI) + dist_k_cr_drive) * dist_in_cr_drive / (f32(math.PI) + dist_k_cr_drive * abs(dist_in_cr_drive));
			tone_k_cr_drive: f32 = math.clamp(2.0 * f32(math.PI) * math.clamp(f32(p.tone), 100.0, 20000.0) / sample_rate, 0.001, 1.0);
			voice.dist_cr_drive_tone += tone_k_cr_drive * (dist_wet_cr_drive - voice.dist_cr_drive_tone);
			mix_cr_drive: f32 = math.clamp(f32(p.mix), 0.0, 1.0);
			node_cr_drive_out = dist_in_cr_drive * (1.0 - mix_cr_drive) + voice.dist_cr_drive_tone * mix_cr_drive;
		}

		// --- ADSR Node cr_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_cr_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Amp_attack) > 0 do envelope = voice.adsr_cr_amp_attack_start + (1.0 - voice.adsr_cr_amp_attack_start) * (voice.age / math.max(f32(p.Amp_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_cr_amp_release_level = envelope;
				if voice.age >= (p.Amp_attack) {
					voice.adsr_cr_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Amp_attack);
				if (p.Amp_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Amp_decay), 0.000001)) * (1.0 - (p.Amp_sustain)); else do envelope = (p.Amp_sustain);
				voice.adsr_cr_amp_release_level = envelope;
				if time_in_decay >= (p.Amp_decay) {
					voice.adsr_cr_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Amp_sustain);
				voice.adsr_cr_amp_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_cr_amp_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Amp_release) > 0 do envelope = voice.adsr_cr_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.Amp_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_cr_amp_stage = .Idle;
				}
			}
			vel_scale_cr_amp: f32 = (1.0 - (p.velocitySensitivity)) + (p.velocitySensitivity) * voice.velocity;
			node_cr_amp_out = ((node_cr_drive_out)) * envelope * (p.Amp_depth) * vel_scale_cr_amp;
		}

		output_left += node_cr_amp_out
		output_right += node_cr_amp_out
		if voice.adsr_cr_amp_stage != .Idle do voice_busy = true
		if voice.adsr_cr_atk_env_stage != .Idle do voice_busy = true
		if voice.adsr_cr_grit_env_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
Crunch_Rhythm_process_sequence :: proc(p: ^Crunch_Rhythm_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "Crunch Rhythm" (16 steps)
		switch p.current_step % 16 {
		case 0:
			Crunch_Rhythm_note_on(p, 40, 0.879999995, f32(3.000000000) * (60.0 / p.bpm / 4.0))
			Crunch_Rhythm_note_on(p, 47, 0.800000012, f32(3.000000000) * (60.0 / p.bpm / 4.0))
		case 4:
			Crunch_Rhythm_note_on(p, 40, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
			Crunch_Rhythm_note_on(p, 47, 0.720000029, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 6:
			Crunch_Rhythm_note_on(p, 43, 0.850000024, f32(2.000000000) * (60.0 / p.bpm / 4.0))
			Crunch_Rhythm_note_on(p, 50, 0.759999990, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			Crunch_Rhythm_note_on(p, 45, 0.879999995, f32(3.000000000) * (60.0 / p.bpm / 4.0))
			Crunch_Rhythm_note_on(p, 52, 0.800000012, f32(3.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			Crunch_Rhythm_note_on(p, 43, 0.839999974, f32(2.000000000) * (60.0 / p.bpm / 4.0))
			Crunch_Rhythm_note_on(p, 50, 0.750000000, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 14:
			Crunch_Rhythm_note_on(p, 40, 0.779999971, f32(2.000000000) * (60.0 / p.bpm / 4.0))
			Crunch_Rhythm_note_on(p, 47, 0.699999988, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	Crunch_Rhythm: ^Crunch_Rhythm_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.750000000
	p.Crunch_Rhythm = new(Crunch_Rhythm_Processor)
	Crunch_Rhythm_init(p.Crunch_Rhythm, sr)
	Crunch_Rhythm_start(p.Crunch_Rhythm)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := Crunch_Rhythm_process(p.Crunch_Rhythm); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.Crunch_Rhythm)
}

