Kick_set_param :: proc(p: ^Kick_Processor, name: string, value: f32) -> bool {
	switch name {
	case "Amp_attack", "kick-amp-envelope::attack":
		Kick_set_Amp_attack(p, value)
		return true
	case "Amp_decay", "kick-amp-envelope::decay":
		Kick_set_Amp_decay(p, value)
		return true
	case "Amp_depth", "kick-amp-envelope::depth":
		Kick_set_Amp_depth(p, value)
		return true
	case "Amp_release", "kick-amp-envelope::release":
		Kick_set_Amp_release(p, value)
		return true
	case "Amp_sustain", "kick-amp-envelope::sustain":
		Kick_set_Amp_sustain(p, value)
		return true
	case "Pitch_attack", "kick-pitch-envelope::attack":
		Kick_set_Pitch_attack(p, value)
		return true
	case "Pitch_decay", "kick-pitch-envelope::decay":
		Kick_set_Pitch_decay(p, value)
		return true
	case "Pitch_depth", "kick-pitch-envelope::depth":
		Kick_set_Pitch_depth(p, value)
		return true
	case "Pitch_release", "kick-pitch-envelope::release":
		Kick_set_Pitch_release(p, value)
		return true
	case "Pitch_sustain", "kick-pitch-envelope::sustain":
		Kick_set_Pitch_sustain(p, value)
		return true
	case "amplitude", "kick-oscillator::amplitude":
		Kick_set_amplitude(p, value)
		return true
	case "drive", "kick-distortion::drive":
		Kick_set_drive(p, value)
		return true
	case "frequency", "kick-oscillator::frequency":
		Kick_set_frequency(p, value)
		return true
	case "mix", "kick-distortion::mix":
		Kick_set_mix(p, value)
		return true
	case "phase", "kick-oscillator::phase":
		Kick_set_phase(p, value)
		return true
	case "tone", "kick-distortion::tone":
		Kick_set_tone(p, value)
		return true
	}
	return false
}

Kick_get_param :: proc(p: ^Kick_Processor, name: string) -> (f32, bool) {
	switch name {
	case "Amp_attack", "kick-amp-envelope::attack":
		return p.Amp_attack, true
	case "Amp_decay", "kick-amp-envelope::decay":
		return p.Amp_decay, true
	case "Amp_depth", "kick-amp-envelope::depth":
		return p.Amp_depth, true
	case "Amp_release", "kick-amp-envelope::release":
		return p.Amp_release, true
	case "Amp_sustain", "kick-amp-envelope::sustain":
		return p.Amp_sustain, true
	case "Pitch_attack", "kick-pitch-envelope::attack":
		return p.Pitch_attack, true
	case "Pitch_decay", "kick-pitch-envelope::decay":
		return p.Pitch_decay, true
	case "Pitch_depth", "kick-pitch-envelope::depth":
		return p.Pitch_depth, true
	case "Pitch_release", "kick-pitch-envelope::release":
		return p.Pitch_release, true
	case "Pitch_sustain", "kick-pitch-envelope::sustain":
		return p.Pitch_sustain, true
	case "amplitude", "kick-oscillator::amplitude":
		return p.amplitude, true
	case "drive", "kick-distortion::drive":
		return p.drive, true
	case "frequency", "kick-oscillator::frequency":
		return p.frequency, true
	case "mix", "kick-distortion::mix":
		return p.mix, true
	case "phase", "kick-oscillator::phase":
		return p.phase, true
	case "tone", "kick-distortion::tone":
		return p.tone, true
	}
	return 0.0, false
}

Kick_process :: proc(p: ^Kick_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	Kick_process_sequence(p)
	p.total_samples += 1

	for v_idx in 0..<8 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.current_freq != voice.target_freq {
			glide_k := 1.0 / math.max(voice.glide_time * sample_rate, 1.0)
			if glide_k > 1.0 do glide_k = 1.0
			voice.current_freq += (voice.target_freq - voice.current_freq) * glide_k
			if abs(voice.target_freq - voice.current_freq) < 0.1 do voice.current_freq = voice.target_freq
		}
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_kick_amp_envelope_stage != .Release && voice.adsr_kick_amp_envelope_stage != .Idle {
				voice.adsr_kick_amp_envelope_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_kick_pitch_envelope_stage != .Release && voice.adsr_kick_pitch_envelope_stage != .Idle {
				voice.adsr_kick_pitch_envelope_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_kick_amp_envelope_out: f32 = 0.0
		node_kick_distortion_out: f32 = 0.0
		node_kick_oscillator_out: f32 = 0.0
		node_kick_output_out: f32 = 0.0
		node_kick_pitch_envelope_out: f32 = 0.0
		node_kick_pitch_mapper_out: f32 = 0.0

		// --- ADSR Node kick_pitch_envelope ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_kick_pitch_envelope_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Pitch_attack) > 0 do envelope = voice.adsr_kick_pitch_envelope_attack_start + (1.0 - voice.adsr_kick_pitch_envelope_attack_start) * (voice.age / math.max(f32(p.Pitch_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_kick_pitch_envelope_release_level = envelope;
				if voice.age >= (p.Pitch_attack) {
					voice.adsr_kick_pitch_envelope_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Pitch_attack);
				if (p.Pitch_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Pitch_decay), 0.000001)) * (1.0 - (p.Pitch_sustain)); else do envelope = (p.Pitch_sustain);
				voice.adsr_kick_pitch_envelope_release_level = envelope;
				if time_in_decay >= (p.Pitch_decay) {
					voice.adsr_kick_pitch_envelope_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Pitch_sustain);
				voice.adsr_kick_pitch_envelope_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Pitch_release) > 0 do envelope = voice.adsr_kick_pitch_envelope_release_level * (1.0 - (time_in_release / math.max(f32(p.Pitch_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_kick_pitch_envelope_stage = .Idle;
				}
			}
			vel_scale_kick_pitch_envelope: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_kick_pitch_envelope_out = (1.0) * envelope * (p.Pitch_depth) * vel_scale_kick_pitch_envelope;
		}

		// --- Mapper Node kick_pitch_mapper ---
		{
			in_range_kick_pitch_mapper: f32 = f32(f32(1.000000000)) - f32(f32(0.000000000));
			if in_range_kick_pitch_mapper == 0.0 do in_range_kick_pitch_mapper = 1.0;
			node_kick_pitch_mapper_out = math.lerp(f32(f32(0.000000000)), f32(f32(2.500000000)), math.clamp((f32((node_kick_pitch_envelope_out)) - f32(f32(0.000000000))) / in_range_kick_pitch_mapper, 0.0, 1.0));
		}

		// --- Oscillator Node kick_oscillator (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (5.000000000);
				detuned_freq: f32 = ((p.frequency) * math.pow(2.0, math.clamp(f32(node_kick_pitch_mapper_out), -10.0, 10.0))) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(p.phase) * (f32(math.PI) / 180.0);
				voice.osc_kick_oscillator_phase[i] = math.mod(voice.osc_kick_oscillator_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_kick_oscillator_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += math.sin(final_phase);
			}
			node_kick_oscillator_out = (unison_out / f32(unison_count)) * (p.amplitude);
		}

		// --- ADSR Node kick_amp_envelope ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_kick_amp_envelope_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Amp_attack) > 0 do envelope = voice.adsr_kick_amp_envelope_attack_start + (1.0 - voice.adsr_kick_amp_envelope_attack_start) * (voice.age / math.max(f32(p.Amp_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_kick_amp_envelope_release_level = envelope;
				if voice.age >= (p.Amp_attack) {
					voice.adsr_kick_amp_envelope_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Amp_attack);
				if (p.Amp_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Amp_decay), 0.000001)) * (1.0 - (p.Amp_sustain)); else do envelope = (p.Amp_sustain);
				voice.adsr_kick_amp_envelope_release_level = envelope;
				if time_in_decay >= (p.Amp_decay) {
					voice.adsr_kick_amp_envelope_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Amp_sustain);
				voice.adsr_kick_amp_envelope_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Amp_release) > 0 do envelope = voice.adsr_kick_amp_envelope_release_level * (1.0 - (time_in_release / math.max(f32(p.Amp_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_kick_amp_envelope_stage = .Idle;
				}
			}
			vel_scale_kick_amp_envelope: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_kick_amp_envelope_out = ((node_kick_oscillator_out)) * envelope * (p.Amp_depth) * vel_scale_kick_amp_envelope;
		}

		// --- Distortion Node kick_distortion (soft) ---
		{
			dist_in_kick_distortion: f32 = ((node_kick_amp_envelope_out));
			dist_k_kick_distortion: f32 = math.max(f32(p.drive), 1.0);
			dist_wet_kick_distortion: f32 = math.tanh(dist_in_kick_distortion * dist_k_kick_distortion);
			tone_k_kick_distortion: f32 = math.clamp(2.0 * f32(math.PI) * math.clamp(f32(p.tone), 100.0, 20000.0) / sample_rate, 0.001, 1.0);
			voice.dist_kick_distortion_tone += tone_k_kick_distortion * (dist_wet_kick_distortion - voice.dist_kick_distortion_tone);
			mix_kick_distortion: f32 = math.clamp(f32(p.mix), 0.0, 1.0);
			node_kick_distortion_out = dist_in_kick_distortion * (1.0 - mix_kick_distortion) + voice.dist_kick_distortion_tone * mix_kick_distortion;
		}

		output_left += node_kick_distortion_out
		output_right += node_kick_distortion_out
		if voice.adsr_kick_amp_envelope_stage != .Idle do voice_busy = true
		if voice.adsr_kick_pitch_envelope_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	if math.is_nan(output_left) || math.is_inf(output_left) || math.is_nan(output_right) || math.is_inf(output_right) {
		p.nonfinite_count += 1
		output_left, output_right = 0.0, 0.0
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
Kick_process_sequence :: proc(p: ^Kick_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "Kick" (16 steps)
		switch p.current_step % 16 {
		case 0:
			Kick_note_on(p, 36, 1.000000000, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 4:
			Kick_note_on(p, 36, 0.920000017, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			Kick_note_on(p, 36, 1.000000000, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			Kick_note_on(p, 36, 0.949999988, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	Kick: ^Kick_Processor,
	master_volume: f32,
	dc: Skald_Dc_Block_State,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.800000012
	p.dc = {}
	p.Kick = new(Kick_Processor)
	Kick_init(p.Kick, sr)
	Kick_start(p.Kick)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := Kick_process(p.Kick); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	mixed_left, mixed_right = skald_dc_block(&p.dc, mixed_left, mixed_right)
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.Kick)
}

