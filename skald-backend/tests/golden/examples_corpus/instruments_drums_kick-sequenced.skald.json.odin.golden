Kick_note_on :: proc(p: ^Kick_Processor, note: u8, velocity: f32, duration: f32) {
	// note and velocity are clamped silently to their MIDI/normalized domains.
	note := note
	if note > 127 do note = 127
	velocity := math.clamp(velocity, 0.0, 1.0)
	voice_idx := -1
	for i in 0..<8 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_releasing_age: f32 = -1.0
		for i in 0..<8 {
			releasing := true
			if p.voices[i].adsr_kick_amp_envelope_stage != .Release && p.voices[i].adsr_kick_amp_envelope_stage != .Idle do releasing = false
			if p.voices[i].adsr_kick_pitch_envelope_stage != .Release && p.voices[i].adsr_kick_pitch_envelope_stage != .Idle do releasing = false
			if releasing && p.voices[i].age > oldest_releasing_age {
				oldest_releasing_age = p.voices[i].age
				voice_idx = i
			}
		}
		if voice_idx == -1 {
			oldest_age: f32 = -1.0
			for i in 0..<8 {
				if p.voices[i].age > oldest_age {
					oldest_age = p.voices[i].age
					voice_idx = i
				}
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	adsr_kick_amp_envelope_prev_level: f32 = 0.0
	if stolen && v.adsr_kick_amp_envelope_stage != .Idle {
		adsr_kick_amp_envelope_prev_level = v.adsr_kick_amp_envelope_release_level
		if v.adsr_kick_amp_envelope_stage == .Release {
			rel_t_kick_amp_envelope: f32 = (p.Amp_release);
			if rel_t_kick_amp_envelope > 0.0 {
				rf_kick_amp_envelope := 1.0 - (v.age - v.time_released) / math.max(rel_t_kick_amp_envelope, 0.000001)
				if rf_kick_amp_envelope < 0.0 do rf_kick_amp_envelope = 0.0
				adsr_kick_amp_envelope_prev_level *= rf_kick_amp_envelope
			} else {
				adsr_kick_amp_envelope_prev_level = 0.0
			}
		}
	}
	adsr_kick_pitch_envelope_prev_level: f32 = 0.0
	if stolen && v.adsr_kick_pitch_envelope_stage != .Idle {
		adsr_kick_pitch_envelope_prev_level = v.adsr_kick_pitch_envelope_release_level
		if v.adsr_kick_pitch_envelope_stage == .Release {
			rel_t_kick_pitch_envelope: f32 = (p.Pitch_release);
			if rel_t_kick_pitch_envelope > 0.0 {
				rf_kick_pitch_envelope := 1.0 - (v.age - v.time_released) / math.max(rel_t_kick_pitch_envelope, 0.000001)
				if rf_kick_pitch_envelope < 0.0 do rf_kick_pitch_envelope = 0.0
				adsr_kick_pitch_envelope_prev_level *= rf_kick_pitch_envelope
			} else {
				adsr_kick_pitch_envelope_prev_level = 0.0
			}
		}
	}
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.050000001
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	v.adsr_kick_amp_envelope_stage = .Attack
	v.adsr_kick_amp_envelope_attack_start = adsr_kick_amp_envelope_prev_level
	v.adsr_kick_amp_envelope_release_level = adsr_kick_amp_envelope_prev_level
	v.adsr_kick_pitch_envelope_stage = .Attack
	v.adsr_kick_pitch_envelope_attack_start = adsr_kick_pitch_envelope_prev_level
	v.adsr_kick_pitch_envelope_release_level = adsr_kick_pitch_envelope_prev_level
	if !stolen {
		v.dist_kick_distortion_tone = 0.0
		v.osc_kick_oscillator_phase = {}
	}
}

Kick_note_off :: proc(p: ^Kick_Processor, note: u8) {
	// Clamped to match _note_on: `note` is the voice key, so both must map it.
	note := note
	if note > 127 do note = 127
	best := -1
	best_age: f32 = -1.0
	for i in 0..<8 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_kick_amp_envelope_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_kick_amp_envelope_stage = .Release
		p.voices[best].adsr_kick_pitch_envelope_stage = .Release
	}
}

Kick_trigger :: proc(p: ^Kick_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (p.Amp_attack) + (p.Amp_decay) > d do d = (p.Amp_attack) + (p.Amp_decay)
		if (p.Pitch_attack) + (p.Pitch_decay) > d do d = (p.Pitch_attack) + (p.Pitch_decay)
		if d <= 0.0 do d = 0.001
	}
	Kick_note_on(p, note, velocity, d)
}

Kick_feed_input :: proc(p: ^Kick_Processor, in_left: f32, in_right: f32) {
	p.ext_in_l = in_left
	p.ext_in_r = in_right
}

Kick_start :: proc(p: ^Kick_Processor) {
	p.playing = true
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
}

Kick_stop :: proc(p: ^Kick_Processor) {
