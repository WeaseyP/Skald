GW_SFX_Kill_Explosion_process :: proc(p: ^GW_SFX_Kill_Explosion_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	p.total_samples += 1

	for v_idx in 0..<6 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_kill_boom_env_stage != .Release && voice.adsr_kill_boom_env_stage != .Idle {
				voice.adsr_kill_boom_env_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_kill_crack_env_stage != .Release && voice.adsr_kill_crack_env_stage != .Idle {
				voice.adsr_kill_crack_env_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_kill_pitch_stage != .Release && voice.adsr_kill_pitch_stage != .Idle {
				voice.adsr_kill_pitch_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_kill_boom_out: f32 = 0.0
		node_kill_boom_env_out: f32 = 0.0
		node_kill_crack_out: f32 = 0.0
		node_kill_crack_env_out: f32 = 0.0
		node_kill_dist_out: f32 = 0.0
		node_kill_mixer_out: f32 = 0.0
		node_kill_output_out: f32 = 0.0
		node_kill_pitch_out: f32 = 0.0
		node_kill_pitch_map_out: f32 = 0.0

		// --- Noise Node kill_crack ---
		node_kill_crack_out = (next_float32(&voice.noise_kill_crack_rng) * 2.0 - 1.0) * (p.Crack_amplitude);

		// --- ADSR Node kill_pitch ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_kill_pitch_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.001000000)) > 0 do envelope = voice.adsr_kill_pitch_attack_start + (1.0 - voice.adsr_kill_pitch_attack_start) * (voice.age / math.max(f32(f32(0.001000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_kill_pitch_release_level = envelope;
				if voice.age >= (f32(0.001000000)) {
					voice.adsr_kill_pitch_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.001000000));
				if (p.Drop_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Drop_decay), 0.000001)) * (1.0 - (f32(0.000000000))); else do envelope = (f32(0.000000000));
				voice.adsr_kill_pitch_release_level = envelope;
				if time_in_decay >= (p.Drop_decay) {
					voice.adsr_kill_pitch_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.000000000));
				voice.adsr_kill_pitch_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.010000000)) > 0 do envelope = voice.adsr_kill_pitch_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.010000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_kill_pitch_stage = .Idle;
				}
			}
			vel_scale_kill_pitch: f32 = (1.0 - (f32(0.000000000))) + (f32(0.000000000)) * voice.velocity;
			node_kill_pitch_out = (1.0) * envelope * (f32(1.000000000)) * vel_scale_kill_pitch;
		}

		// --- ADSR Node kill_crack_env ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_kill_crack_env_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.001000000)) > 0 do envelope = voice.adsr_kill_crack_env_attack_start + (1.0 - voice.adsr_kill_crack_env_attack_start) * (voice.age / math.max(f32(f32(0.001000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_kill_crack_env_release_level = envelope;
				if voice.age >= (f32(0.001000000)) {
					voice.adsr_kill_crack_env_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.001000000));
				if (p.Crack_Env_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Crack_Env_decay), 0.000001)) * (1.0 - (f32(0.000000000))); else do envelope = (f32(0.000000000));
				voice.adsr_kill_crack_env_release_level = envelope;
				if time_in_decay >= (p.Crack_Env_decay) {
					voice.adsr_kill_crack_env_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.000000000));
				voice.adsr_kill_crack_env_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.020000000)) > 0 do envelope = voice.adsr_kill_crack_env_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.020000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_kill_crack_env_stage = .Idle;
				}
			}
			vel_scale_kill_crack_env: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_kill_crack_env_out = ((node_kill_crack_out)) * envelope * (f32(1.000000000)) * vel_scale_kill_crack_env;
		}

		// --- Mapper Node kill_pitch_map ---
		{
			in_range_kill_pitch_map: f32 = f32(f32(1.000000000)) - f32(f32(0.000000000));
			if in_range_kill_pitch_map == 0.0 do in_range_kill_pitch_map = 1.0;
			node_kill_pitch_map_out = math.lerp(f32(f32(0.000000000)), f32(f32(1.800000000)), math.clamp((f32((node_kill_pitch_out)) - f32(f32(0.000000000))) / in_range_kill_pitch_map, 0.0, 1.0));
		}

		// --- Oscillator Node kill_boom (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = ((p.frequency) * math.pow(2.0, math.clamp(f32(node_kill_pitch_map_out), -10.0, 10.0))) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_kill_boom_phase[i] = math.mod(voice.osc_kill_boom_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_kill_boom_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += math.sin(final_phase);
			}
			node_kill_boom_out = (unison_out / f32(unison_count)) * (p.Boom_amplitude);
		}

		// --- ADSR Node kill_boom_env ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_kill_boom_env_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.002000000)) > 0 do envelope = voice.adsr_kill_boom_env_attack_start + (1.0 - voice.adsr_kill_boom_env_attack_start) * (voice.age / math.max(f32(f32(0.002000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_kill_boom_env_release_level = envelope;
				if voice.age >= (f32(0.002000000)) {
					voice.adsr_kill_boom_env_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.002000000));
				if (p.Boom_Env_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Boom_Env_decay), 0.000001)) * (1.0 - (f32(0.000000000))); else do envelope = (f32(0.000000000));
				voice.adsr_kill_boom_env_release_level = envelope;
				if time_in_decay >= (p.Boom_Env_decay) {
					voice.adsr_kill_boom_env_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.000000000));
				voice.adsr_kill_boom_env_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.100000000)) > 0 do envelope = voice.adsr_kill_boom_env_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.100000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_kill_boom_env_stage = .Idle;
				}
			}
			vel_scale_kill_boom_env: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_kill_boom_env_out = ((node_kill_boom_out)) * envelope * (f32(1.000000000)) * vel_scale_kill_boom_env;
		}

		// --- Mixer Node kill_mixer (2 inputs) ---
		{
			mix_sum_kill_mixer: f32 = 0.0;
			mix_sum_kill_mixer += node_kill_crack_env_out * (f32(0.699999988));
			mix_sum_kill_mixer += node_kill_boom_env_out * (f32(0.899999976));
		node_kill_mixer_out = mix_sum_kill_mixer;
		}

		// --- Distortion Node kill_dist (soft) ---
		{
			dist_in_kill_dist: f32 = ((node_kill_mixer_out));
			dist_k_kill_dist: f32 = math.max(f32(p.drive), 1.0);
			dist_wet_kill_dist: f32 = math.tanh(dist_in_kill_dist * dist_k_kill_dist);
			tone_k_kill_dist: f32 = math.clamp(2.0 * f32(math.PI) * math.clamp(f32(f32(3000.000000000)), 100.0, 20000.0) / sample_rate, 0.001, 1.0);
			voice.dist_kill_dist_tone += tone_k_kill_dist * (dist_wet_kill_dist - voice.dist_kill_dist_tone);
			mix_kill_dist: f32 = math.clamp(f32(p.mix), 0.0, 1.0);
			node_kill_dist_out = dist_in_kill_dist * (1.0 - mix_kill_dist) + voice.dist_kill_dist_tone * mix_kill_dist;
		}

		output_left += node_kill_dist_out
		output_right += node_kill_dist_out
		if voice.adsr_kill_boom_env_stage != .Idle do voice_busy = true
		if voice.adsr_kill_crack_env_stage != .Idle do voice_busy = true
		if voice.adsr_kill_pitch_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	if math.is_nan(output_left) || math.is_inf(output_left) || math.is_nan(output_right) || math.is_inf(output_right) {
		p.nonfinite_count += 1
		output_left, output_right = 0.0, 0.0
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
GW_SFX_Kill_Explosion_process_sequence :: proc(p: ^GW_SFX_Kill_Explosion_Processor) {
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	GW_SFX_Kill_Explosion: ^GW_SFX_Kill_Explosion_Processor,
	master_volume: f32,
	dc: Skald_Dc_Block_State,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.750000000
	p.dc = {}
	p.GW_SFX_Kill_Explosion = new(GW_SFX_Kill_Explosion_Processor)
	GW_SFX_Kill_Explosion_init(p.GW_SFX_Kill_Explosion, sr)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := GW_SFX_Kill_Explosion_process(p.GW_SFX_Kill_Explosion); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	mixed_left, mixed_right = skald_dc_block(&p.dc, mixed_left, mixed_right)
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.GW_SFX_Kill_Explosion)
}

