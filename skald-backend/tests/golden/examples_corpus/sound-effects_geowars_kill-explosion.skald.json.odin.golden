// y = x - x1 + R*y1, R = 0.995 (~38 Hz cutoff at 48 kHz — see the note
// above generate_project_code's call to emit_dc_block_proc).
skald_dc_block :: proc(s: ^Skald_Dc_Block_State, l: f32, r: f32) -> (f32, f32) {
	yl := l - s.x1_l + 0.995 * s.y1_l
	yr := r - s.x1_r + 0.995 * s.y1_r
	s.x1_l, s.y1_l = l, yl
	s.x1_r, s.y1_r = r, yr
	return yl, yr
}

