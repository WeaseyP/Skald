	p.total_samples += 1

	for v_idx in 0..<4 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_shrapnel_amp_stage != .Release && voice.adsr_shrapnel_amp_stage != .Idle {
				voice.adsr_shrapnel_amp_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_shrapnel_amp_out: f32 = 0.0
		node_shrapnel_dist_out: f32 = 0.0
		node_shrapnel_filter_out: f32 = 0.0
		node_shrapnel_noise_out: f32 = 0.0
		node_shrapnel_output_out: f32 = 0.0

		// --- Noise Node shrapnel_noise ---
		node_shrapnel_noise_out = (next_float32(&voice.noise_shrapnel_noise_rng) * 2.0 - 1.0) * (p.amplitude);

		// --- Filter Node shrapnel_filter (SVF) ---
		{
			cutoff_c_shrapnel_filter: f32 = math.clamp(f32(p.cutoff), 10.0, sample_rate * 0.16);
			f_shrapnel_filter := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_shrapnel_filter / sample_rate));
			q_shrapnel_filter: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_shrapnel_filter);
			voice.filter_shrapnel_filter_low += f_shrapnel_filter * voice.filter_shrapnel_filter_band;
			high_shrapnel_filter := f32(((node_shrapnel_noise_out)) - voice.filter_shrapnel_filter_low - q_shrapnel_filter * voice.filter_shrapnel_filter_band);
			voice.filter_shrapnel_filter_band += f_shrapnel_filter * high_shrapnel_filter;
			node_shrapnel_filter_out = voice.filter_shrapnel_filter_band;
		}

		// --- ADSR Node shrapnel_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_shrapnel_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.001000000)) > 0 do envelope = voice.adsr_shrapnel_amp_attack_start + (1.0 - voice.adsr_shrapnel_amp_attack_start) * (voice.age / math.max(f32(f32(0.001000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_shrapnel_amp_release_level = envelope;
				if voice.age >= (f32(0.001000000)) {
					voice.adsr_shrapnel_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.001000000));
				if (p.decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.decay), 0.000001)) * (1.0 - (f32(0.000000000))); else do envelope = (f32(0.000000000));
				voice.adsr_shrapnel_amp_release_level = envelope;
				if time_in_decay >= (p.decay) {
					voice.adsr_shrapnel_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.000000000));
				voice.adsr_shrapnel_amp_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_shrapnel_amp_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.070000000)) > 0 do envelope = voice.adsr_shrapnel_amp_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.070000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_shrapnel_amp_stage = .Idle;
				}
			}
			vel_scale_shrapnel_amp: f32 = (1.0 - (f32(0.600000000))) + (f32(0.600000000)) * voice.velocity;
			node_shrapnel_amp_out = ((node_shrapnel_filter_out)) * envelope * (f32(1.000000000)) * vel_scale_shrapnel_amp;
		}

		// --- Distortion Node shrapnel_dist (soft) ---
		{
			dist_in_shrapnel_dist: f32 = ((node_shrapnel_amp_out));
			dist_k_shrapnel_dist: f32 = math.max(f32(p.drive), 1.0);
			dist_wet_shrapnel_dist: f32 = math.tanh(dist_in_shrapnel_dist * dist_k_shrapnel_dist);
			tone_k_shrapnel_dist: f32 = math.clamp(2.0 * f32(math.PI) * math.clamp(f32(f32(5000.000000000)), 100.0, 20000.0) / sample_rate, 0.001, 1.0);
			voice.dist_shrapnel_dist_tone += tone_k_shrapnel_dist * (dist_wet_shrapnel_dist - voice.dist_shrapnel_dist_tone);
			mix_shrapnel_dist: f32 = math.clamp(f32(p.mix), 0.0, 1.0);
			node_shrapnel_dist_out = dist_in_shrapnel_dist * (1.0 - mix_shrapnel_dist) + voice.dist_shrapnel_dist_tone * mix_shrapnel_dist;
		}

		output_left += node_shrapnel_dist_out
		output_right += node_shrapnel_dist_out
		if voice.adsr_shrapnel_amp_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
GW_Snare_Shrapnel_process_sequence :: proc(p: ^GW_Snare_Shrapnel_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "GW Snare Shrapnel" (16 steps)
		switch p.current_step % 16 {
		case 4:
			GW_Snare_Shrapnel_note_on(p, 38, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 10:
			if next_float32(&p.prng) <= 0.500000000 {
				GW_Snare_Shrapnel_note_on(p, 38, 0.400000006, f32(1.000000000) * (60.0 / p.bpm / 4.0))
			}
		case 12:
			GW_Snare_Shrapnel_note_on(p, 38, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 15:
			if next_float32(&p.prng) <= 0.400000006 {
				GW_Snare_Shrapnel_note_on(p, 38, 0.449999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
			}
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	GW_Snare_Shrapnel: ^GW_Snare_Shrapnel_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.750000000
	p.GW_Snare_Shrapnel = new(GW_Snare_Shrapnel_Processor)
	GW_Snare_Shrapnel_init(p.GW_Snare_Shrapnel, sr)
	GW_Snare_Shrapnel_start(p.GW_Snare_Shrapnel)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := GW_Snare_Shrapnel_process(p.GW_Snare_Shrapnel); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.GW_Snare_Shrapnel)
}

