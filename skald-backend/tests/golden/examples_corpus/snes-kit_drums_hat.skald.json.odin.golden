SNES_Hat_set_param :: proc(p: ^SNES_Hat_Processor, name: string, value: f32) -> bool {
	switch name {
	case "amplitude", "hat-noise::amplitude":
		SNES_Hat_set_amplitude(p, value)
		return true
	case "cutoff", "hat-hp::cutoff":
		SNES_Hat_set_cutoff(p, value)
		return true
	case "decay", "hat-env::decay":
		SNES_Hat_set_decay(p, value)
		return true
	}
	return false
}

SNES_Hat_get_param :: proc(p: ^SNES_Hat_Processor, name: string) -> (f32, bool) {
	switch name {
	case "amplitude", "hat-noise::amplitude":
		return p.amplitude, true
	case "cutoff", "hat-hp::cutoff":
		return p.cutoff, true
	case "decay", "hat-env::decay":
		return p.decay, true
	}
	return 0.0, false
}

SNES_Hat_process :: proc(p: ^SNES_Hat_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	SNES_Hat_process_sequence(p)
	p.total_samples += 1

	for v_idx in 0..<4 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_hat_env_stage != .Release && voice.adsr_hat_env_stage != .Idle {
				voice.adsr_hat_env_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_hat_env_out: f32 = 0.0
		node_hat_hp_out: f32 = 0.0
		node_hat_noise_out: f32 = 0.0
		node_hat_output_out: f32 = 0.0

		// --- Noise Node hat_noise ---
		node_hat_noise_out = (next_float32(&voice.noise_hat_noise_rng) * 2.0 - 1.0) * (p.amplitude);

		// --- Filter Node hat_hp (SVF) ---
		{
			cutoff_c_hat_hp: f32 = math.clamp(f32(p.cutoff), 10.0, sample_rate * 0.16);
			f_hat_hp := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_hat_hp / sample_rate));
			q_hat_hp: f32 = math.clamp(1.0 / math.max(f32(f32(1.200000000)), 0.1), 0.05, 1.9 - f_hat_hp);
			voice.filter_hat_hp_low += f_hat_hp * voice.filter_hat_hp_band;
			high_hat_hp := f32(((node_hat_noise_out)) - voice.filter_hat_hp_low - q_hat_hp * voice.filter_hat_hp_band);
			voice.filter_hat_hp_band += f_hat_hp * high_hat_hp;
			node_hat_hp_out = high_hat_hp;
		}

		// --- ADSR Node hat_env ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_hat_env_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.001000000)) > 0 do envelope = voice.adsr_hat_env_attack_start + (1.0 - voice.adsr_hat_env_attack_start) * (voice.age / math.max(f32(f32(0.001000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_hat_env_release_level = envelope;
				if voice.age >= (f32(0.001000000)) {
					voice.adsr_hat_env_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.001000000));
				if (p.decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.decay), 0.000001)) * (1.0 - (f32(0.000000000))); else do envelope = (f32(0.000000000));
				voice.adsr_hat_env_release_level = envelope;
				if time_in_decay >= (p.decay) {
					voice.adsr_hat_env_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.000000000));
				voice.adsr_hat_env_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.020000000)) > 0 do envelope = voice.adsr_hat_env_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.020000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_hat_env_stage = .Idle;
				}
			}
			vel_scale_hat_env: f32 = (1.0 - (f32(0.800000000))) + (f32(0.800000000)) * voice.velocity;
			node_hat_env_out = ((node_hat_hp_out)) * envelope * (f32(1.000000000)) * vel_scale_hat_env;
		}

		output_left += node_hat_env_out
		output_right += node_hat_env_out
		if voice.adsr_hat_env_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
SNES_Hat_process_sequence :: proc(p: ^SNES_Hat_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "SNES Hat" (16 steps)
		switch p.current_step % 16 {
		case 0:
			SNES_Hat_note_on(p, 42, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 2:
			SNES_Hat_note_on(p, 42, 0.449999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 4:
			SNES_Hat_note_on(p, 42, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 6:
			SNES_Hat_note_on(p, 42, 0.449999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			SNES_Hat_note_on(p, 42, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 10:
			SNES_Hat_note_on(p, 42, 0.449999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			SNES_Hat_note_on(p, 42, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 14:
			SNES_Hat_note_on(p, 42, 0.500000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 15:
			SNES_Hat_note_on(p, 42, 0.349999994, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	SNES_Hat: ^SNES_Hat_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.750000000
	p.SNES_Hat = new(SNES_Hat_Processor)
	SNES_Hat_init(p.SNES_Hat, sr)
	SNES_Hat_start(p.SNES_Hat)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := SNES_Hat_process(p.SNES_Hat); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.SNES_Hat)
}

