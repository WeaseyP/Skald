			SNES_Hat_note_on(p, 42, 0.300000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 56:
			SNES_Hat_note_on(p, 42, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 57:
			SNES_Hat_note_on(p, 42, 0.300000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 58:
			SNES_Hat_note_on(p, 42, 0.300000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 59:
			SNES_Hat_note_on(p, 42, 0.300000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 60:
			SNES_Hat_note_on(p, 42, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 61:
			SNES_Hat_note_on(p, 42, 0.300000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 62:
			SNES_Hat_note_on(p, 42, 0.300000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 63:
			SNES_Hat_note_on(p, 42, 0.300000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 64 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

SNES_Kick_Voice_State :: struct {
	active: bool,
	note: u8,
	velocity: f32,
	age: f32,
	time_released: f32,
	current_freq: f32,
	target_freq: f32,
	glide_time: f32,
	duration: f32,
	adsr_kick_amp_stage: ADSR_Stage,
	adsr_kick_amp_release_level: f32,
	adsr_kick_amp_attack_start: f32,
	osc_kick_osc_phase: [1]f32,
	adsr_kick_pitch_stage: ADSR_Stage,
	adsr_kick_pitch_release_level: f32,
	adsr_kick_pitch_attack_start: f32,
	dist_kick_punch_tone: f32,
}

SNES_Kick_Processor :: struct {
	sample_rate: f32,
	bpm: f32,
	voices: [2]SNES_Kick_Voice_State,
	prng: PRNG_State,
	total_samples: u64,
	playing: bool,
	loop: bool,
	current_step: u64,
	samples_until_next_step: u64,
	step_frac_acc: f32,
	ext_in_l: f32,
	ext_in_r: f32,
	volume: f32,
	Amp_decay: f32,
	Pitch_Env_decay: f32,
	amplitude: f32,
	drive: f32,
	frequency: f32,
	mix: f32,
}

SNES_Kick_init :: proc(p: ^SNES_Kick_Processor, sr: f32) {
	p.sample_rate = sr
	p.bpm = 104.000000000
	p.volume = 0.800000012
	p.prng.state = 12345
	p.loop = true
	p.voices = {}
	p.total_samples = 0
	p.playing = false
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
	p.ext_in_l = 0.0
	p.ext_in_r = 0.0
	p.Amp_decay = 0.219999999
	p.Pitch_Env_decay = 0.050000001
	p.amplitude = 0.600000024
	p.drive = 14.000000000
	p.frequency = 52.000000000
	p.mix = 0.400000006
}

SNES_Kick_note_on :: proc(p: ^SNES_Kick_Processor, note: u8, velocity: f32, duration: f32) {
	// note and velocity are clamped silently to their MIDI/normalized domains.
	note := note
	if note > 127 do note = 127
	velocity := math.clamp(velocity, 0.0, 1.0)
	voice_idx := -1
	for i in 0..<2 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_releasing_age: f32 = -1.0
		for i in 0..<2 {
			releasing := true
			if p.voices[i].adsr_kick_amp_stage != .Release && p.voices[i].adsr_kick_amp_stage != .Idle do releasing = false
			if p.voices[i].adsr_kick_pitch_stage != .Release && p.voices[i].adsr_kick_pitch_stage != .Idle do releasing = false
			if releasing && p.voices[i].age > oldest_releasing_age {
				oldest_releasing_age = p.voices[i].age
				voice_idx = i
			}
		}
		if voice_idx == -1 {
			oldest_age: f32 = -1.0
			for i in 0..<2 {
				if p.voices[i].age > oldest_age {
					oldest_age = p.voices[i].age
					voice_idx = i
				}
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	adsr_kick_amp_prev_level: f32 = 0.0
	if stolen && v.adsr_kick_amp_stage != .Idle {
		adsr_kick_amp_prev_level = v.adsr_kick_amp_release_level
		if v.adsr_kick_amp_stage == .Release {
			rel_t_kick_amp: f32 = (f32(0.040000000));
			if rel_t_kick_amp > 0.0 {
				rf_kick_amp := 1.0 - (v.age - v.time_released) / math.max(rel_t_kick_amp, 0.000001)
				if rf_kick_amp < 0.0 do rf_kick_amp = 0.0
				adsr_kick_amp_prev_level *= rf_kick_amp
			} else {
				adsr_kick_amp_prev_level = 0.0
			}
		}
	}
	adsr_kick_pitch_prev_level: f32 = 0.0
	if stolen && v.adsr_kick_pitch_stage != .Idle {
		adsr_kick_pitch_prev_level = v.adsr_kick_pitch_release_level
		if v.adsr_kick_pitch_stage == .Release {
			rel_t_kick_pitch: f32 = (f32(0.010000000));
			if rel_t_kick_pitch > 0.0 {
				rf_kick_pitch := 1.0 - (v.age - v.time_released) / math.max(rel_t_kick_pitch, 0.000001)
				if rf_kick_pitch < 0.0 do rf_kick_pitch = 0.0
				adsr_kick_pitch_prev_level *= rf_kick_pitch
			} else {
				adsr_kick_pitch_prev_level = 0.0
			}
		}
	}
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.000000000
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	v.adsr_kick_amp_stage = .Attack
	v.adsr_kick_amp_attack_start = adsr_kick_amp_prev_level
	v.adsr_kick_amp_release_level = adsr_kick_amp_prev_level
	v.adsr_kick_pitch_stage = .Attack
	v.adsr_kick_pitch_attack_start = adsr_kick_pitch_prev_level
	v.adsr_kick_pitch_release_level = adsr_kick_pitch_prev_level
	if !stolen {
		v.osc_kick_osc_phase = {}
		v.dist_kick_punch_tone = 0.0
	}
}

SNES_Kick_note_off :: proc(p: ^SNES_Kick_Processor, note: u8) {
	// Clamped to match _note_on: `note` is the voice key, so both must map it.
	note := note
	if note > 127 do note = 127
	best := -1
	best_age: f32 = -1.0
	for i in 0..<2 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_kick_amp_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_kick_amp_stage = .Release
		p.voices[best].adsr_kick_pitch_stage = .Release
	}
}

SNES_Kick_trigger :: proc(p: ^SNES_Kick_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (f32(0.001000000)) + (p.Amp_decay) > d do d = (f32(0.001000000)) + (p.Amp_decay)
		if (f32(0.001000000)) + (p.Pitch_Env_decay) > d do d = (f32(0.001000000)) + (p.Pitch_Env_decay)
		if d <= 0.0 do d = 0.001
	}
	SNES_Kick_note_on(p, note, velocity, d)
}

SNES_Kick_feed_input :: proc(p: ^SNES_Kick_Processor, in_left: f32, in_right: f32) {
	p.ext_in_l = in_left
	p.ext_in_r = in_right
}

SNES_Kick_start :: proc(p: ^SNES_Kick_Processor) {
	p.playing = true
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
}

SNES_Kick_stop :: proc(p: ^SNES_Kick_Processor) {
	p.playing = false
}

SNES_Kick_set_loop :: proc(p: ^SNES_Kick_Processor, loop: bool) {
	p.loop = loop
}

SNES_Kick_set_volume :: proc(p: ^SNES_Kick_Processor, value: f32) {
	p.volume = math.clamp(value, 0.0, 1.0)
}

SNES_Kick_is_playing :: proc(p: ^SNES_Kick_Processor) -> bool {
	if p.playing do return true
	for i in 0..<2 {
		if p.voices[i].active do return true
	}
	return false
}

SNES_Kick_set_Amp_decay :: proc(p: ^SNES_Kick_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 10.000000000 do v = 10.000000000
	p.Amp_decay = v
}

SNES_Kick_set_Pitch_Env_decay :: proc(p: ^SNES_Kick_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 10.000000000 do v = 10.000000000
	p.Pitch_Env_decay = v
}

SNES_Kick_set_amplitude :: proc(p: ^SNES_Kick_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 1.000000000 do v = 1.000000000
	p.amplitude = v
}

SNES_Kick_set_drive :: proc(p: ^SNES_Kick_Processor, value: f32) {
	v := value
	if v < 1.000000000 do v = 1.000000000
	if v > 100.000000000 do v = 100.000000000
	p.drive = v
}

SNES_Kick_set_frequency :: proc(p: ^SNES_Kick_Processor, value: f32) {
	v := value
	if v < 20.000000000 do v = 20.000000000
	if v > 20000.000000000 do v = 20000.000000000
	p.frequency = v
}

SNES_Kick_set_mix :: proc(p: ^SNES_Kick_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 1.000000000 do v = 1.000000000
	p.mix = v
}

SNES_Kick_PARAMS := []Skald_Param_Info{
	{"Amp_decay", 0.000000000, 10.000000000, 0.219999999, "s"},
	{"Pitch_Env_decay", 0.000000000, 10.000000000, 0.050000001, "s"},
	{"amplitude", 0.000000000, 1.000000000, 0.600000024, ""},
	{"drive", 1.000000000, 100.000000000, 14.000000000, "x"},
	{"frequency", 20.000000000, 20000.000000000, 52.000000000, "Hz"},
	{"mix", 0.000000000, 1.000000000, 0.400000006, ""},
}

SNES_Kick_set_param :: proc(p: ^SNES_Kick_Processor, name: string, value: f32) -> bool {
	switch name {
	case "Amp_decay", "kick-amp::decay":
		SNES_Kick_set_Amp_decay(p, value)
		return true
	case "Pitch_Env_decay", "kick-pitch::decay":
		SNES_Kick_set_Pitch_Env_decay(p, value)
		return true
	case "amplitude", "kick-osc::amplitude":
		SNES_Kick_set_amplitude(p, value)
		return true
	case "drive", "kick-punch::drive":
		SNES_Kick_set_drive(p, value)
		return true
	case "frequency", "kick-osc::frequency":
		SNES_Kick_set_frequency(p, value)
		return true
	case "mix", "kick-punch::mix":
		SNES_Kick_set_mix(p, value)
		return true
	}
	return false
}

SNES_Kick_get_param :: proc(p: ^SNES_Kick_Processor, name: string) -> (f32, bool) {
	switch name {
	case "Amp_decay", "kick-amp::decay":
		return p.Amp_decay, true
	case "Pitch_Env_decay", "kick-pitch::decay":
		return p.Pitch_Env_decay, true
	case "amplitude", "kick-osc::amplitude":
		return p.amplitude, true
	case "drive", "kick-punch::drive":
		return p.drive, true
	case "frequency", "kick-osc::frequency":
		return p.frequency, true
	case "mix", "kick-punch::mix":
		return p.mix, true
	}
	return 0.0, false
}

SNES_Kick_process :: proc(p: ^SNES_Kick_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	SNES_Kick_process_sequence(p)
	p.total_samples += 1

	for v_idx in 0..<2 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_kick_amp_stage != .Release && voice.adsr_kick_amp_stage != .Idle {
				voice.adsr_kick_amp_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_kick_pitch_stage != .Release && voice.adsr_kick_pitch_stage != .Idle {
				voice.adsr_kick_pitch_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_kick_amp_out: f32 = 0.0
		node_kick_osc_out: f32 = 0.0
		node_kick_output_out: f32 = 0.0
		node_kick_pitch_out: f32 = 0.0
		node_kick_pitch_map_out: f32 = 0.0
		node_kick_punch_out: f32 = 0.0

		// --- ADSR Node kick_pitch ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_kick_pitch_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.001000000)) > 0 do envelope = voice.adsr_kick_pitch_attack_start + (1.0 - voice.adsr_kick_pitch_attack_start) * (voice.age / math.max(f32(f32(0.001000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_kick_pitch_release_level = envelope;
				if voice.age >= (f32(0.001000000)) {
					voice.adsr_kick_pitch_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.001000000));
				if (p.Pitch_Env_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Pitch_Env_decay), 0.000001)) * (1.0 - (f32(0.000000000))); else do envelope = (f32(0.000000000));
				voice.adsr_kick_pitch_release_level = envelope;
				if time_in_decay >= (p.Pitch_Env_decay) {
					voice.adsr_kick_pitch_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.000000000));
				voice.adsr_kick_pitch_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.010000000)) > 0 do envelope = voice.adsr_kick_pitch_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.010000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_kick_pitch_stage = .Idle;
				}
			}
			vel_scale_kick_pitch: f32 = (1.0 - (f32(0.300000000))) + (f32(0.300000000)) * voice.velocity;
			node_kick_pitch_out = (1.0) * envelope * (f32(1.000000000)) * vel_scale_kick_pitch;
		}

		// --- Mapper Node kick_pitch_map ---
		{
			in_range_kick_pitch_map: f32 = f32(f32(1.000000000)) - f32(f32(0.000000000));
			if in_range_kick_pitch_map == 0.0 do in_range_kick_pitch_map = 1.0;
			node_kick_pitch_map_out = math.lerp(f32(f32(0.000000000)), f32(f32(2.200000000)), math.clamp((f32((node_kick_pitch_out)) - f32(f32(0.000000000))) / in_range_kick_pitch_map, 0.0, 1.0));
		}

		// --- Oscillator Node kick_osc (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = ((p.frequency) * math.pow(2.0, math.clamp(f32(node_kick_pitch_map_out), -10.0, 10.0))) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_kick_osc_phase[i] = math.mod(voice.osc_kick_osc_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_kick_osc_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += math.sin(final_phase);
			}
			node_kick_osc_out = (unison_out / f32(unison_count)) * (p.amplitude);
		}

		// --- ADSR Node kick_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_kick_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.001000000)) > 0 do envelope = voice.adsr_kick_amp_attack_start + (1.0 - voice.adsr_kick_amp_attack_start) * (voice.age / math.max(f32(f32(0.001000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_kick_amp_release_level = envelope;
				if voice.age >= (f32(0.001000000)) {
					voice.adsr_kick_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.001000000));
				if (p.Amp_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Amp_decay), 0.000001)) * (1.0 - (f32(0.000000000))); else do envelope = (f32(0.000000000));
				voice.adsr_kick_amp_release_level = envelope;
				if time_in_decay >= (p.Amp_decay) {
					voice.adsr_kick_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.000000000));
				voice.adsr_kick_amp_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.040000000)) > 0 do envelope = voice.adsr_kick_amp_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.040000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_kick_amp_stage = .Idle;
				}
			}
			vel_scale_kick_amp: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_kick_amp_out = ((node_kick_osc_out)) * envelope * (f32(1.000000000)) * vel_scale_kick_amp;
		}

		// --- Distortion Node kick_punch (soft) ---
		{
			dist_in_kick_punch: f32 = ((node_kick_amp_out));
			dist_k_kick_punch: f32 = math.max(f32(p.drive), 1.0);
			dist_wet_kick_punch: f32 = math.tanh(dist_in_kick_punch * dist_k_kick_punch);
			tone_k_kick_punch: f32 = math.clamp(2.0 * f32(math.PI) * math.clamp(f32(f32(2400.000000000)), 100.0, 20000.0) / sample_rate, 0.001, 1.0);
			voice.dist_kick_punch_tone += tone_k_kick_punch * (dist_wet_kick_punch - voice.dist_kick_punch_tone);
			mix_kick_punch: f32 = math.clamp(f32(p.mix), 0.0, 1.0);
			node_kick_punch_out = dist_in_kick_punch * (1.0 - mix_kick_punch) + voice.dist_kick_punch_tone * mix_kick_punch;
		}

		output_left += node_kick_punch_out
		output_right += node_kick_punch_out
		if voice.adsr_kick_amp_stage != .Idle do voice_busy = true
		if voice.adsr_kick_pitch_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
SNES_Kick_process_sequence :: proc(p: ^SNES_Kick_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "SNES Kick" (64 steps)
		switch p.current_step % 64 {
		case 0:
			SNES_Kick_note_on(p, 36, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 7:
			SNES_Kick_note_on(p, 36, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 10:
			SNES_Kick_note_on(p, 36, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 14:
			SNES_Kick_note_on(p, 36, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 16:
			SNES_Kick_note_on(p, 36, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 23:
			SNES_Kick_note_on(p, 36, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 26:
			SNES_Kick_note_on(p, 36, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 30:
			SNES_Kick_note_on(p, 36, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 32:
			SNES_Kick_note_on(p, 36, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 39:
			SNES_Kick_note_on(p, 36, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 42:
			SNES_Kick_note_on(p, 36, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 46:
			SNES_Kick_note_on(p, 36, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 48:
			SNES_Kick_note_on(p, 36, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 55:
			SNES_Kick_note_on(p, 36, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 58:
			SNES_Kick_note_on(p, 36, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 62:
			SNES_Kick_note_on(p, 36, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 63:
			SNES_Kick_note_on(p, 36, 0.649999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 64 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

SNES_Slap_Bass_Voice_State :: struct {
	active: bool,
	note: u8,
	velocity: f32,
	age: f32,
	time_released: f32,
	current_freq: f32,
	target_freq: f32,
	glide_time: f32,
	duration: f32,
	adsr_bass_amp_stage: ADSR_Stage,
	adsr_bass_amp_release_level: f32,
	adsr_bass_amp_attack_start: f32,
	adsr_bass_fenv_stage: ADSR_Stage,
	adsr_bass_fenv_release_level: f32,
	adsr_bass_fenv_attack_start: f32,
	filter_bass_filter_low: f32,
	filter_bass_filter_band: f32,
	dist_bass_grit_tone: f32,
	osc_bass_osc_phase: [1]f32,
}

SNES_Slap_Bass_Processor :: struct {
	sample_rate: f32,
	bpm: f32,
	voices: [1]SNES_Slap_Bass_Voice_State,
	prng: PRNG_State,
	total_samples: u64,
	playing: bool,
	loop: bool,
	current_step: u64,
	samples_until_next_step: u64,
	step_frac_acc: f32,
	ext_in_l: f32,
	ext_in_r: f32,
	volume: f32,
	Amp_decay: f32,
	Slap_Env_decay: f32,
	amplitude: f32,
	cutoff: f32,
	drive: f32,
	mix: f32,
	resonance: f32,
	sustain: f32,
}

SNES_Slap_Bass_init :: proc(p: ^SNES_Slap_Bass_Processor, sr: f32) {
	p.sample_rate = sr
	p.bpm = 104.000000000
	p.volume = 0.699999988
	p.prng.state = 12345
	p.loop = true
	p.voices = {}
	p.total_samples = 0
	p.playing = false
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
	p.ext_in_l = 0.0
	p.ext_in_r = 0.0
	p.Amp_decay = 0.180000007
	p.Slap_Env_decay = 0.090000004
	p.amplitude = 0.600000024
	p.cutoff = 420.000000000
	p.drive = 8.000000000
	p.mix = 0.300000012
	p.resonance = 3.500000000
	p.sustain = 0.349999994
}

SNES_Slap_Bass_note_on :: proc(p: ^SNES_Slap_Bass_Processor, note: u8, velocity: f32, duration: f32) {
	// note and velocity are clamped silently to their MIDI/normalized domains.
	note := note
	if note > 127 do note = 127
	velocity := math.clamp(velocity, 0.0, 1.0)
	voice_idx := -1
	for i in 0..<1 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_releasing_age: f32 = -1.0
		for i in 0..<1 {
			releasing := true
			if p.voices[i].adsr_bass_amp_stage != .Release && p.voices[i].adsr_bass_amp_stage != .Idle do releasing = false
			if p.voices[i].adsr_bass_fenv_stage != .Release && p.voices[i].adsr_bass_fenv_stage != .Idle do releasing = false
			if releasing && p.voices[i].age > oldest_releasing_age {
				oldest_releasing_age = p.voices[i].age
				voice_idx = i
			}
		}
		if voice_idx == -1 {
			oldest_age: f32 = -1.0
			for i in 0..<1 {
				if p.voices[i].age > oldest_age {
					oldest_age = p.voices[i].age
					voice_idx = i
				}
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	adsr_bass_amp_prev_level: f32 = 0.0
	if stolen && v.adsr_bass_amp_stage != .Idle {
		adsr_bass_amp_prev_level = v.adsr_bass_amp_release_level
		if v.adsr_bass_amp_stage == .Release {
			rel_t_bass_amp: f32 = (f32(0.080000000));
			if rel_t_bass_amp > 0.0 {
				rf_bass_amp := 1.0 - (v.age - v.time_released) / math.max(rel_t_bass_amp, 0.000001)
				if rf_bass_amp < 0.0 do rf_bass_amp = 0.0
				adsr_bass_amp_prev_level *= rf_bass_amp
			} else {
				adsr_bass_amp_prev_level = 0.0
			}
		}
	}
	adsr_bass_fenv_prev_level: f32 = 0.0
	if stolen && v.adsr_bass_fenv_stage != .Idle {
		adsr_bass_fenv_prev_level = v.adsr_bass_fenv_release_level
		if v.adsr_bass_fenv_stage == .Release {
			rel_t_bass_fenv: f32 = (f32(0.050000000));
			if rel_t_bass_fenv > 0.0 {
				rf_bass_fenv := 1.0 - (v.age - v.time_released) / math.max(rel_t_bass_fenv, 0.000001)
				if rf_bass_fenv < 0.0 do rf_bass_fenv = 0.0
				adsr_bass_fenv_prev_level *= rf_bass_fenv
			} else {
				adsr_bass_fenv_prev_level = 0.0
			}
		}
	}
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.020000000
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	v.adsr_bass_amp_stage = .Attack
	v.adsr_bass_amp_attack_start = adsr_bass_amp_prev_level
	v.adsr_bass_amp_release_level = adsr_bass_amp_prev_level
	v.adsr_bass_fenv_stage = .Attack
	v.adsr_bass_fenv_attack_start = adsr_bass_fenv_prev_level
	v.adsr_bass_fenv_release_level = adsr_bass_fenv_prev_level
	if !stolen {
		v.filter_bass_filter_low = 0.0
		v.filter_bass_filter_band = 0.0
		v.dist_bass_grit_tone = 0.0
		v.osc_bass_osc_phase = {}
	}
}

SNES_Slap_Bass_note_off :: proc(p: ^SNES_Slap_Bass_Processor, note: u8) {
	// Clamped to match _note_on: `note` is the voice key, so both must map it.
	note := note
	if note > 127 do note = 127
	best := -1
	best_age: f32 = -1.0
	for i in 0..<1 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_bass_amp_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_bass_amp_stage = .Release
		p.voices[best].adsr_bass_fenv_stage = .Release
	}
}

SNES_Slap_Bass_trigger :: proc(p: ^SNES_Slap_Bass_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (f32(0.002000000)) + (p.Amp_decay) > d do d = (f32(0.002000000)) + (p.Amp_decay)
		if (f32(0.001000000)) + (p.Slap_Env_decay) > d do d = (f32(0.001000000)) + (p.Slap_Env_decay)
		if d <= 0.0 do d = 0.001
	}
	SNES_Slap_Bass_note_on(p, note, velocity, d)
}

SNES_Slap_Bass_feed_input :: proc(p: ^SNES_Slap_Bass_Processor, in_left: f32, in_right: f32) {
	p.ext_in_l = in_left
	p.ext_in_r = in_right
}

SNES_Slap_Bass_start :: proc(p: ^SNES_Slap_Bass_Processor) {
	p.playing = true
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
}

SNES_Slap_Bass_stop :: proc(p: ^SNES_Slap_Bass_Processor) {
	p.playing = false
}

SNES_Slap_Bass_set_loop :: proc(p: ^SNES_Slap_Bass_Processor, loop: bool) {
	p.loop = loop
}

SNES_Slap_Bass_set_volume :: proc(p: ^SNES_Slap_Bass_Processor, value: f32) {
	p.volume = math.clamp(value, 0.0, 1.0)
}

SNES_Slap_Bass_is_playing :: proc(p: ^SNES_Slap_Bass_Processor) -> bool {
	if p.playing do return true
	for i in 0..<1 {
		if p.voices[i].active do return true
	}
	return false
}

SNES_Slap_Bass_set_Amp_decay :: proc(p: ^SNES_Slap_Bass_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 10.000000000 do v = 10.000000000
	p.Amp_decay = v
}

SNES_Slap_Bass_set_Slap_Env_decay :: proc(p: ^SNES_Slap_Bass_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 10.000000000 do v = 10.000000000
	p.Slap_Env_decay = v
}

SNES_Slap_Bass_set_amplitude :: proc(p: ^SNES_Slap_Bass_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 1.000000000 do v = 1.000000000
	p.amplitude = v
}

SNES_Slap_Bass_set_cutoff :: proc(p: ^SNES_Slap_Bass_Processor, value: f32) {
	v := value
	if v < 20.000000000 do v = 20.000000000
	if v > 20000.000000000 do v = 20000.000000000
	p.cutoff = v
}

SNES_Slap_Bass_set_drive :: proc(p: ^SNES_Slap_Bass_Processor, value: f32) {
	v := value
	if v < 1.000000000 do v = 1.000000000
	if v > 100.000000000 do v = 100.000000000
	p.drive = v
}

SNES_Slap_Bass_set_mix :: proc(p: ^SNES_Slap_Bass_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 1.000000000 do v = 1.000000000
	p.mix = v
}

SNES_Slap_Bass_set_resonance :: proc(p: ^SNES_Slap_Bass_Processor, value: f32) {
	v := value
	if v < 0.100000001 do v = 0.100000001
	if v > 20.000000000 do v = 20.000000000
	p.resonance = v
}

SNES_Slap_Bass_set_sustain :: proc(p: ^SNES_Slap_Bass_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 1.000000000 do v = 1.000000000
	p.sustain = v
}

SNES_Slap_Bass_PARAMS := []Skald_Param_Info{
	{"Amp_decay", 0.000000000, 10.000000000, 0.180000007, "s"},
	{"Slap_Env_decay", 0.000000000, 10.000000000, 0.090000004, "s"},
	{"amplitude", 0.000000000, 1.000000000, 0.600000024, ""},
	{"cutoff", 20.000000000, 20000.000000000, 420.000000000, "Hz"},
	{"drive", 1.000000000, 100.000000000, 8.000000000, "x"},
	{"mix", 0.000000000, 1.000000000, 0.300000012, ""},
	{"resonance", 0.100000001, 20.000000000, 3.500000000, "Q"},
	{"sustain", 0.000000000, 1.000000000, 0.349999994, ""},
}

SNES_Slap_Bass_set_param :: proc(p: ^SNES_Slap_Bass_Processor, name: string, value: f32) -> bool {
	switch name {
	case "Amp_decay", "bass-amp::decay":
		SNES_Slap_Bass_set_Amp_decay(p, value)
		return true
	case "Slap_Env_decay", "bass-fenv::decay":
		SNES_Slap_Bass_set_Slap_Env_decay(p, value)
		return true
	case "amplitude", "bass-osc::amplitude":
		SNES_Slap_Bass_set_amplitude(p, value)
		return true
	case "cutoff", "bass-filter::cutoff":
		SNES_Slap_Bass_set_cutoff(p, value)
		return true
	case "drive", "bass-grit::drive":
		SNES_Slap_Bass_set_drive(p, value)
		return true
	case "mix", "bass-grit::mix":
		SNES_Slap_Bass_set_mix(p, value)
		return true
	case "resonance", "bass-filter::resonance":
		SNES_Slap_Bass_set_resonance(p, value)
		return true
	case "sustain", "bass-amp::sustain":
		SNES_Slap_Bass_set_sustain(p, value)
		return true
	}
	return false
}

SNES_Slap_Bass_get_param :: proc(p: ^SNES_Slap_Bass_Processor, name: string) -> (f32, bool) {
	switch name {
	case "Amp_decay", "bass-amp::decay":
		return p.Amp_decay, true
	case "Slap_Env_decay", "bass-fenv::decay":
		return p.Slap_Env_decay, true
	case "amplitude", "bass-osc::amplitude":
		return p.amplitude, true
	case "cutoff", "bass-filter::cutoff":
		return p.cutoff, true
	case "drive", "bass-grit::drive":
		return p.drive, true
	case "mix", "bass-grit::mix":
		return p.mix, true
	case "resonance", "bass-filter::resonance":
		return p.resonance, true
	case "sustain", "bass-amp::sustain":
		return p.sustain, true
	}
	return 0.0, false
}

SNES_Slap_Bass_process :: proc(p: ^SNES_Slap_Bass_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	SNES_Slap_Bass_process_sequence(p)
	p.total_samples += 1

	for v_idx in 0..<1 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.current_freq != voice.target_freq {
			glide_k := 1.0 / math.max(voice.glide_time * sample_rate, 1.0)
			if glide_k > 1.0 do glide_k = 1.0
			voice.current_freq += (voice.target_freq - voice.current_freq) * glide_k
			if abs(voice.target_freq - voice.current_freq) < 0.1 do voice.current_freq = voice.target_freq
		}
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_bass_amp_stage != .Release && voice.adsr_bass_amp_stage != .Idle {
				voice.adsr_bass_amp_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_bass_fenv_stage != .Release && voice.adsr_bass_fenv_stage != .Idle {
				voice.adsr_bass_fenv_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_bass_amp_out: f32 = 0.0
		node_bass_fenv_out: f32 = 0.0
		node_bass_filter_out: f32 = 0.0
		node_bass_fmap_out: f32 = 0.0
		node_bass_grit_out: f32 = 0.0
		node_bass_osc_out: f32 = 0.0
		node_bass_output_out: f32 = 0.0

		// --- ADSR Node bass_fenv ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_bass_fenv_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.001000000)) > 0 do envelope = voice.adsr_bass_fenv_attack_start + (1.0 - voice.adsr_bass_fenv_attack_start) * (voice.age / math.max(f32(f32(0.001000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_bass_fenv_release_level = envelope;
				if voice.age >= (f32(0.001000000)) {
					voice.adsr_bass_fenv_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.001000000));
				if (p.Slap_Env_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Slap_Env_decay), 0.000001)) * (1.0 - (f32(0.100000000))); else do envelope = (f32(0.100000000));
				voice.adsr_bass_fenv_release_level = envelope;
				if time_in_decay >= (p.Slap_Env_decay) {
					voice.adsr_bass_fenv_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.100000000));
				voice.adsr_bass_fenv_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.050000000)) > 0 do envelope = voice.adsr_bass_fenv_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.050000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_bass_fenv_stage = .Idle;
				}
			}
			vel_scale_bass_fenv: f32 = (1.0 - (f32(0.700000000))) + (f32(0.700000000)) * voice.velocity;
			node_bass_fenv_out = (1.0) * envelope * (f32(1.000000000)) * vel_scale_bass_fenv;
		}

		// --- Oscillator Node bass_osc (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_bass_osc_phase[i] = math.mod(voice.osc_bass_osc_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_bass_osc_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += ((final_phase / f32(math.PI)) - 1.0);
			}
			node_bass_osc_out = (unison_out / f32(unison_count)) * (p.amplitude);
		}

		// --- Mapper Node bass_fmap ---
		{
			in_range_bass_fmap: f32 = f32(f32(1.000000000)) - f32(f32(0.000000000));
			if in_range_bass_fmap == 0.0 do in_range_bass_fmap = 1.0;
			node_bass_fmap_out = math.lerp(f32(f32(200.000000000)), f32(f32(3600.000000000)), math.clamp((f32((node_bass_fenv_out)) - f32(f32(0.000000000))) / in_range_bass_fmap, 0.0, 1.0));
		}

		// --- ADSR Node bass_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_bass_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.002000000)) > 0 do envelope = voice.adsr_bass_amp_attack_start + (1.0 - voice.adsr_bass_amp_attack_start) * (voice.age / math.max(f32(f32(0.002000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_bass_amp_release_level = envelope;
				if voice.age >= (f32(0.002000000)) {
					voice.adsr_bass_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.002000000));
				if (p.Amp_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Amp_decay), 0.000001)) * (1.0 - (p.sustain)); else do envelope = (p.sustain);
				voice.adsr_bass_amp_release_level = envelope;
				if time_in_decay >= (p.Amp_decay) {
					voice.adsr_bass_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.sustain);
				voice.adsr_bass_amp_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.080000000)) > 0 do envelope = voice.adsr_bass_amp_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.080000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_bass_amp_stage = .Idle;
				}
			}
			vel_scale_bass_amp: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_bass_amp_out = ((node_bass_osc_out)) * envelope * (f32(1.000000000)) * vel_scale_bass_amp;
		}

		// --- Filter Node bass_filter (SVF) ---
		{
			cutoff_c_bass_filter: f32 = math.clamp(f32((p.cutoff) + (node_bass_fmap_out)), 10.0, sample_rate * 0.16);
			f_bass_filter := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_bass_filter / sample_rate));
			q_bass_filter: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_bass_filter);
			voice.filter_bass_filter_low += f_bass_filter * voice.filter_bass_filter_band;
			high_bass_filter := f32(((node_bass_amp_out)) - voice.filter_bass_filter_low - q_bass_filter * voice.filter_bass_filter_band);
			voice.filter_bass_filter_band += f_bass_filter * high_bass_filter;
			node_bass_filter_out = voice.filter_bass_filter_low;
		}

		// --- Distortion Node bass_grit (soft) ---
		{
			dist_in_bass_grit: f32 = ((node_bass_filter_out));
			dist_k_bass_grit: f32 = math.max(f32(p.drive), 1.0);
			dist_wet_bass_grit: f32 = math.tanh(dist_in_bass_grit * dist_k_bass_grit);
			tone_k_bass_grit: f32 = math.clamp(2.0 * f32(math.PI) * math.clamp(f32(f32(2600.000000000)), 100.0, 20000.0) / sample_rate, 0.001, 1.0);
			voice.dist_bass_grit_tone += tone_k_bass_grit * (dist_wet_bass_grit - voice.dist_bass_grit_tone);
			mix_bass_grit: f32 = math.clamp(f32(p.mix), 0.0, 1.0);
			node_bass_grit_out = dist_in_bass_grit * (1.0 - mix_bass_grit) + voice.dist_bass_grit_tone * mix_bass_grit;
		}

		output_left += node_bass_grit_out
		output_right += node_bass_grit_out
		if voice.adsr_bass_amp_stage != .Idle do voice_busy = true
		if voice.adsr_bass_fenv_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
SNES_Slap_Bass_process_sequence :: proc(p: ^SNES_Slap_Bass_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "SNES Slap Bass" (64 steps)
		switch p.current_step % 64 {
		case 0:
			SNES_Slap_Bass_note_on(p, 38, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 3:
			SNES_Slap_Bass_note_on(p, 50, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 4:
			SNES_Slap_Bass_note_on(p, 38, 0.500000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 6:
			SNES_Slap_Bass_note_on(p, 48, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 7:
			SNES_Slap_Bass_note_on(p, 38, 0.600000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 10:
			SNES_Slap_Bass_note_on(p, 50, 0.850000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 11:
			SNES_Slap_Bass_note_on(p, 38, 0.500000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 13:
			SNES_Slap_Bass_note_on(p, 45, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 14:
			SNES_Slap_Bass_note_on(p, 38, 0.649999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 16:
			SNES_Slap_Bass_note_on(p, 34, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 19:
			SNES_Slap_Bass_note_on(p, 46, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 20:
			SNES_Slap_Bass_note_on(p, 34, 0.500000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 22:
			SNES_Slap_Bass_note_on(p, 44, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 23:
			SNES_Slap_Bass_note_on(p, 34, 0.600000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 26:
			SNES_Slap_Bass_note_on(p, 46, 0.850000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 27:
			SNES_Slap_Bass_note_on(p, 34, 0.500000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 29:
			SNES_Slap_Bass_note_on(p, 41, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 30:
			SNES_Slap_Bass_note_on(p, 34, 0.649999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 32:
			SNES_Slap_Bass_note_on(p, 31, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 35:
			SNES_Slap_Bass_note_on(p, 43, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 36:
			SNES_Slap_Bass_note_on(p, 31, 0.500000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 38:
			SNES_Slap_Bass_note_on(p, 41, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 39:
			SNES_Slap_Bass_note_on(p, 31, 0.600000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 42:
			SNES_Slap_Bass_note_on(p, 43, 0.850000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 43:
			SNES_Slap_Bass_note_on(p, 31, 0.500000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 45:
			SNES_Slap_Bass_note_on(p, 38, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 46:
			SNES_Slap_Bass_note_on(p, 31, 0.649999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 48:
			SNES_Slap_Bass_note_on(p, 33, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 51:
			SNES_Slap_Bass_note_on(p, 45, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 52:
			SNES_Slap_Bass_note_on(p, 33, 0.500000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 54:
			SNES_Slap_Bass_note_on(p, 43, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 55:
			SNES_Slap_Bass_note_on(p, 33, 0.600000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 58:
			SNES_Slap_Bass_note_on(p, 45, 0.850000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 59:
			SNES_Slap_Bass_note_on(p, 33, 0.500000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 61:
			SNES_Slap_Bass_note_on(p, 40, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 62:
			SNES_Slap_Bass_note_on(p, 33, 0.649999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 64 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

SNES_Snare_Voice_State :: struct {
	active: bool,
	note: u8,
	velocity: f32,
	age: f32,
	time_released: f32,
	current_freq: f32,
	target_freq: f32,
	glide_time: f32,
	duration: f32,
	filter_snare_band_low: f32,
	filter_snare_band_band: f32,
	noise_snare_noise_rng: PRNG_State,
	adsr_snare_noise_env_stage: ADSR_Stage,
	adsr_snare_noise_env_release_level: f32,
	adsr_snare_noise_env_attack_start: f32,
	adsr_snare_tone_env_stage: ADSR_Stage,
	adsr_snare_tone_env_release_level: f32,
	adsr_snare_tone_env_attack_start: f32,
	osc_snare_tone_osc_phase: [1]f32,
}

SNES_Snare_Processor :: struct {
	sample_rate: f32,
	bpm: f32,
	voices: [3]SNES_Snare_Voice_State,
	prng: PRNG_State,
	total_samples: u64,
	playing: bool,
	loop: bool,
	current_step: u64,
	samples_until_next_step: u64,
	step_frac_acc: f32,
	ext_in_l: f32,
	ext_in_r: f32,
	volume: f32,
	bus_tail_remaining: u64,
	bus_tail_armed: bool,
	delay_snare_room_buffer: [96000]f32,
	delay_snare_room_write_index: int,
	reverb_snare_room_pre_buffer: [48000]f32,
	Rattle_Env_decay: f32,
	Rattle_amplitude: f32,
	SNES_Room_decay: f32,
	Shell_Env_decay: f32,
	Shell_amplitude: f32,
	cutoff: f32,
	frequency: f32,
	mix: f32,
	resonance: f32,
}

SNES_Snare_BUS_TAIL_SECONDS :: f32(10.058000000)

// B7-2-followup / SKB-016: the LIVE counterpart to the worst-case constant
// above. Sums, over the same Delay/Reverb nodes compute_bus_tail_seconds
// analyzed, the same feedback_tail_seconds formula — but against each
// parameter's CURRENT value instead of its range maximum. Safe to call
// outside the audio path (once per note-off, not once per sample)
// because no Delay/Reverb parameter has a modulation port: get_f32_param
// resolves every one of them to either a plain field read or a literal,
// both valid wherever `p` is in scope.
SNES_Snare_bus_tail_seconds :: proc(p: ^SNES_Snare_Processor) -> f32 {
	total: f32 = 0.0
	mix_snare_room: f32 = (p.mix);
	if mix_snare_room > 0.0 {
		pre_snare_room: f32 = math.clamp(f32(f32(0.008000000)), 0.0, 0.25);
		decay_gain_snare_room: f32 = math.clamp(math.pow(f32(0.001), f32(0.075000000) / math.max(f32(p.SNES_Room_decay), 0.01)), 0.0, 0.95);
		total += pre_snare_room + skald_feedback_tail_seconds(f32(0.075000000), decay_gain_snare_room)
	}
	return total
}

SNES_Snare_init :: proc(p: ^SNES_Snare_Processor, sr: f32) {
	p.sample_rate = sr
	p.bpm = 104.000000000
	p.volume = 0.550000012
	p.prng.state = 12345
	p.loop = true
	p.voices = {}
	p.total_samples = 0
	p.playing = false
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
	p.ext_in_l = 0.0
	p.ext_in_r = 0.0
	p.bus_tail_remaining = 0
	p.bus_tail_armed = false
	for i in 0..<3 {
		v := &p.voices[i]
		v.noise_snare_noise_rng.state = u32(0xC0FFEE01) ~ u32(i + 1) * 2654435761
	}
	p.delay_snare_room_buffer = {}
	p.delay_snare_room_write_index = 0
	p.reverb_snare_room_pre_buffer = {}
	p.Rattle_Env_decay = 0.159999996
	p.Rattle_amplitude = 0.800000012
	p.SNES_Room_decay = 1.100000024
	p.Shell_Env_decay = 0.090000004
	p.Shell_amplitude = 0.349999994
	p.cutoff = 2200.000000000
	p.frequency = 190.000000000
	p.mix = 0.219999999
	p.resonance = 1.799999952
}

SNES_Snare_note_on :: proc(p: ^SNES_Snare_Processor, note: u8, velocity: f32, duration: f32) {
	// note and velocity are clamped silently to their MIDI/normalized domains.
	note := note
	if note > 127 do note = 127
	velocity := math.clamp(velocity, 0.0, 1.0)
	voice_idx := -1
	for i in 0..<3 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_releasing_age: f32 = -1.0
		for i in 0..<3 {
			releasing := true
			if p.voices[i].adsr_snare_noise_env_stage != .Release && p.voices[i].adsr_snare_noise_env_stage != .Idle do releasing = false
			if p.voices[i].adsr_snare_tone_env_stage != .Release && p.voices[i].adsr_snare_tone_env_stage != .Idle do releasing = false
			if releasing && p.voices[i].age > oldest_releasing_age {
				oldest_releasing_age = p.voices[i].age
				voice_idx = i
			}
		}
		if voice_idx == -1 {
			oldest_age: f32 = -1.0
			for i in 0..<3 {
				if p.voices[i].age > oldest_age {
					oldest_age = p.voices[i].age
					voice_idx = i
				}
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	adsr_snare_noise_env_prev_level: f32 = 0.0
	if stolen && v.adsr_snare_noise_env_stage != .Idle {
		adsr_snare_noise_env_prev_level = v.adsr_snare_noise_env_release_level
		if v.adsr_snare_noise_env_stage == .Release {
			rel_t_snare_noise_env: f32 = (f32(0.050000000));
			if rel_t_snare_noise_env > 0.0 {
				rf_snare_noise_env := 1.0 - (v.age - v.time_released) / math.max(rel_t_snare_noise_env, 0.000001)
				if rf_snare_noise_env < 0.0 do rf_snare_noise_env = 0.0
				adsr_snare_noise_env_prev_level *= rf_snare_noise_env
			} else {
				adsr_snare_noise_env_prev_level = 0.0
			}
		}
	}
	adsr_snare_tone_env_prev_level: f32 = 0.0
	if stolen && v.adsr_snare_tone_env_stage != .Idle {
		adsr_snare_tone_env_prev_level = v.adsr_snare_tone_env_release_level
		if v.adsr_snare_tone_env_stage == .Release {
			rel_t_snare_tone_env: f32 = (f32(0.030000000));
			if rel_t_snare_tone_env > 0.0 {
				rf_snare_tone_env := 1.0 - (v.age - v.time_released) / math.max(rel_t_snare_tone_env, 0.000001)
				if rf_snare_tone_env < 0.0 do rf_snare_tone_env = 0.0
				adsr_snare_tone_env_prev_level *= rf_snare_tone_env
			} else {
				adsr_snare_tone_env_prev_level = 0.0
			}
		}
	}
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.000000000
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	v.adsr_snare_noise_env_stage = .Attack
	v.adsr_snare_noise_env_attack_start = adsr_snare_noise_env_prev_level
	v.adsr_snare_noise_env_release_level = adsr_snare_noise_env_prev_level
	v.adsr_snare_tone_env_stage = .Attack
	v.adsr_snare_tone_env_attack_start = adsr_snare_tone_env_prev_level
	v.adsr_snare_tone_env_release_level = adsr_snare_tone_env_prev_level
	if !stolen {
		v.filter_snare_band_low = 0.0
		v.filter_snare_band_band = 0.0
		v.osc_snare_tone_osc_phase = {}
	}
}

SNES_Snare_note_off :: proc(p: ^SNES_Snare_Processor, note: u8) {
	// Clamped to match _note_on: `note` is the voice key, so both must map it.
	note := note
	if note > 127 do note = 127
	best := -1
	best_age: f32 = -1.0
	for i in 0..<3 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_snare_noise_env_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_snare_noise_env_stage = .Release
		p.voices[best].adsr_snare_tone_env_stage = .Release
	}
}

SNES_Snare_trigger :: proc(p: ^SNES_Snare_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (f32(0.001000000)) + (p.Rattle_Env_decay) > d do d = (f32(0.001000000)) + (p.Rattle_Env_decay)
		if (f32(0.001000000)) + (p.Shell_Env_decay) > d do d = (f32(0.001000000)) + (p.Shell_Env_decay)
		if d <= 0.0 do d = 0.001
	}
	SNES_Snare_note_on(p, note, velocity, d)
}

SNES_Snare_feed_input :: proc(p: ^SNES_Snare_Processor, in_left: f32, in_right: f32) {
	p.ext_in_l = in_left
	p.ext_in_r = in_right
}

SNES_Snare_start :: proc(p: ^SNES_Snare_Processor) {
	p.playing = true
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
}

SNES_Snare_stop :: proc(p: ^SNES_Snare_Processor) {
	p.playing = false
}

SNES_Snare_set_loop :: proc(p: ^SNES_Snare_Processor, loop: bool) {
	p.loop = loop
}

SNES_Snare_set_volume :: proc(p: ^SNES_Snare_Processor, value: f32) {
	p.volume = math.clamp(value, 0.0, 1.0)
}

SNES_Snare_is_playing :: proc(p: ^SNES_Snare_Processor) -> bool {
	if p.playing do return true
	for i in 0..<3 {
		if p.voices[i].active do return true
	}
	// The effect tail counts as playing: it is still audible after every
	// voice went inactive, and reporting false here is what let a game free
	// the asset mid-echo.
	if p.bus_tail_remaining > 0 do return true
	return false
}

SNES_Snare_set_Rattle_Env_decay :: proc(p: ^SNES_Snare_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 10.000000000 do v = 10.000000000
	p.Rattle_Env_decay = v
}

SNES_Snare_set_Rattle_amplitude :: proc(p: ^SNES_Snare_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 1.000000000 do v = 1.000000000
	p.Rattle_amplitude = v
}

SNES_Snare_set_SNES_Room_decay :: proc(p: ^SNES_Snare_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 10.000000000 do v = 10.000000000
	p.SNES_Room_decay = v
}

SNES_Snare_set_Shell_Env_decay :: proc(p: ^SNES_Snare_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 10.000000000 do v = 10.000000000
	p.Shell_Env_decay = v
}

SNES_Snare_set_Shell_amplitude :: proc(p: ^SNES_Snare_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 1.000000000 do v = 1.000000000
	p.Shell_amplitude = v
}

SNES_Snare_set_cutoff :: proc(p: ^SNES_Snare_Processor, value: f32) {
	v := value
	if v < 20.000000000 do v = 20.000000000
	if v > 20000.000000000 do v = 20000.000000000
	p.cutoff = v
}

SNES_Snare_set_frequency :: proc(p: ^SNES_Snare_Processor, value: f32) {
	v := value
	if v < 20.000000000 do v = 20.000000000
	if v > 20000.000000000 do v = 20000.000000000
	p.frequency = v
}

SNES_Snare_set_mix :: proc(p: ^SNES_Snare_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 1.000000000 do v = 1.000000000
	p.mix = v
}

SNES_Snare_set_resonance :: proc(p: ^SNES_Snare_Processor, value: f32) {
	v := value
	if v < 0.100000001 do v = 0.100000001
	if v > 20.000000000 do v = 20.000000000
	p.resonance = v
}

SNES_Snare_PARAMS := []Skald_Param_Info{
	{"Rattle_Env_decay", 0.000000000, 10.000000000, 0.159999996, "s"},
	{"Rattle_amplitude", 0.000000000, 1.000000000, 0.800000012, ""},
	{"SNES_Room_decay", 0.000000000, 10.000000000, 1.100000024, "s"},
	{"Shell_Env_decay", 0.000000000, 10.000000000, 0.090000004, "s"},
	{"Shell_amplitude", 0.000000000, 1.000000000, 0.349999994, ""},
	{"cutoff", 20.000000000, 20000.000000000, 2200.000000000, "Hz"},
	{"frequency", 20.000000000, 20000.000000000, 190.000000000, "Hz"},
	{"mix", 0.000000000, 1.000000000, 0.219999999, ""},
	{"resonance", 0.100000001, 20.000000000, 1.799999952, "Q"},
}

SNES_Snare_set_param :: proc(p: ^SNES_Snare_Processor, name: string, value: f32) -> bool {
	switch name {
	case "Rattle_Env_decay", "snare-noise-env::decay":
		SNES_Snare_set_Rattle_Env_decay(p, value)
		return true
	case "Rattle_amplitude", "snare-noise::amplitude":
		SNES_Snare_set_Rattle_amplitude(p, value)
		return true
	case "SNES_Room_decay", "snare-room::decay":
		SNES_Snare_set_SNES_Room_decay(p, value)
		return true
	case "Shell_Env_decay", "snare-tone-env::decay":
		SNES_Snare_set_Shell_Env_decay(p, value)
		return true
	case "Shell_amplitude", "snare-tone-osc::amplitude":
		SNES_Snare_set_Shell_amplitude(p, value)
		return true
	case "cutoff", "snare-band::cutoff":
		SNES_Snare_set_cutoff(p, value)
		return true
	case "frequency", "snare-tone-osc::frequency":
		SNES_Snare_set_frequency(p, value)
		return true
	case "mix", "snare-room::mix":
		SNES_Snare_set_mix(p, value)
		return true
	case "resonance", "snare-band::resonance":
		SNES_Snare_set_resonance(p, value)
		return true
	}
	return false
}

SNES_Snare_get_param :: proc(p: ^SNES_Snare_Processor, name: string) -> (f32, bool) {
	switch name {
	case "Rattle_Env_decay", "snare-noise-env::decay":
		return p.Rattle_Env_decay, true
	case "Rattle_amplitude", "snare-noise::amplitude":
		return p.Rattle_amplitude, true
	case "SNES_Room_decay", "snare-room::decay":
		return p.SNES_Room_decay, true
	case "Shell_Env_decay", "snare-tone-env::decay":
		return p.Shell_Env_decay, true
	case "Shell_amplitude", "snare-tone-osc::amplitude":
		return p.Shell_amplitude, true
	case "cutoff", "snare-band::cutoff":
		return p.cutoff, true
	case "frequency", "snare-tone-osc::frequency":
		return p.frequency, true
	case "mix", "snare-room::mix":
		return p.mix, true
	case "resonance", "snare-band::resonance":
		return p.resonance, true
	}
	return 0.0, false
}

SNES_Snare_process :: proc(p: ^SNES_Snare_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	SNES_Snare_process_sequence(p)
	p.total_samples += 1

	node_snare_mix_out_vsum: f32 = 0.0
	for v_idx in 0..<3 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_snare_noise_env_stage != .Release && voice.adsr_snare_noise_env_stage != .Idle {
				voice.adsr_snare_noise_env_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_snare_tone_env_stage != .Release && voice.adsr_snare_tone_env_stage != .Idle {
				voice.adsr_snare_tone_env_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_snare_band_out: f32 = 0.0
		node_snare_mix_out: f32 = 0.0
		node_snare_noise_out: f32 = 0.0
		node_snare_noise_env_out: f32 = 0.0
		node_snare_tone_env_out: f32 = 0.0
		node_snare_tone_osc_out: f32 = 0.0

		// --- Noise Node snare_noise ---
		node_snare_noise_out = (next_float32(&voice.noise_snare_noise_rng) * 2.0 - 1.0) * (p.Rattle_amplitude);

		// --- Oscillator Node snare_tone_osc (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = (p.frequency) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_snare_tone_osc_phase[i] = math.mod(voice.osc_snare_tone_osc_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_snare_tone_osc_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += (2.0 / f32(math.PI)) * math.asin(math.sin(final_phase));
			}
			node_snare_tone_osc_out = (unison_out / f32(unison_count)) * (p.Shell_amplitude);
		}

		// --- Filter Node snare_band (SVF) ---
		{
			cutoff_c_snare_band: f32 = math.clamp(f32(p.cutoff), 10.0, sample_rate * 0.16);
			f_snare_band := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_snare_band / sample_rate));
			q_snare_band: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_snare_band);
			voice.filter_snare_band_low += f_snare_band * voice.filter_snare_band_band;
			high_snare_band := f32(((node_snare_noise_out)) - voice.filter_snare_band_low - q_snare_band * voice.filter_snare_band_band);
			voice.filter_snare_band_band += f_snare_band * high_snare_band;
			node_snare_band_out = voice.filter_snare_band_band;
		}

		// --- ADSR Node snare_tone_env ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_snare_tone_env_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.001000000)) > 0 do envelope = voice.adsr_snare_tone_env_attack_start + (1.0 - voice.adsr_snare_tone_env_attack_start) * (voice.age / math.max(f32(f32(0.001000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_snare_tone_env_release_level = envelope;
				if voice.age >= (f32(0.001000000)) {
					voice.adsr_snare_tone_env_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.001000000));
				if (p.Shell_Env_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Shell_Env_decay), 0.000001)) * (1.0 - (f32(0.000000000))); else do envelope = (f32(0.000000000));
				voice.adsr_snare_tone_env_release_level = envelope;
				if time_in_decay >= (p.Shell_Env_decay) {
					voice.adsr_snare_tone_env_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.000000000));
				voice.adsr_snare_tone_env_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.030000000)) > 0 do envelope = voice.adsr_snare_tone_env_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.030000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_snare_tone_env_stage = .Idle;
				}
			}
			vel_scale_snare_tone_env: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_snare_tone_env_out = ((node_snare_tone_osc_out)) * envelope * (f32(1.000000000)) * vel_scale_snare_tone_env;
		}

		// --- ADSR Node snare_noise_env ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_snare_noise_env_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.001000000)) > 0 do envelope = voice.adsr_snare_noise_env_attack_start + (1.0 - voice.adsr_snare_noise_env_attack_start) * (voice.age / math.max(f32(f32(0.001000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_snare_noise_env_release_level = envelope;
				if voice.age >= (f32(0.001000000)) {
					voice.adsr_snare_noise_env_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.001000000));
				if (p.Rattle_Env_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Rattle_Env_decay), 0.000001)) * (1.0 - (f32(0.000000000))); else do envelope = (f32(0.000000000));
				voice.adsr_snare_noise_env_release_level = envelope;
				if time_in_decay >= (p.Rattle_Env_decay) {
					voice.adsr_snare_noise_env_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.000000000));
				voice.adsr_snare_noise_env_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.050000000)) > 0 do envelope = voice.adsr_snare_noise_env_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.050000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_snare_noise_env_stage = .Idle;
				}
			}
			vel_scale_snare_noise_env: f32 = (1.0 - (f32(0.600000000))) + (f32(0.600000000)) * voice.velocity;
			node_snare_noise_env_out = ((node_snare_band_out)) * envelope * (f32(1.000000000)) * vel_scale_snare_noise_env;
		}

		// --- Mixer Node snare_mix (2 inputs) ---
		{
			mix_sum_snare_mix: f32 = 0.0;
			mix_sum_snare_mix += node_snare_noise_env_out * (f32(0.850000024));
			mix_sum_snare_mix += node_snare_tone_env_out * (f32(0.600000024));
		node_snare_mix_out = mix_sum_snare_mix;
		}

		node_snare_mix_out_vsum += node_snare_mix_out
		if voice.adsr_snare_noise_env_stage != .Idle do voice_busy = true
		if voice.adsr_snare_tone_env_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}

	// --- Bus effects (once per sample, post voice sum) ---
	{
		node_snare_mix_out := node_snare_mix_out_vsum
		node_snare_room_out: f32 = 0.0
		// --- Reverb Node snare_room (pre-delay + feedback comb) ---
		{
			pre_delay_seconds_snare_room: f32 = math.clamp(f32(f32(0.008000000)), 0.0, 0.25);
			pre_delay_samples_snare_room := int(math.clamp(pre_delay_seconds_snare_room * sample_rate, 0.0, f32(48000)));
			pre_write_index_snare_room := p.delay_snare_room_write_index % len(p.reverb_snare_room_pre_buffer)
			pre_delayed_input_snare_room := f32((node_snare_mix_out))
			if pre_delay_samples_snare_room > 0 {
				pre_read_index_snare_room := (pre_write_index_snare_room - pre_delay_samples_snare_room + len(p.reverb_snare_room_pre_buffer)) % len(p.reverb_snare_room_pre_buffer)
				pre_delayed_input_snare_room = p.reverb_snare_room_pre_buffer[pre_read_index_snare_room]
			}
			p.reverb_snare_room_pre_buffer[pre_write_index_snare_room] = f32((node_snare_mix_out))
			delay_samples_snare_room := int(math.clamp((0.075000000) * sample_rate, 0, 96000-1));
			read_index_snare_room := (p.delay_snare_room_write_index - delay_samples_snare_room + len(p.delay_snare_room_buffer)) % len(p.delay_snare_room_buffer);
			delayed_sample_snare_room := p.delay_snare_room_buffer[read_index_snare_room];
			decay_gain_snare_room: f32 = math.clamp(math.pow(f32(0.001), f32(0.075000000) / math.max(f32(p.SNES_Room_decay), 0.01)), 0.0, 0.95);
			p.delay_snare_room_buffer[p.delay_snare_room_write_index] = pre_delayed_input_snare_room + delayed_sample_snare_room * decay_gain_snare_room;
			p.delay_snare_room_write_index = (p.delay_snare_room_write_index + 1) % len(p.delay_snare_room_buffer);
			node_snare_room_out = ((node_snare_mix_out)) * (1.0 - (p.mix)) + delayed_sample_snare_room * (p.mix);
		}

		output_left += node_snare_room_out
		output_right += node_snare_room_out
	}

	// B7-2-followup / SKB-016: a baked worst-case constant here held
	// is_playing true for minutes on real content (every exposed tail param
	// contributed its range maximum, so glassy-fm-pluck alone baked 202.5s
	// for a true tail under 2s). Arm on the FALLING EDGE instead, from the
	// live field values — that is one ln/pow per note-off rather than per
	// sample, which is what keeps this proc off the audio path.
	{
		voice_alive := false
		for i in 0..<3 {
			if p.voices[i].active {
				voice_alive = true
				break
			}
		}
		if voice_alive || p.playing {
			p.bus_tail_armed = false
			p.bus_tail_remaining = 0
		} else if !p.bus_tail_armed {
			p.bus_tail_armed = true
			p.bus_tail_remaining = u64(SNES_Snare_bus_tail_seconds(p) * sample_rate)
		} else if p.bus_tail_remaining > 0 {
			p.bus_tail_remaining -= 1
		}
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
SNES_Snare_process_sequence :: proc(p: ^SNES_Snare_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "SNES Snare" (64 steps)
		switch p.current_step % 64 {
		case 4:
			SNES_Snare_note_on(p, 38, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			SNES_Snare_note_on(p, 38, 0.949999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 20:
			SNES_Snare_note_on(p, 38, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 22:
			SNES_Snare_note_on(p, 38, 0.349999994, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 27:
			SNES_Snare_note_on(p, 38, 0.400000006, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 28:
			SNES_Snare_note_on(p, 38, 0.949999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 36:
			SNES_Snare_note_on(p, 38, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 44:
			SNES_Snare_note_on(p, 38, 0.949999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 52:
			SNES_Snare_note_on(p, 38, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 54:
			SNES_Snare_note_on(p, 38, 0.349999994, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 59:
			SNES_Snare_note_on(p, 38, 0.400000006, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 60:
			SNES_Snare_note_on(p, 38, 0.949999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 61:
			SNES_Snare_note_on(p, 38, 0.600000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 62:
			SNES_Snare_note_on(p, 38, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 63:
			SNES_Snare_note_on(p, 38, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 64 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

SNES_Space_Pad_Voice_State :: struct {
	active: bool,
	note: u8,
	velocity: f32,
	age: f32,
	time_released: f32,
	current_freq: f32,
	target_freq: f32,
	glide_time: f32,
	duration: f32,
	adsr_pad_amp_stage: ADSR_Stage,
	adsr_pad_amp_release_level: f32,
	adsr_pad_amp_attack_start: f32,
	lfo_pad_drift_lfo_phase: f32,
	filter_pad_filter_low: f32,
	filter_pad_filter_band: f32,
	osc_pad_osc_phase: [6]f32,
}

SNES_Space_Pad_Processor :: struct {
	sample_rate: f32,
	bpm: f32,
	voices: [8]SNES_Space_Pad_Voice_State,
	prng: PRNG_State,
	total_samples: u64,
	playing: bool,
	loop: bool,
	current_step: u64,
	samples_until_next_step: u64,
	step_frac_acc: f32,
	ext_in_l: f32,
	ext_in_r: f32,
	volume: f32,
	bus_tail_remaining: u64,
	bus_tail_armed: bool,
	delay_pad_space_buffer: [96000]f32,
	delay_pad_space_write_index: int,
	reverb_pad_space_pre_buffer: [48000]f32,
	Slow_Drift_amplitude: f32,
	Wide_Saw_amplitude: f32,
	attack: f32,
	cutoff: f32,
	decay: f32,
	frequency: f32,
	mix: f32,
	release: f32,
	resonance: f32,
}

SNES_Space_Pad_BUS_TAIL_SECONDS :: f32(10.110000000)

// B7-2-followup / SKB-016: the LIVE counterpart to the worst-case constant
// above. Sums, over the same Delay/Reverb nodes compute_bus_tail_seconds
// analyzed, the same feedback_tail_seconds formula — but against each
// parameter's CURRENT value instead of its range maximum. Safe to call
// outside the audio path (once per note-off, not once per sample)
// because no Delay/Reverb parameter has a modulation port: get_f32_param
// resolves every one of them to either a plain field read or a literal,
// both valid wherever `p` is in scope.
SNES_Space_Pad_bus_tail_seconds :: proc(p: ^SNES_Space_Pad_Processor) -> f32 {
	total: f32 = 0.0
	mix_pad_space: f32 = (p.mix);
	if mix_pad_space > 0.0 {
		pre_pad_space: f32 = math.clamp(f32(f32(0.060000000)), 0.0, 0.25);
		decay_gain_pad_space: f32 = math.clamp(math.pow(f32(0.001), f32(0.075000000) / math.max(f32(p.decay), 0.01)), 0.0, 0.95);
		total += pre_pad_space + skald_feedback_tail_seconds(f32(0.075000000), decay_gain_pad_space)
	}
	return total
}

SNES_Space_Pad_init :: proc(p: ^SNES_Space_Pad_Processor, sr: f32) {
	p.sample_rate = sr
	p.bpm = 104.000000000
	p.volume = 0.400000006
	p.prng.state = 12345
	p.loop = true
	p.voices = {}
	p.total_samples = 0
	p.playing = false
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
	p.ext_in_l = 0.0
	p.ext_in_r = 0.0
	p.bus_tail_remaining = 0
	p.bus_tail_armed = false
	p.delay_pad_space_buffer = {}
	p.delay_pad_space_write_index = 0
	p.reverb_pad_space_pre_buffer = {}
	p.Slow_Drift_amplitude = 1.000000000
	p.Wide_Saw_amplitude = 0.349999994
	p.attack = 0.899999976
	p.cutoff = 900.000000000
	p.decay = 6.000000000
	p.frequency = 0.119999997
	p.mix = 0.550000012
	p.release = 1.799999952
	p.resonance = 1.200000048
}

SNES_Space_Pad_note_on :: proc(p: ^SNES_Space_Pad_Processor, note: u8, velocity: f32, duration: f32) {
	// note and velocity are clamped silently to their MIDI/normalized domains.
	note := note
	if note > 127 do note = 127
	velocity := math.clamp(velocity, 0.0, 1.0)
	voice_idx := -1
	for i in 0..<8 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_releasing_age: f32 = -1.0
		for i in 0..<8 {
			releasing := true
			if p.voices[i].adsr_pad_amp_stage != .Release && p.voices[i].adsr_pad_amp_stage != .Idle do releasing = false
			if releasing && p.voices[i].age > oldest_releasing_age {
				oldest_releasing_age = p.voices[i].age
				voice_idx = i
			}
		}
		if voice_idx == -1 {
			oldest_age: f32 = -1.0
			for i in 0..<8 {
				if p.voices[i].age > oldest_age {
					oldest_age = p.voices[i].age
					voice_idx = i
				}
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	adsr_pad_amp_prev_level: f32 = 0.0
	if stolen && v.adsr_pad_amp_stage != .Idle {
		adsr_pad_amp_prev_level = v.adsr_pad_amp_release_level
		if v.adsr_pad_amp_stage == .Release {
			rel_t_pad_amp: f32 = (p.release);
			if rel_t_pad_amp > 0.0 {
				rf_pad_amp := 1.0 - (v.age - v.time_released) / math.max(rel_t_pad_amp, 0.000001)
				if rf_pad_amp < 0.0 do rf_pad_amp = 0.0
				adsr_pad_amp_prev_level *= rf_pad_amp
			} else {
				adsr_pad_amp_prev_level = 0.0
			}
		}
	}
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.000000000
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	v.adsr_pad_amp_stage = .Attack
	v.adsr_pad_amp_attack_start = adsr_pad_amp_prev_level
	v.adsr_pad_amp_release_level = adsr_pad_amp_prev_level
	if !stolen {
		v.lfo_pad_drift_lfo_phase = 0.0
		v.filter_pad_filter_low = 0.0
		v.filter_pad_filter_band = 0.0
		v.osc_pad_osc_phase = {}
	}
}

SNES_Space_Pad_note_off :: proc(p: ^SNES_Space_Pad_Processor, note: u8) {
	// Clamped to match _note_on: `note` is the voice key, so both must map it.
	note := note
	if note > 127 do note = 127
	best := -1
	best_age: f32 = -1.0
	for i in 0..<8 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_pad_amp_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_pad_amp_stage = .Release
	}
}

SNES_Space_Pad_trigger :: proc(p: ^SNES_Space_Pad_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (p.attack) + (f32(1.200000000)) > d do d = (p.attack) + (f32(1.200000000))
		if d <= 0.0 do d = 0.001
	}
	SNES_Space_Pad_note_on(p, note, velocity, d)
}

SNES_Space_Pad_feed_input :: proc(p: ^SNES_Space_Pad_Processor, in_left: f32, in_right: f32) {
	p.ext_in_l = in_left
	p.ext_in_r = in_right
}

SNES_Space_Pad_start :: proc(p: ^SNES_Space_Pad_Processor) {
	p.playing = true
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
}

SNES_Space_Pad_stop :: proc(p: ^SNES_Space_Pad_Processor) {
	p.playing = false
}

SNES_Space_Pad_set_loop :: proc(p: ^SNES_Space_Pad_Processor, loop: bool) {
	p.loop = loop
}

SNES_Space_Pad_set_volume :: proc(p: ^SNES_Space_Pad_Processor, value: f32) {
	p.volume = math.clamp(value, 0.0, 1.0)
}

SNES_Space_Pad_is_playing :: proc(p: ^SNES_Space_Pad_Processor) -> bool {
	if p.playing do return true
	for i in 0..<8 {
		if p.voices[i].active do return true
	}
	// The effect tail counts as playing: it is still audible after every
	// voice went inactive, and reporting false here is what let a game free
	// the asset mid-echo.
	if p.bus_tail_remaining > 0 do return true
	return false
}

SNES_Space_Pad_set_Slow_Drift_amplitude :: proc(p: ^SNES_Space_Pad_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 20000.000000000 do v = 20000.000000000
	p.Slow_Drift_amplitude = v
}

SNES_Space_Pad_set_Wide_Saw_amplitude :: proc(p: ^SNES_Space_Pad_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 1.000000000 do v = 1.000000000
	p.Wide_Saw_amplitude = v
}

SNES_Space_Pad_set_attack :: proc(p: ^SNES_Space_Pad_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 10.000000000 do v = 10.000000000
	p.attack = v
}

SNES_Space_Pad_set_cutoff :: proc(p: ^SNES_Space_Pad_Processor, value: f32) {
	v := value
	if v < 20.000000000 do v = 20.000000000
	if v > 20000.000000000 do v = 20000.000000000
	p.cutoff = v
}

SNES_Space_Pad_set_decay :: proc(p: ^SNES_Space_Pad_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 10.000000000 do v = 10.000000000
	p.decay = v
}

SNES_Space_Pad_set_frequency :: proc(p: ^SNES_Space_Pad_Processor, value: f32) {
	v := value
	if v < 0.010000000 do v = 0.010000000
	if v > 100.000000000 do v = 100.000000000
	p.frequency = v
}

SNES_Space_Pad_set_mix :: proc(p: ^SNES_Space_Pad_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 1.000000000 do v = 1.000000000
	p.mix = v
}

SNES_Space_Pad_set_release :: proc(p: ^SNES_Space_Pad_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 10.000000000 do v = 10.000000000
	p.release = v
}

SNES_Space_Pad_set_resonance :: proc(p: ^SNES_Space_Pad_Processor, value: f32) {
	v := value
	if v < 0.100000001 do v = 0.100000001
	if v > 20.000000000 do v = 20.000000000
	p.resonance = v
}

SNES_Space_Pad_PARAMS := []Skald_Param_Info{
	{"Slow_Drift_amplitude", 0.000000000, 20000.000000000, 1.000000000, ""},
	{"Wide_Saw_amplitude", 0.000000000, 1.000000000, 0.349999994, ""},
	{"attack", 0.000000000, 10.000000000, 0.899999976, "s"},
	{"cutoff", 20.000000000, 20000.000000000, 900.000000000, "Hz"},
	{"decay", 0.000000000, 10.000000000, 6.000000000, "s"},
	{"frequency", 0.010000000, 100.000000000, 0.119999997, "Hz"},
	{"mix", 0.000000000, 1.000000000, 0.550000012, ""},
	{"release", 0.000000000, 10.000000000, 1.799999952, "s"},
	{"resonance", 0.100000001, 20.000000000, 1.200000048, "Q"},
}

SNES_Space_Pad_set_param :: proc(p: ^SNES_Space_Pad_Processor, name: string, value: f32) -> bool {
	switch name {
	case "Slow_Drift_amplitude", "pad-drift-lfo::amplitude":
		SNES_Space_Pad_set_Slow_Drift_amplitude(p, value)
		return true
	case "Wide_Saw_amplitude", "pad-osc::amplitude":
		SNES_Space_Pad_set_Wide_Saw_amplitude(p, value)
		return true
	case "attack", "pad-amp::attack":
		SNES_Space_Pad_set_attack(p, value)
		return true
	case "cutoff", "pad-filter::cutoff":
		SNES_Space_Pad_set_cutoff(p, value)
		return true
	case "decay", "pad-space::decay":
		SNES_Space_Pad_set_decay(p, value)
		return true
	case "frequency", "pad-drift-lfo::frequency":
		SNES_Space_Pad_set_frequency(p, value)
		return true
	case "mix", "pad-space::mix":
		SNES_Space_Pad_set_mix(p, value)
		return true
	case "release", "pad-amp::release":
		SNES_Space_Pad_set_release(p, value)
		return true
	case "resonance", "pad-filter::resonance":
		SNES_Space_Pad_set_resonance(p, value)
		return true
	}
	return false
}

SNES_Space_Pad_get_param :: proc(p: ^SNES_Space_Pad_Processor, name: string) -> (f32, bool) {
	switch name {
	case "Slow_Drift_amplitude", "pad-drift-lfo::amplitude":
		return p.Slow_Drift_amplitude, true
	case "Wide_Saw_amplitude", "pad-osc::amplitude":
		return p.Wide_Saw_amplitude, true
	case "attack", "pad-amp::attack":
		return p.attack, true
	case "cutoff", "pad-filter::cutoff":
		return p.cutoff, true
	case "decay", "pad-space::decay":
		return p.decay, true
	case "frequency", "pad-drift-lfo::frequency":
		return p.frequency, true
	case "mix", "pad-space::mix":
		return p.mix, true
	case "release", "pad-amp::release":
		return p.release, true
	case "resonance", "pad-filter::resonance":
		return p.resonance, true
	}
	return 0.0, false
}

SNES_Space_Pad_process :: proc(p: ^SNES_Space_Pad_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	SNES_Space_Pad_process_sequence(p)
	p.total_samples += 1

	node_pad_filter_out_vsum: f32 = 0.0
	for v_idx in 0..<8 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_pad_amp_stage != .Release && voice.adsr_pad_amp_stage != .Idle {
				voice.adsr_pad_amp_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_pad_amp_out: f32 = 0.0
		node_pad_drift_lfo_out: f32 = 0.0
		node_pad_drift_map_out: f32 = 0.0
		node_pad_filter_out: f32 = 0.0
		node_pad_osc_out: f32 = 0.0

		// --- LFO Node pad_drift_lfo ---
		voice.lfo_pad_drift_lfo_phase = math.mod(voice.lfo_pad_drift_lfo_phase + (2 * f32(math.PI) * (p.frequency) / sample_rate), 2 * f32(math.PI));
		if voice.lfo_pad_drift_lfo_phase < 0.0 do voice.lfo_pad_drift_lfo_phase += 2 * f32(math.PI);
		node_pad_drift_lfo_out = math.sin(voice.lfo_pad_drift_lfo_phase) * (p.Slow_Drift_amplitude);

		// --- Oscillator Node pad_osc (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 6;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (22.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_pad_osc_phase[i] = math.mod(voice.osc_pad_osc_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_pad_osc_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += ((final_phase / f32(math.PI)) - 1.0);
			}
			node_pad_osc_out = (unison_out / f32(unison_count)) * (p.Wide_Saw_amplitude);
		}

		// --- Mapper Node pad_drift_map ---
		{
			in_range_pad_drift_map: f32 = f32(f32(1.000000000)) - f32(f32(-1.000000000));
			if in_range_pad_drift_map == 0.0 do in_range_pad_drift_map = 1.0;
			node_pad_drift_map_out = math.lerp(f32(f32(-450.000000000)), f32(f32(450.000000000)), math.clamp((f32((node_pad_drift_lfo_out)) - f32(f32(-1.000000000))) / in_range_pad_drift_map, 0.0, 1.0));
		}

		// --- ADSR Node pad_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_pad_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.attack) > 0 do envelope = voice.adsr_pad_amp_attack_start + (1.0 - voice.adsr_pad_amp_attack_start) * (voice.age / math.max(f32(p.attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_pad_amp_release_level = envelope;
				if voice.age >= (p.attack) {
					voice.adsr_pad_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.attack);
				if (f32(1.200000000)) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(f32(1.200000000)), 0.000001)) * (1.0 - (f32(0.700000000))); else do envelope = (f32(0.700000000));
				voice.adsr_pad_amp_release_level = envelope;
				if time_in_decay >= (f32(1.200000000)) {
					voice.adsr_pad_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.700000000));
				voice.adsr_pad_amp_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.release) > 0 do envelope = voice.adsr_pad_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_pad_amp_stage = .Idle;
				}
			}
			vel_scale_pad_amp: f32 = (1.0 - (f32(0.300000000))) + (f32(0.300000000)) * voice.velocity;
			node_pad_amp_out = ((node_pad_osc_out)) * envelope * (f32(1.000000000)) * vel_scale_pad_amp;
		}

		// --- Filter Node pad_filter (SVF) ---
		{
			cutoff_c_pad_filter: f32 = math.clamp(f32((p.cutoff) + (node_pad_drift_map_out)), 10.0, sample_rate * 0.16);
			f_pad_filter := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_pad_filter / sample_rate));
			q_pad_filter: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_pad_filter);
			voice.filter_pad_filter_low += f_pad_filter * voice.filter_pad_filter_band;
			high_pad_filter := f32(((node_pad_amp_out)) - voice.filter_pad_filter_low - q_pad_filter * voice.filter_pad_filter_band);
			voice.filter_pad_filter_band += f_pad_filter * high_pad_filter;
			node_pad_filter_out = voice.filter_pad_filter_low;
		}

		node_pad_filter_out_vsum += node_pad_filter_out
		if voice.adsr_pad_amp_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}

	// --- Bus effects (once per sample, post voice sum) ---
	{
		node_pad_filter_out := node_pad_filter_out_vsum
		node_pad_space_out: f32 = 0.0
		// --- Reverb Node pad_space (pre-delay + feedback comb) ---
		{
			pre_delay_seconds_pad_space: f32 = math.clamp(f32(f32(0.060000000)), 0.0, 0.25);
			pre_delay_samples_pad_space := int(math.clamp(pre_delay_seconds_pad_space * sample_rate, 0.0, f32(48000)));
			pre_write_index_pad_space := p.delay_pad_space_write_index % len(p.reverb_pad_space_pre_buffer)
			pre_delayed_input_pad_space := f32((node_pad_filter_out))
			if pre_delay_samples_pad_space > 0 {
				pre_read_index_pad_space := (pre_write_index_pad_space - pre_delay_samples_pad_space + len(p.reverb_pad_space_pre_buffer)) % len(p.reverb_pad_space_pre_buffer)
				pre_delayed_input_pad_space = p.reverb_pad_space_pre_buffer[pre_read_index_pad_space]
			}
			p.reverb_pad_space_pre_buffer[pre_write_index_pad_space] = f32((node_pad_filter_out))
			delay_samples_pad_space := int(math.clamp((0.075000000) * sample_rate, 0, 96000-1));
			read_index_pad_space := (p.delay_pad_space_write_index - delay_samples_pad_space + len(p.delay_pad_space_buffer)) % len(p.delay_pad_space_buffer);
			delayed_sample_pad_space := p.delay_pad_space_buffer[read_index_pad_space];
			decay_gain_pad_space: f32 = math.clamp(math.pow(f32(0.001), f32(0.075000000) / math.max(f32(p.decay), 0.01)), 0.0, 0.95);
			p.delay_pad_space_buffer[p.delay_pad_space_write_index] = pre_delayed_input_pad_space + delayed_sample_pad_space * decay_gain_pad_space;
			p.delay_pad_space_write_index = (p.delay_pad_space_write_index + 1) % len(p.delay_pad_space_buffer);
			node_pad_space_out = ((node_pad_filter_out)) * (1.0 - (p.mix)) + delayed_sample_pad_space * (p.mix);
		}

		output_left += node_pad_space_out
		output_right += node_pad_space_out
	}

	// B7-2-followup / SKB-016: a baked worst-case constant here held
	// is_playing true for minutes on real content (every exposed tail param
	// contributed its range maximum, so glassy-fm-pluck alone baked 202.5s
	// for a true tail under 2s). Arm on the FALLING EDGE instead, from the
	// live field values — that is one ln/pow per note-off rather than per
	// sample, which is what keeps this proc off the audio path.
	{
		voice_alive := false
		for i in 0..<8 {
			if p.voices[i].active {
				voice_alive = true
				break
			}
		}
		if voice_alive || p.playing {
			p.bus_tail_armed = false
			p.bus_tail_remaining = 0
		} else if !p.bus_tail_armed {
			p.bus_tail_armed = true
			p.bus_tail_remaining = u64(SNES_Space_Pad_bus_tail_seconds(p) * sample_rate)
		} else if p.bus_tail_remaining > 0 {
			p.bus_tail_remaining -= 1
		}
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
SNES_Space_Pad_process_sequence :: proc(p: ^SNES_Space_Pad_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "SNES Space Pad" (64 steps)
		switch p.current_step % 64 {
		case 0:
			SNES_Space_Pad_note_on(p, 50, 0.600000024, f32(16.000000000) * (60.0 / p.bpm / 4.0))
			SNES_Space_Pad_note_on(p, 53, 0.569999993, f32(16.000000000) * (60.0 / p.bpm / 4.0))
			SNES_Space_Pad_note_on(p, 57, 0.540000021, f32(16.000000000) * (60.0 / p.bpm / 4.0))
			SNES_Space_Pad_note_on(p, 60, 0.509999990, f32(16.000000000) * (60.0 / p.bpm / 4.0))
			SNES_Space_Pad_note_on(p, 64, 0.479999989, f32(16.000000000) * (60.0 / p.bpm / 4.0))
		case 16:
			SNES_Space_Pad_note_on(p, 46, 0.600000024, f32(16.000000000) * (60.0 / p.bpm / 4.0))
			SNES_Space_Pad_note_on(p, 50, 0.569999993, f32(16.000000000) * (60.0 / p.bpm / 4.0))
			SNES_Space_Pad_note_on(p, 53, 0.540000021, f32(16.000000000) * (60.0 / p.bpm / 4.0))
			SNES_Space_Pad_note_on(p, 57, 0.509999990, f32(16.000000000) * (60.0 / p.bpm / 4.0))
		case 32:
			SNES_Space_Pad_note_on(p, 43, 0.600000024, f32(16.000000000) * (60.0 / p.bpm / 4.0))
			SNES_Space_Pad_note_on(p, 46, 0.569999993, f32(16.000000000) * (60.0 / p.bpm / 4.0))
			SNES_Space_Pad_note_on(p, 50, 0.540000021, f32(16.000000000) * (60.0 / p.bpm / 4.0))
			SNES_Space_Pad_note_on(p, 53, 0.509999990, f32(16.000000000) * (60.0 / p.bpm / 4.0))
			SNES_Space_Pad_note_on(p, 57, 0.479999989, f32(16.000000000) * (60.0 / p.bpm / 4.0))
		case 48:
			SNES_Space_Pad_note_on(p, 45, 0.600000024, f32(16.000000000) * (60.0 / p.bpm / 4.0))
			SNES_Space_Pad_note_on(p, 49, 0.569999993, f32(16.000000000) * (60.0 / p.bpm / 4.0))
			SNES_Space_Pad_note_on(p, 52, 0.540000021, f32(16.000000000) * (60.0 / p.bpm / 4.0))
			SNES_Space_Pad_note_on(p, 55, 0.509999990, f32(16.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 64 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

SNES_Starfield_Arp_Voice_State :: struct {
	active: bool,
	note: u8,
	velocity: f32,
	age: f32,
	time_released: f32,
	current_freq: f32,
	target_freq: f32,
	glide_time: f32,
	duration: f32,
	adsr_arp_amp_stage: ADSR_Stage,
	adsr_arp_amp_release_level: f32,
	adsr_arp_amp_attack_start: f32,
	filter_arp_filter_low: f32,
	filter_arp_filter_band: f32,
	osc_arp_osc_phase: [1]f32,
	sh_arp_sh_counter: u64,
	sh_arp_sh_rng: PRNG_State,
	sh_arp_sh_current_value: f32,
}

SNES_Starfield_Arp_Processor :: struct {
	sample_rate: f32,
	bpm: f32,
	voices: [4]SNES_Starfield_Arp_Voice_State,
	prng: PRNG_State,
	total_samples: u64,
	playing: bool,
	loop: bool,
	current_step: u64,
	samples_until_next_step: u64,
	step_frac_acc: f32,
	ext_in_l: f32,
	ext_in_r: f32,
	volume: f32,
	bus_tail_remaining: u64,
	bus_tail_armed: bool,
	delay_arp_echo_buffer: [96000]f32,
	delay_arp_echo_write_index: int,
	Glass_amplitude: f32,
	Random_Steps_amplitude: f32,
	cutoff: f32,
	decay: f32,
	feedback: f32,
	mix: f32,
	release: f32,
	resonance: f32,
}

SNES_Starfield_Arp_BUS_TAIL_SECONDS :: f32(202.500000000)

// B7-2-followup / SKB-016: the LIVE counterpart to the worst-case constant
// above. Sums, over the same Delay/Reverb nodes compute_bus_tail_seconds
// analyzed, the same feedback_tail_seconds formula — but against each
// parameter's CURRENT value instead of its range maximum. Safe to call
// outside the audio path (once per note-off, not once per sample)
// because no Delay/Reverb parameter has a modulation port: get_f32_param
// resolves every one of them to either a plain field read or a literal,
// both valid wherever `p` is in scope.
SNES_Starfield_Arp_bus_tail_seconds :: proc(p: ^SNES_Starfield_Arp_Processor) -> f32 {
	total: f32 = 0.0
	mix_arp_echo: f32 = (p.mix);
	if mix_arp_echo > 0.0 {
		period_arp_echo: f32 = 0.0;
		if p.bpm > 0.0 {
			period_arp_echo = ((60.0 / p.bpm) * 0.500000000)
		}
		fdbk_arp_echo: f32 = (p.feedback);
		total += skald_feedback_tail_seconds(period_arp_echo, fdbk_arp_echo)
	}
	return total
}

SNES_Starfield_Arp_init :: proc(p: ^SNES_Starfield_Arp_Processor, sr: f32) {
	p.sample_rate = sr
	p.bpm = 104.000000000
	p.volume = 0.449999988
	p.prng.state = 12345
	p.loop = true
	p.voices = {}
	p.total_samples = 0
	p.playing = false
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
	p.ext_in_l = 0.0
	p.ext_in_r = 0.0
	p.bus_tail_remaining = 0
	p.bus_tail_armed = false
	for i in 0..<4 {
		v := &p.voices[i]
		v.sh_arp_sh_rng.state = u32(0xC0FFEE01) ~ u32(i + 1) * 2654435761
	}
	p.delay_arp_echo_buffer = {}
	p.delay_arp_echo_write_index = 0
	p.Glass_amplitude = 0.449999988
	p.Random_Steps_amplitude = 1.000000000
	p.cutoff = 1200.000000000
	p.decay = 0.140000001
	p.feedback = 0.500000000
	p.mix = 0.400000006
	p.release = 0.100000001
	p.resonance = 6.000000000
}

SNES_Starfield_Arp_note_on :: proc(p: ^SNES_Starfield_Arp_Processor, note: u8, velocity: f32, duration: f32) {
	// note and velocity are clamped silently to their MIDI/normalized domains.
	note := note
	if note > 127 do note = 127
	velocity := math.clamp(velocity, 0.0, 1.0)
	voice_idx := -1
	for i in 0..<4 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_releasing_age: f32 = -1.0
		for i in 0..<4 {
			releasing := true
			if p.voices[i].adsr_arp_amp_stage != .Release && p.voices[i].adsr_arp_amp_stage != .Idle do releasing = false
			if releasing && p.voices[i].age > oldest_releasing_age {
				oldest_releasing_age = p.voices[i].age
				voice_idx = i
			}
		}
		if voice_idx == -1 {
			oldest_age: f32 = -1.0
			for i in 0..<4 {
				if p.voices[i].age > oldest_age {
					oldest_age = p.voices[i].age
					voice_idx = i
				}
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	adsr_arp_amp_prev_level: f32 = 0.0
	if stolen && v.adsr_arp_amp_stage != .Idle {
		adsr_arp_amp_prev_level = v.adsr_arp_amp_release_level
		if v.adsr_arp_amp_stage == .Release {
			rel_t_arp_amp: f32 = (p.release);
			if rel_t_arp_amp > 0.0 {
				rf_arp_amp := 1.0 - (v.age - v.time_released) / math.max(rel_t_arp_amp, 0.000001)
				if rf_arp_amp < 0.0 do rf_arp_amp = 0.0
				adsr_arp_amp_prev_level *= rf_arp_amp
			} else {
				adsr_arp_amp_prev_level = 0.0
			}
		}
	}
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.000000000
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	v.adsr_arp_amp_stage = .Attack
	v.adsr_arp_amp_attack_start = adsr_arp_amp_prev_level
	v.adsr_arp_amp_release_level = adsr_arp_amp_prev_level
	if !stolen {
		v.filter_arp_filter_low = 0.0
		v.filter_arp_filter_band = 0.0
		v.osc_arp_osc_phase = {}
		v.sh_arp_sh_counter = 0
		v.sh_arp_sh_current_value = next_float32(&v.sh_arp_sh_rng) * 2.0 - 1.0
	}
}

SNES_Starfield_Arp_note_off :: proc(p: ^SNES_Starfield_Arp_Processor, note: u8) {
	// Clamped to match _note_on: `note` is the voice key, so both must map it.
	note := note
	if note > 127 do note = 127
	best := -1
	best_age: f32 = -1.0
	for i in 0..<4 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_arp_amp_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_arp_amp_stage = .Release
	}
}

SNES_Starfield_Arp_trigger :: proc(p: ^SNES_Starfield_Arp_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (f32(0.001000000)) + (p.decay) > d do d = (f32(0.001000000)) + (p.decay)
		if d <= 0.0 do d = 0.001
	}
	SNES_Starfield_Arp_note_on(p, note, velocity, d)
}

SNES_Starfield_Arp_feed_input :: proc(p: ^SNES_Starfield_Arp_Processor, in_left: f32, in_right: f32) {
	p.ext_in_l = in_left
	p.ext_in_r = in_right
}

SNES_Starfield_Arp_start :: proc(p: ^SNES_Starfield_Arp_Processor) {
	p.playing = true
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
}

SNES_Starfield_Arp_stop :: proc(p: ^SNES_Starfield_Arp_Processor) {
	p.playing = false
}

SNES_Starfield_Arp_set_loop :: proc(p: ^SNES_Starfield_Arp_Processor, loop: bool) {
	p.loop = loop
}

SNES_Starfield_Arp_set_volume :: proc(p: ^SNES_Starfield_Arp_Processor, value: f32) {
	p.volume = math.clamp(value, 0.0, 1.0)
}

SNES_Starfield_Arp_is_playing :: proc(p: ^SNES_Starfield_Arp_Processor) -> bool {
	if p.playing do return true
	for i in 0..<4 {
		if p.voices[i].active do return true
	}
	// The effect tail counts as playing: it is still audible after every
	// voice went inactive, and reporting false here is what let a game free
	// the asset mid-echo.
	if p.bus_tail_remaining > 0 do return true
	return false
}

SNES_Starfield_Arp_set_Glass_amplitude :: proc(p: ^SNES_Starfield_Arp_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 1.000000000 do v = 1.000000000
	p.Glass_amplitude = v
}

SNES_Starfield_Arp_set_Random_Steps_amplitude :: proc(p: ^SNES_Starfield_Arp_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 1.000000000 do v = 1.000000000
	p.Random_Steps_amplitude = v
}

SNES_Starfield_Arp_set_cutoff :: proc(p: ^SNES_Starfield_Arp_Processor, value: f32) {
	v := value
	if v < 20.000000000 do v = 20.000000000
	if v > 20000.000000000 do v = 20000.000000000
	p.cutoff = v
}

SNES_Starfield_Arp_set_decay :: proc(p: ^SNES_Starfield_Arp_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 10.000000000 do v = 10.000000000
	p.decay = v
}

SNES_Starfield_Arp_set_feedback :: proc(p: ^SNES_Starfield_Arp_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 0.949999988 do v = 0.949999988
	p.feedback = v
}

SNES_Starfield_Arp_set_mix :: proc(p: ^SNES_Starfield_Arp_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 1.000000000 do v = 1.000000000
	p.mix = v
}

SNES_Starfield_Arp_set_release :: proc(p: ^SNES_Starfield_Arp_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 10.000000000 do v = 10.000000000
	p.release = v
}

SNES_Starfield_Arp_set_resonance :: proc(p: ^SNES_Starfield_Arp_Processor, value: f32) {
	v := value
	if v < 0.100000001 do v = 0.100000001
	if v > 20.000000000 do v = 20.000000000
	p.resonance = v
}

SNES_Starfield_Arp_PARAMS := []Skald_Param_Info{
	{"Glass_amplitude", 0.000000000, 1.000000000, 0.449999988, ""},
	{"Random_Steps_amplitude", 0.000000000, 1.000000000, 1.000000000, ""},
	{"cutoff", 20.000000000, 20000.000000000, 1200.000000000, "Hz"},
	{"decay", 0.000000000, 10.000000000, 0.140000001, "s"},
	{"feedback", 0.000000000, 0.949999988, 0.500000000, ""},
	{"mix", 0.000000000, 1.000000000, 0.400000006, ""},
	{"release", 0.000000000, 10.000000000, 0.100000001, "s"},
	{"resonance", 0.100000001, 20.000000000, 6.000000000, "Q"},
}

SNES_Starfield_Arp_set_param :: proc(p: ^SNES_Starfield_Arp_Processor, name: string, value: f32) -> bool {
	switch name {
	case "Glass_amplitude", "arp-osc::amplitude":
		SNES_Starfield_Arp_set_Glass_amplitude(p, value)
		return true
	case "Random_Steps_amplitude", "arp-sh::amplitude":
		SNES_Starfield_Arp_set_Random_Steps_amplitude(p, value)
		return true
	case "cutoff", "arp-filter::cutoff":
		SNES_Starfield_Arp_set_cutoff(p, value)
		return true
	case "decay", "arp-amp::decay":
		SNES_Starfield_Arp_set_decay(p, value)
		return true
	case "feedback", "arp-echo::feedback":
		SNES_Starfield_Arp_set_feedback(p, value)
		return true
	case "mix", "arp-echo::mix":
		SNES_Starfield_Arp_set_mix(p, value)
		return true
	case "release", "arp-amp::release":
		SNES_Starfield_Arp_set_release(p, value)
		return true
	case "resonance", "arp-filter::resonance":
		SNES_Starfield_Arp_set_resonance(p, value)
		return true
	}
	return false
}

SNES_Starfield_Arp_get_param :: proc(p: ^SNES_Starfield_Arp_Processor, name: string) -> (f32, bool) {
	switch name {
	case "Glass_amplitude", "arp-osc::amplitude":
		return p.Glass_amplitude, true
	case "Random_Steps_amplitude", "arp-sh::amplitude":
		return p.Random_Steps_amplitude, true
	case "cutoff", "arp-filter::cutoff":
		return p.cutoff, true
	case "decay", "arp-amp::decay":
		return p.decay, true
	case "feedback", "arp-echo::feedback":
		return p.feedback, true
	case "mix", "arp-echo::mix":
		return p.mix, true
	case "release", "arp-amp::release":
		return p.release, true
	case "resonance", "arp-filter::resonance":
		return p.resonance, true
	}
	return 0.0, false
}

SNES_Starfield_Arp_process :: proc(p: ^SNES_Starfield_Arp_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	SNES_Starfield_Arp_process_sequence(p)
	p.total_samples += 1

	node_arp_filter_out_vsum: f32 = 0.0
	for v_idx in 0..<4 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_arp_amp_stage != .Release && voice.adsr_arp_amp_stage != .Idle {
				voice.adsr_arp_amp_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_arp_amp_out: f32 = 0.0
		node_arp_filter_out: f32 = 0.0
		node_arp_osc_out: f32 = 0.0
		node_arp_sh_out: f32 = 0.0
		node_arp_sh_map_out: f32 = 0.0

		// --- Oscillator Node arp_osc (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_arp_osc_phase[i] = math.mod(voice.osc_arp_osc_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_arp_osc_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += (2.0 / f32(math.PI)) * math.asin(math.sin(final_phase));
			}
			node_arp_osc_out = (unison_out / f32(unison_count)) * (p.Glass_amplitude);
		}

		// --- Sample & Hold Node arp_sh ---
		voice.sh_arp_sh_counter += 1;
		update_interval_arp_sh := u64(sample_rate / math.max(f32((1.0 / ((60.0 / p.bpm) * 0.250000000))), 0.1));
		if voice.sh_arp_sh_counter >= update_interval_arp_sh {
			voice.sh_arp_sh_current_value = next_float32(&voice.sh_arp_sh_rng) * 2.0 - 1.0;
			voice.sh_arp_sh_counter = 0;
		}
		node_arp_sh_out = voice.sh_arp_sh_current_value * (p.Random_Steps_amplitude);

		// --- ADSR Node arp_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_arp_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.001000000)) > 0 do envelope = voice.adsr_arp_amp_attack_start + (1.0 - voice.adsr_arp_amp_attack_start) * (voice.age / math.max(f32(f32(0.001000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_arp_amp_release_level = envelope;
				if voice.age >= (f32(0.001000000)) {
					voice.adsr_arp_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.001000000));
				if (p.decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.decay), 0.000001)) * (1.0 - (f32(0.000000000))); else do envelope = (f32(0.000000000));
				voice.adsr_arp_amp_release_level = envelope;
				if time_in_decay >= (p.decay) {
					voice.adsr_arp_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.000000000));
				voice.adsr_arp_amp_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.release) > 0 do envelope = voice.adsr_arp_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_arp_amp_stage = .Idle;
				}
			}
			vel_scale_arp_amp: f32 = (1.0 - (f32(0.700000000))) + (f32(0.700000000)) * voice.velocity;
			node_arp_amp_out = ((node_arp_osc_out)) * envelope * (f32(1.000000000)) * vel_scale_arp_amp;
		}

		// --- Mapper Node arp_sh_map ---
		{
			in_range_arp_sh_map: f32 = f32(f32(1.000000000)) - f32(f32(-1.000000000));
			if in_range_arp_sh_map == 0.0 do in_range_arp_sh_map = 1.0;
			node_arp_sh_map_out = math.lerp(f32(f32(-700.000000000)), f32(f32(1800.000000000)), math.clamp((f32((node_arp_sh_out)) - f32(f32(-1.000000000))) / in_range_arp_sh_map, 0.0, 1.0));
		}

		// --- Filter Node arp_filter (SVF) ---
		{
			cutoff_c_arp_filter: f32 = math.clamp(f32((p.cutoff) + (node_arp_sh_map_out)), 10.0, sample_rate * 0.16);
			f_arp_filter := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_arp_filter / sample_rate));
			q_arp_filter: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_arp_filter);
			voice.filter_arp_filter_low += f_arp_filter * voice.filter_arp_filter_band;
			high_arp_filter := f32(((node_arp_amp_out)) - voice.filter_arp_filter_low - q_arp_filter * voice.filter_arp_filter_band);
			voice.filter_arp_filter_band += f_arp_filter * high_arp_filter;
			node_arp_filter_out = voice.filter_arp_filter_low;
		}

		node_arp_filter_out_vsum += node_arp_filter_out
		if voice.adsr_arp_amp_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}

	// --- Bus effects (once per sample, post voice sum) ---
	{
		node_arp_filter_out := node_arp_filter_out_vsum
		node_arp_echo_out: f32 = 0.0
		// --- Delay Node arp_echo ---
		{
			delay_samples_arp_echo := int(math.clamp((((60.0 / p.bpm) * 0.500000000)) * sample_rate, 1, 96000-1));
			read_index_arp_echo := (p.delay_arp_echo_write_index - delay_samples_arp_echo + len(p.delay_arp_echo_buffer)) % len(p.delay_arp_echo_buffer);
			delayed_sample_arp_echo := p.delay_arp_echo_buffer[read_index_arp_echo];
			p.delay_arp_echo_buffer[p.delay_arp_echo_write_index] = ((node_arp_filter_out)) + delayed_sample_arp_echo * math.clamp(f32(p.feedback), 0.0, 0.95);
			p.delay_arp_echo_write_index = (p.delay_arp_echo_write_index + 1) % len(p.delay_arp_echo_buffer);
			node_arp_echo_out = ((node_arp_filter_out)) * (1.0 - (p.mix)) + delayed_sample_arp_echo * (p.mix);
		}

		output_left += node_arp_echo_out
		output_right += node_arp_echo_out
	}

	// B7-2-followup / SKB-016: a baked worst-case constant here held
	// is_playing true for minutes on real content (every exposed tail param
	// contributed its range maximum, so glassy-fm-pluck alone baked 202.5s
	// for a true tail under 2s). Arm on the FALLING EDGE instead, from the
	// live field values — that is one ln/pow per note-off rather than per
	// sample, which is what keeps this proc off the audio path.
	{
		voice_alive := false
		for i in 0..<4 {
			if p.voices[i].active {
				voice_alive = true
				break
			}
		}
		if voice_alive || p.playing {
			p.bus_tail_armed = false
			p.bus_tail_remaining = 0
		} else if !p.bus_tail_armed {
			p.bus_tail_armed = true
			p.bus_tail_remaining = u64(SNES_Starfield_Arp_bus_tail_seconds(p) * sample_rate)
		} else if p.bus_tail_remaining > 0 {
			p.bus_tail_remaining -= 1
		}
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
SNES_Starfield_Arp_process_sequence :: proc(p: ^SNES_Starfield_Arp_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "SNES Starfield Arp" (64 steps)
		switch p.current_step % 64 {
		case 0:
			SNES_Starfield_Arp_note_on(p, 74, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 1:
			SNES_Starfield_Arp_note_on(p, 77, 0.550000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
