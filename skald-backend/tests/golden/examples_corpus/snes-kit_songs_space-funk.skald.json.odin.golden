		case 49:
			SNES_Starfield_Arp_note_on(p, 73, 0.550000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 50:
			SNES_Starfield_Arp_note_on(p, 76, 0.550000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 51:
			SNES_Starfield_Arp_note_on(p, 79, 0.550000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 52:
			SNES_Starfield_Arp_note_on(p, 76, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 53:
			SNES_Starfield_Arp_note_on(p, 73, 0.550000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
