		case 63:
			SNES_Starfield_Arp_note_on(p, 79, 0.550000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 64 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	SNES_Hat: ^SNES_Hat_Processor,
	SNES_Kick: ^SNES_Kick_Processor,
	SNES_Slap_Bass: ^SNES_Slap_Bass_Processor,
	SNES_Snare: ^SNES_Snare_Processor,
	SNES_Space_Pad: ^SNES_Space_Pad_Processor,
	SNES_Starfield_Arp: ^SNES_Starfield_Arp_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.699999988
	p.SNES_Hat = new(SNES_Hat_Processor)
	SNES_Hat_init(p.SNES_Hat, sr)
	SNES_Hat_start(p.SNES_Hat)
	p.SNES_Kick = new(SNES_Kick_Processor)
	SNES_Kick_init(p.SNES_Kick, sr)
	SNES_Kick_start(p.SNES_Kick)
	p.SNES_Slap_Bass = new(SNES_Slap_Bass_Processor)
	SNES_Slap_Bass_init(p.SNES_Slap_Bass, sr)
	SNES_Slap_Bass_start(p.SNES_Slap_Bass)
	p.SNES_Snare = new(SNES_Snare_Processor)
	SNES_Snare_init(p.SNES_Snare, sr)
	SNES_Snare_start(p.SNES_Snare)
	p.SNES_Space_Pad = new(SNES_Space_Pad_Processor)
	SNES_Space_Pad_init(p.SNES_Space_Pad, sr)
	SNES_Space_Pad_start(p.SNES_Space_Pad)
	p.SNES_Starfield_Arp = new(SNES_Starfield_Arp_Processor)
	SNES_Starfield_Arp_init(p.SNES_Starfield_Arp, sr)
	SNES_Starfield_Arp_start(p.SNES_Starfield_Arp)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := SNES_Hat_process(p.SNES_Hat); mixed_left += l; mixed_right += r }
	{ l, r := SNES_Kick_process(p.SNES_Kick); mixed_left += l; mixed_right += r }
	{ l, r := SNES_Slap_Bass_process(p.SNES_Slap_Bass); mixed_left += l; mixed_right += r }
	{ l, r := SNES_Snare_process(p.SNES_Snare); mixed_left += l; mixed_right += r }
	{ l, r := SNES_Space_Pad_process(p.SNES_Space_Pad); mixed_left += l; mixed_right += r }
	{ l, r := SNES_Starfield_Arp_process(p.SNES_Starfield_Arp); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.SNES_Hat)
	free(p.SNES_Kick)
	free(p.SNES_Slap_Bass)
	free(p.SNES_Snare)
	free(p.SNES_Space_Pad)
	free(p.SNES_Starfield_Arp)
}

