			SNES_Starfield_Arp_note_on(p, 81, 0.550000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 11:
			SNES_Starfield_Arp_note_on(p, 77, 0.550000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			SNES_Starfield_Arp_note_on(p, 74, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 13:
			SNES_Starfield_Arp_note_on(p, 77, 0.550000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 14:
			SNES_Starfield_Arp_note_on(p, 81, 0.550000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 15:
			SNES_Starfield_Arp_note_on(p, 84, 0.550000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 16:
			SNES_Starfield_Arp_note_on(p, 70, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 17:
