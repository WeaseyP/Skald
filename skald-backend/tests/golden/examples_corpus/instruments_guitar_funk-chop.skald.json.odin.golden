	{"Snap_Env_attack", 0.000000000, 10.000000000, 0.001000000, "s"},
	{"Snap_Env_decay", 0.000000000, 10.000000000, 0.079999998, "s"},
	{"Snap_Env_depth", 0.000000000, 1.000000000, 1.000000000, ""},
	{"Snap_Env_release", 0.000000000, 10.000000000, 0.050000001, "s"},
	{"Snap_Env_sustain", 0.000000000, 1.000000000, 0.100000001, ""},
	{"outMax", -1000000.000000000, 1000000.000000000, 1800.000000000, ""},
	{"pulseWidth", 0.010000000, 0.990000010, 0.280000001, ""},
	{"velocitySensitivity", 0.000000000, 1.000000000, 0.899999976, ""},
}

Funk_Chop_set_param :: proc(p: ^Funk_Chop_Processor, name: string, value: f32) -> bool {
	switch name {
	case "Amp_attack", "fk-amp::attack":
		Funk_Chop_set_Amp_attack(p, value)
		return true
	case "Amp_decay", "fk-amp::decay":
		Funk_Chop_set_Amp_decay(p, value)
		return true
	case "Amp_depth", "fk-amp::depth":
		Funk_Chop_set_Amp_depth(p, value)
		return true
	case "Amp_release", "fk-amp::release":
		Funk_Chop_set_Amp_release(p, value)
		return true
	case "Amp_sustain", "fk-amp::sustain":
		Funk_Chop_set_Amp_sustain(p, value)
		return true
	case "Pick_Scratch_amplitude", "fk-pick-noise::amplitude":
		Funk_Chop_set_Pick_Scratch_amplitude(p, value)
		return true
	case "Quack_cutoff", "fk-quack::cutoff":
		Funk_Chop_set_Quack_cutoff(p, value)
		return true
	case "Quack_resonance", "fk-quack::resonance":
		Funk_Chop_set_Quack_resonance(p, value)
		return true
	case "Scratch_Band_cutoff", "fk-pick-bp::cutoff":
		Funk_Chop_set_Scratch_Band_cutoff(p, value)
		return true
	case "Scratch_Band_resonance", "fk-pick-bp::resonance":
		Funk_Chop_set_Scratch_Band_resonance(p, value)
		return true
	case "Scratch_Env_attack", "fk-pick-env::attack":
		Funk_Chop_set_Scratch_Env_attack(p, value)
		return true
	case "Scratch_Env_decay", "fk-pick-env::decay":
		Funk_Chop_set_Scratch_Env_decay(p, value)
		return true
	case "Scratch_Env_depth", "fk-pick-env::depth":
		Funk_Chop_set_Scratch_Env_depth(p, value)
		return true
	case "Scratch_Env_release", "fk-pick-env::release":
		Funk_Chop_set_Scratch_Env_release(p, value)
		return true
	case "Scratch_Env_sustain", "fk-pick-env::sustain":
		Funk_Chop_set_Scratch_Env_sustain(p, value)
		return true
	case "Single_Coil_amplitude", "fk-string::amplitude":
		Funk_Chop_set_Single_Coil_amplitude(p, value)
		return true
	case "Snap_Env_attack", "fk-snap-env::attack":
		Funk_Chop_set_Snap_Env_attack(p, value)
		return true
	case "Snap_Env_decay", "fk-snap-env::decay":
		Funk_Chop_set_Snap_Env_decay(p, value)
		return true
	case "Snap_Env_depth", "fk-snap-env::depth":
		Funk_Chop_set_Snap_Env_depth(p, value)
		return true
	case "Snap_Env_release", "fk-snap-env::release":
		Funk_Chop_set_Snap_Env_release(p, value)
		return true
	case "Snap_Env_sustain", "fk-snap-env::sustain":
		Funk_Chop_set_Snap_Env_sustain(p, value)
		return true
	case "outMax", "fk-snap-map::outMax":
		Funk_Chop_set_outMax(p, value)
		return true
	case "pulseWidth", "fk-string::pulseWidth":
		Funk_Chop_set_pulseWidth(p, value)
		return true
	case "velocitySensitivity", "fk-amp::velocitySensitivity":
		Funk_Chop_set_velocitySensitivity(p, value)
		return true
	}
	return false
}

Funk_Chop_get_param :: proc(p: ^Funk_Chop_Processor, name: string) -> (f32, bool) {
	switch name {
	case "Amp_attack", "fk-amp::attack":
		return p.Amp_attack, true
	case "Amp_decay", "fk-amp::decay":
		return p.Amp_decay, true
	case "Amp_depth", "fk-amp::depth":
		return p.Amp_depth, true
	case "Amp_release", "fk-amp::release":
		return p.Amp_release, true
	case "Amp_sustain", "fk-amp::sustain":
		return p.Amp_sustain, true
	case "Pick_Scratch_amplitude", "fk-pick-noise::amplitude":
		return p.Pick_Scratch_amplitude, true
	case "Quack_cutoff", "fk-quack::cutoff":
		return p.Quack_cutoff, true
	case "Quack_resonance", "fk-quack::resonance":
		return p.Quack_resonance, true
	case "Scratch_Band_cutoff", "fk-pick-bp::cutoff":
		return p.Scratch_Band_cutoff, true
	case "Scratch_Band_resonance", "fk-pick-bp::resonance":
		return p.Scratch_Band_resonance, true
	case "Scratch_Env_attack", "fk-pick-env::attack":
		return p.Scratch_Env_attack, true
	case "Scratch_Env_decay", "fk-pick-env::decay":
		return p.Scratch_Env_decay, true
	case "Scratch_Env_depth", "fk-pick-env::depth":
		return p.Scratch_Env_depth, true
	case "Scratch_Env_release", "fk-pick-env::release":
		return p.Scratch_Env_release, true
	case "Scratch_Env_sustain", "fk-pick-env::sustain":
		return p.Scratch_Env_sustain, true
	case "Single_Coil_amplitude", "fk-string::amplitude":
		return p.Single_Coil_amplitude, true
	case "Snap_Env_attack", "fk-snap-env::attack":
		return p.Snap_Env_attack, true
	case "Snap_Env_decay", "fk-snap-env::decay":
		return p.Snap_Env_decay, true
	case "Snap_Env_depth", "fk-snap-env::depth":
		return p.Snap_Env_depth, true
	case "Snap_Env_release", "fk-snap-env::release":
		return p.Snap_Env_release, true
	case "Snap_Env_sustain", "fk-snap-env::sustain":
		return p.Snap_Env_sustain, true
	case "outMax", "fk-snap-map::outMax":
		return p.outMax, true
	case "pulseWidth", "fk-string::pulseWidth":
		return p.pulseWidth, true
	case "velocitySensitivity", "fk-amp::velocitySensitivity":
		return p.velocitySensitivity, true
	}
	return 0.0, false
}

Funk_Chop_process :: proc(p: ^Funk_Chop_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	Funk_Chop_process_sequence(p)
	p.total_samples += 1

	for v_idx in 0..<6 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_fk_amp_stage != .Release && voice.adsr_fk_amp_stage != .Idle {
				voice.adsr_fk_amp_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_fk_pick_env_stage != .Release && voice.adsr_fk_pick_env_stage != .Idle {
				voice.adsr_fk_pick_env_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_fk_snap_env_stage != .Release && voice.adsr_fk_snap_env_stage != .Idle {
				voice.adsr_fk_snap_env_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_fk_amp_out: f32 = 0.0
		node_fk_mixer_out: f32 = 0.0
		node_fk_output_out: f32 = 0.0
		node_fk_pick_bp_out: f32 = 0.0
		node_fk_pick_env_out: f32 = 0.0
		node_fk_pick_noise_out: f32 = 0.0
		node_fk_quack_out: f32 = 0.0
		node_fk_snap_env_out: f32 = 0.0
		node_fk_snap_map_out: f32 = 0.0
		node_fk_string_out: f32 = 0.0

		// --- Noise Node fk_pick_noise ---
		node_fk_pick_noise_out = (next_float32(&voice.noise_fk_pick_noise_rng) * 2.0 - 1.0) * (p.Pick_Scratch_amplitude);

		// --- ADSR Node fk_snap_env ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_fk_snap_env_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Snap_Env_attack) > 0 do envelope = voice.adsr_fk_snap_env_attack_start + (1.0 - voice.adsr_fk_snap_env_attack_start) * (voice.age / math.max(f32(p.Snap_Env_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_fk_snap_env_release_level = envelope;
				if voice.age >= (p.Snap_Env_attack) {
					voice.adsr_fk_snap_env_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Snap_Env_attack);
				if (p.Snap_Env_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Snap_Env_decay), 0.000001)) * (1.0 - (p.Snap_Env_sustain)); else do envelope = (p.Snap_Env_sustain);
				voice.adsr_fk_snap_env_release_level = envelope;
				if time_in_decay >= (p.Snap_Env_decay) {
					voice.adsr_fk_snap_env_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Snap_Env_sustain);
				voice.adsr_fk_snap_env_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_fk_snap_env_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Snap_Env_release) > 0 do envelope = voice.adsr_fk_snap_env_release_level * (1.0 - (time_in_release / math.max(f32(p.Snap_Env_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_fk_snap_env_stage = .Idle;
				}
			}
			vel_scale_fk_snap_env: f32 = (1.0 - (f32(0.800000000))) + (f32(0.800000000)) * voice.velocity;
			node_fk_snap_env_out = (1.0) * envelope * (p.Snap_Env_depth) * vel_scale_fk_snap_env;
		}

		// --- Oscillator Node fk_string (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_fk_string_phase[i] = math.mod(voice.osc_fk_string_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_fk_string_phase[i] + phase_rads, 2 * f32(math.PI));
				if final_phase < 2 * f32(math.PI) * math.clamp(f32(p.pulseWidth), 0.01, 0.99) do unison_out += 1.0; else do unison_out -= 1.0;
			}
			node_fk_string_out = (unison_out / f32(unison_count)) * (p.Single_Coil_amplitude);
		}

		// --- Filter Node fk_pick_bp (SVF) ---
		{
			cutoff_c_fk_pick_bp: f32 = math.clamp(f32(p.Scratch_Band_cutoff), 10.0, sample_rate * 0.16);
			f_fk_pick_bp := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_fk_pick_bp / sample_rate));
			q_fk_pick_bp: f32 = math.clamp(1.0 / math.max(f32(p.Scratch_Band_resonance), 0.1), 0.05, 1.9 - f_fk_pick_bp);
			voice.filter_fk_pick_bp_low += f_fk_pick_bp * voice.filter_fk_pick_bp_band;
			high_fk_pick_bp := f32(((node_fk_pick_noise_out)) - voice.filter_fk_pick_bp_low - q_fk_pick_bp * voice.filter_fk_pick_bp_band);
			voice.filter_fk_pick_bp_band += f_fk_pick_bp * high_fk_pick_bp;
			node_fk_pick_bp_out = voice.filter_fk_pick_bp_band;
		}

		// --- Mapper Node fk_snap_map ---
		{
			in_range_fk_snap_map: f32 = f32(f32(1.000000000)) - f32(f32(0.000000000));
			if in_range_fk_snap_map == 0.0 do in_range_fk_snap_map = 1.0;
			node_fk_snap_map_out = math.lerp(f32(f32(0.000000000)), f32(p.outMax), math.clamp((f32((node_fk_snap_env_out)) - f32(f32(0.000000000))) / in_range_fk_snap_map, 0.0, 1.0));
		}

		// --- ADSR Node fk_pick_env ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_fk_pick_env_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Scratch_Env_attack) > 0 do envelope = voice.adsr_fk_pick_env_attack_start + (1.0 - voice.adsr_fk_pick_env_attack_start) * (voice.age / math.max(f32(p.Scratch_Env_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_fk_pick_env_release_level = envelope;
				if voice.age >= (p.Scratch_Env_attack) {
					voice.adsr_fk_pick_env_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Scratch_Env_attack);
				if (p.Scratch_Env_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Scratch_Env_decay), 0.000001)) * (1.0 - (p.Scratch_Env_sustain)); else do envelope = (p.Scratch_Env_sustain);
				voice.adsr_fk_pick_env_release_level = envelope;
				if time_in_decay >= (p.Scratch_Env_decay) {
					voice.adsr_fk_pick_env_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Scratch_Env_sustain);
				voice.adsr_fk_pick_env_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_fk_pick_env_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Scratch_Env_release) > 0 do envelope = voice.adsr_fk_pick_env_release_level * (1.0 - (time_in_release / math.max(f32(p.Scratch_Env_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_fk_pick_env_stage = .Idle;
				}
			}
			vel_scale_fk_pick_env: f32 = (1.0 - (f32(0.900000000))) + (f32(0.900000000)) * voice.velocity;
			node_fk_pick_env_out = ((node_fk_pick_bp_out)) * envelope * (p.Scratch_Env_depth) * vel_scale_fk_pick_env;
		}

		// --- Filter Node fk_quack (SVF) ---
		{
			cutoff_c_fk_quack: f32 = math.clamp(f32((p.Quack_cutoff) + (node_fk_snap_map_out)), 10.0, sample_rate * 0.16);
			f_fk_quack := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_fk_quack / sample_rate));
			q_fk_quack: f32 = math.clamp(1.0 / math.max(f32(p.Quack_resonance), 0.1), 0.05, 1.9 - f_fk_quack);
			voice.filter_fk_quack_low += f_fk_quack * voice.filter_fk_quack_band;
			high_fk_quack := f32(((node_fk_string_out)) - voice.filter_fk_quack_low - q_fk_quack * voice.filter_fk_quack_band);
			voice.filter_fk_quack_band += f_fk_quack * high_fk_quack;
			node_fk_quack_out = voice.filter_fk_quack_band;
		}

		// --- Mixer Node fk_mixer (2 inputs) ---
		{
			mix_sum_fk_mixer: f32 = 0.0;
			mix_sum_fk_mixer += node_fk_quack_out * (f32(0.850000024));
			mix_sum_fk_mixer += node_fk_pick_env_out * (f32(0.250000000));
		node_fk_mixer_out = mix_sum_fk_mixer;
		}

		// --- ADSR Node fk_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_fk_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Amp_attack) > 0 do envelope = voice.adsr_fk_amp_attack_start + (1.0 - voice.adsr_fk_amp_attack_start) * (voice.age / math.max(f32(p.Amp_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_fk_amp_release_level = envelope;
				if voice.age >= (p.Amp_attack) {
					voice.adsr_fk_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Amp_attack);
				if (p.Amp_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Amp_decay), 0.000001)) * (1.0 - (p.Amp_sustain)); else do envelope = (p.Amp_sustain);
				voice.adsr_fk_amp_release_level = envelope;
				if time_in_decay >= (p.Amp_decay) {
					voice.adsr_fk_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Amp_sustain);
				voice.adsr_fk_amp_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_fk_amp_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Amp_release) > 0 do envelope = voice.adsr_fk_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.Amp_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_fk_amp_stage = .Idle;
				}
			}
			vel_scale_fk_amp: f32 = (1.0 - (p.velocitySensitivity)) + (p.velocitySensitivity) * voice.velocity;
			node_fk_amp_out = ((node_fk_mixer_out)) * envelope * (p.Amp_depth) * vel_scale_fk_amp;
		}

		output_left += node_fk_amp_out
		output_right += node_fk_amp_out
		if voice.adsr_fk_amp_stage != .Idle do voice_busy = true
		if voice.adsr_fk_pick_env_stage != .Idle do voice_busy = true
		if voice.adsr_fk_snap_env_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
Funk_Chop_process_sequence :: proc(p: ^Funk_Chop_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "Funk Chop" (16 steps)
		switch p.current_step % 16 {
		case 0:
			Funk_Chop_note_on(p, 52, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 1:
			Funk_Chop_note_on(p, 52, 0.349999994, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 3:
			Funk_Chop_note_on(p, 56, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 4:
			Funk_Chop_note_on(p, 59, 0.850000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 6:
			Funk_Chop_note_on(p, 59, 0.400000006, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 7:
			Funk_Chop_note_on(p, 62, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			Funk_Chop_note_on(p, 52, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 10:
			Funk_Chop_note_on(p, 52, 0.400000006, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 11:
			Funk_Chop_note_on(p, 56, 0.750000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			Funk_Chop_note_on(p, 64, 0.850000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 14:
			Funk_Chop_note_on(p, 62, 0.600000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 15:
			Funk_Chop_note_on(p, 59, 0.500000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	Funk_Chop: ^Funk_Chop_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.779999971
	p.Funk_Chop = new(Funk_Chop_Processor)
	Funk_Chop_init(p.Funk_Chop, sr)
	Funk_Chop_start(p.Funk_Chop)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := Funk_Chop_process(p.Funk_Chop); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.Funk_Chop)
}

