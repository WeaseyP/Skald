Funk_Chop_init :: proc(p: ^Funk_Chop_Processor, sr: f32) {
	p.sample_rate = sr
	p.bpm = 104.000000000
	p.volume = 0.800000012
	p.prng.state = 12345
	p.loop = true
	p.voices = {}
	p.total_samples = 0
	p.playing = false
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
	p.ext_in_l = 0.0
	p.ext_in_r = 0.0
	for i in 0..<6 {
		v := &p.voices[i]
		v.noise_fk_pick_noise_rng.state = u32(0xC0FFEE01) ~ u32(i + 1) * 2654435761
	}
	p.Amp_attack = 0.002000000
	p.Amp_decay = 0.109999999
	p.Amp_depth = 1.000000000
	p.Amp_release = 0.050000001
	p.Amp_sustain = 0.000000000
	p.Pick_Scratch_amplitude = 0.449999988
	p.Quack_cutoff = 1400.000000000
	p.Quack_resonance = 2.000000000
	p.Scratch_Band_cutoff = 4500.000000000
	p.Scratch_Band_resonance = 1.299999952
	p.Scratch_Env_attack = 0.001000000
	p.Scratch_Env_decay = 0.017999999
	p.Scratch_Env_depth = 1.000000000
	p.Scratch_Env_release = 0.015000000
	p.Scratch_Env_sustain = 0.000000000
	p.Single_Coil_amplitude = 0.419999987
	p.Snap_Env_attack = 0.001000000
	p.Snap_Env_decay = 0.079999998
	p.Snap_Env_depth = 1.000000000
	p.Snap_Env_release = 0.050000001
	p.Snap_Env_sustain = 0.100000001
	p.outMax = 1800.000000000
	p.pulseWidth = 0.280000001
	p.velocitySensitivity = 0.899999976
}

Funk_Chop_note_on :: proc(p: ^Funk_Chop_Processor, note: u8, velocity: f32, duration: f32) {
	// note and velocity are clamped silently to their MIDI/normalized domains.
	note := note
	if note > 127 do note = 127
	velocity := math.clamp(velocity, 0.0, 1.0)
	voice_idx := -1
	for i in 0..<6 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_age: f32 = -1.0
		for i in 0..<6 {
			if p.voices[i].age > oldest_age {
				oldest_age = p.voices[i].age
				voice_idx = i
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	adsr_fk_amp_prev_level: f32 = 0.0
	if stolen && v.adsr_fk_amp_stage != .Idle {
		adsr_fk_amp_prev_level = v.adsr_fk_amp_release_level
		if v.adsr_fk_amp_stage == .Release {
			rel_t_fk_amp: f32 = (p.Amp_release);
			if rel_t_fk_amp > 0.0 {
				rf_fk_amp := 1.0 - (v.age - v.time_released) / math.max(rel_t_fk_amp, 0.000001)
				if rf_fk_amp < 0.0 do rf_fk_amp = 0.0
				adsr_fk_amp_prev_level *= rf_fk_amp
			} else {
				adsr_fk_amp_prev_level = 0.0
			}
		}
	}
	adsr_fk_pick_env_prev_level: f32 = 0.0
	if stolen && v.adsr_fk_pick_env_stage != .Idle {
		adsr_fk_pick_env_prev_level = v.adsr_fk_pick_env_release_level
		if v.adsr_fk_pick_env_stage == .Release {
			rel_t_fk_pick_env: f32 = (p.Scratch_Env_release);
			if rel_t_fk_pick_env > 0.0 {
				rf_fk_pick_env := 1.0 - (v.age - v.time_released) / math.max(rel_t_fk_pick_env, 0.000001)
				if rf_fk_pick_env < 0.0 do rf_fk_pick_env = 0.0
				adsr_fk_pick_env_prev_level *= rf_fk_pick_env
			} else {
				adsr_fk_pick_env_prev_level = 0.0
			}
		}
	}
	adsr_fk_snap_env_prev_level: f32 = 0.0
	if stolen && v.adsr_fk_snap_env_stage != .Idle {
		adsr_fk_snap_env_prev_level = v.adsr_fk_snap_env_release_level
		if v.adsr_fk_snap_env_stage == .Release {
			rel_t_fk_snap_env: f32 = (p.Snap_Env_release);
			if rel_t_fk_snap_env > 0.0 {
				rf_fk_snap_env := 1.0 - (v.age - v.time_released) / math.max(rel_t_fk_snap_env, 0.000001)
				if rf_fk_snap_env < 0.0 do rf_fk_snap_env = 0.0
				adsr_fk_snap_env_prev_level *= rf_fk_snap_env
			} else {
				adsr_fk_snap_env_prev_level = 0.0
			}
		}
	}
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.000000000
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	v.adsr_fk_amp_stage = .Attack
	v.adsr_fk_amp_attack_start = adsr_fk_amp_prev_level
	v.adsr_fk_amp_release_level = adsr_fk_amp_prev_level
	v.adsr_fk_pick_env_stage = .Attack
	v.adsr_fk_pick_env_attack_start = adsr_fk_pick_env_prev_level
	v.adsr_fk_pick_env_release_level = adsr_fk_pick_env_prev_level
	v.adsr_fk_snap_env_stage = .Attack
	v.adsr_fk_snap_env_attack_start = adsr_fk_snap_env_prev_level
	v.adsr_fk_snap_env_release_level = adsr_fk_snap_env_prev_level
	if !stolen {
		v.filter_fk_pick_bp_low = 0.0
		v.filter_fk_pick_bp_band = 0.0
		v.filter_fk_quack_low = 0.0
		v.filter_fk_quack_band = 0.0
		v.osc_fk_string_phase = {}
	}
}

Funk_Chop_note_off :: proc(p: ^Funk_Chop_Processor, note: u8) {
	// Clamped to match _note_on: `note` is the voice key, so both must map it.
	note := note
	if note > 127 do note = 127
	best := -1
	best_age: f32 = -1.0
	for i in 0..<6 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_fk_amp_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_fk_amp_stage = .Release
		p.voices[best].adsr_fk_pick_env_stage = .Release
		p.voices[best].adsr_fk_snap_env_stage = .Release
	}
}

Funk_Chop_trigger :: proc(p: ^Funk_Chop_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (p.Amp_attack) + (p.Amp_decay) > d do d = (p.Amp_attack) + (p.Amp_decay)
		if (p.Scratch_Env_attack) + (p.Scratch_Env_decay) > d do d = (p.Scratch_Env_attack) + (p.Scratch_Env_decay)
		if (p.Snap_Env_attack) + (p.Snap_Env_decay) > d do d = (p.Snap_Env_attack) + (p.Snap_Env_decay)
		if d <= 0.0 do d = 0.001
	}
	Funk_Chop_note_on(p, note, velocity, d)
}

Funk_Chop_feed_input :: proc(p: ^Funk_Chop_Processor, in_left: f32, in_right: f32) {
	p.ext_in_l = in_left
	p.ext_in_r = in_right
}

Funk_Chop_start :: proc(p: ^Funk_Chop_Processor) {
	p.playing = true
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
}

Funk_Chop_stop :: proc(p: ^Funk_Chop_Processor) {
	p.playing = false
}

Funk_Chop_set_loop :: proc(p: ^Funk_Chop_Processor, loop: bool) {
	p.loop = loop
}

Funk_Chop_set_volume :: proc(p: ^Funk_Chop_Processor, value: f32) {
	p.volume = math.clamp(value, 0.0, 1.0)
}

Funk_Chop_is_playing :: proc(p: ^Funk_Chop_Processor) -> bool {
	if p.playing do return true
	for i in 0..<6 {
		if p.voices[i].active do return true
	}
	return false
}

