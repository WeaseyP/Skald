GW_Gold_Midas_Bells_process :: proc(p: ^GW_Gold_Midas_Bells_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	GW_Gold_Midas_Bells_process_sequence(p)
	p.total_samples += 1

	node_midas_strike_out_vsum: f32 = 0.0
	for v_idx in 0..<8 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_midas_strike_stage != .Release && voice.adsr_midas_strike_stage != .Idle {
				voice.adsr_midas_strike_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_midas_carrier_out: f32 = 0.0
		node_midas_mod_out: f32 = 0.0
		node_midas_strike_out: f32 = 0.0

		// --- FM Operator Node midas_mod (Unison/Detune) ---
		{
			carrier_freq_midas_mod: f32 = voice.current_freq * math.clamp(f32(p.Mod_frequency), 0.01, 32.0);
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_carrier_freq_midas_mod: f32 = carrier_freq_midas_mod * math.pow(2.0, detune_amount / 1200.0);
				voice.fm_midas_mod_phase[i] = math.mod(voice.fm_midas_mod_phase[i] + (2 * f32(math.PI) * detuned_carrier_freq_midas_mod / sample_rate), 2 * f32(math.PI));
				unison_out += math.sin(voice.fm_midas_mod_phase[i] + (0.0) * (f32(0.000000000)));
			}
			node_midas_mod_out = unison_out / f32(unison_count);
		}

		// --- FM Operator Node midas_carrier (Unison/Detune) ---
		{
			carrier_freq_midas_carrier: f32 = voice.current_freq * math.clamp(f32(p.Carrier_frequency), 0.01, 32.0);
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_carrier_freq_midas_carrier: f32 = carrier_freq_midas_carrier * math.pow(2.0, detune_amount / 1200.0);
				voice.fm_midas_carrier_phase[i] = math.mod(voice.fm_midas_carrier_phase[i] + (2 * f32(math.PI) * detuned_carrier_freq_midas_carrier / sample_rate), 2 * f32(math.PI));
				unison_out += math.sin(voice.fm_midas_carrier_phase[i] + ((node_midas_mod_out)) * (p.modIndex));
			}
			node_midas_carrier_out = unison_out / f32(unison_count);
		}

		// --- ADSR Node midas_strike ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_midas_strike_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.002000000)) > 0 do envelope = voice.adsr_midas_strike_attack_start + (1.0 - voice.adsr_midas_strike_attack_start) * (voice.age / math.max(f32(f32(0.002000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_midas_strike_release_level = envelope;
				if voice.age >= (f32(0.002000000)) {
					voice.adsr_midas_strike_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.002000000));
				if (p.Strike_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Strike_decay), 0.000001)) * (1.0 - (f32(0.000000000))); else do envelope = (f32(0.000000000));
				voice.adsr_midas_strike_release_level = envelope;
				if time_in_decay >= (p.Strike_decay) {
					voice.adsr_midas_strike_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.000000000));
				voice.adsr_midas_strike_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_midas_strike_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.release) > 0 do envelope = voice.adsr_midas_strike_release_level * (1.0 - (time_in_release / math.max(f32(p.release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_midas_strike_stage = .Idle;
				}
			}
			vel_scale_midas_strike: f32 = (1.0 - (f32(0.900000000))) + (f32(0.900000000)) * voice.velocity;
			node_midas_strike_out = ((node_midas_carrier_out)) * envelope * (f32(1.000000000)) * vel_scale_midas_strike;
		}

		node_midas_strike_out_vsum += node_midas_strike_out
		if voice.adsr_midas_strike_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}

	// --- Bus effects (once per sample, post voice sum) ---
	{
		node_midas_strike_out := node_midas_strike_out_vsum
		node_midas_sparkle_out: f32 = 0.0
		node_midas_reverb_out: f32 = 0.0
		// --- Delay Node midas_sparkle ---
		{
			delay_samples_midas_sparkle := int(math.clamp((((60.0 / p.bpm) * 0.500000000)) * sample_rate, 1, 96000-1));
			read_index_midas_sparkle := (p.delay_midas_sparkle_write_index - delay_samples_midas_sparkle + len(p.delay_midas_sparkle_buffer)) % len(p.delay_midas_sparkle_buffer);
			delayed_sample_midas_sparkle := p.delay_midas_sparkle_buffer[read_index_midas_sparkle];
			p.delay_midas_sparkle_buffer[p.delay_midas_sparkle_write_index] = ((node_midas_strike_out)) + delayed_sample_midas_sparkle * math.clamp(f32(p.feedback), 0.0, 0.95);
			p.delay_midas_sparkle_write_index = (p.delay_midas_sparkle_write_index + 1) % len(p.delay_midas_sparkle_buffer);
			node_midas_sparkle_out = ((node_midas_strike_out)) * (1.0 - (p.Sparkle_mix)) + delayed_sample_midas_sparkle * (p.Sparkle_mix);
		}

		// --- Reverb Node midas_reverb (pre-delay + feedback comb) ---
		{
			pre_delay_seconds_midas_reverb: f32 = math.clamp(f32(f32(0.010000000)), 0.0, 0.25);
			pre_delay_samples_midas_reverb := int(math.clamp(pre_delay_seconds_midas_reverb * sample_rate, 0.0, f32(48000)));
			pre_write_index_midas_reverb := p.delay_midas_reverb_write_index % len(p.reverb_midas_reverb_pre_buffer)
			pre_delayed_input_midas_reverb := f32((node_midas_sparkle_out))
			if pre_delay_samples_midas_reverb > 0 {
				pre_read_index_midas_reverb := (pre_write_index_midas_reverb - pre_delay_samples_midas_reverb + len(p.reverb_midas_reverb_pre_buffer)) % len(p.reverb_midas_reverb_pre_buffer)
				pre_delayed_input_midas_reverb = p.reverb_midas_reverb_pre_buffer[pre_read_index_midas_reverb]
			}
			p.reverb_midas_reverb_pre_buffer[pre_write_index_midas_reverb] = f32((node_midas_sparkle_out))
			delay_samples_midas_reverb := int(math.clamp((0.075000000) * sample_rate, 0, 96000-1));
			read_index_midas_reverb := (p.delay_midas_reverb_write_index - delay_samples_midas_reverb + len(p.delay_midas_reverb_buffer)) % len(p.delay_midas_reverb_buffer);
			delayed_sample_midas_reverb := p.delay_midas_reverb_buffer[read_index_midas_reverb];
			decay_gain_midas_reverb: f32 = math.clamp(math.pow(f32(0.001), f32(0.075000000) / math.max(f32(p.Gilded_Hall_decay), 0.01)), 0.0, 0.95);
			p.delay_midas_reverb_buffer[p.delay_midas_reverb_write_index] = pre_delayed_input_midas_reverb + delayed_sample_midas_reverb * decay_gain_midas_reverb;
			p.delay_midas_reverb_write_index = (p.delay_midas_reverb_write_index + 1) % len(p.delay_midas_reverb_buffer);
			node_midas_reverb_out = ((node_midas_sparkle_out)) * (1.0 - (p.Gilded_Hall_mix)) + delayed_sample_midas_reverb * (p.Gilded_Hall_mix);
		}

		output_left += node_midas_reverb_out
		output_right += node_midas_reverb_out
	}

	// B7-2-followup / SKB-016: a baked worst-case constant here held
	// is_playing true for minutes on real content (every exposed tail param
	// contributed its range maximum, so glassy-fm-pluck alone baked 202.5s
	// for a true tail under 2s). Arm on the FALLING EDGE instead, from the
	// live field values — that is one ln/pow per note-off rather than per
	// sample, which is what keeps this proc off the audio path.
	{
		voice_alive := false
		for i in 0..<8 {
			if p.voices[i].active {
				voice_alive = true
				break
			}
		}
		if voice_alive || p.playing {
			p.bus_tail_armed = false
			p.bus_tail_remaining = 0
		} else if !p.bus_tail_armed {
			p.bus_tail_armed = true
			p.bus_tail_remaining = u64(GW_Gold_Midas_Bells_bus_tail_seconds(p) * sample_rate)
		} else if p.bus_tail_remaining > 0 {
			p.bus_tail_remaining -= 1
		}
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
GW_Gold_Midas_Bells_process_sequence :: proc(p: ^GW_Gold_Midas_Bells_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "GW Gold Midas Bells" (16 steps)
		switch p.current_step % 16 {
		case 0:
			GW_Gold_Midas_Bells_note_on(p, 74, 0.899999976, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 3:
			GW_Gold_Midas_Bells_note_on(p, 69, 0.600000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 4:
			GW_Gold_Midas_Bells_note_on(p, 78, 0.800000012, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 7:
			if next_float32(&p.prng) <= 0.800000012 {
				GW_Gold_Midas_Bells_note_on(p, 76, 0.550000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
			}
		case 8:
			GW_Gold_Midas_Bells_note_on(p, 71, 0.750000000, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 11:
			GW_Gold_Midas_Bells_note_on(p, 74, 0.600000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			GW_Gold_Midas_Bells_note_on(p, 81, 0.850000024, f32(3.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	GW_Gold_Midas_Bells: ^GW_Gold_Midas_Bells_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.750000000
	p.GW_Gold_Midas_Bells = new(GW_Gold_Midas_Bells_Processor)
	GW_Gold_Midas_Bells_init(p.GW_Gold_Midas_Bells, sr)
	GW_Gold_Midas_Bells_start(p.GW_Gold_Midas_Bells)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := GW_Gold_Midas_Bells_process(p.GW_Gold_Midas_Bells); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.GW_Gold_Midas_Bells)
}

