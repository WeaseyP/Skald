	{"amplitude", 0.000000000, 1.000000000, 0.500000000, ""},
	{"attack", 0.000000000, 10.000000000, 0.005000000, "s"},
	{"cutoff", 20.000000000, 20000.000000000, 750.000000000, "Hz"},
	{"decay", 0.000000000, 10.000000000, 0.119999997, "s"},
