GW_Grunt_Swarm_Bass_set_param :: proc(p: ^GW_Grunt_Swarm_Bass_Processor, name: string, value: f32) -> bool {
	switch name {
	case "amplitude", "grunt-osc::amplitude":
		GW_Grunt_Swarm_Bass_set_amplitude(p, value)
		return true
	case "attack", "grunt-amp::attack":
		GW_Grunt_Swarm_Bass_set_attack(p, value)
		return true
	case "cutoff", "grunt-filter::cutoff":
		GW_Grunt_Swarm_Bass_set_cutoff(p, value)
		return true
	case "decay", "grunt-amp::decay":
		GW_Grunt_Swarm_Bass_set_decay(p, value)
		return true
	case "drive", "grunt-dirt::drive":
		GW_Grunt_Swarm_Bass_set_drive(p, value)
		return true
	case "mix", "grunt-dirt::mix":
		GW_Grunt_Swarm_Bass_set_mix(p, value)
		return true
	case "release", "grunt-amp::release":
		GW_Grunt_Swarm_Bass_set_release(p, value)
		return true
	case "resonance", "grunt-filter::resonance":
		GW_Grunt_Swarm_Bass_set_resonance(p, value)
		return true
	case "sustain", "grunt-amp::sustain":
		GW_Grunt_Swarm_Bass_set_sustain(p, value)
		return true
	}
	return false
}

GW_Grunt_Swarm_Bass_get_param :: proc(p: ^GW_Grunt_Swarm_Bass_Processor, name: string) -> (f32, bool) {
	switch name {
	case "amplitude", "grunt-osc::amplitude":
		return p.amplitude, true
	case "attack", "grunt-amp::attack":
		return p.attack, true
	case "cutoff", "grunt-filter::cutoff":
		return p.cutoff, true
	case "decay", "grunt-amp::decay":
		return p.decay, true
	case "drive", "grunt-dirt::drive":
		return p.drive, true
	case "mix", "grunt-dirt::mix":
		return p.mix, true
	case "release", "grunt-amp::release":
		return p.release, true
	case "resonance", "grunt-filter::resonance":
		return p.resonance, true
	case "sustain", "grunt-amp::sustain":
		return p.sustain, true
	}
	return 0.0, false
}

GW_Grunt_Swarm_Bass_process :: proc(p: ^GW_Grunt_Swarm_Bass_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	GW_Grunt_Swarm_Bass_process_sequence(p)
	p.total_samples += 1

	for v_idx in 0..<4 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_grunt_amp_stage != .Release && voice.adsr_grunt_amp_stage != .Idle {
				voice.adsr_grunt_amp_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_grunt_amp_out: f32 = 0.0
		node_grunt_dirt_out: f32 = 0.0
		node_grunt_filter_out: f32 = 0.0
		node_grunt_osc_out: f32 = 0.0
		node_grunt_output_out: f32 = 0.0

		// --- Oscillator Node grunt_osc (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_grunt_osc_phase[i] = math.mod(voice.osc_grunt_osc_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_grunt_osc_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += ((final_phase / f32(math.PI)) - 1.0);
			}
			node_grunt_osc_out = (unison_out / f32(unison_count)) * (p.amplitude);
		}

		// --- Filter Node grunt_filter (SVF) ---
		{
			cutoff_c_grunt_filter: f32 = math.clamp(f32(p.cutoff), 10.0, sample_rate * 0.16);
			f_grunt_filter := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_grunt_filter / sample_rate));
			q_grunt_filter: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_grunt_filter);
			voice.filter_grunt_filter_low += f_grunt_filter * voice.filter_grunt_filter_band;
			high_grunt_filter := f32(((node_grunt_osc_out)) - voice.filter_grunt_filter_low - q_grunt_filter * voice.filter_grunt_filter_band);
			voice.filter_grunt_filter_band += f_grunt_filter * high_grunt_filter;
			node_grunt_filter_out = voice.filter_grunt_filter_low;
		}

		// --- ADSR Node grunt_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_grunt_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.attack) > 0 do envelope = voice.adsr_grunt_amp_attack_start + (1.0 - voice.adsr_grunt_amp_attack_start) * (voice.age / math.max(f32(p.attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_grunt_amp_release_level = envelope;
				if voice.age >= (p.attack) {
					voice.adsr_grunt_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.attack);
				if (p.decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.decay), 0.000001)) * (1.0 - (p.sustain)); else do envelope = (p.sustain);
				voice.adsr_grunt_amp_release_level = envelope;
				if time_in_decay >= (p.decay) {
					voice.adsr_grunt_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.sustain);
				voice.adsr_grunt_amp_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_grunt_amp_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.release) > 0 do envelope = voice.adsr_grunt_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_grunt_amp_stage = .Idle;
				}
			}
			vel_scale_grunt_amp: f32 = (1.0 - (f32(0.600000000))) + (f32(0.600000000)) * voice.velocity;
			node_grunt_amp_out = ((node_grunt_filter_out)) * envelope * (f32(1.000000000)) * vel_scale_grunt_amp;
		}

		// --- Distortion Node grunt_dirt (classic) ---
		{
			dist_in_grunt_dirt: f32 = ((node_grunt_amp_out));
			dist_k_grunt_dirt: f32 = math.max(f32(p.drive), 1.0);
			dist_wet_grunt_dirt: f32 = (f32(math.PI) + dist_k_grunt_dirt) * dist_in_grunt_dirt / (f32(math.PI) + dist_k_grunt_dirt * abs(dist_in_grunt_dirt));
			tone_k_grunt_dirt: f32 = math.clamp(2.0 * f32(math.PI) * math.clamp(f32(f32(4500.000000000)), 100.0, 20000.0) / sample_rate, 0.001, 1.0);
			voice.dist_grunt_dirt_tone += tone_k_grunt_dirt * (dist_wet_grunt_dirt - voice.dist_grunt_dirt_tone);
			mix_grunt_dirt: f32 = math.clamp(f32(p.mix), 0.0, 1.0);
			node_grunt_dirt_out = dist_in_grunt_dirt * (1.0 - mix_grunt_dirt) + voice.dist_grunt_dirt_tone * mix_grunt_dirt;
		}

		output_left += node_grunt_dirt_out
		output_right += node_grunt_dirt_out
		if voice.adsr_grunt_amp_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
GW_Grunt_Swarm_Bass_process_sequence :: proc(p: ^GW_Grunt_Swarm_Bass_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "GW Grunt Swarm Bass" (16 steps)
		switch p.current_step % 16 {
		case 0:
			GW_Grunt_Swarm_Bass_note_on(p, 38, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 2:
			GW_Grunt_Swarm_Bass_note_on(p, 38, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 4:
			GW_Grunt_Swarm_Bass_note_on(p, 41, 0.850000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 6:
			GW_Grunt_Swarm_Bass_note_on(p, 38, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 7:
			if next_float32(&p.prng) <= 0.500000000 {
				GW_Grunt_Swarm_Bass_note_on(p, 38, 0.500000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
			}
		case 8:
			GW_Grunt_Swarm_Bass_note_on(p, 43, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 10:
			GW_Grunt_Swarm_Bass_note_on(p, 41, 0.750000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			GW_Grunt_Swarm_Bass_note_on(p, 40, 0.850000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 14:
			GW_Grunt_Swarm_Bass_note_on(p, 38, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 15:
			if next_float32(&p.prng) <= 0.500000000 {
				GW_Grunt_Swarm_Bass_note_on(p, 40, 0.500000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
			}
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

GW_Splitter_Echo_Stab_Voice_State :: struct {
	active: bool,
	note: u8,
	velocity: f32,
	age: f32,
	time_released: f32,
	current_freq: f32,
	target_freq: f32,
	glide_time: f32,
	duration: f32,
	adsr_split_amp_stage: ADSR_Stage,
	adsr_split_amp_release_level: f32,
	adsr_split_amp_attack_start: f32,
	filter_split_filter_low: f32,
	filter_split_filter_band: f32,
	osc_split_osc_phase: [1]f32,
}

GW_Splitter_Echo_Stab_Processor :: struct {
	sample_rate: f32,
	bpm: f32,
	voices: [5]GW_Splitter_Echo_Stab_Voice_State,
	prng: PRNG_State,
	total_samples: u64,
	playing: bool,
	loop: bool,
	current_step: u64,
	samples_until_next_step: u64,
	step_frac_acc: f32,
	ext_in_l: f32,
	ext_in_r: f32,
	volume: f32,
	bus_tail_remaining: u64,
	bus_tail_armed: bool,
	delay_split_echo_buffer: [96000]f32,
	delay_split_echo_write_index: int,
	amplitude: f32,
	cutoff: f32,
	decay: f32,
	feedback: f32,
	mix: f32,
	pulseWidth: f32,
	release: f32,
	resonance: f32,
}

GW_Splitter_Echo_Stab_BUS_TAIL_SECONDS :: f32(202.500000000)

// B7-2-followup / SKB-016: the LIVE counterpart to the worst-case constant
// above. Sums, over the same Delay/Reverb nodes compute_bus_tail_seconds
// analyzed, the same feedback_tail_seconds formula — but against each
// parameter's CURRENT value instead of its range maximum. Safe to call
// outside the audio path (once per note-off, not once per sample)
// because no Delay/Reverb parameter has a modulation port: get_f32_param
// resolves every one of them to either a plain field read or a literal,
// both valid wherever `p` is in scope.
GW_Splitter_Echo_Stab_bus_tail_seconds :: proc(p: ^GW_Splitter_Echo_Stab_Processor) -> f32 {
	total: f32 = 0.0
	mix_split_echo: f32 = (p.mix);
	if mix_split_echo > 0.0 {
		period_split_echo: f32 = 0.0;
		if p.bpm > 0.0 {
			period_split_echo = ((60.0 / p.bpm) * 0.500000000)
		}
		fdbk_split_echo: f32 = (p.feedback);
		total += skald_feedback_tail_seconds(period_split_echo, fdbk_split_echo)
	}
	return total
}

GW_Splitter_Echo_Stab_init :: proc(p: ^GW_Splitter_Echo_Stab_Processor, sr: f32) {
	p.sample_rate = sr
	p.bpm = 180.000000000
	p.volume = 0.579999983
	p.prng.state = 12345
	p.loop = true
	p.voices = {}
	p.total_samples = 0
	p.playing = false
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
	p.ext_in_l = 0.0
	p.ext_in_r = 0.0
	p.bus_tail_remaining = 0
	p.bus_tail_armed = false
	p.delay_split_echo_buffer = {}
	p.delay_split_echo_write_index = 0
	p.amplitude = 0.449999988
	p.cutoff = 1500.000000000
	p.decay = 0.159999996
	p.feedback = 0.349999994
	p.mix = 0.300000012
	p.pulseWidth = 0.500000000
	p.release = 0.100000001
	p.resonance = 1.799999952
}

GW_Splitter_Echo_Stab_note_on :: proc(p: ^GW_Splitter_Echo_Stab_Processor, note: u8, velocity: f32, duration: f32) {
	// note and velocity are clamped silently to their MIDI/normalized domains.
	note := note
	if note > 127 do note = 127
	velocity := math.clamp(velocity, 0.0, 1.0)
	voice_idx := -1
	for i in 0..<5 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_age: f32 = -1.0
		for i in 0..<5 {
			if p.voices[i].age > oldest_age {
				oldest_age = p.voices[i].age
				voice_idx = i
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	adsr_split_amp_prev_level: f32 = 0.0
	if stolen && v.adsr_split_amp_stage != .Idle {
		adsr_split_amp_prev_level = v.adsr_split_amp_release_level
		if v.adsr_split_amp_stage == .Release {
			rel_t_split_amp: f32 = (p.release);
			if rel_t_split_amp > 0.0 {
				rf_split_amp := 1.0 - (v.age - v.time_released) / math.max(rel_t_split_amp, 0.000001)
				if rf_split_amp < 0.0 do rf_split_amp = 0.0
				adsr_split_amp_prev_level *= rf_split_amp
			} else {
				adsr_split_amp_prev_level = 0.0
			}
		}
	}
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.000000000
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	v.adsr_split_amp_stage = .Attack
	v.adsr_split_amp_attack_start = adsr_split_amp_prev_level
	v.adsr_split_amp_release_level = adsr_split_amp_prev_level
	if !stolen {
		v.filter_split_filter_low = 0.0
		v.filter_split_filter_band = 0.0
		v.osc_split_osc_phase = {}
	}
}

GW_Splitter_Echo_Stab_note_off :: proc(p: ^GW_Splitter_Echo_Stab_Processor, note: u8) {
	// Clamped to match _note_on: `note` is the voice key, so both must map it.
	note := note
	if note > 127 do note = 127
	best := -1
	best_age: f32 = -1.0
	for i in 0..<5 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_split_amp_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_split_amp_stage = .Release
	}
}

GW_Splitter_Echo_Stab_trigger :: proc(p: ^GW_Splitter_Echo_Stab_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (f32(0.003000000)) + (p.decay) > d do d = (f32(0.003000000)) + (p.decay)
		if d <= 0.0 do d = 0.001
	}
	GW_Splitter_Echo_Stab_note_on(p, note, velocity, d)
}

GW_Splitter_Echo_Stab_feed_input :: proc(p: ^GW_Splitter_Echo_Stab_Processor, in_left: f32, in_right: f32) {
	p.ext_in_l = in_left
	p.ext_in_r = in_right
}

GW_Splitter_Echo_Stab_start :: proc(p: ^GW_Splitter_Echo_Stab_Processor) {
	p.playing = true
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
}

GW_Splitter_Echo_Stab_stop :: proc(p: ^GW_Splitter_Echo_Stab_Processor) {
	p.playing = false
}

GW_Splitter_Echo_Stab_set_loop :: proc(p: ^GW_Splitter_Echo_Stab_Processor, loop: bool) {
	p.loop = loop
}

GW_Splitter_Echo_Stab_set_volume :: proc(p: ^GW_Splitter_Echo_Stab_Processor, value: f32) {
	p.volume = math.clamp(value, 0.0, 1.0)
}

GW_Splitter_Echo_Stab_is_playing :: proc(p: ^GW_Splitter_Echo_Stab_Processor) -> bool {
	if p.playing do return true
	for i in 0..<5 {
		if p.voices[i].active do return true
	}
	// The effect tail counts as playing: it is still audible after every
	// voice went inactive, and reporting false here is what let a game free
	// the asset mid-echo.
	if p.bus_tail_remaining > 0 do return true
	return false
}

GW_Splitter_Echo_Stab_set_amplitude :: proc(p: ^GW_Splitter_Echo_Stab_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 1.000000000 do v = 1.000000000
	p.amplitude = v
}

GW_Splitter_Echo_Stab_set_cutoff :: proc(p: ^GW_Splitter_Echo_Stab_Processor, value: f32) {
	v := value
	if v < 20.000000000 do v = 20.000000000
	if v > 20000.000000000 do v = 20000.000000000
	p.cutoff = v
}

GW_Splitter_Echo_Stab_set_decay :: proc(p: ^GW_Splitter_Echo_Stab_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 10.000000000 do v = 10.000000000
	p.decay = v
}

GW_Splitter_Echo_Stab_set_feedback :: proc(p: ^GW_Splitter_Echo_Stab_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 0.949999988 do v = 0.949999988
	p.feedback = v
}

GW_Splitter_Echo_Stab_set_mix :: proc(p: ^GW_Splitter_Echo_Stab_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 1.000000000 do v = 1.000000000
	p.mix = v
}

GW_Splitter_Echo_Stab_set_pulseWidth :: proc(p: ^GW_Splitter_Echo_Stab_Processor, value: f32) {
	v := value
	if v < 0.010000000 do v = 0.010000000
	if v > 0.990000010 do v = 0.990000010
	p.pulseWidth = v
}

GW_Splitter_Echo_Stab_set_release :: proc(p: ^GW_Splitter_Echo_Stab_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 10.000000000 do v = 10.000000000
	p.release = v
}

GW_Splitter_Echo_Stab_set_resonance :: proc(p: ^GW_Splitter_Echo_Stab_Processor, value: f32) {
	v := value
	if v < 0.100000001 do v = 0.100000001
	if v > 20.000000000 do v = 20.000000000
	p.resonance = v
}

GW_Splitter_Echo_Stab_PARAMS := []Skald_Param_Info{
	{"amplitude", 0.000000000, 1.000000000, 0.449999988, ""},
	{"cutoff", 20.000000000, 20000.000000000, 1500.000000000, "Hz"},
	{"decay", 0.000000000, 10.000000000, 0.159999996, "s"},
	{"feedback", 0.000000000, 0.949999988, 0.349999994, ""},
	{"mix", 0.000000000, 1.000000000, 0.300000012, ""},
	{"pulseWidth", 0.010000000, 0.990000010, 0.500000000, ""},
	{"release", 0.000000000, 10.000000000, 0.100000001, "s"},
	{"resonance", 0.100000001, 20.000000000, 1.799999952, "Q"},
}

GW_Splitter_Echo_Stab_set_param :: proc(p: ^GW_Splitter_Echo_Stab_Processor, name: string, value: f32) -> bool {
	switch name {
	case "amplitude", "split-osc::amplitude":
		GW_Splitter_Echo_Stab_set_amplitude(p, value)
		return true
	case "cutoff", "split-filter::cutoff":
		GW_Splitter_Echo_Stab_set_cutoff(p, value)
		return true
	case "decay", "split-amp::decay":
		GW_Splitter_Echo_Stab_set_decay(p, value)
		return true
	case "feedback", "split-echo::feedback":
		GW_Splitter_Echo_Stab_set_feedback(p, value)
		return true
	case "mix", "split-echo::mix":
		GW_Splitter_Echo_Stab_set_mix(p, value)
		return true
	case "pulseWidth", "split-osc::pulseWidth":
		GW_Splitter_Echo_Stab_set_pulseWidth(p, value)
		return true
	case "release", "split-amp::release":
		GW_Splitter_Echo_Stab_set_release(p, value)
		return true
	case "resonance", "split-filter::resonance":
		GW_Splitter_Echo_Stab_set_resonance(p, value)
		return true
	}
	return false
}

GW_Splitter_Echo_Stab_get_param :: proc(p: ^GW_Splitter_Echo_Stab_Processor, name: string) -> (f32, bool) {
	switch name {
	case "amplitude", "split-osc::amplitude":
		return p.amplitude, true
	case "cutoff", "split-filter::cutoff":
		return p.cutoff, true
	case "decay", "split-amp::decay":
		return p.decay, true
	case "feedback", "split-echo::feedback":
		return p.feedback, true
	case "mix", "split-echo::mix":
		return p.mix, true
	case "pulseWidth", "split-osc::pulseWidth":
		return p.pulseWidth, true
	case "release", "split-amp::release":
		return p.release, true
	case "resonance", "split-filter::resonance":
		return p.resonance, true
	}
	return 0.0, false
}

GW_Splitter_Echo_Stab_process :: proc(p: ^GW_Splitter_Echo_Stab_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	GW_Splitter_Echo_Stab_process_sequence(p)
	p.total_samples += 1

	node_split_amp_out_vsum: f32 = 0.0
	for v_idx in 0..<5 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_split_amp_stage != .Release && voice.adsr_split_amp_stage != .Idle {
				voice.adsr_split_amp_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_split_amp_out: f32 = 0.0
		node_split_filter_out: f32 = 0.0
		node_split_osc_out: f32 = 0.0

		// --- Oscillator Node split_osc (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_split_osc_phase[i] = math.mod(voice.osc_split_osc_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_split_osc_phase[i] + phase_rads, 2 * f32(math.PI));
				if final_phase < 2 * f32(math.PI) * math.clamp(f32(p.pulseWidth), 0.01, 0.99) do unison_out += 1.0; else do unison_out -= 1.0;
			}
			node_split_osc_out = (unison_out / f32(unison_count)) * (p.amplitude);
		}

		// --- Filter Node split_filter (SVF) ---
		{
			cutoff_c_split_filter: f32 = math.clamp(f32(p.cutoff), 10.0, sample_rate * 0.16);
			f_split_filter := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_split_filter / sample_rate));
			q_split_filter: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_split_filter);
			voice.filter_split_filter_low += f_split_filter * voice.filter_split_filter_band;
			high_split_filter := f32(((node_split_osc_out)) - voice.filter_split_filter_low - q_split_filter * voice.filter_split_filter_band);
			voice.filter_split_filter_band += f_split_filter * high_split_filter;
			node_split_filter_out = voice.filter_split_filter_low;
		}

		// --- ADSR Node split_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_split_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.003000000)) > 0 do envelope = voice.adsr_split_amp_attack_start + (1.0 - voice.adsr_split_amp_attack_start) * (voice.age / math.max(f32(f32(0.003000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_split_amp_release_level = envelope;
				if voice.age >= (f32(0.003000000)) {
					voice.adsr_split_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.003000000));
				if (p.decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.decay), 0.000001)) * (1.0 - (f32(0.000000000))); else do envelope = (f32(0.000000000));
				voice.adsr_split_amp_release_level = envelope;
				if time_in_decay >= (p.decay) {
					voice.adsr_split_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.000000000));
				voice.adsr_split_amp_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_split_amp_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.release) > 0 do envelope = voice.adsr_split_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_split_amp_stage = .Idle;
				}
			}
			vel_scale_split_amp: f32 = (1.0 - (f32(0.700000000))) + (f32(0.700000000)) * voice.velocity;
			node_split_amp_out = ((node_split_filter_out)) * envelope * (f32(1.000000000)) * vel_scale_split_amp;
		}

		node_split_amp_out_vsum += node_split_amp_out
		if voice.adsr_split_amp_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}

	// --- Bus effects (once per sample, post voice sum) ---
	{
		node_split_amp_out := node_split_amp_out_vsum
		node_split_echo_out: f32 = 0.0
		// --- Delay Node split_echo ---
		{
			delay_samples_split_echo := int(math.clamp((((60.0 / p.bpm) * 0.500000000)) * sample_rate, 1, 96000-1));
			read_index_split_echo := (p.delay_split_echo_write_index - delay_samples_split_echo + len(p.delay_split_echo_buffer)) % len(p.delay_split_echo_buffer);
			delayed_sample_split_echo := p.delay_split_echo_buffer[read_index_split_echo];
			p.delay_split_echo_buffer[p.delay_split_echo_write_index] = ((node_split_amp_out)) + delayed_sample_split_echo * math.clamp(f32(p.feedback), 0.0, 0.95);
			p.delay_split_echo_write_index = (p.delay_split_echo_write_index + 1) % len(p.delay_split_echo_buffer);
			node_split_echo_out = ((node_split_amp_out)) * (1.0 - (p.mix)) + delayed_sample_split_echo * (p.mix);
		}

		output_left += node_split_echo_out
		output_right += node_split_echo_out
	}

	// B7-2-followup / SKB-016: a baked worst-case constant here held
	// is_playing true for minutes on real content (every exposed tail param
	// contributed its range maximum, so glassy-fm-pluck alone baked 202.5s
	// for a true tail under 2s). Arm on the FALLING EDGE instead, from the
	// live field values — that is one ln/pow per note-off rather than per
	// sample, which is what keeps this proc off the audio path.
	{
		voice_alive := false
		for i in 0..<5 {
			if p.voices[i].active {
				voice_alive = true
				break
			}
		}
		if voice_alive || p.playing {
			p.bus_tail_armed = false
			p.bus_tail_remaining = 0
		} else if !p.bus_tail_armed {
			p.bus_tail_armed = true
			p.bus_tail_remaining = u64(GW_Splitter_Echo_Stab_bus_tail_seconds(p) * sample_rate)
		} else if p.bus_tail_remaining > 0 {
			p.bus_tail_remaining -= 1
		}
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
GW_Splitter_Echo_Stab_process_sequence :: proc(p: ^GW_Splitter_Echo_Stab_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "GW Splitter Echo Stab" (16 steps)
		switch p.current_step % 16 {
		case 0:
			GW_Splitter_Echo_Stab_note_on(p, 50, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 3:
			GW_Splitter_Echo_Stab_note_on(p, 53, 0.750000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 6:
			GW_Splitter_Echo_Stab_note_on(p, 50, 0.850000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 10:
			GW_Splitter_Echo_Stab_note_on(p, 45, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			GW_Splitter_Echo_Stab_note_on(p, 48, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 15:
			if next_float32(&p.prng) <= 0.600000024 {
				GW_Splitter_Echo_Stab_note_on(p, 50, 0.600000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
			}
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	GW_Hat_Static: ^GW_Hat_Static_Processor,
	GW_Grunt_Swarm_Bass: ^GW_Grunt_Swarm_Bass_Processor,
	GW_Splitter_Echo_Stab: ^GW_Splitter_Echo_Stab_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.750000000
	p.GW_Hat_Static = new(GW_Hat_Static_Processor)
	GW_Hat_Static_init(p.GW_Hat_Static, sr)
	GW_Hat_Static_start(p.GW_Hat_Static)
	p.GW_Grunt_Swarm_Bass = new(GW_Grunt_Swarm_Bass_Processor)
	GW_Grunt_Swarm_Bass_init(p.GW_Grunt_Swarm_Bass, sr)
	GW_Grunt_Swarm_Bass_start(p.GW_Grunt_Swarm_Bass)
	p.GW_Splitter_Echo_Stab = new(GW_Splitter_Echo_Stab_Processor)
	GW_Splitter_Echo_Stab_init(p.GW_Splitter_Echo_Stab, sr)
	GW_Splitter_Echo_Stab_start(p.GW_Splitter_Echo_Stab)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := GW_Hat_Static_process(p.GW_Hat_Static); mixed_left += l; mixed_right += r }
	{ l, r := GW_Grunt_Swarm_Bass_process(p.GW_Grunt_Swarm_Bass); mixed_left += l; mixed_right += r }
	{ l, r := GW_Splitter_Echo_Stab_process(p.GW_Splitter_Echo_Stab); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.GW_Hat_Static)
	free(p.GW_Grunt_Swarm_Bass)
	free(p.GW_Splitter_Echo_Stab)
}

