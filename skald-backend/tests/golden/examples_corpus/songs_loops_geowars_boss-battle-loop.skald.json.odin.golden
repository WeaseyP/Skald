		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

GW_Grunt_Swarm_Bass_Voice_State :: struct {
	active: bool,
	note: u8,
	velocity: f32,
	age: f32,
	time_released: f32,
	current_freq: f32,
	target_freq: f32,
	glide_time: f32,
	duration: f32,
	adsr_grunt_amp_stage: ADSR_Stage,
	adsr_grunt_amp_release_level: f32,
	adsr_grunt_amp_attack_start: f32,
	dist_grunt_dirt_tone: f32,
	filter_grunt_filter_low: f32,
	filter_grunt_filter_band: f32,
	osc_grunt_osc_phase: [1]f32,
}

GW_Grunt_Swarm_Bass_Processor :: struct {
	sample_rate: f32,
	bpm: f32,
	voices: [4]GW_Grunt_Swarm_Bass_Voice_State,
	prng: PRNG_State,
	total_samples: u64,
	playing: bool,
	loop: bool,
	current_step: u64,
	samples_until_next_step: u64,
	step_frac_acc: f32,
	ext_in_l: f32,
	ext_in_r: f32,
	volume: f32,
	amplitude: f32,
	attack: f32,
	cutoff: f32,
	decay: f32,
	drive: f32,
	mix: f32,
	release: f32,
	resonance: f32,
	sustain: f32,
}

GW_Grunt_Swarm_Bass_init :: proc(p: ^GW_Grunt_Swarm_Bass_Processor, sr: f32) {
	p.sample_rate = sr
	p.bpm = 180.000000000
	p.volume = 0.620000005
	p.prng.state = 12345
	p.loop = true
	p.voices = {}
	p.total_samples = 0
	p.playing = false
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
	p.ext_in_l = 0.0
	p.ext_in_r = 0.0
	p.amplitude = 0.500000000
	p.attack = 0.005000000
	p.cutoff = 750.000000000
	p.decay = 0.119999997
	p.drive = 8.000000000
	p.mix = 0.180000007
	p.release = 0.079999998
	p.resonance = 1.399999976
	p.sustain = 0.550000012
}

GW_Grunt_Swarm_Bass_note_on :: proc(p: ^GW_Grunt_Swarm_Bass_Processor, note: u8, velocity: f32, duration: f32) {
	// note and velocity are clamped silently to their MIDI/normalized domains.
	note := note
	if note > 127 do note = 127
	velocity := math.clamp(velocity, 0.0, 1.0)
	voice_idx := -1
	for i in 0..<4 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_age: f32 = -1.0
		for i in 0..<4 {
			if p.voices[i].age > oldest_age {
				oldest_age = p.voices[i].age
				voice_idx = i
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	adsr_grunt_amp_prev_level: f32 = 0.0
	if stolen && v.adsr_grunt_amp_stage != .Idle {
		adsr_grunt_amp_prev_level = v.adsr_grunt_amp_release_level
		if v.adsr_grunt_amp_stage == .Release {
			rel_t_grunt_amp: f32 = (p.release);
			if rel_t_grunt_amp > 0.0 {
				rf_grunt_amp := 1.0 - (v.age - v.time_released) / math.max(rel_t_grunt_amp, 0.000001)
				if rf_grunt_amp < 0.0 do rf_grunt_amp = 0.0
				adsr_grunt_amp_prev_level *= rf_grunt_amp
			} else {
				adsr_grunt_amp_prev_level = 0.0
			}
		}
	}
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.000000000
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	v.adsr_grunt_amp_stage = .Attack
	v.adsr_grunt_amp_attack_start = adsr_grunt_amp_prev_level
	v.adsr_grunt_amp_release_level = adsr_grunt_amp_prev_level
	if !stolen {
		v.dist_grunt_dirt_tone = 0.0
		v.filter_grunt_filter_low = 0.0
		v.filter_grunt_filter_band = 0.0
		v.osc_grunt_osc_phase = {}
	}
}

GW_Grunt_Swarm_Bass_note_off :: proc(p: ^GW_Grunt_Swarm_Bass_Processor, note: u8) {
	// Clamped to match _note_on: `note` is the voice key, so both must map it.
	note := note
	if note > 127 do note = 127
	best := -1
	best_age: f32 = -1.0
	for i in 0..<4 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_grunt_amp_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_grunt_amp_stage = .Release
	}
}

GW_Grunt_Swarm_Bass_trigger :: proc(p: ^GW_Grunt_Swarm_Bass_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (p.attack) + (p.decay) > d do d = (p.attack) + (p.decay)
		if d <= 0.0 do d = 0.001
	}
	GW_Grunt_Swarm_Bass_note_on(p, note, velocity, d)
}

GW_Grunt_Swarm_Bass_feed_input :: proc(p: ^GW_Grunt_Swarm_Bass_Processor, in_left: f32, in_right: f32) {
	p.ext_in_l = in_left
	p.ext_in_r = in_right
}

GW_Grunt_Swarm_Bass_start :: proc(p: ^GW_Grunt_Swarm_Bass_Processor) {
	p.playing = true
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
}

GW_Grunt_Swarm_Bass_stop :: proc(p: ^GW_Grunt_Swarm_Bass_Processor) {
	p.playing = false
}

GW_Grunt_Swarm_Bass_set_loop :: proc(p: ^GW_Grunt_Swarm_Bass_Processor, loop: bool) {
	p.loop = loop
}

GW_Grunt_Swarm_Bass_set_volume :: proc(p: ^GW_Grunt_Swarm_Bass_Processor, value: f32) {
	p.volume = math.clamp(value, 0.0, 1.0)
}

GW_Grunt_Swarm_Bass_is_playing :: proc(p: ^GW_Grunt_Swarm_Bass_Processor) -> bool {
	if p.playing do return true
	for i in 0..<4 {
		if p.voices[i].active do return true
	}
	return false
}

