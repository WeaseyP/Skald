Ambient_Clean_set_feedback :: proc(p: ^Ambient_Clean_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 0.949999988 do v = 0.949999988
	p.feedback = v
}

Ambient_Clean_set_frequency :: proc(p: ^Ambient_Clean_Processor, value: f32) {
	v := value
	if v < 0.010000000 do v = 0.010000000
	if v > 100.000000000 do v = 100.000000000
	p.frequency = v
}

Ambient_Clean_set_outMax :: proc(p: ^Ambient_Clean_Processor, value: f32) {
	v := value
	if v < -1000000.000000000 do v = -1000000.000000000
	if v > 1000000.000000000 do v = 1000000.000000000
	p.outMax = v
}

Ambient_Clean_set_resonance :: proc(p: ^Ambient_Clean_Processor, value: f32) {
	v := value
	if v < 0.100000001 do v = 0.100000001
	if v > 20.000000000 do v = 20.000000000
	p.resonance = v
}

Ambient_Clean_set_velocitySensitivity :: proc(p: ^Ambient_Clean_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 1.000000000 do v = 1.000000000
	p.velocitySensitivity = v
}

Ambient_Clean_PARAMS := []Skald_Param_Info{
	{"Amp_attack", 0.000000000, 10.000000000, 0.020000000, "s"},
	{"Amp_decay", 0.000000000, 10.000000000, 0.800000012, "s"},
	{"Amp_depth", 0.000000000, 1.000000000, 1.000000000, ""},
	{"Amp_release", 0.000000000, 10.000000000, 1.399999976, "s"},
	{"Amp_sustain", 0.000000000, 1.000000000, 0.600000024, ""},
	{"Fundamental_amplitude", 0.000000000, 1.000000000, 0.319999993, ""},
	{"Quarter_Echo_mix", 0.000000000, 1.000000000, 0.280000001, ""},
	{"Shimmer_amplitude", 0.000000000, 1.000000000, 0.280000001, ""},
	{"Space_decay", 0.000000000, 10.000000000, 2.799999952, "s"},
	{"Space_mix", 0.000000000, 1.000000000, 0.300000012, ""},
	{"Swell_Env_attack", 0.000000000, 10.000000000, 0.300000012, "s"},
	{"Swell_Env_decay", 0.000000000, 10.000000000, 1.000000000, "s"},
	{"Swell_Env_depth", 0.000000000, 1.000000000, 1.000000000, ""},
	{"Swell_Env_release", 0.000000000, 10.000000000, 1.000000000, "s"},
	{"Swell_Env_sustain", 0.000000000, 1.000000000, 0.500000000, ""},
	{"Vibrato_amplitude", 0.000000000, 20000.000000000, 0.008000000, ""},
	{"cutoff", 20.000000000, 20000.000000000, 1500.000000000, "Hz"},
	{"feedback", 0.000000000, 0.949999988, 0.400000006, ""},
	{"frequency", 0.010000000, 100.000000000, 4.800000191, "Hz"},
	{"outMax", -1000000.000000000, 1000000.000000000, 1200.000000000, ""},
	{"resonance", 0.100000001, 20.000000000, 0.800000012, "Q"},
	{"velocitySensitivity", 0.000000000, 1.000000000, 0.400000006, ""},
}

Ambient_Clean_set_param :: proc(p: ^Ambient_Clean_Processor, name: string, value: f32) -> bool {
	switch name {
	case "Amp_attack", "am-amp::attack":
		Ambient_Clean_set_Amp_attack(p, value)
		return true
	case "Amp_decay", "am-amp::decay":
		Ambient_Clean_set_Amp_decay(p, value)
		return true
	case "Amp_depth", "am-amp::depth":
		Ambient_Clean_set_Amp_depth(p, value)
		return true
	case "Amp_release", "am-amp::release":
		Ambient_Clean_set_Amp_release(p, value)
		return true
	case "Amp_sustain", "am-amp::sustain":
		Ambient_Clean_set_Amp_sustain(p, value)
		return true
	case "Fundamental_amplitude", "am-fund::amplitude":
		Ambient_Clean_set_Fundamental_amplitude(p, value)
		return true
	case "Quarter_Echo_mix", "am-echo::mix":
		Ambient_Clean_set_Quarter_Echo_mix(p, value)
		return true
	case "Shimmer_amplitude", "am-shimmer::amplitude":
		Ambient_Clean_set_Shimmer_amplitude(p, value)
		return true
	case "Space_decay", "am-space::decay":
		Ambient_Clean_set_Space_decay(p, value)
		return true
	case "Space_mix", "am-space::mix":
		Ambient_Clean_set_Space_mix(p, value)
		return true
	case "Swell_Env_attack", "am-swell-env::attack":
		Ambient_Clean_set_Swell_Env_attack(p, value)
		return true
	case "Swell_Env_decay", "am-swell-env::decay":
		Ambient_Clean_set_Swell_Env_decay(p, value)
		return true
	case "Swell_Env_depth", "am-swell-env::depth":
		Ambient_Clean_set_Swell_Env_depth(p, value)
		return true
	case "Swell_Env_release", "am-swell-env::release":
		Ambient_Clean_set_Swell_Env_release(p, value)
		return true
	case "Swell_Env_sustain", "am-swell-env::sustain":
		Ambient_Clean_set_Swell_Env_sustain(p, value)
		return true
	case "Vibrato_amplitude", "am-vibrato::amplitude":
		Ambient_Clean_set_Vibrato_amplitude(p, value)
		return true
	case "cutoff", "am-tone::cutoff":
		Ambient_Clean_set_cutoff(p, value)
		return true
	case "feedback", "am-echo::feedback":
		Ambient_Clean_set_feedback(p, value)
		return true
	case "frequency", "am-vibrato::frequency":
		Ambient_Clean_set_frequency(p, value)
		return true
	case "outMax", "am-swell-map::outMax":
		Ambient_Clean_set_outMax(p, value)
		return true
	case "resonance", "am-tone::resonance":
		Ambient_Clean_set_resonance(p, value)
		return true
	case "velocitySensitivity", "am-amp::velocitySensitivity":
		Ambient_Clean_set_velocitySensitivity(p, value)
		return true
	}
	return false
}

Ambient_Clean_get_param :: proc(p: ^Ambient_Clean_Processor, name: string) -> (f32, bool) {
	switch name {
	case "Amp_attack", "am-amp::attack":
		return p.Amp_attack, true
	case "Amp_decay", "am-amp::decay":
		return p.Amp_decay, true
	case "Amp_depth", "am-amp::depth":
		return p.Amp_depth, true
	case "Amp_release", "am-amp::release":
		return p.Amp_release, true
	case "Amp_sustain", "am-amp::sustain":
		return p.Amp_sustain, true
	case "Fundamental_amplitude", "am-fund::amplitude":
		return p.Fundamental_amplitude, true
	case "Quarter_Echo_mix", "am-echo::mix":
		return p.Quarter_Echo_mix, true
	case "Shimmer_amplitude", "am-shimmer::amplitude":
		return p.Shimmer_amplitude, true
	case "Space_decay", "am-space::decay":
		return p.Space_decay, true
	case "Space_mix", "am-space::mix":
		return p.Space_mix, true
	case "Swell_Env_attack", "am-swell-env::attack":
		return p.Swell_Env_attack, true
	case "Swell_Env_decay", "am-swell-env::decay":
		return p.Swell_Env_decay, true
	case "Swell_Env_depth", "am-swell-env::depth":
		return p.Swell_Env_depth, true
	case "Swell_Env_release", "am-swell-env::release":
		return p.Swell_Env_release, true
	case "Swell_Env_sustain", "am-swell-env::sustain":
		return p.Swell_Env_sustain, true
	case "Vibrato_amplitude", "am-vibrato::amplitude":
		return p.Vibrato_amplitude, true
	case "cutoff", "am-tone::cutoff":
		return p.cutoff, true
	case "feedback", "am-echo::feedback":
		return p.feedback, true
	case "frequency", "am-vibrato::frequency":
		return p.frequency, true
	case "outMax", "am-swell-map::outMax":
		return p.outMax, true
	case "resonance", "am-tone::resonance":
		return p.resonance, true
	case "velocitySensitivity", "am-amp::velocitySensitivity":
		return p.velocitySensitivity, true
	}
	return 0.0, false
}

Ambient_Clean_process :: proc(p: ^Ambient_Clean_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	Ambient_Clean_process_sequence(p)
	p.total_samples += 1

	node_am_amp_out_vsum: f32 = 0.0
	for v_idx in 0..<8 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.current_freq != voice.target_freq {
			glide_k := 1.0 / math.max(voice.glide_time * sample_rate, 1.0)
			if glide_k > 1.0 do glide_k = 1.0
			voice.current_freq += (voice.target_freq - voice.current_freq) * glide_k
			if abs(voice.target_freq - voice.current_freq) < 0.1 do voice.current_freq = voice.target_freq
		}
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_am_amp_stage != .Release && voice.adsr_am_amp_stage != .Idle {
				voice.adsr_am_amp_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_am_swell_env_stage != .Release && voice.adsr_am_swell_env_stage != .Idle {
				voice.adsr_am_swell_env_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_am_amp_out: f32 = 0.0
		node_am_fund_out: f32 = 0.0
		node_am_shimmer_out: f32 = 0.0
		node_am_swell_env_out: f32 = 0.0
		node_am_swell_map_out: f32 = 0.0
		node_am_tone_out: f32 = 0.0
		node_am_vibrato_out: f32 = 0.0

		// --- ADSR Node am_swell_env ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_am_swell_env_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Swell_Env_attack) > 0 do envelope = voice.adsr_am_swell_env_attack_start + (1.0 - voice.adsr_am_swell_env_attack_start) * (voice.age / math.max(f32(p.Swell_Env_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_am_swell_env_release_level = envelope;
				if voice.age >= (p.Swell_Env_attack) {
					voice.adsr_am_swell_env_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Swell_Env_attack);
				if (p.Swell_Env_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Swell_Env_decay), 0.000001)) * (1.0 - (p.Swell_Env_sustain)); else do envelope = (p.Swell_Env_sustain);
				voice.adsr_am_swell_env_release_level = envelope;
				if time_in_decay >= (p.Swell_Env_decay) {
					voice.adsr_am_swell_env_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Swell_Env_sustain);
				voice.adsr_am_swell_env_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_am_swell_env_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Swell_Env_release) > 0 do envelope = voice.adsr_am_swell_env_release_level * (1.0 - (time_in_release / math.max(f32(p.Swell_Env_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_am_swell_env_stage = .Idle;
				}
			}
			vel_scale_am_swell_env: f32 = (1.0 - (f32(0.300000000))) + (f32(0.300000000)) * voice.velocity;
			node_am_swell_env_out = (1.0) * envelope * (p.Swell_Env_depth) * vel_scale_am_swell_env;
		}

		// --- LFO Node am_vibrato ---
		voice.lfo_am_vibrato_phase = math.mod(voice.lfo_am_vibrato_phase + (2 * f32(math.PI) * (p.frequency) / sample_rate), 2 * f32(math.PI));
		if voice.lfo_am_vibrato_phase < 0.0 do voice.lfo_am_vibrato_phase += 2 * f32(math.PI);
		node_am_vibrato_out = math.sin(voice.lfo_am_vibrato_phase) * (p.Vibrato_amplitude);

		// --- Mapper Node am_swell_map ---
		{
			in_range_am_swell_map: f32 = f32(f32(1.000000000)) - f32(f32(0.000000000));
			if in_range_am_swell_map == 0.0 do in_range_am_swell_map = 1.0;
			node_am_swell_map_out = math.lerp(f32(f32(0.000000000)), f32(p.outMax), math.clamp((f32((node_am_swell_env_out)) - f32(f32(0.000000000))) / in_range_am_swell_map, 0.0, 1.0));
		}

		// --- Oscillator Node am_fund (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 2;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (4.000000000);
				detuned_freq: f32 = ((voice.current_freq) * math.pow(2.0, math.clamp(f32(node_am_vibrato_out), -10.0, 10.0))) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_am_fund_phase[i] = math.mod(voice.osc_am_fund_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_am_fund_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += math.sin(final_phase);
			}
			node_am_fund_out = (unison_out / f32(unison_count)) * (p.Fundamental_amplitude);
		}

		// --- Oscillator Node am_shimmer (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 2;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (4.000000000);
				detuned_freq: f32 = ((voice.current_freq) * math.pow(2.0, math.clamp(f32(node_am_vibrato_out), -10.0, 10.0))) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_am_shimmer_phase[i] = math.mod(voice.osc_am_shimmer_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_am_shimmer_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += (2.0 / f32(math.PI)) * math.asin(math.sin(final_phase));
			}
			node_am_shimmer_out = (unison_out / f32(unison_count)) * (p.Shimmer_amplitude);
		}

		// --- Filter Node am_tone (SVF) ---
		{
			cutoff_c_am_tone: f32 = math.clamp(f32((p.cutoff) + (node_am_swell_map_out)), 10.0, sample_rate * 0.16);
			f_am_tone := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_am_tone / sample_rate));
			q_am_tone: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_am_tone);
			voice.filter_am_tone_low += f_am_tone * voice.filter_am_tone_band;
			high_am_tone := f32(((node_am_fund_out + node_am_shimmer_out)) - voice.filter_am_tone_low - q_am_tone * voice.filter_am_tone_band);
			voice.filter_am_tone_band += f_am_tone * high_am_tone;
			node_am_tone_out = voice.filter_am_tone_low;
		}

		// --- ADSR Node am_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_am_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Amp_attack) > 0 do envelope = voice.adsr_am_amp_attack_start + (1.0 - voice.adsr_am_amp_attack_start) * (voice.age / math.max(f32(p.Amp_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_am_amp_release_level = envelope;
				if voice.age >= (p.Amp_attack) {
					voice.adsr_am_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Amp_attack);
				if (p.Amp_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Amp_decay), 0.000001)) * (1.0 - (p.Amp_sustain)); else do envelope = (p.Amp_sustain);
				voice.adsr_am_amp_release_level = envelope;
				if time_in_decay >= (p.Amp_decay) {
					voice.adsr_am_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Amp_sustain);
				voice.adsr_am_amp_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_am_amp_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Amp_release) > 0 do envelope = voice.adsr_am_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.Amp_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_am_amp_stage = .Idle;
				}
			}
			vel_scale_am_amp: f32 = (1.0 - (p.velocitySensitivity)) + (p.velocitySensitivity) * voice.velocity;
			node_am_amp_out = ((node_am_tone_out)) * envelope * (p.Amp_depth) * vel_scale_am_amp;
		}

		node_am_amp_out_vsum += node_am_amp_out
		if voice.adsr_am_amp_stage != .Idle do voice_busy = true
		if voice.adsr_am_swell_env_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}

	// --- Bus effects (once per sample, post voice sum) ---
	{
		node_am_amp_out := node_am_amp_out_vsum
		node_am_echo_out: f32 = 0.0
		node_am_space_out: f32 = 0.0
		// --- Delay Node am_echo ---
		{
			delay_samples_am_echo := int(math.clamp((((60.0 / p.bpm) * 1.000000000)) * sample_rate, 1, 96000-1));
			read_index_am_echo := (p.delay_am_echo_write_index - delay_samples_am_echo + len(p.delay_am_echo_buffer)) % len(p.delay_am_echo_buffer);
			delayed_sample_am_echo := p.delay_am_echo_buffer[read_index_am_echo];
			p.delay_am_echo_buffer[p.delay_am_echo_write_index] = ((node_am_amp_out)) + delayed_sample_am_echo * math.clamp(f32(p.feedback), 0.0, 0.95);
			p.delay_am_echo_write_index = (p.delay_am_echo_write_index + 1) % len(p.delay_am_echo_buffer);
			node_am_echo_out = ((node_am_amp_out)) * (1.0 - (p.Quarter_Echo_mix)) + delayed_sample_am_echo * (p.Quarter_Echo_mix);
		}

		// --- Reverb Node am_space (pre-delay + feedback comb) ---
		{
			pre_delay_seconds_am_space: f32 = math.clamp(f32(f32(0.010000000)), 0.0, 0.25);
			pre_delay_samples_am_space := int(math.clamp(pre_delay_seconds_am_space * sample_rate, 0.0, f32(48000)));
			pre_write_index_am_space := p.delay_am_space_write_index % len(p.reverb_am_space_pre_buffer)
			pre_delayed_input_am_space := f32((node_am_echo_out))
			if pre_delay_samples_am_space > 0 {
				pre_read_index_am_space := (pre_write_index_am_space - pre_delay_samples_am_space + len(p.reverb_am_space_pre_buffer)) % len(p.reverb_am_space_pre_buffer)
				pre_delayed_input_am_space = p.reverb_am_space_pre_buffer[pre_read_index_am_space]
			}
			p.reverb_am_space_pre_buffer[pre_write_index_am_space] = f32((node_am_echo_out))
			delay_samples_am_space := int(math.clamp((0.075000000) * sample_rate, 0, 96000-1));
			read_index_am_space := (p.delay_am_space_write_index - delay_samples_am_space + len(p.delay_am_space_buffer)) % len(p.delay_am_space_buffer);
			delayed_sample_am_space := p.delay_am_space_buffer[read_index_am_space];
			decay_gain_am_space: f32 = math.clamp(math.pow(f32(0.001), f32(0.075000000) / math.max(f32(p.Space_decay), 0.01)), 0.0, 0.95);
			p.delay_am_space_buffer[p.delay_am_space_write_index] = pre_delayed_input_am_space + delayed_sample_am_space * decay_gain_am_space;
			p.delay_am_space_write_index = (p.delay_am_space_write_index + 1) % len(p.delay_am_space_buffer);
			node_am_space_out = ((node_am_echo_out)) * (1.0 - (p.Space_mix)) + delayed_sample_am_space * (p.Space_mix);
		}

		output_left += node_am_space_out
		output_right += node_am_space_out
	}

	// B7-2-followup / SKB-016: a baked worst-case constant here held
	// is_playing true for minutes on real content (every exposed tail param
	// contributed its range maximum, so glassy-fm-pluck alone baked 202.5s
	// for a true tail under 2s). Arm on the FALLING EDGE instead, from the
	// live field values — that is one ln/pow per note-off rather than per
	// sample, which is what keeps this proc off the audio path.
	{
		voice_alive := false
		for i in 0..<8 {
			if p.voices[i].active {
				voice_alive = true
				break
			}
		}
		if voice_alive || p.playing {
			p.bus_tail_armed = false
			p.bus_tail_remaining = 0
		} else if !p.bus_tail_armed {
			p.bus_tail_armed = true
			p.bus_tail_remaining = u64(Ambient_Clean_bus_tail_seconds(p) * sample_rate)
		} else if p.bus_tail_remaining > 0 {
			p.bus_tail_remaining -= 1
		}
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
Ambient_Clean_process_sequence :: proc(p: ^Ambient_Clean_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "Ambient Clean" (16 steps)
		switch p.current_step % 16 {
		case 0:
			Ambient_Clean_note_on(p, 52, 0.720000029, f32(8.000000000) * (60.0 / p.bpm / 4.0))
		case 4:
			Ambient_Clean_note_on(p, 59, 0.620000005, f32(6.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			Ambient_Clean_note_on(p, 64, 0.680000007, f32(5.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			Ambient_Clean_note_on(p, 67, 0.600000024, f32(4.000000000) * (60.0 / p.bpm / 4.0))
		case 14:
			Ambient_Clean_note_on(p, 66, 0.550000012, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	Ambient_Clean: ^Ambient_Clean_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.750000000
	p.Ambient_Clean = new(Ambient_Clean_Processor)
	Ambient_Clean_init(p.Ambient_Clean, sr)
	Ambient_Clean_start(p.Ambient_Clean)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := Ambient_Clean_process(p.Ambient_Clean); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.Ambient_Clean)
}

