Ambient_Clean_BUS_TAIL_SECONDS :: f32(415.060000000)

// B7-2-followup / SKB-016: the LIVE counterpart to the worst-case constant
// above. Sums, over the same Delay/Reverb nodes compute_bus_tail_seconds
// analyzed, the same feedback_tail_seconds formula — but against each
// parameter's CURRENT value instead of its range maximum. Safe to call
// outside the audio path (once per note-off, not once per sample)
// because no Delay/Reverb parameter has a modulation port: get_f32_param
// resolves every one of them to either a plain field read or a literal,
// both valid wherever `p` is in scope.
Ambient_Clean_bus_tail_seconds :: proc(p: ^Ambient_Clean_Processor) -> f32 {
	total: f32 = 0.0
	mix_am_echo: f32 = (p.Quarter_Echo_mix);
	if mix_am_echo > 0.0 {
		period_am_echo: f32 = 0.0;
		if p.bpm > 0.0 {
			period_am_echo = ((60.0 / p.bpm) * 1.000000000)
		}
		fdbk_am_echo: f32 = (p.feedback);
		total += skald_feedback_tail_seconds(period_am_echo, fdbk_am_echo)
	}
	mix_am_space: f32 = (p.Space_mix);
	if mix_am_space > 0.0 {
		pre_am_space: f32 = math.clamp(f32(f32(0.010000000)), 0.0, 0.25);
		decay_gain_am_space: f32 = math.clamp(math.pow(f32(0.001), f32(0.075000000) / math.max(f32(p.Space_decay), 0.01)), 0.0, 0.95);
		total += pre_am_space + skald_feedback_tail_seconds(f32(0.075000000), decay_gain_am_space)
	}
	return total
}

