Reese_Bass_set_param :: proc(p: ^Reese_Bass_Processor, name: string, value: f32) -> bool {
	switch name {
	case "Amp_attack", "reese-amp::attack":
		Reese_Bass_set_Amp_attack(p, value)
		return true
	case "Amp_decay", "reese-amp::decay":
		Reese_Bass_set_Amp_decay(p, value)
		return true
	case "Amp_depth", "reese-amp::depth":
		Reese_Bass_set_Amp_depth(p, value)
		return true
	case "Amp_release", "reese-amp::release":
		Reese_Bass_set_Amp_release(p, value)
		return true
	case "Amp_sustain", "reese-amp::sustain":
		Reese_Bass_set_Amp_sustain(p, value)
		return true
	case "Detuned_Saws_amplitude", "reese-osc::amplitude":
		Reese_Bass_set_Detuned_Saws_amplitude(p, value)
		return true
	case "Env_0_1100_Hz_outMax", "reese-fenv-map::outMax":
		Reese_Bass_set_Env_0_1100_Hz_outMax(p, value)
		return true
	case "Filter_Env_attack", "reese-fenv::attack":
		Reese_Bass_set_Filter_Env_attack(p, value)
		return true
	case "Filter_Env_decay", "reese-fenv::decay":
		Reese_Bass_set_Filter_Env_decay(p, value)
		return true
	case "Filter_Env_depth", "reese-fenv::depth":
		Reese_Bass_set_Filter_Env_depth(p, value)
		return true
	case "Filter_Env_release", "reese-fenv::release":
		Reese_Bass_set_Filter_Env_release(p, value)
		return true
	case "Filter_Env_sustain", "reese-fenv::sustain":
		Reese_Bass_set_Filter_Env_sustain(p, value)
		return true
	case "Slow_Sweep_amplitude", "reese-sweep-lfo::amplitude":
		Reese_Bass_set_Slow_Sweep_amplitude(p, value)
		return true
	case "Sweep_0_500_Hz_outMax", "reese-sweep-map::outMax":
		Reese_Bass_set_Sweep_0_500_Hz_outMax(p, value)
		return true
	case "cutoff", "reese-filter::cutoff":
		Reese_Bass_set_cutoff(p, value)
		return true
	case "frequency", "reese-sweep-lfo::frequency":
		Reese_Bass_set_frequency(p, value)
		return true
	case "outMin", "reese-sweep-map::outMin":
		Reese_Bass_set_outMin(p, value)
		return true
	case "resonance", "reese-filter::resonance":
		Reese_Bass_set_resonance(p, value)
		return true
	case "velocitySensitivity", "reese-amp::velocitySensitivity":
		Reese_Bass_set_velocitySensitivity(p, value)
		return true
	}
	return false
}

Reese_Bass_get_param :: proc(p: ^Reese_Bass_Processor, name: string) -> (f32, bool) {
	switch name {
	case "Amp_attack", "reese-amp::attack":
		return p.Amp_attack, true
	case "Amp_decay", "reese-amp::decay":
		return p.Amp_decay, true
	case "Amp_depth", "reese-amp::depth":
		return p.Amp_depth, true
	case "Amp_release", "reese-amp::release":
		return p.Amp_release, true
	case "Amp_sustain", "reese-amp::sustain":
		return p.Amp_sustain, true
	case "Detuned_Saws_amplitude", "reese-osc::amplitude":
		return p.Detuned_Saws_amplitude, true
	case "Env_0_1100_Hz_outMax", "reese-fenv-map::outMax":
		return p.Env_0_1100_Hz_outMax, true
	case "Filter_Env_attack", "reese-fenv::attack":
		return p.Filter_Env_attack, true
	case "Filter_Env_decay", "reese-fenv::decay":
		return p.Filter_Env_decay, true
	case "Filter_Env_depth", "reese-fenv::depth":
		return p.Filter_Env_depth, true
	case "Filter_Env_release", "reese-fenv::release":
		return p.Filter_Env_release, true
	case "Filter_Env_sustain", "reese-fenv::sustain":
		return p.Filter_Env_sustain, true
	case "Slow_Sweep_amplitude", "reese-sweep-lfo::amplitude":
		return p.Slow_Sweep_amplitude, true
	case "Sweep_0_500_Hz_outMax", "reese-sweep-map::outMax":
		return p.Sweep_0_500_Hz_outMax, true
	case "cutoff", "reese-filter::cutoff":
		return p.cutoff, true
	case "frequency", "reese-sweep-lfo::frequency":
		return p.frequency, true
	case "outMin", "reese-sweep-map::outMin":
		return p.outMin, true
	case "resonance", "reese-filter::resonance":
		return p.resonance, true
	case "velocitySensitivity", "reese-amp::velocitySensitivity":
		return p.velocitySensitivity, true
	}
	return 0.0, false
}

Reese_Bass_process :: proc(p: ^Reese_Bass_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	Reese_Bass_process_sequence(p)
	p.total_samples += 1

	for v_idx in 0..<6 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.current_freq != voice.target_freq {
			glide_k := 1.0 / math.max(voice.glide_time * sample_rate, 1.0)
			if glide_k > 1.0 do glide_k = 1.0
			voice.current_freq += (voice.target_freq - voice.current_freq) * glide_k
			if abs(voice.target_freq - voice.current_freq) < 0.1 do voice.current_freq = voice.target_freq
		}
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_reese_amp_stage != .Release && voice.adsr_reese_amp_stage != .Idle {
				voice.adsr_reese_amp_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_reese_fenv_stage != .Release && voice.adsr_reese_fenv_stage != .Idle {
				voice.adsr_reese_fenv_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_reese_amp_out: f32 = 0.0
		node_reese_fenv_out: f32 = 0.0
		node_reese_fenv_map_out: f32 = 0.0
		node_reese_filter_out: f32 = 0.0
		node_reese_osc_out: f32 = 0.0
		node_reese_output_out: f32 = 0.0
		node_reese_sweep_lfo_out: f32 = 0.0
		node_reese_sweep_map_out: f32 = 0.0

		// --- ADSR Node reese_fenv ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_reese_fenv_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Filter_Env_attack) > 0 do envelope = voice.adsr_reese_fenv_attack_start + (1.0 - voice.adsr_reese_fenv_attack_start) * (voice.age / math.max(f32(p.Filter_Env_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_reese_fenv_release_level = envelope;
				if voice.age >= (p.Filter_Env_attack) {
					voice.adsr_reese_fenv_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Filter_Env_attack);
				if (p.Filter_Env_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Filter_Env_decay), 0.000001)) * (1.0 - (p.Filter_Env_sustain)); else do envelope = (p.Filter_Env_sustain);
				voice.adsr_reese_fenv_release_level = envelope;
				if time_in_decay >= (p.Filter_Env_decay) {
					voice.adsr_reese_fenv_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Filter_Env_sustain);
				voice.adsr_reese_fenv_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Filter_Env_release) > 0 do envelope = voice.adsr_reese_fenv_release_level * (1.0 - (time_in_release / math.max(f32(p.Filter_Env_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_reese_fenv_stage = .Idle;
				}
			}
			vel_scale_reese_fenv: f32 = (1.0 - (f32(0.400000000))) + (f32(0.400000000)) * voice.velocity;
			node_reese_fenv_out = (1.0) * envelope * (p.Filter_Env_depth) * vel_scale_reese_fenv;
		}

		// --- Oscillator Node reese_osc (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 7;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (28.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_reese_osc_phase[i] = math.mod(voice.osc_reese_osc_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_reese_osc_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += ((final_phase / f32(math.PI)) - 1.0);
			}
			node_reese_osc_out = (unison_out / f32(unison_count)) * (p.Detuned_Saws_amplitude);
		}

		// --- LFO Node reese_sweep_lfo ---
		voice.lfo_reese_sweep_lfo_phase = math.mod(voice.lfo_reese_sweep_lfo_phase + (2 * f32(math.PI) * (p.frequency) / sample_rate), 2 * f32(math.PI));
		if voice.lfo_reese_sweep_lfo_phase < 0.0 do voice.lfo_reese_sweep_lfo_phase += 2 * f32(math.PI);
		node_reese_sweep_lfo_out = math.sin(voice.lfo_reese_sweep_lfo_phase) * (p.Slow_Sweep_amplitude);

		// --- Mapper Node reese_fenv_map ---
		{
			in_range_reese_fenv_map: f32 = f32(f32(1.000000000)) - f32(f32(0.000000000));
			if in_range_reese_fenv_map == 0.0 do in_range_reese_fenv_map = 1.0;
			node_reese_fenv_map_out = math.lerp(f32(f32(0.000000000)), f32(p.Env_0_1100_Hz_outMax), math.clamp((f32((node_reese_fenv_out)) - f32(f32(0.000000000))) / in_range_reese_fenv_map, 0.0, 1.0));
		}

		// --- Mapper Node reese_sweep_map ---
		{
			in_range_reese_sweep_map: f32 = f32(f32(1.000000000)) - f32(f32(-1.000000000));
			if in_range_reese_sweep_map == 0.0 do in_range_reese_sweep_map = 1.0;
			node_reese_sweep_map_out = math.lerp(f32(p.outMin), f32(p.Sweep_0_500_Hz_outMax), math.clamp((f32((node_reese_sweep_lfo_out)) - f32(f32(-1.000000000))) / in_range_reese_sweep_map, 0.0, 1.0));
		}

		// --- Filter Node reese_filter (SVF) ---
		{
			cutoff_c_reese_filter: f32 = math.clamp(f32((p.cutoff) + (node_reese_fenv_map_out) + (node_reese_sweep_map_out)), 10.0, sample_rate * 0.16);
			f_reese_filter := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_reese_filter / sample_rate));
			q_reese_filter: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_reese_filter);
			voice.filter_reese_filter_low += f_reese_filter * voice.filter_reese_filter_band;
			high_reese_filter := f32(((node_reese_osc_out)) - voice.filter_reese_filter_low - q_reese_filter * voice.filter_reese_filter_band);
			voice.filter_reese_filter_band += f_reese_filter * high_reese_filter;
			node_reese_filter_out = voice.filter_reese_filter_low;
		}

		// --- ADSR Node reese_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_reese_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Amp_attack) > 0 do envelope = voice.adsr_reese_amp_attack_start + (1.0 - voice.adsr_reese_amp_attack_start) * (voice.age / math.max(f32(p.Amp_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_reese_amp_release_level = envelope;
				if voice.age >= (p.Amp_attack) {
					voice.adsr_reese_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Amp_attack);
				if (p.Amp_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Amp_decay), 0.000001)) * (1.0 - (p.Amp_sustain)); else do envelope = (p.Amp_sustain);
				voice.adsr_reese_amp_release_level = envelope;
				if time_in_decay >= (p.Amp_decay) {
					voice.adsr_reese_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Amp_sustain);
				voice.adsr_reese_amp_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Amp_release) > 0 do envelope = voice.adsr_reese_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.Amp_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_reese_amp_stage = .Idle;
				}
			}
			vel_scale_reese_amp: f32 = (1.0 - (p.velocitySensitivity)) + (p.velocitySensitivity) * voice.velocity;
			node_reese_amp_out = ((node_reese_filter_out)) * envelope * (p.Amp_depth) * vel_scale_reese_amp;
		}

		output_left += node_reese_amp_out
		output_right += node_reese_amp_out
		if voice.adsr_reese_amp_stage != .Idle do voice_busy = true
		if voice.adsr_reese_fenv_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
Reese_Bass_process_sequence :: proc(p: ^Reese_Bass_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "Reese Bass" (16 steps)
		switch p.current_step % 16 {
		case 0:
			Reese_Bass_note_on(p, 29, 0.899999976, f32(6.000000000) * (60.0 / p.bpm / 4.0))
		case 6:
			Reese_Bass_note_on(p, 29, 0.750000000, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			Reese_Bass_note_on(p, 36, 0.879999995, f32(4.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			Reese_Bass_note_on(p, 34, 0.819999993, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 14:
			Reese_Bass_note_on(p, 32, 0.800000012, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	Reese_Bass: ^Reese_Bass_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.720000029
	p.Reese_Bass = new(Reese_Bass_Processor)
	Reese_Bass_init(p.Reese_Bass, sr)
	Reese_Bass_start(p.Reese_Bass)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := Reese_Bass_process(p.Reese_Bass); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.Reese_Bass)
}

