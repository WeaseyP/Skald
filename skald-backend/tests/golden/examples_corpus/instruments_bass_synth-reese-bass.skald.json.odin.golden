Reese_Bass_note_on :: proc(p: ^Reese_Bass_Processor, note: u8, velocity: f32, duration: f32) {
	// note and velocity are clamped silently to their MIDI/normalized domains.
	note := note
	if note > 127 do note = 127
	velocity := math.clamp(velocity, 0.0, 1.0)
	voice_idx := -1
	for i in 0..<6 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_releasing_age: f32 = -1.0
		for i in 0..<6 {
			releasing := true
			if p.voices[i].adsr_reese_amp_stage != .Release && p.voices[i].adsr_reese_amp_stage != .Idle do releasing = false
			if p.voices[i].adsr_reese_fenv_stage != .Release && p.voices[i].adsr_reese_fenv_stage != .Idle do releasing = false
			if releasing && p.voices[i].age > oldest_releasing_age {
				oldest_releasing_age = p.voices[i].age
				voice_idx = i
			}
		}
		if voice_idx == -1 {
			oldest_age: f32 = -1.0
			for i in 0..<6 {
				if p.voices[i].age > oldest_age {
					oldest_age = p.voices[i].age
					voice_idx = i
				}
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	adsr_reese_amp_prev_level: f32 = 0.0
	if stolen && v.adsr_reese_amp_stage != .Idle {
		adsr_reese_amp_prev_level = v.adsr_reese_amp_release_level
		if v.adsr_reese_amp_stage == .Release {
			rel_t_reese_amp: f32 = (p.Amp_release);
			if rel_t_reese_amp > 0.0 {
				rf_reese_amp := 1.0 - (v.age - v.time_released) / math.max(rel_t_reese_amp, 0.000001)
				if rf_reese_amp < 0.0 do rf_reese_amp = 0.0
				adsr_reese_amp_prev_level *= rf_reese_amp
			} else {
				adsr_reese_amp_prev_level = 0.0
			}
		}
	}
	adsr_reese_fenv_prev_level: f32 = 0.0
	if stolen && v.adsr_reese_fenv_stage != .Idle {
		adsr_reese_fenv_prev_level = v.adsr_reese_fenv_release_level
		if v.adsr_reese_fenv_stage == .Release {
			rel_t_reese_fenv: f32 = (p.Filter_Env_release);
			if rel_t_reese_fenv > 0.0 {
				rf_reese_fenv := 1.0 - (v.age - v.time_released) / math.max(rel_t_reese_fenv, 0.000001)
				if rf_reese_fenv < 0.0 do rf_reese_fenv = 0.0
				adsr_reese_fenv_prev_level *= rf_reese_fenv
			} else {
				adsr_reese_fenv_prev_level = 0.0
			}
		}
	}
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.020000000
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	v.adsr_reese_amp_stage = .Attack
	v.adsr_reese_amp_attack_start = adsr_reese_amp_prev_level
	v.adsr_reese_amp_release_level = adsr_reese_amp_prev_level
	v.adsr_reese_fenv_stage = .Attack
	v.adsr_reese_fenv_attack_start = adsr_reese_fenv_prev_level
	v.adsr_reese_fenv_release_level = adsr_reese_fenv_prev_level
	if !stolen {
		v.filter_reese_filter_low = 0.0
		v.filter_reese_filter_band = 0.0
		v.osc_reese_osc_phase = {}
		v.lfo_reese_sweep_lfo_phase = 0.0
	}
}

Reese_Bass_note_off :: proc(p: ^Reese_Bass_Processor, note: u8) {
	// Clamped to match _note_on: `note` is the voice key, so both must map it.
	note := note
	if note > 127 do note = 127
	best := -1
	best_age: f32 = -1.0
	for i in 0..<6 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_reese_amp_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_reese_amp_stage = .Release
		p.voices[best].adsr_reese_fenv_stage = .Release
	}
}

Reese_Bass_trigger :: proc(p: ^Reese_Bass_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (p.Amp_attack) + (p.Amp_decay) > d do d = (p.Amp_attack) + (p.Amp_decay)
		if (p.Filter_Env_attack) + (p.Filter_Env_decay) > d do d = (p.Filter_Env_attack) + (p.Filter_Env_decay)
		if d <= 0.0 do d = 0.001
	}
	Reese_Bass_note_on(p, note, velocity, d)
}

