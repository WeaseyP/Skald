FM_Electric_Piano_PARAMS := []Skald_Param_Info{
	{"Amp_attack", 0.000000000, 10.000000000, 0.003000000, "s"},
	{"Amp_decay", 0.000000000, 10.000000000, 1.600000024, "s"},
	{"Amp_depth", 0.000000000, 1.000000000, 0.219999999, ""},
	{"Amp_release", 0.000000000, 10.000000000, 0.600000024, "s"},
	{"Amp_sustain", 0.000000000, 1.000000000, 0.219999999, ""},
	{"Body_Mod_frequency", 0.010000000, 32.000000000, 1.000000000, "ratio"},
	{"Carrier_frequency", 0.010000000, 32.000000000, 1.000000000, "ratio"},
	{"Room_decay", 0.000000000, 10.000000000, 1.600000024, "s"},
	{"Tine_Env_attack", 0.000000000, 10.000000000, 0.001000000, "s"},
	{"Tine_Env_decay", 0.000000000, 10.000000000, 0.119999997, "s"},
	{"Tine_Env_depth", 0.000000000, 1.000000000, 1.000000000, ""},
	{"Tine_Env_release", 0.000000000, 10.000000000, 0.100000001, "s"},
	{"Tine_Env_sustain", 0.000000000, 1.000000000, 0.000000000, ""},
	{"Tine_Mod_frequency", 0.010000000, 32.000000000, 14.000000000, "ratio"},
	{"gain", 0.000000000, 4.000000000, 0.000000000, "x"},
	{"mix", 0.000000000, 1.000000000, 0.159999996, ""},
	{"modIndex", 0.000000000, 1000.000000000, 1.500000000, ""},
	{"outMax", -1000000.000000000, 1000000.000000000, 1.000000000, ""},
}

FM_Electric_Piano_set_param :: proc(p: ^FM_Electric_Piano_Processor, name: string, value: f32) -> bool {
	switch name {
	case "Amp_attack", "ep-amp::attack":
		FM_Electric_Piano_set_Amp_attack(p, value)
		return true
	case "Amp_decay", "ep-amp::decay":
		FM_Electric_Piano_set_Amp_decay(p, value)
		return true
	case "Amp_depth", "ep-amp::depth":
		FM_Electric_Piano_set_Amp_depth(p, value)
		return true
	case "Amp_release", "ep-amp::release":
		FM_Electric_Piano_set_Amp_release(p, value)
		return true
	case "Amp_sustain", "ep-amp::sustain":
		FM_Electric_Piano_set_Amp_sustain(p, value)
		return true
	case "Body_Mod_frequency", "ep-body-mod::frequency":
		FM_Electric_Piano_set_Body_Mod_frequency(p, value)
		return true
	case "Carrier_frequency", "ep-carrier::frequency":
		FM_Electric_Piano_set_Carrier_frequency(p, value)
		return true
	case "Room_decay", "ep-reverb::decay":
		FM_Electric_Piano_set_Room_decay(p, value)
		return true
	case "Tine_Env_attack", "ep-tine-env::attack":
		FM_Electric_Piano_set_Tine_Env_attack(p, value)
		return true
	case "Tine_Env_decay", "ep-tine-env::decay":
		FM_Electric_Piano_set_Tine_Env_decay(p, value)
		return true
	case "Tine_Env_depth", "ep-tine-env::depth":
		FM_Electric_Piano_set_Tine_Env_depth(p, value)
		return true
	case "Tine_Env_release", "ep-tine-env::release":
		FM_Electric_Piano_set_Tine_Env_release(p, value)
		return true
	case "Tine_Env_sustain", "ep-tine-env::sustain":
		FM_Electric_Piano_set_Tine_Env_sustain(p, value)
		return true
	case "Tine_Mod_frequency", "ep-tine-mod::frequency":
		FM_Electric_Piano_set_Tine_Mod_frequency(p, value)
		return true
	case "gain", "ep-tine-gain::gain":
		FM_Electric_Piano_set_gain(p, value)
		return true
	case "mix", "ep-reverb::mix":
		FM_Electric_Piano_set_mix(p, value)
		return true
	case "modIndex", "ep-carrier::modIndex":
		FM_Electric_Piano_set_modIndex(p, value)
		return true
	case "outMax", "ep-tine-map::outMax":
		FM_Electric_Piano_set_outMax(p, value)
		return true
	}
	return false
}

FM_Electric_Piano_get_param :: proc(p: ^FM_Electric_Piano_Processor, name: string) -> (f32, bool) {
	switch name {
	case "Amp_attack", "ep-amp::attack":
		return p.Amp_attack, true
	case "Amp_decay", "ep-amp::decay":
		return p.Amp_decay, true
	case "Amp_depth", "ep-amp::depth":
		return p.Amp_depth, true
	case "Amp_release", "ep-amp::release":
		return p.Amp_release, true
	case "Amp_sustain", "ep-amp::sustain":
		return p.Amp_sustain, true
	case "Body_Mod_frequency", "ep-body-mod::frequency":
		return p.Body_Mod_frequency, true
	case "Carrier_frequency", "ep-carrier::frequency":
		return p.Carrier_frequency, true
	case "Room_decay", "ep-reverb::decay":
		return p.Room_decay, true
	case "Tine_Env_attack", "ep-tine-env::attack":
		return p.Tine_Env_attack, true
	case "Tine_Env_decay", "ep-tine-env::decay":
		return p.Tine_Env_decay, true
	case "Tine_Env_depth", "ep-tine-env::depth":
		return p.Tine_Env_depth, true
	case "Tine_Env_release", "ep-tine-env::release":
		return p.Tine_Env_release, true
	case "Tine_Env_sustain", "ep-tine-env::sustain":
		return p.Tine_Env_sustain, true
	case "Tine_Mod_frequency", "ep-tine-mod::frequency":
		return p.Tine_Mod_frequency, true
	case "gain", "ep-tine-gain::gain":
		return p.gain, true
	case "mix", "ep-reverb::mix":
		return p.mix, true
	case "modIndex", "ep-carrier::modIndex":
		return p.modIndex, true
	case "outMax", "ep-tine-map::outMax":
		return p.outMax, true
	}
	return 0.0, false
}

FM_Electric_Piano_process :: proc(p: ^FM_Electric_Piano_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	FM_Electric_Piano_process_sequence(p)
	p.total_samples += 1

	node_ep_amp_out_vsum: f32 = 0.0
	for v_idx in 0..<12 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_ep_amp_stage != .Release && voice.adsr_ep_amp_stage != .Idle {
				voice.adsr_ep_amp_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_ep_tine_env_stage != .Release && voice.adsr_ep_tine_env_stage != .Idle {
				voice.adsr_ep_tine_env_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_ep_amp_out: f32 = 0.0
		node_ep_body_mod_out: f32 = 0.0
		node_ep_carrier_out: f32 = 0.0
		node_ep_tine_env_out: f32 = 0.0
		node_ep_tine_gain_out: f32 = 0.0
		node_ep_tine_map_out: f32 = 0.0
		node_ep_tine_mod_out: f32 = 0.0

		// --- FM Operator Node ep_body_mod (Unison/Detune) ---
		{
			carrier_freq_ep_body_mod: f32 = voice.current_freq * math.clamp(f32(p.Body_Mod_frequency), 0.01, 32.0);
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_carrier_freq_ep_body_mod: f32 = carrier_freq_ep_body_mod * math.pow(2.0, detune_amount / 1200.0);
				voice.fm_ep_body_mod_phase[i] = math.mod(voice.fm_ep_body_mod_phase[i] + (2 * f32(math.PI) * detuned_carrier_freq_ep_body_mod / sample_rate), 2 * f32(math.PI));
				unison_out += math.sin(voice.fm_ep_body_mod_phase[i] + (0.0) * (f32(0.000000000)));
			}
			node_ep_body_mod_out = unison_out / f32(unison_count);
		}

		// --- ADSR Node ep_tine_env ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_ep_tine_env_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Tine_Env_attack) > 0 do envelope = voice.adsr_ep_tine_env_attack_start + (1.0 - voice.adsr_ep_tine_env_attack_start) * (voice.age / math.max(f32(p.Tine_Env_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_ep_tine_env_release_level = envelope;
				if voice.age >= (p.Tine_Env_attack) {
					voice.adsr_ep_tine_env_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Tine_Env_attack);
				if (p.Tine_Env_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Tine_Env_decay), 0.000001)) * (1.0 - (p.Tine_Env_sustain)); else do envelope = (p.Tine_Env_sustain);
				voice.adsr_ep_tine_env_release_level = envelope;
				if time_in_decay >= (p.Tine_Env_decay) {
					voice.adsr_ep_tine_env_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Tine_Env_sustain);
				voice.adsr_ep_tine_env_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Tine_Env_release) > 0 do envelope = voice.adsr_ep_tine_env_release_level * (1.0 - (time_in_release / math.max(f32(p.Tine_Env_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_ep_tine_env_stage = .Idle;
				}
			}
			vel_scale_ep_tine_env: f32 = (1.0 - (f32(0.850000000))) + (f32(0.850000000)) * voice.velocity;
			node_ep_tine_env_out = (1.0) * envelope * (p.Tine_Env_depth) * vel_scale_ep_tine_env;
		}

		// --- FM Operator Node ep_tine_mod (Unison/Detune) ---
		{
			carrier_freq_ep_tine_mod: f32 = voice.current_freq * math.clamp(f32(p.Tine_Mod_frequency), 0.01, 32.0);
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_carrier_freq_ep_tine_mod: f32 = carrier_freq_ep_tine_mod * math.pow(2.0, detune_amount / 1200.0);
				voice.fm_ep_tine_mod_phase[i] = math.mod(voice.fm_ep_tine_mod_phase[i] + (2 * f32(math.PI) * detuned_carrier_freq_ep_tine_mod / sample_rate), 2 * f32(math.PI));
				unison_out += math.sin(voice.fm_ep_tine_mod_phase[i] + (0.0) * (f32(0.000000000)));
			}
			node_ep_tine_mod_out = unison_out / f32(unison_count);
		}

		// --- Mapper Node ep_tine_map ---
		{
			in_range_ep_tine_map: f32 = f32(f32(1.000000000)) - f32(f32(0.000000000));
			if in_range_ep_tine_map == 0.0 do in_range_ep_tine_map = 1.0;
			node_ep_tine_map_out = math.lerp(f32(f32(0.000000000)), f32(p.outMax), math.clamp((f32((node_ep_tine_env_out)) - f32(f32(0.000000000))) / in_range_ep_tine_map, 0.0, 1.0));
		}

		// --- Gain Node ep_tine_gain ---
		node_ep_tine_gain_out = ((node_ep_tine_mod_out)) * ((p.gain) + (node_ep_tine_map_out));

		// --- FM Operator Node ep_carrier (Unison/Detune) ---
		{
			carrier_freq_ep_carrier: f32 = voice.current_freq * math.clamp(f32(p.Carrier_frequency), 0.01, 32.0);
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_carrier_freq_ep_carrier: f32 = carrier_freq_ep_carrier * math.pow(2.0, detune_amount / 1200.0);
				voice.fm_ep_carrier_phase[i] = math.mod(voice.fm_ep_carrier_phase[i] + (2 * f32(math.PI) * detuned_carrier_freq_ep_carrier / sample_rate), 2 * f32(math.PI));
				unison_out += math.sin(voice.fm_ep_carrier_phase[i] + ((node_ep_tine_gain_out + node_ep_body_mod_out)) * (p.modIndex));
			}
			node_ep_carrier_out = unison_out / f32(unison_count);
		}

		// --- ADSR Node ep_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_ep_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Amp_attack) > 0 do envelope = voice.adsr_ep_amp_attack_start + (1.0 - voice.adsr_ep_amp_attack_start) * (voice.age / math.max(f32(p.Amp_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_ep_amp_release_level = envelope;
				if voice.age >= (p.Amp_attack) {
					voice.adsr_ep_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Amp_attack);
				if (p.Amp_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Amp_decay), 0.000001)) * (1.0 - (p.Amp_sustain)); else do envelope = (p.Amp_sustain);
				voice.adsr_ep_amp_release_level = envelope;
				if time_in_decay >= (p.Amp_decay) {
					voice.adsr_ep_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Amp_sustain);
				voice.adsr_ep_amp_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Amp_release) > 0 do envelope = voice.adsr_ep_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.Amp_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_ep_amp_stage = .Idle;
				}
			}
			vel_scale_ep_amp: f32 = (1.0 - (f32(0.800000000))) + (f32(0.800000000)) * voice.velocity;
			node_ep_amp_out = ((node_ep_carrier_out)) * envelope * (p.Amp_depth) * vel_scale_ep_amp;
		}

		node_ep_amp_out_vsum += node_ep_amp_out
		if voice.adsr_ep_amp_stage != .Idle do voice_busy = true
		if voice.adsr_ep_tine_env_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}

	// --- Bus effects (once per sample, post voice sum) ---
	{
		node_ep_amp_out := node_ep_amp_out_vsum
		node_ep_reverb_out: f32 = 0.0
		// --- Reverb Node ep_reverb (pre-delay + feedback comb) ---
		{
			pre_delay_seconds_ep_reverb: f32 = math.clamp(f32(f32(0.010000000)), 0.0, 0.25);
			pre_delay_samples_ep_reverb := int(math.clamp(pre_delay_seconds_ep_reverb * sample_rate, 0.0, f32(48000)));
			pre_write_index_ep_reverb := p.delay_ep_reverb_write_index % len(p.reverb_ep_reverb_pre_buffer)
			pre_delayed_input_ep_reverb := f32((node_ep_amp_out))
			if pre_delay_samples_ep_reverb > 0 {
				pre_read_index_ep_reverb := (pre_write_index_ep_reverb - pre_delay_samples_ep_reverb + len(p.reverb_ep_reverb_pre_buffer)) % len(p.reverb_ep_reverb_pre_buffer)
				pre_delayed_input_ep_reverb = p.reverb_ep_reverb_pre_buffer[pre_read_index_ep_reverb]
			}
			p.reverb_ep_reverb_pre_buffer[pre_write_index_ep_reverb] = f32((node_ep_amp_out))
			delay_samples_ep_reverb := int(math.clamp((0.075000000) * sample_rate, 0, 96000-1));
			read_index_ep_reverb := (p.delay_ep_reverb_write_index - delay_samples_ep_reverb + len(p.delay_ep_reverb_buffer)) % len(p.delay_ep_reverb_buffer);
			delayed_sample_ep_reverb := p.delay_ep_reverb_buffer[read_index_ep_reverb];
			decay_gain_ep_reverb: f32 = math.clamp(math.pow(f32(0.001), f32(0.075000000) / math.max(f32(p.Room_decay), 0.01)), 0.0, 0.95);
			p.delay_ep_reverb_buffer[p.delay_ep_reverb_write_index] = pre_delayed_input_ep_reverb + delayed_sample_ep_reverb * decay_gain_ep_reverb;
			p.delay_ep_reverb_write_index = (p.delay_ep_reverb_write_index + 1) % len(p.delay_ep_reverb_buffer);
			node_ep_reverb_out = ((node_ep_amp_out)) * (1.0 - (p.mix)) + delayed_sample_ep_reverb * (p.mix);
		}

		output_left += node_ep_reverb_out
		output_right += node_ep_reverb_out
	}

	// B7-2-followup / SKB-016: a baked worst-case constant here held
	// is_playing true for minutes on real content (every exposed tail param
	// contributed its range maximum, so glassy-fm-pluck alone baked 202.5s
	// for a true tail under 2s). Arm on the FALLING EDGE instead, from the
	// live field values — that is one ln/pow per note-off rather than per
	// sample, which is what keeps this proc off the audio path.
	{
		voice_alive := false
		for i in 0..<12 {
			if p.voices[i].active {
				voice_alive = true
				break
			}
		}
		if voice_alive || p.playing {
			p.bus_tail_armed = false
			p.bus_tail_remaining = 0
		} else if !p.bus_tail_armed {
			p.bus_tail_armed = true
			p.bus_tail_remaining = u64(FM_Electric_Piano_bus_tail_seconds(p) * sample_rate)
		} else if p.bus_tail_remaining > 0 {
			p.bus_tail_remaining -= 1
		}
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
FM_Electric_Piano_process_sequence :: proc(p: ^FM_Electric_Piano_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "FM Electric Piano" (32 steps)
		switch p.current_step % 32 {
		case 0:
			FM_Electric_Piano_note_on(p, 53, 0.819999993, f32(8.000000000) * (60.0 / p.bpm / 4.0))
			FM_Electric_Piano_note_on(p, 57, 0.759999990, f32(8.000000000) * (60.0 / p.bpm / 4.0))
			FM_Electric_Piano_note_on(p, 60, 0.720000029, f32(8.000000000) * (60.0 / p.bpm / 4.0))
			FM_Electric_Piano_note_on(p, 64, 0.699999988, f32(8.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			FM_Electric_Piano_note_on(p, 50, 0.819999993, f32(8.000000000) * (60.0 / p.bpm / 4.0))
			FM_Electric_Piano_note_on(p, 53, 0.759999990, f32(8.000000000) * (60.0 / p.bpm / 4.0))
			FM_Electric_Piano_note_on(p, 57, 0.720000029, f32(8.000000000) * (60.0 / p.bpm / 4.0))
			FM_Electric_Piano_note_on(p, 60, 0.699999988, f32(8.000000000) * (60.0 / p.bpm / 4.0))
		case 16:
			FM_Electric_Piano_note_on(p, 55, 0.819999993, f32(8.000000000) * (60.0 / p.bpm / 4.0))
			FM_Electric_Piano_note_on(p, 58, 0.759999990, f32(8.000000000) * (60.0 / p.bpm / 4.0))
			FM_Electric_Piano_note_on(p, 62, 0.720000029, f32(8.000000000) * (60.0 / p.bpm / 4.0))
			FM_Electric_Piano_note_on(p, 65, 0.699999988, f32(8.000000000) * (60.0 / p.bpm / 4.0))
		case 24:
			FM_Electric_Piano_note_on(p, 48, 0.819999993, f32(8.000000000) * (60.0 / p.bpm / 4.0))
			FM_Electric_Piano_note_on(p, 52, 0.759999990, f32(8.000000000) * (60.0 / p.bpm / 4.0))
			FM_Electric_Piano_note_on(p, 55, 0.720000029, f32(8.000000000) * (60.0 / p.bpm / 4.0))
			FM_Electric_Piano_note_on(p, 58, 0.699999988, f32(8.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 32 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	FM_Electric_Piano: ^FM_Electric_Piano_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.800000012
	p.FM_Electric_Piano = new(FM_Electric_Piano_Processor)
	FM_Electric_Piano_init(p.FM_Electric_Piano, sr)
	FM_Electric_Piano_start(p.FM_Electric_Piano)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := FM_Electric_Piano_process(p.FM_Electric_Piano); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.FM_Electric_Piano)
}

