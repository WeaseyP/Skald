Bass_set_param :: proc(p: ^Bass_Processor, name: string, value: f32) -> bool {
	switch name {
	case "Growl_amplitude", "bass-growl::amplitude":
		Bass_set_Growl_amplitude(p, value)
		return true
	case "Sub_amplitude", "bass-sub::amplitude":
		Bass_set_Sub_amplitude(p, value)
		return true
	case "attack", "bass-amp::attack":
		Bass_set_attack(p, value)
		return true
	case "cutoff", "bass-filter::cutoff":
		Bass_set_cutoff(p, value)
		return true
	case "decay", "bass-amp::decay":
		Bass_set_decay(p, value)
		return true
	case "depth", "bass-amp::depth":
		Bass_set_depth(p, value)
		return true
	case "pulseWidth", "bass-growl::pulseWidth":
		Bass_set_pulseWidth(p, value)
		return true
	case "release", "bass-amp::release":
		Bass_set_release(p, value)
		return true
	case "resonance", "bass-filter::resonance":
		Bass_set_resonance(p, value)
		return true
	case "sustain", "bass-amp::sustain":
		Bass_set_sustain(p, value)
		return true
	case "velocitySensitivity", "bass-amp::velocitySensitivity":
		Bass_set_velocitySensitivity(p, value)
		return true
	}
	return false
}

Bass_get_param :: proc(p: ^Bass_Processor, name: string) -> (f32, bool) {
	switch name {
	case "Growl_amplitude", "bass-growl::amplitude":
		return p.Growl_amplitude, true
	case "Sub_amplitude", "bass-sub::amplitude":
		return p.Sub_amplitude, true
	case "attack", "bass-amp::attack":
		return p.attack, true
	case "cutoff", "bass-filter::cutoff":
		return p.cutoff, true
	case "decay", "bass-amp::decay":
		return p.decay, true
	case "depth", "bass-amp::depth":
		return p.depth, true
	case "pulseWidth", "bass-growl::pulseWidth":
		return p.pulseWidth, true
	case "release", "bass-amp::release":
		return p.release, true
	case "resonance", "bass-filter::resonance":
		return p.resonance, true
	case "sustain", "bass-amp::sustain":
		return p.sustain, true
	case "velocitySensitivity", "bass-amp::velocitySensitivity":
		return p.velocitySensitivity, true
	}
	return 0.0, false
}

Bass_process :: proc(p: ^Bass_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	Bass_process_sequence(p)
	p.total_samples += 1

	for v_idx in 0..<4 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.current_freq != voice.target_freq {
			glide_k := 1.0 / math.max(voice.glide_time * sample_rate, 1.0)
			if glide_k > 1.0 do glide_k = 1.0
			voice.current_freq += (voice.target_freq - voice.current_freq) * glide_k
			if abs(voice.target_freq - voice.current_freq) < 0.1 do voice.current_freq = voice.target_freq
		}
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_bass_amp_stage != .Release && voice.adsr_bass_amp_stage != .Idle {
				voice.adsr_bass_amp_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_bass_amp_out: f32 = 0.0
		node_bass_filter_out: f32 = 0.0
		node_bass_growl_out: f32 = 0.0
		node_bass_mixer_out: f32 = 0.0
		node_bass_output_out: f32 = 0.0
		node_bass_sub_out: f32 = 0.0

		// --- Oscillator Node bass_growl (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_bass_growl_phase[i] = math.mod(voice.osc_bass_growl_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_bass_growl_phase[i] + phase_rads, 2 * f32(math.PI));
				if final_phase < 2 * f32(math.PI) * math.clamp(f32(p.pulseWidth), 0.01, 0.99) do unison_out += 1.0; else do unison_out -= 1.0;
			}
			node_bass_growl_out = (unison_out / f32(unison_count)) * (p.Growl_amplitude);
		}

		// --- Oscillator Node bass_sub (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_bass_sub_phase[i] = math.mod(voice.osc_bass_sub_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_bass_sub_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += math.sin(final_phase);
			}
			node_bass_sub_out = (unison_out / f32(unison_count)) * (p.Sub_amplitude);
		}

		// --- Mixer Node bass_mixer (2 inputs) ---
		{
			mix_sum_bass_mixer: f32 = 0.0;
			mix_sum_bass_mixer += node_bass_growl_out * (f32(0.699999988));
			mix_sum_bass_mixer += node_bass_sub_out * (f32(0.899999976));
		node_bass_mixer_out = mix_sum_bass_mixer;
		}

		// --- Filter Node bass_filter (SVF) ---
		{
			cutoff_c_bass_filter: f32 = math.clamp(f32(p.cutoff), 10.0, sample_rate * 0.16);
			f_bass_filter := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_bass_filter / sample_rate));
			q_bass_filter: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_bass_filter);
			voice.filter_bass_filter_low += f_bass_filter * voice.filter_bass_filter_band;
			high_bass_filter := f32(((node_bass_mixer_out)) - voice.filter_bass_filter_low - q_bass_filter * voice.filter_bass_filter_band);
			voice.filter_bass_filter_band += f_bass_filter * high_bass_filter;
			node_bass_filter_out = voice.filter_bass_filter_low;
		}

		// --- ADSR Node bass_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_bass_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.attack) > 0 do envelope = voice.adsr_bass_amp_attack_start + (1.0 - voice.adsr_bass_amp_attack_start) * (voice.age / math.max(f32(p.attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_bass_amp_release_level = envelope;
				if voice.age >= (p.attack) {
					voice.adsr_bass_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.attack);
				if (p.decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.decay), 0.000001)) * (1.0 - (p.sustain)); else do envelope = (p.sustain);
				voice.adsr_bass_amp_release_level = envelope;
				if time_in_decay >= (p.decay) {
					voice.adsr_bass_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.sustain);
				voice.adsr_bass_amp_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.release) > 0 do envelope = voice.adsr_bass_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_bass_amp_stage = .Idle;
				}
			}
			vel_scale_bass_amp: f32 = (1.0 - (p.velocitySensitivity)) + (p.velocitySensitivity) * voice.velocity;
			node_bass_amp_out = ((node_bass_filter_out)) * envelope * (p.depth) * vel_scale_bass_amp;
		}

		output_left += node_bass_amp_out
		output_right += node_bass_amp_out
		if voice.adsr_bass_amp_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
Bass_process_sequence :: proc(p: ^Bass_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "Bass" (16 steps)
		switch p.current_step % 16 {
		case 0:
			Bass_note_on(p, 36, 0.949999988, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 3:
			Bass_note_on(p, 36, 0.720000029, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 5:
			Bass_note_on(p, 43, 0.879999995, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			Bass_note_on(p, 34, 0.920000017, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 11:
			Bass_note_on(p, 34, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 13:
			Bass_note_on(p, 31, 0.860000014, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	Bass: ^Bass_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.800000012
	p.Bass = new(Bass_Processor)
	Bass_init(p.Bass, sr)
	Bass_start(p.Bass)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := Bass_process(p.Bass); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.Bass)
}

