GW_Tuba_Oompah_Shop_note_on :: proc(p: ^GW_Tuba_Oompah_Shop_Processor, note: u8, velocity: f32, duration: f32) {
	// note and velocity are clamped silently to their MIDI/normalized domains.
	note := note
	if note > 127 do note = 127
	velocity := math.clamp(velocity, 0.0, 1.0)
	voice_idx := -1
	for i in 0..<3 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_releasing_age: f32 = -1.0
		for i in 0..<3 {
			releasing := true
			if p.voices[i].adsr_oompah_amp_stage != .Release && p.voices[i].adsr_oompah_amp_stage != .Idle do releasing = false
			if releasing && p.voices[i].age > oldest_releasing_age {
				oldest_releasing_age = p.voices[i].age
				voice_idx = i
			}
		}
		if voice_idx == -1 {
			oldest_age: f32 = -1.0
			for i in 0..<3 {
				if p.voices[i].age > oldest_age {
					oldest_age = p.voices[i].age
					voice_idx = i
				}
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	adsr_oompah_amp_prev_level: f32 = 0.0
	if stolen && v.adsr_oompah_amp_stage != .Idle {
		adsr_oompah_amp_prev_level = v.adsr_oompah_amp_release_level
		if v.adsr_oompah_amp_stage == .Release {
			rel_t_oompah_amp: f32 = (p.release);
			if rel_t_oompah_amp > 0.0 {
				rf_oompah_amp := 1.0 - (v.age - v.time_released) / math.max(rel_t_oompah_amp, 0.000001)
				if rf_oompah_amp < 0.0 do rf_oompah_amp = 0.0
				adsr_oompah_amp_prev_level *= rf_oompah_amp
			} else {
				adsr_oompah_amp_prev_level = 0.0
			}
		}
	}
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.029999999
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	v.adsr_oompah_amp_stage = .Attack
	v.adsr_oompah_amp_attack_start = adsr_oompah_amp_prev_level
	v.adsr_oompah_amp_release_level = adsr_oompah_amp_prev_level
	if !stolen {
		v.filter_oompah_body_low = 0.0
		v.filter_oompah_body_band = 0.0
		v.osc_oompah_osc_phase = {}
		v.lfo_oompah_vibrato_phase = 0.0
	}
}

GW_Tuba_Oompah_Shop_note_off :: proc(p: ^GW_Tuba_Oompah_Shop_Processor, note: u8) {
	// Clamped to match _note_on: `note` is the voice key, so both must map it.
	note := note
	if note > 127 do note = 127
	best := -1
	best_age: f32 = -1.0
	for i in 0..<3 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_oompah_amp_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_oompah_amp_stage = .Release
	}
}

GW_Tuba_Oompah_Shop_trigger :: proc(p: ^GW_Tuba_Oompah_Shop_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (p.attack) + (p.Bounce_decay) > d do d = (p.attack) + (p.Bounce_decay)
		if d <= 0.0 do d = 0.001
	}
	GW_Tuba_Oompah_Shop_note_on(p, note, velocity, d)
}

