		return true
	case "mix", "oompah-reverb::mix":
		GW_Tuba_Oompah_Shop_set_mix(p, value)
		return true
	case "release", "oompah-amp::release":
		GW_Tuba_Oompah_Shop_set_release(p, value)
		return true
	case "resonance", "oompah-body::resonance":
		GW_Tuba_Oompah_Shop_set_resonance(p, value)
		return true
	case "sustain", "oompah-amp::sustain":
		GW_Tuba_Oompah_Shop_set_sustain(p, value)
		return true
	}
	return false
}

GW_Tuba_Oompah_Shop_get_param :: proc(p: ^GW_Tuba_Oompah_Shop_Processor, name: string) -> (f32, bool) {
	switch name {
	case "Bounce_decay", "oompah-amp::decay":
		return p.Bounce_decay, true
	case "Shop_Floor_decay", "oompah-reverb::decay":
		return p.Shop_Floor_decay, true
	case "Sousa_amplitude", "oompah-osc::amplitude":
		return p.Sousa_amplitude, true
	case "Vibrato_amplitude", "oompah-vibrato::amplitude":
		return p.Vibrato_amplitude, true
	case "attack", "oompah-amp::attack":
		return p.attack, true
	case "cutoff", "oompah-body::cutoff":
		return p.cutoff, true
	case "frequency", "oompah-vibrato::frequency":
		return p.frequency, true
	case "mix", "oompah-reverb::mix":
		return p.mix, true
	case "release", "oompah-amp::release":
		return p.release, true
	case "resonance", "oompah-body::resonance":
		return p.resonance, true
	case "sustain", "oompah-amp::sustain":
		return p.sustain, true
	}
	return 0.0, false
}

GW_Tuba_Oompah_Shop_process :: proc(p: ^GW_Tuba_Oompah_Shop_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	GW_Tuba_Oompah_Shop_process_sequence(p)
	p.total_samples += 1

	node_oompah_amp_out_vsum: f32 = 0.0
	for v_idx in 0..<3 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.current_freq != voice.target_freq {
			glide_k := 1.0 / math.max(voice.glide_time * sample_rate, 1.0)
			if glide_k > 1.0 do glide_k = 1.0
			voice.current_freq += (voice.target_freq - voice.current_freq) * glide_k
			if abs(voice.target_freq - voice.current_freq) < 0.1 do voice.current_freq = voice.target_freq
		}
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_oompah_amp_stage != .Release && voice.adsr_oompah_amp_stage != .Idle {
				voice.adsr_oompah_amp_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_oompah_amp_out: f32 = 0.0
		node_oompah_body_out: f32 = 0.0
		node_oompah_osc_out: f32 = 0.0
		node_oompah_vibrato_out: f32 = 0.0

		// --- LFO Node oompah_vibrato ---
		voice.lfo_oompah_vibrato_phase = math.mod(voice.lfo_oompah_vibrato_phase + (2 * f32(math.PI) * (p.frequency) / sample_rate), 2 * f32(math.PI));
		if voice.lfo_oompah_vibrato_phase < 0.0 do voice.lfo_oompah_vibrato_phase += 2 * f32(math.PI);
		node_oompah_vibrato_out = math.sin(voice.lfo_oompah_vibrato_phase) * (p.Vibrato_amplitude);

		// --- Oscillator Node oompah_osc (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = ((voice.current_freq) * math.pow(2.0, math.clamp(f32(node_oompah_vibrato_out), -10.0, 10.0))) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_oompah_osc_phase[i] = math.mod(voice.osc_oompah_osc_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_oompah_osc_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += ((final_phase / f32(math.PI)) - 1.0);
			}
			node_oompah_osc_out = (unison_out / f32(unison_count)) * (p.Sousa_amplitude);
		}

		// --- Filter Node oompah_body (SVF) ---
		{
			cutoff_c_oompah_body: f32 = math.clamp(f32(p.cutoff), 10.0, sample_rate * 0.16);
			f_oompah_body := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_oompah_body / sample_rate));
			q_oompah_body: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_oompah_body);
			voice.filter_oompah_body_low += f_oompah_body * voice.filter_oompah_body_band;
			high_oompah_body := f32(((node_oompah_osc_out)) - voice.filter_oompah_body_low - q_oompah_body * voice.filter_oompah_body_band);
			voice.filter_oompah_body_band += f_oompah_body * high_oompah_body;
			node_oompah_body_out = voice.filter_oompah_body_low;
		}

		// --- ADSR Node oompah_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_oompah_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.attack) > 0 do envelope = voice.adsr_oompah_amp_attack_start + (1.0 - voice.adsr_oompah_amp_attack_start) * (voice.age / math.max(f32(p.attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_oompah_amp_release_level = envelope;
				if voice.age >= (p.attack) {
					voice.adsr_oompah_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.attack);
				if (p.Bounce_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Bounce_decay), 0.000001)) * (1.0 - (p.sustain)); else do envelope = (p.sustain);
				voice.adsr_oompah_amp_release_level = envelope;
				if time_in_decay >= (p.Bounce_decay) {
					voice.adsr_oompah_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.sustain);
				voice.adsr_oompah_amp_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.release) > 0 do envelope = voice.adsr_oompah_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_oompah_amp_stage = .Idle;
				}
			}
			vel_scale_oompah_amp: f32 = (1.0 - (f32(0.600000000))) + (f32(0.600000000)) * voice.velocity;
			node_oompah_amp_out = ((node_oompah_body_out)) * envelope * (f32(1.000000000)) * vel_scale_oompah_amp;
		}

		node_oompah_amp_out_vsum += node_oompah_amp_out
		if voice.adsr_oompah_amp_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}

	// --- Bus effects (once per sample, post voice sum) ---
	{
		node_oompah_amp_out := node_oompah_amp_out_vsum
		node_oompah_reverb_out: f32 = 0.0
		// --- Reverb Node oompah_reverb (pre-delay + feedback comb) ---
		{
			pre_delay_seconds_oompah_reverb: f32 = math.clamp(f32(f32(0.010000000)), 0.0, 0.25);
			pre_delay_samples_oompah_reverb := int(math.clamp(pre_delay_seconds_oompah_reverb * sample_rate, 0.0, f32(48000)));
			pre_write_index_oompah_reverb := p.delay_oompah_reverb_write_index % len(p.reverb_oompah_reverb_pre_buffer)
			pre_delayed_input_oompah_reverb := f32((node_oompah_amp_out))
			if pre_delay_samples_oompah_reverb > 0 {
				pre_read_index_oompah_reverb := (pre_write_index_oompah_reverb - pre_delay_samples_oompah_reverb + len(p.reverb_oompah_reverb_pre_buffer)) % len(p.reverb_oompah_reverb_pre_buffer)
				pre_delayed_input_oompah_reverb = p.reverb_oompah_reverb_pre_buffer[pre_read_index_oompah_reverb]
			}
			p.reverb_oompah_reverb_pre_buffer[pre_write_index_oompah_reverb] = f32((node_oompah_amp_out))
			delay_samples_oompah_reverb := int(math.clamp((0.075000000) * sample_rate, 0, 96000-1));
			read_index_oompah_reverb := (p.delay_oompah_reverb_write_index - delay_samples_oompah_reverb + len(p.delay_oompah_reverb_buffer)) % len(p.delay_oompah_reverb_buffer);
			delayed_sample_oompah_reverb := p.delay_oompah_reverb_buffer[read_index_oompah_reverb];
			decay_gain_oompah_reverb: f32 = math.clamp(math.pow(f32(0.001), f32(0.075000000) / math.max(f32(p.Shop_Floor_decay), 0.01)), 0.0, 0.95);
			p.delay_oompah_reverb_buffer[p.delay_oompah_reverb_write_index] = pre_delayed_input_oompah_reverb + delayed_sample_oompah_reverb * decay_gain_oompah_reverb;
			p.delay_oompah_reverb_write_index = (p.delay_oompah_reverb_write_index + 1) % len(p.delay_oompah_reverb_buffer);
			node_oompah_reverb_out = ((node_oompah_amp_out)) * (1.0 - (p.mix)) + delayed_sample_oompah_reverb * (p.mix);
		}

		output_left += node_oompah_reverb_out
		output_right += node_oompah_reverb_out
	}

	// B7-2-followup / SKB-016: a baked worst-case constant here held
	// is_playing true for minutes on real content (every exposed tail param
	// contributed its range maximum, so glassy-fm-pluck alone baked 202.5s
	// for a true tail under 2s). Arm on the FALLING EDGE instead, from the
	// live field values — that is one ln/pow per note-off rather than per
	// sample, which is what keeps this proc off the audio path.
	{
		voice_alive := false
		for i in 0..<3 {
			if p.voices[i].active {
				voice_alive = true
				break
			}
		}
		if voice_alive || p.playing {
			p.bus_tail_armed = false
			p.bus_tail_remaining = 0
		} else if !p.bus_tail_armed {
			p.bus_tail_armed = true
			p.bus_tail_remaining = u64(GW_Tuba_Oompah_Shop_bus_tail_seconds(p) * sample_rate)
		} else if p.bus_tail_remaining > 0 {
			p.bus_tail_remaining -= 1
		}
	}
	if math.is_nan(output_left) || math.is_inf(output_left) || math.is_nan(output_right) || math.is_inf(output_right) {
		p.nonfinite_count += 1
		output_left, output_right = 0.0, 0.0
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
GW_Tuba_Oompah_Shop_process_sequence :: proc(p: ^GW_Tuba_Oompah_Shop_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "GW Tuba Oompah Shop" (16 steps)
		switch p.current_step % 16 {
		case 0:
			GW_Tuba_Oompah_Shop_note_on(p, 41, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 2:
			GW_Tuba_Oompah_Shop_note_on(p, 48, 0.600000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 4:
			GW_Tuba_Oompah_Shop_note_on(p, 45, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 6:
			GW_Tuba_Oompah_Shop_note_on(p, 48, 0.600000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			GW_Tuba_Oompah_Shop_note_on(p, 41, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 10:
			GW_Tuba_Oompah_Shop_note_on(p, 48, 0.600000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			GW_Tuba_Oompah_Shop_note_on(p, 43, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 14:
			GW_Tuba_Oompah_Shop_note_on(p, 48, 0.649999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	GW_Tuba_Oompah_Shop: ^GW_Tuba_Oompah_Shop_Processor,
	master_volume: f32,
	dc: Skald_Dc_Block_State,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.750000000
	p.dc = {}
	p.GW_Tuba_Oompah_Shop = new(GW_Tuba_Oompah_Shop_Processor)
	GW_Tuba_Oompah_Shop_init(p.GW_Tuba_Oompah_Shop, sr)
	GW_Tuba_Oompah_Shop_start(p.GW_Tuba_Oompah_Shop)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := GW_Tuba_Oompah_Shop_process(p.GW_Tuba_Oompah_Shop); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	mixed_left, mixed_right = skald_dc_block(&p.dc, mixed_left, mixed_right)
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.GW_Tuba_Oompah_Shop)
}

