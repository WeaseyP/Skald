PRNG_State :: struct {
	state: u32,
}

next_float32 :: proc(rng: ^PRNG_State) -> f32 {
	x := rng.state
	x ~= x << 13
	x ~= x >> 17
	x ~= x << 5
	if x == 0 do x = 0xDEADBEEF
	rng.state = x
	return f32(x) / 4294967296.0
}

ADSR_Stage :: enum { Idle, Attack, Decay, Sustain, Release }

skald_wavetable_shape :: proc(idx: int, ph: f32, pw: f32) -> f32 {
	switch idx {
	case 1: return abs(ph * 4.0 - 2.0) - 1.0
	case 2: return ph * 2.0 - 1.0
	case 3: return ph < pw ? 1.0 : -1.0
	}
	return math.sin(ph * 2.0 * f32(math.PI))
}

skald_wavetable_sample :: proc(ph: f32, pos: f32, pw: f32) -> f32 {
	p := math.clamp(pos, 0.0, 3.0)
	i1 := int(p)
	i2 := (i1 + 1) % 4
	frac := p - f32(i1)
	s1 := skald_wavetable_shape(i1, ph, pw)
	s2 := skald_wavetable_shape(i2, ph, pw)
	return s1 + (s2 - s1) * frac
}

skald_master_flush_count: i32

// Soft limiter with a ceiling that really is 1.0 — plain tanh, not
// tanh(x*k)/k, which topped out above 1 and still clipped the device.
// Transparent for small signals (tanh(x) ~= x below ~0.3), saturating
// smoothly instead of clipping as the mix gets hot.
//
// E5: tanh(NaN) is NaN, and tanh(+-Inf) is +-1 — a NaN INPUT would poison
// the entire mix silently, and an Inf input would report a false full-scale
// tone. Flushed to silence and counted instead, here, so this is caught no
// matter which of the three call sites (a per-asset _process, project_process,
// or the wasm shim's skald_process) fed it a bad sample.
skald_soft_limit :: proc(l: f32, r: f32) -> (f32, f32) {
	lf, rf := l, r
	if math.is_nan(lf) || math.is_inf(lf) || math.is_nan(rf) || math.is_inf(rf) {
		lf, rf = 0.0, 0.0
		skald_master_flush_count += 1
	}
	return math.tanh(lf), math.tanh(rf)
}

// E5: one-pole DC blocker state, one instance per master bus (project_process
// or the wasm shim's skald_process — see skald_dc_block below). Reset
// alongside every other master-bus field (project_init / skald_init).
Skald_Dc_Block_State :: struct {
	x1_l, y1_l, x1_r, y1_r: f32,
}

// y = x - x1 + R*y1, R = 0.995 (~38 Hz cutoff at 48 kHz — see the note
// above generate_project_code's call to emit_dc_block_proc).
skald_dc_block :: proc(s: ^Skald_Dc_Block_State, l: f32, r: f32) -> (f32, f32) {
	yl := l - s.x1_l + 0.995 * s.y1_l
	yr := r - s.x1_r + 0.995 * s.y1_r
	s.x1_l, s.y1_l = l, yl
	s.x1_r, s.y1_r = r, yr
	return yl, yr
}

skald_feedback_tail_seconds :: proc(period: f32, gain: f32) -> f32 {
	if math.is_nan(period) || period <= 0.0 do return 0.0
	// 0.95 is the DSP's own feedback ceiling (see generate_delay_code /
	// generate_reverb_code), so no live value can ring longer than this.
	g := math.clamp(gain, 0.0, 0.95)
	if g <= 0.0 do return period
	passes := math.ceil(math.ln(f32(0.001)) / math.ln(g))
	result := period * passes
	if math.is_nan(result) || math.is_inf(result) || result < 0.0 do return period
	return result
}

