Glassy_FM_Pluck_set_param :: proc(p: ^Glassy_FM_Pluck_Processor, name: string, value: f32) -> bool {
	switch name {
	case "Auto_Pan_frequency", "glass-autopan::frequency":
		Glassy_FM_Pluck_set_Auto_Pan_frequency(p, value)
		return true
	case "Carrier_frequency", "glass-carrier::frequency":
		Glassy_FM_Pluck_set_Carrier_frequency(p, value)
		return true
	case "Glass_Mod_frequency", "glass-mod::frequency":
		Glassy_FM_Pluck_set_Glass_Mod_frequency(p, value)
		return true
	case "amplitude", "glass-autopan::amplitude":
		Glassy_FM_Pluck_set_amplitude(p, value)
		return true
	case "attack", "glass-amp::attack":
		Glassy_FM_Pluck_set_attack(p, value)
		return true
	case "cutoff", "glass-filter::cutoff":
		Glassy_FM_Pluck_set_cutoff(p, value)
		return true
	case "decay", "glass-amp::decay":
		Glassy_FM_Pluck_set_decay(p, value)
		return true
	case "depth", "glass-amp::depth":
		Glassy_FM_Pluck_set_depth(p, value)
		return true
	case "feedback", "glass-delay::feedback":
		Glassy_FM_Pluck_set_feedback(p, value)
		return true
	case "mix", "glass-delay::mix":
		Glassy_FM_Pluck_set_mix(p, value)
		return true
	case "modIndex", "glass-carrier::modIndex":
		Glassy_FM_Pluck_set_modIndex(p, value)
		return true
	case "pan", "glass-panner::pan":
		Glassy_FM_Pluck_set_pan(p, value)
		return true
	case "release", "glass-amp::release":
		Glassy_FM_Pluck_set_release(p, value)
		return true
	case "resonance", "glass-filter::resonance":
		Glassy_FM_Pluck_set_resonance(p, value)
		return true
	case "sustain", "glass-amp::sustain":
		Glassy_FM_Pluck_set_sustain(p, value)
		return true
	}
	return false
}

Glassy_FM_Pluck_get_param :: proc(p: ^Glassy_FM_Pluck_Processor, name: string) -> (f32, bool) {
	switch name {
	case "Auto_Pan_frequency", "glass-autopan::frequency":
		return p.Auto_Pan_frequency, true
	case "Carrier_frequency", "glass-carrier::frequency":
		return p.Carrier_frequency, true
	case "Glass_Mod_frequency", "glass-mod::frequency":
		return p.Glass_Mod_frequency, true
	case "amplitude", "glass-autopan::amplitude":
		return p.amplitude, true
	case "attack", "glass-amp::attack":
		return p.attack, true
	case "cutoff", "glass-filter::cutoff":
		return p.cutoff, true
	case "decay", "glass-amp::decay":
		return p.decay, true
	case "depth", "glass-amp::depth":
		return p.depth, true
	case "feedback", "glass-delay::feedback":
		return p.feedback, true
	case "mix", "glass-delay::mix":
		return p.mix, true
	case "modIndex", "glass-carrier::modIndex":
		return p.modIndex, true
	case "pan", "glass-panner::pan":
		return p.pan, true
	case "release", "glass-amp::release":
		return p.release, true
	case "resonance", "glass-filter::resonance":
		return p.resonance, true
	case "sustain", "glass-amp::sustain":
		return p.sustain, true
	}
	return 0.0, false
}

Glassy_FM_Pluck_process :: proc(p: ^Glassy_FM_Pluck_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	Glassy_FM_Pluck_process_sequence(p)
	p.total_samples += 1

	node_glass_filter_out_vsum: f32 = 0.0
	for v_idx in 0..<12 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_glass_amp_stage != .Release && voice.adsr_glass_amp_stage != .Idle {
				voice.adsr_glass_amp_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_glass_amp_out: f32 = 0.0
		node_glass_carrier_out: f32 = 0.0
		node_glass_filter_out: f32 = 0.0
		node_glass_mod_out: f32 = 0.0

		// --- FM Operator Node glass_mod (Unison/Detune) ---
		{
			carrier_freq_glass_mod: f32 = voice.current_freq * math.clamp(f32(p.Glass_Mod_frequency), 0.01, 32.0);
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_carrier_freq_glass_mod: f32 = carrier_freq_glass_mod * math.pow(2.0, detune_amount / 1200.0);
				voice.fm_glass_mod_phase[i] = math.mod(voice.fm_glass_mod_phase[i] + (2 * f32(math.PI) * detuned_carrier_freq_glass_mod / sample_rate), 2 * f32(math.PI));
				unison_out += math.sin(voice.fm_glass_mod_phase[i] + (0.0) * (f32(0.000000000)));
			}
			node_glass_mod_out = unison_out / f32(unison_count);
		}

		// --- FM Operator Node glass_carrier (Unison/Detune) ---
		{
			carrier_freq_glass_carrier: f32 = voice.current_freq * math.clamp(f32(p.Carrier_frequency), 0.01, 32.0);
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_carrier_freq_glass_carrier: f32 = carrier_freq_glass_carrier * math.pow(2.0, detune_amount / 1200.0);
				voice.fm_glass_carrier_phase[i] = math.mod(voice.fm_glass_carrier_phase[i] + (2 * f32(math.PI) * detuned_carrier_freq_glass_carrier / sample_rate), 2 * f32(math.PI));
				unison_out += math.sin(voice.fm_glass_carrier_phase[i] + ((node_glass_mod_out)) * (p.modIndex));
			}
			node_glass_carrier_out = unison_out / f32(unison_count);
		}

		// --- ADSR Node glass_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_glass_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.attack) > 0 do envelope = voice.adsr_glass_amp_attack_start + (1.0 - voice.adsr_glass_amp_attack_start) * (voice.age / math.max(f32(p.attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_glass_amp_release_level = envelope;
				if voice.age >= (p.attack) {
					voice.adsr_glass_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.attack);
				if (p.decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.decay), 0.000001)) * (1.0 - (p.sustain)); else do envelope = (p.sustain);
				voice.adsr_glass_amp_release_level = envelope;
				if time_in_decay >= (p.decay) {
					voice.adsr_glass_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.sustain);
				voice.adsr_glass_amp_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.release) > 0 do envelope = voice.adsr_glass_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_glass_amp_stage = .Idle;
				}
			}
			vel_scale_glass_amp: f32 = (1.0 - (f32(0.750000000))) + (f32(0.750000000)) * voice.velocity;
			node_glass_amp_out = ((node_glass_carrier_out)) * envelope * (p.depth) * vel_scale_glass_amp;
		}

		// --- Filter Node glass_filter (SVF) ---
		{
			cutoff_c_glass_filter: f32 = math.clamp(f32(p.cutoff), 10.0, sample_rate * 0.16);
			f_glass_filter := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_glass_filter / sample_rate));
			q_glass_filter: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_glass_filter);
			voice.filter_glass_filter_low += f_glass_filter * voice.filter_glass_filter_band;
			high_glass_filter := f32(((node_glass_amp_out)) - voice.filter_glass_filter_low - q_glass_filter * voice.filter_glass_filter_band);
			voice.filter_glass_filter_band += f_glass_filter * high_glass_filter;
			node_glass_filter_out = voice.filter_glass_filter_low;
		}

		node_glass_filter_out_vsum += node_glass_filter_out
		if voice.adsr_glass_amp_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}

	// --- Bus effects (once per sample, post voice sum) ---
	{
		node_glass_filter_out := node_glass_filter_out_vsum
		node_glass_autopan_out: f32 = 0.0
		node_glass_delay_out: f32 = 0.0
		node_glass_panner_out: f32 = 0.0
		node_glass_panner_out_left: f32 = 0.0
		node_glass_panner_out_right: f32 = 0.0
		// --- LFO Node glass_autopan ---
		p.lfo_glass_autopan_phase = math.mod(p.lfo_glass_autopan_phase + (2 * f32(math.PI) * (p.Auto_Pan_frequency) / sample_rate), 2 * f32(math.PI));
		if p.lfo_glass_autopan_phase < 0.0 do p.lfo_glass_autopan_phase += 2 * f32(math.PI);
		node_glass_autopan_out = math.sin(p.lfo_glass_autopan_phase) * (p.amplitude);

		// --- Delay Node glass_delay ---
		{
			delay_samples_glass_delay := int(math.clamp((((60.0 / p.bpm) * 0.500000000)) * sample_rate, 1, 96000-1));
			read_index_glass_delay := (p.delay_glass_delay_write_index - delay_samples_glass_delay + len(p.delay_glass_delay_buffer)) % len(p.delay_glass_delay_buffer);
			delayed_sample_glass_delay := p.delay_glass_delay_buffer[read_index_glass_delay];
			p.delay_glass_delay_buffer[p.delay_glass_delay_write_index] = ((node_glass_filter_out)) + delayed_sample_glass_delay * math.clamp(f32(p.feedback), 0.0, 0.95);
			p.delay_glass_delay_write_index = (p.delay_glass_delay_write_index + 1) % len(p.delay_glass_delay_buffer);
			node_glass_delay_out = ((node_glass_filter_out)) * (1.0 - (p.mix)) + delayed_sample_glass_delay * (p.mix);
		}

		// --- Panner Node glass_panner ---
		// Constant-power cos/sin law normalized by sqrt(2), so pan 0 is unity in
		// BOTH channels and a centred Panner is a transparent insert. Full
		// deflection therefore peaks at 1.4142 in one channel (+3dB).
		{
			pan_in_glass_panner: f32 = ((node_glass_delay_out));
			pan_angle_glass_panner: f32 = (math.clamp(f32((p.pan) + (node_glass_autopan_out)), -1.0, 1.0) * 0.5 + 0.5) * f32(math.PI) / 2.0;
			node_glass_panner_out_left = pan_in_glass_panner * math.cos(pan_angle_glass_panner) * 1.4142136;
			node_glass_panner_out_right = pan_in_glass_panner * math.sin(pan_angle_glass_panner) * 1.4142136;
			// Mono consumers get the input untouched: pan is not a level.
			node_glass_panner_out = pan_in_glass_panner;
		}

		output_left += node_glass_panner_out_left
		output_right += node_glass_panner_out_right
	}

	// B7-2-followup / SKB-016: a baked worst-case constant here held
	// is_playing true for minutes on real content (every exposed tail param
	// contributed its range maximum, so glassy-fm-pluck alone baked 202.5s
	// for a true tail under 2s). Arm on the FALLING EDGE instead, from the
	// live field values — that is one ln/pow per note-off rather than per
	// sample, which is what keeps this proc off the audio path.
	{
		voice_alive := false
		for i in 0..<12 {
			if p.voices[i].active {
				voice_alive = true
				break
			}
		}
		if voice_alive || p.playing {
			p.bus_tail_armed = false
			p.bus_tail_remaining = 0
		} else if !p.bus_tail_armed {
			p.bus_tail_armed = true
			p.bus_tail_remaining = u64(Glassy_FM_Pluck_bus_tail_seconds(p) * sample_rate)
		} else if p.bus_tail_remaining > 0 {
			p.bus_tail_remaining -= 1
		}
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
Glassy_FM_Pluck_process_sequence :: proc(p: ^Glassy_FM_Pluck_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "Glassy FM Pluck" (16 steps)
		switch p.current_step % 16 {
		case 0:
			Glassy_FM_Pluck_note_on(p, 64, 0.850000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 2:
			Glassy_FM_Pluck_note_on(p, 68, 0.779999971, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 3:
			Glassy_FM_Pluck_note_on(p, 71, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 4:
			Glassy_FM_Pluck_note_on(p, 76, 0.879999995, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 6:
			Glassy_FM_Pluck_note_on(p, 71, 0.740000010, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 7:
			Glassy_FM_Pluck_note_on(p, 73, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			Glassy_FM_Pluck_note_on(p, 68, 0.819999993, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 10:
			Glassy_FM_Pluck_note_on(p, 64, 0.759999990, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 11:
			Glassy_FM_Pluck_note_on(p, 71, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			Glassy_FM_Pluck_note_on(p, 75, 0.860000014, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 14:
			Glassy_FM_Pluck_note_on(p, 71, 0.740000010, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 15:
			Glassy_FM_Pluck_note_on(p, 76, 0.839999974, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	Glassy_FM_Pluck: ^Glassy_FM_Pluck_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.800000012
	p.Glassy_FM_Pluck = new(Glassy_FM_Pluck_Processor)
	Glassy_FM_Pluck_init(p.Glassy_FM_Pluck, sr)
	Glassy_FM_Pluck_start(p.Glassy_FM_Pluck)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := Glassy_FM_Pluck_process(p.Glassy_FM_Pluck); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.Glassy_FM_Pluck)
}

