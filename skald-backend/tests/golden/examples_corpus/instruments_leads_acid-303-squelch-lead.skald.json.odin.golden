Acid_Squelch_set_param :: proc(p: ^Acid_Squelch_Processor, name: string, value: f32) -> bool {
	switch name {
	case "Amp_attack", "acid-amp::attack":
		Acid_Squelch_set_Amp_attack(p, value)
		return true
	case "Amp_decay", "acid-amp::decay":
		Acid_Squelch_set_Amp_decay(p, value)
		return true
	case "Amp_depth", "acid-amp::depth":
		Acid_Squelch_set_Amp_depth(p, value)
		return true
	case "Amp_release", "acid-amp::release":
		Acid_Squelch_set_Amp_release(p, value)
		return true
	case "Amp_sustain", "acid-amp::sustain":
		Acid_Squelch_set_Amp_sustain(p, value)
		return true
	case "Squelch_Env_attack", "acid-filter-env::attack":
		Acid_Squelch_set_Squelch_Env_attack(p, value)
		return true
	case "Squelch_Env_decay", "acid-filter-env::decay":
		Acid_Squelch_set_Squelch_Env_decay(p, value)
		return true
	case "Squelch_Env_depth", "acid-filter-env::depth":
		Acid_Squelch_set_Squelch_Env_depth(p, value)
		return true
	case "Squelch_Env_release", "acid-filter-env::release":
		Acid_Squelch_set_Squelch_Env_release(p, value)
		return true
	case "Squelch_Env_sustain", "acid-filter-env::sustain":
		Acid_Squelch_set_Squelch_Env_sustain(p, value)
		return true
	case "amplitude", "acid-osc::amplitude":
		Acid_Squelch_set_amplitude(p, value)
		return true
	case "cutoff", "acid-filter::cutoff":
		Acid_Squelch_set_cutoff(p, value)
		return true
	case "drive", "acid-drive::drive":
		Acid_Squelch_set_drive(p, value)
		return true
	case "mix", "acid-drive::mix":
		Acid_Squelch_set_mix(p, value)
		return true
	case "outMax", "acid-env-map::outMax":
		Acid_Squelch_set_outMax(p, value)
		return true
	case "resonance", "acid-filter::resonance":
		Acid_Squelch_set_resonance(p, value)
		return true
	case "tone", "acid-drive::tone":
		Acid_Squelch_set_tone(p, value)
		return true
	}
	return false
}

Acid_Squelch_get_param :: proc(p: ^Acid_Squelch_Processor, name: string) -> (f32, bool) {
	switch name {
	case "Amp_attack", "acid-amp::attack":
		return p.Amp_attack, true
	case "Amp_decay", "acid-amp::decay":
		return p.Amp_decay, true
	case "Amp_depth", "acid-amp::depth":
		return p.Amp_depth, true
	case "Amp_release", "acid-amp::release":
		return p.Amp_release, true
	case "Amp_sustain", "acid-amp::sustain":
		return p.Amp_sustain, true
	case "Squelch_Env_attack", "acid-filter-env::attack":
		return p.Squelch_Env_attack, true
	case "Squelch_Env_decay", "acid-filter-env::decay":
		return p.Squelch_Env_decay, true
	case "Squelch_Env_depth", "acid-filter-env::depth":
		return p.Squelch_Env_depth, true
	case "Squelch_Env_release", "acid-filter-env::release":
		return p.Squelch_Env_release, true
	case "Squelch_Env_sustain", "acid-filter-env::sustain":
		return p.Squelch_Env_sustain, true
	case "amplitude", "acid-osc::amplitude":
		return p.amplitude, true
	case "cutoff", "acid-filter::cutoff":
		return p.cutoff, true
	case "drive", "acid-drive::drive":
		return p.drive, true
	case "mix", "acid-drive::mix":
		return p.mix, true
	case "outMax", "acid-env-map::outMax":
		return p.outMax, true
	case "resonance", "acid-filter::resonance":
		return p.resonance, true
	case "tone", "acid-drive::tone":
		return p.tone, true
	}
	return 0.0, false
}

Acid_Squelch_process :: proc(p: ^Acid_Squelch_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	Acid_Squelch_process_sequence(p)
	p.total_samples += 1

	for v_idx in 0..<4 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.current_freq != voice.target_freq {
			glide_k := 1.0 / math.max(voice.glide_time * sample_rate, 1.0)
			if glide_k > 1.0 do glide_k = 1.0
			voice.current_freq += (voice.target_freq - voice.current_freq) * glide_k
			if abs(voice.target_freq - voice.current_freq) < 0.1 do voice.current_freq = voice.target_freq
		}
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_acid_amp_stage != .Release && voice.adsr_acid_amp_stage != .Idle {
				voice.adsr_acid_amp_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_acid_filter_env_stage != .Release && voice.adsr_acid_filter_env_stage != .Idle {
				voice.adsr_acid_filter_env_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_acid_amp_out: f32 = 0.0
		node_acid_drive_out: f32 = 0.0
		node_acid_env_map_out: f32 = 0.0
		node_acid_filter_out: f32 = 0.0
		node_acid_filter_env_out: f32 = 0.0
		node_acid_osc_out: f32 = 0.0
		node_acid_output_out: f32 = 0.0

		// --- ADSR Node acid_filter_env ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_acid_filter_env_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Squelch_Env_attack) > 0 do envelope = voice.adsr_acid_filter_env_attack_start + (1.0 - voice.adsr_acid_filter_env_attack_start) * (voice.age / math.max(f32(p.Squelch_Env_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_acid_filter_env_release_level = envelope;
				if voice.age >= (p.Squelch_Env_attack) {
					voice.adsr_acid_filter_env_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Squelch_Env_attack);
				if (p.Squelch_Env_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Squelch_Env_decay), 0.000001)) * (1.0 - (p.Squelch_Env_sustain)); else do envelope = (p.Squelch_Env_sustain);
				voice.adsr_acid_filter_env_release_level = envelope;
				if time_in_decay >= (p.Squelch_Env_decay) {
					voice.adsr_acid_filter_env_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Squelch_Env_sustain);
				voice.adsr_acid_filter_env_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_acid_filter_env_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Squelch_Env_release) > 0 do envelope = voice.adsr_acid_filter_env_release_level * (1.0 - (time_in_release / math.max(f32(p.Squelch_Env_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_acid_filter_env_stage = .Idle;
				}
			}
			vel_scale_acid_filter_env: f32 = (1.0 - (f32(0.700000000))) + (f32(0.700000000)) * voice.velocity;
			node_acid_filter_env_out = (1.0) * envelope * (p.Squelch_Env_depth) * vel_scale_acid_filter_env;
		}

		// --- Oscillator Node acid_osc (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_acid_osc_phase[i] = math.mod(voice.osc_acid_osc_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_acid_osc_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += ((final_phase / f32(math.PI)) - 1.0);
			}
			node_acid_osc_out = (unison_out / f32(unison_count)) * (p.amplitude);
		}

		// --- Mapper Node acid_env_map ---
		{
			in_range_acid_env_map: f32 = f32(f32(1.000000000)) - f32(f32(0.000000000));
			if in_range_acid_env_map == 0.0 do in_range_acid_env_map = 1.0;
			node_acid_env_map_out = math.lerp(f32(f32(0.000000000)), f32(p.outMax), math.clamp((f32((node_acid_filter_env_out)) - f32(f32(0.000000000))) / in_range_acid_env_map, 0.0, 1.0));
		}

		// --- Filter Node acid_filter (SVF) ---
		{
			cutoff_c_acid_filter: f32 = math.clamp(f32((p.cutoff) + (node_acid_env_map_out)), 10.0, sample_rate * 0.16);
			f_acid_filter := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_acid_filter / sample_rate));
			q_acid_filter: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_acid_filter);
			voice.filter_acid_filter_low += f_acid_filter * voice.filter_acid_filter_band;
			high_acid_filter := f32(((node_acid_osc_out)) - voice.filter_acid_filter_low - q_acid_filter * voice.filter_acid_filter_band);
			voice.filter_acid_filter_band += f_acid_filter * high_acid_filter;
			node_acid_filter_out = voice.filter_acid_filter_low;
		}

		// --- ADSR Node acid_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_acid_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Amp_attack) > 0 do envelope = voice.adsr_acid_amp_attack_start + (1.0 - voice.adsr_acid_amp_attack_start) * (voice.age / math.max(f32(p.Amp_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_acid_amp_release_level = envelope;
				if voice.age >= (p.Amp_attack) {
					voice.adsr_acid_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Amp_attack);
				if (p.Amp_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Amp_decay), 0.000001)) * (1.0 - (p.Amp_sustain)); else do envelope = (p.Amp_sustain);
				voice.adsr_acid_amp_release_level = envelope;
				if time_in_decay >= (p.Amp_decay) {
					voice.adsr_acid_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Amp_sustain);
				voice.adsr_acid_amp_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_acid_amp_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Amp_release) > 0 do envelope = voice.adsr_acid_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.Amp_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_acid_amp_stage = .Idle;
				}
			}
			vel_scale_acid_amp: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_acid_amp_out = ((node_acid_filter_out)) * envelope * (p.Amp_depth) * vel_scale_acid_amp;
		}

		// --- Distortion Node acid_drive (classic) ---
		{
			dist_in_acid_drive: f32 = ((node_acid_amp_out));
			dist_k_acid_drive: f32 = math.max(f32(p.drive), 1.0);
			dist_wet_acid_drive: f32 = (f32(math.PI) + dist_k_acid_drive) * dist_in_acid_drive / (f32(math.PI) + dist_k_acid_drive * abs(dist_in_acid_drive));
			tone_k_acid_drive: f32 = math.clamp(2.0 * f32(math.PI) * math.clamp(f32(p.tone), 100.0, 20000.0) / sample_rate, 0.001, 1.0);
			voice.dist_acid_drive_tone += tone_k_acid_drive * (dist_wet_acid_drive - voice.dist_acid_drive_tone);
			mix_acid_drive: f32 = math.clamp(f32(p.mix), 0.0, 1.0);
			node_acid_drive_out = dist_in_acid_drive * (1.0 - mix_acid_drive) + voice.dist_acid_drive_tone * mix_acid_drive;
		}

		output_left += node_acid_drive_out
		output_right += node_acid_drive_out
		if voice.adsr_acid_amp_stage != .Idle do voice_busy = true
		if voice.adsr_acid_filter_env_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
Acid_Squelch_process_sequence :: proc(p: ^Acid_Squelch_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "Acid Squelch" (16 steps)
		switch p.current_step % 16 {
		case 0:
			Acid_Squelch_note_on(p, 45, 0.949999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 1:
			Acid_Squelch_note_on(p, 45, 0.600000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 2:
			Acid_Squelch_note_on(p, 57, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 3:
			Acid_Squelch_note_on(p, 45, 0.649999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 4:
			Acid_Squelch_note_on(p, 48, 0.920000017, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 5:
			Acid_Squelch_note_on(p, 45, 0.600000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 6:
			Acid_Squelch_note_on(p, 52, 0.879999995, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 7:
			Acid_Squelch_note_on(p, 57, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			Acid_Squelch_note_on(p, 45, 0.949999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 9:
			Acid_Squelch_note_on(p, 60, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 10:
			Acid_Squelch_note_on(p, 57, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 11:
			Acid_Squelch_note_on(p, 45, 0.600000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			Acid_Squelch_note_on(p, 55, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 13:
			Acid_Squelch_note_on(p, 45, 0.649999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 14:
			Acid_Squelch_note_on(p, 52, 0.850000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 15:
			Acid_Squelch_note_on(p, 48, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	Acid_Squelch: ^Acid_Squelch_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.800000012
	p.Acid_Squelch = new(Acid_Squelch_Processor)
	Acid_Squelch_init(p.Acid_Squelch, sr)
	Acid_Squelch_start(p.Acid_Squelch)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := Acid_Squelch_process(p.Acid_Squelch); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.Acid_Squelch)
}

