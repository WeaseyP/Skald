Acid_Squelch_note_on :: proc(p: ^Acid_Squelch_Processor, note: u8, velocity: f32, duration: f32) {
	// note and velocity are clamped silently to their MIDI/normalized domains.
	note := note
	if note > 127 do note = 127
	velocity := math.clamp(velocity, 0.0, 1.0)
	voice_idx := -1
	for i in 0..<4 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_age: f32 = -1.0
		for i in 0..<4 {
			if p.voices[i].age > oldest_age {
				oldest_age = p.voices[i].age
				voice_idx = i
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	adsr_acid_amp_prev_level: f32 = 0.0
	if stolen && v.adsr_acid_amp_stage != .Idle {
		adsr_acid_amp_prev_level = v.adsr_acid_amp_release_level
		if v.adsr_acid_amp_stage == .Release {
			rel_t_acid_amp: f32 = (p.Amp_release);
			if rel_t_acid_amp > 0.0 {
				rf_acid_amp := 1.0 - (v.age - v.time_released) / math.max(rel_t_acid_amp, 0.000001)
				if rf_acid_amp < 0.0 do rf_acid_amp = 0.0
				adsr_acid_amp_prev_level *= rf_acid_amp
			} else {
				adsr_acid_amp_prev_level = 0.0
			}
		}
	}
	adsr_acid_filter_env_prev_level: f32 = 0.0
	if stolen && v.adsr_acid_filter_env_stage != .Idle {
		adsr_acid_filter_env_prev_level = v.adsr_acid_filter_env_release_level
		if v.adsr_acid_filter_env_stage == .Release {
			rel_t_acid_filter_env: f32 = (p.Squelch_Env_release);
			if rel_t_acid_filter_env > 0.0 {
				rf_acid_filter_env := 1.0 - (v.age - v.time_released) / math.max(rel_t_acid_filter_env, 0.000001)
				if rf_acid_filter_env < 0.0 do rf_acid_filter_env = 0.0
				adsr_acid_filter_env_prev_level *= rf_acid_filter_env
			} else {
				adsr_acid_filter_env_prev_level = 0.0
			}
		}
	}
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.059999999
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	v.adsr_acid_amp_stage = .Attack
	v.adsr_acid_amp_attack_start = adsr_acid_amp_prev_level
	v.adsr_acid_amp_release_level = adsr_acid_amp_prev_level
	v.adsr_acid_filter_env_stage = .Attack
	v.adsr_acid_filter_env_attack_start = adsr_acid_filter_env_prev_level
	v.adsr_acid_filter_env_release_level = adsr_acid_filter_env_prev_level
	if !stolen {
		v.dist_acid_drive_tone = 0.0
		v.filter_acid_filter_low = 0.0
		v.filter_acid_filter_band = 0.0
		v.osc_acid_osc_phase = {}
	}
}

Acid_Squelch_note_off :: proc(p: ^Acid_Squelch_Processor, note: u8) {
	// Clamped to match _note_on: `note` is the voice key, so both must map it.
	note := note
	if note > 127 do note = 127
	best := -1
	best_age: f32 = -1.0
	for i in 0..<4 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_acid_amp_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_acid_amp_stage = .Release
		p.voices[best].adsr_acid_filter_env_stage = .Release
	}
}

Acid_Squelch_trigger :: proc(p: ^Acid_Squelch_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (p.Amp_attack) + (p.Amp_decay) > d do d = (p.Amp_attack) + (p.Amp_decay)
		if (p.Squelch_Env_attack) + (p.Squelch_Env_decay) > d do d = (p.Squelch_Env_attack) + (p.Squelch_Env_decay)
		if d <= 0.0 do d = 0.001
	}
	Acid_Squelch_note_on(p, note, velocity, d)
}

Acid_Squelch_feed_input :: proc(p: ^Acid_Squelch_Processor, in_left: f32, in_right: f32) {
	p.ext_in_l = in_left
	p.ext_in_r = in_right
}

Acid_Squelch_start :: proc(p: ^Acid_Squelch_Processor) {
	p.playing = true
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
}

Acid_Squelch_stop :: proc(p: ^Acid_Squelch_Processor) {
	p.playing = false
}

Acid_Squelch_set_loop :: proc(p: ^Acid_Squelch_Processor, loop: bool) {
	p.loop = loop
}

Acid_Squelch_set_volume :: proc(p: ^Acid_Squelch_Processor, value: f32) {
	p.volume = math.clamp(value, 0.0, 1.0)
}

Acid_Squelch_is_playing :: proc(p: ^Acid_Squelch_Processor) -> bool {
	if p.playing do return true
	for i in 0..<4 {
		if p.voices[i].active do return true
	}
	return false
}

