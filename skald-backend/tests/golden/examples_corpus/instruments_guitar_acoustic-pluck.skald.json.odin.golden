	case "Body_amplitude", "ac-body::amplitude":
		return p.Body_amplitude, true
	case "Pick_Click_cutoff", "ac-pick-bp::cutoff":
		return p.Pick_Click_cutoff, true
	case "Pick_Click_resonance", "ac-pick-bp::resonance":
		return p.Pick_Click_resonance, true
	case "Pick_Env_attack", "ac-pick-env::attack":
		return p.Pick_Env_attack, true
	case "Pick_Env_decay", "ac-pick-env::decay":
		return p.Pick_Env_decay, true
	case "Pick_Env_depth", "ac-pick-env::depth":
		return p.Pick_Env_depth, true
	case "Pick_Env_release", "ac-pick-env::release":
		return p.Pick_Env_release, true
	case "Pick_Env_sustain", "ac-pick-env::sustain":
		return p.Pick_Env_sustain, true
	case "Pick_Noise_amplitude", "ac-pick-noise::amplitude":
		return p.Pick_Noise_amplitude, true
	case "Pluck_Env_attack", "ac-pluck-env::attack":
		return p.Pluck_Env_attack, true
	case "Pluck_Env_decay", "ac-pluck-env::decay":
		return p.Pluck_Env_decay, true
	case "Pluck_Env_depth", "ac-pluck-env::depth":
		return p.Pluck_Env_depth, true
	case "Pluck_Env_release", "ac-pluck-env::release":
		return p.Pluck_Env_release, true
	case "Pluck_Env_sustain", "ac-pluck-env::sustain":
		return p.Pluck_Env_sustain, true
	case "String_Tone_cutoff", "ac-tone::cutoff":
		return p.String_Tone_cutoff, true
	case "String_Tone_resonance", "ac-tone::resonance":
		return p.String_Tone_resonance, true
	case "String_amplitude", "ac-string::amplitude":
		return p.String_amplitude, true
	case "outMax", "ac-pluck-map::outMax":
		return p.outMax, true
	case "velocitySensitivity", "ac-amp::velocitySensitivity":
		return p.velocitySensitivity, true
	}
	return 0.0, false
}

Acoustic_Pluck_process :: proc(p: ^Acoustic_Pluck_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	Acoustic_Pluck_process_sequence(p)
	p.total_samples += 1

	for v_idx in 0..<6 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_ac_amp_stage != .Release && voice.adsr_ac_amp_stage != .Idle {
				voice.adsr_ac_amp_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_ac_pick_env_stage != .Release && voice.adsr_ac_pick_env_stage != .Idle {
				voice.adsr_ac_pick_env_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_ac_pluck_env_stage != .Release && voice.adsr_ac_pluck_env_stage != .Idle {
				voice.adsr_ac_pluck_env_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_ac_amp_out: f32 = 0.0
		node_ac_body_out: f32 = 0.0
		node_ac_mixer_out: f32 = 0.0
		node_ac_output_out: f32 = 0.0
		node_ac_pick_bp_out: f32 = 0.0
		node_ac_pick_env_out: f32 = 0.0
		node_ac_pick_noise_out: f32 = 0.0
		node_ac_pluck_env_out: f32 = 0.0
		node_ac_pluck_map_out: f32 = 0.0
		node_ac_string_out: f32 = 0.0
		node_ac_tone_out: f32 = 0.0

		// --- Oscillator Node ac_body (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 2;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (5.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_ac_body_phase[i] = math.mod(voice.osc_ac_body_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_ac_body_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += (2.0 / f32(math.PI)) * math.asin(math.sin(final_phase));
			}
			node_ac_body_out = (unison_out / f32(unison_count)) * (p.Body_amplitude);
		}

		// --- Noise Node ac_pick_noise ---
		node_ac_pick_noise_out = (next_float32(&voice.noise_ac_pick_noise_rng) * 2.0 - 1.0) * (p.Pick_Noise_amplitude);

		// --- ADSR Node ac_pluck_env ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_ac_pluck_env_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Pluck_Env_attack) > 0 do envelope = voice.adsr_ac_pluck_env_attack_start + (1.0 - voice.adsr_ac_pluck_env_attack_start) * (voice.age / math.max(f32(p.Pluck_Env_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_ac_pluck_env_release_level = envelope;
				if voice.age >= (p.Pluck_Env_attack) {
					voice.adsr_ac_pluck_env_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Pluck_Env_attack);
				if (p.Pluck_Env_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Pluck_Env_decay), 0.000001)) * (1.0 - (p.Pluck_Env_sustain)); else do envelope = (p.Pluck_Env_sustain);
				voice.adsr_ac_pluck_env_release_level = envelope;
				if time_in_decay >= (p.Pluck_Env_decay) {
					voice.adsr_ac_pluck_env_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Pluck_Env_sustain);
				voice.adsr_ac_pluck_env_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Pluck_Env_release) > 0 do envelope = voice.adsr_ac_pluck_env_release_level * (1.0 - (time_in_release / math.max(f32(p.Pluck_Env_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_ac_pluck_env_stage = .Idle;
				}
			}
			vel_scale_ac_pluck_env: f32 = (1.0 - (f32(0.600000000))) + (f32(0.600000000)) * voice.velocity;
			node_ac_pluck_env_out = (1.0) * envelope * (p.Pluck_Env_depth) * vel_scale_ac_pluck_env;
		}

		// --- Oscillator Node ac_string (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 2;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (5.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_ac_string_phase[i] = math.mod(voice.osc_ac_string_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_ac_string_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += ((final_phase / f32(math.PI)) - 1.0);
			}
			node_ac_string_out = (unison_out / f32(unison_count)) * (p.String_amplitude);
		}

		// --- Filter Node ac_pick_bp (SVF) ---
		{
			cutoff_c_ac_pick_bp: f32 = math.clamp(f32(p.Pick_Click_cutoff), 10.0, sample_rate * 0.16);
			f_ac_pick_bp := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_ac_pick_bp / sample_rate));
			q_ac_pick_bp: f32 = math.clamp(1.0 / math.max(f32(p.Pick_Click_resonance), 0.1), 0.05, 1.9 - f_ac_pick_bp);
			voice.filter_ac_pick_bp_low += f_ac_pick_bp * voice.filter_ac_pick_bp_band;
			high_ac_pick_bp := f32(((node_ac_pick_noise_out)) - voice.filter_ac_pick_bp_low - q_ac_pick_bp * voice.filter_ac_pick_bp_band);
			voice.filter_ac_pick_bp_band += f_ac_pick_bp * high_ac_pick_bp;
			node_ac_pick_bp_out = voice.filter_ac_pick_bp_band;
		}

		// --- Mapper Node ac_pluck_map ---
		{
			in_range_ac_pluck_map: f32 = f32(f32(1.000000000)) - f32(f32(0.000000000));
			if in_range_ac_pluck_map == 0.0 do in_range_ac_pluck_map = 1.0;
			node_ac_pluck_map_out = math.lerp(f32(f32(0.000000000)), f32(p.outMax), math.clamp((f32((node_ac_pluck_env_out)) - f32(f32(0.000000000))) / in_range_ac_pluck_map, 0.0, 1.0));
		}

		// --- ADSR Node ac_pick_env ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_ac_pick_env_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Pick_Env_attack) > 0 do envelope = voice.adsr_ac_pick_env_attack_start + (1.0 - voice.adsr_ac_pick_env_attack_start) * (voice.age / math.max(f32(p.Pick_Env_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_ac_pick_env_release_level = envelope;
				if voice.age >= (p.Pick_Env_attack) {
					voice.adsr_ac_pick_env_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Pick_Env_attack);
				if (p.Pick_Env_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Pick_Env_decay), 0.000001)) * (1.0 - (p.Pick_Env_sustain)); else do envelope = (p.Pick_Env_sustain);
				voice.adsr_ac_pick_env_release_level = envelope;
				if time_in_decay >= (p.Pick_Env_decay) {
					voice.adsr_ac_pick_env_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Pick_Env_sustain);
				voice.adsr_ac_pick_env_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Pick_Env_release) > 0 do envelope = voice.adsr_ac_pick_env_release_level * (1.0 - (time_in_release / math.max(f32(p.Pick_Env_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_ac_pick_env_stage = .Idle;
				}
			}
			vel_scale_ac_pick_env: f32 = (1.0 - (f32(0.800000000))) + (f32(0.800000000)) * voice.velocity;
			node_ac_pick_env_out = ((node_ac_pick_bp_out)) * envelope * (p.Pick_Env_depth) * vel_scale_ac_pick_env;
		}

		// --- Filter Node ac_tone (SVF) ---
		{
			cutoff_c_ac_tone: f32 = math.clamp(f32((p.String_Tone_cutoff) + (node_ac_pluck_map_out)), 10.0, sample_rate * 0.16);
			f_ac_tone := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_ac_tone / sample_rate));
			q_ac_tone: f32 = math.clamp(1.0 / math.max(f32(p.String_Tone_resonance), 0.1), 0.05, 1.9 - f_ac_tone);
			voice.filter_ac_tone_low += f_ac_tone * voice.filter_ac_tone_band;
			high_ac_tone := f32(((node_ac_string_out)) - voice.filter_ac_tone_low - q_ac_tone * voice.filter_ac_tone_band);
			voice.filter_ac_tone_band += f_ac_tone * high_ac_tone;
			node_ac_tone_out = voice.filter_ac_tone_low;
		}

		// --- Mixer Node ac_mixer (3 inputs) ---
		{
			mix_sum_ac_mixer: f32 = 0.0;
			mix_sum_ac_mixer += node_ac_tone_out * (f32(0.750000000));
			mix_sum_ac_mixer += node_ac_body_out * (f32(0.400000006));
			mix_sum_ac_mixer += node_ac_pick_env_out * (f32(0.219999999));
		node_ac_mixer_out = mix_sum_ac_mixer;
		}

		// --- ADSR Node ac_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_ac_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Amp_attack) > 0 do envelope = voice.adsr_ac_amp_attack_start + (1.0 - voice.adsr_ac_amp_attack_start) * (voice.age / math.max(f32(p.Amp_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_ac_amp_release_level = envelope;
				if voice.age >= (p.Amp_attack) {
					voice.adsr_ac_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Amp_attack);
				if (p.Amp_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Amp_decay), 0.000001)) * (1.0 - (p.Amp_sustain)); else do envelope = (p.Amp_sustain);
				voice.adsr_ac_amp_release_level = envelope;
				if time_in_decay >= (p.Amp_decay) {
					voice.adsr_ac_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Amp_sustain);
				voice.adsr_ac_amp_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Amp_release) > 0 do envelope = voice.adsr_ac_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.Amp_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_ac_amp_stage = .Idle;
				}
			}
			vel_scale_ac_amp: f32 = (1.0 - (p.velocitySensitivity)) + (p.velocitySensitivity) * voice.velocity;
			node_ac_amp_out = ((node_ac_mixer_out)) * envelope * (p.Amp_depth) * vel_scale_ac_amp;
		}

		output_left += node_ac_amp_out
		output_right += node_ac_amp_out
		if voice.adsr_ac_amp_stage != .Idle do voice_busy = true
		if voice.adsr_ac_pick_env_stage != .Idle do voice_busy = true
		if voice.adsr_ac_pluck_env_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
Acoustic_Pluck_process_sequence :: proc(p: ^Acoustic_Pluck_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "Acoustic Pluck" (16 steps)
		switch p.current_step % 16 {
		case 0:
			Acoustic_Pluck_note_on(p, 43, 0.819999993, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 2:
			Acoustic_Pluck_note_on(p, 59, 0.600000024, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 4:
			Acoustic_Pluck_note_on(p, 50, 0.680000007, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 6:
			Acoustic_Pluck_note_on(p, 55, 0.620000005, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			Acoustic_Pluck_note_on(p, 40, 0.850000024, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 10:
			Acoustic_Pluck_note_on(p, 59, 0.579999983, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			Acoustic_Pluck_note_on(p, 47, 0.699999988, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 14:
			Acoustic_Pluck_note_on(p, 55, 0.639999986, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	Acoustic_Pluck: ^Acoustic_Pluck_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.779999971
	p.Acoustic_Pluck = new(Acoustic_Pluck_Processor)
	Acoustic_Pluck_init(p.Acoustic_Pluck, sr)
	Acoustic_Pluck_start(p.Acoustic_Pluck)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := Acoustic_Pluck_process(p.Acoustic_Pluck); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.Acoustic_Pluck)
}

