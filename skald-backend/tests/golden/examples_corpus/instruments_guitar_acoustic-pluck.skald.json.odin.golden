Acoustic_Pluck_set_param :: proc(p: ^Acoustic_Pluck_Processor, name: string, value: f32) -> bool {
	switch name {
	case "Amp_attack", "ac-amp::attack":
		Acoustic_Pluck_set_Amp_attack(p, value)
		return true
	case "Amp_decay", "ac-amp::decay":
		Acoustic_Pluck_set_Amp_decay(p, value)
		return true
	case "Amp_depth", "ac-amp::depth":
		Acoustic_Pluck_set_Amp_depth(p, value)
		return true
	case "Amp_release", "ac-amp::release":
		Acoustic_Pluck_set_Amp_release(p, value)
		return true
	case "Amp_sustain", "ac-amp::sustain":
		Acoustic_Pluck_set_Amp_sustain(p, value)
		return true
	case "Body_amplitude", "ac-body::amplitude":
		Acoustic_Pluck_set_Body_amplitude(p, value)
		return true
	case "Pick_Click_cutoff", "ac-pick-bp::cutoff":
		Acoustic_Pluck_set_Pick_Click_cutoff(p, value)
		return true
	case "Pick_Click_resonance", "ac-pick-bp::resonance":
		Acoustic_Pluck_set_Pick_Click_resonance(p, value)
		return true
	case "Pick_Env_attack", "ac-pick-env::attack":
		Acoustic_Pluck_set_Pick_Env_attack(p, value)
		return true
	case "Pick_Env_decay", "ac-pick-env::decay":
		Acoustic_Pluck_set_Pick_Env_decay(p, value)
		return true
	case "Pick_Env_depth", "ac-pick-env::depth":
		Acoustic_Pluck_set_Pick_Env_depth(p, value)
		return true
	case "Pick_Env_release", "ac-pick-env::release":
		Acoustic_Pluck_set_Pick_Env_release(p, value)
		return true
	case "Pick_Env_sustain", "ac-pick-env::sustain":
		Acoustic_Pluck_set_Pick_Env_sustain(p, value)
		return true
	case "Pick_Noise_amplitude", "ac-pick-noise::amplitude":
		Acoustic_Pluck_set_Pick_Noise_amplitude(p, value)
		return true
	case "Pluck_Env_attack", "ac-pluck-env::attack":
		Acoustic_Pluck_set_Pluck_Env_attack(p, value)
		return true
	case "Pluck_Env_decay", "ac-pluck-env::decay":
		Acoustic_Pluck_set_Pluck_Env_decay(p, value)
		return true
	case "Pluck_Env_depth", "ac-pluck-env::depth":
		Acoustic_Pluck_set_Pluck_Env_depth(p, value)
		return true
	case "Pluck_Env_release", "ac-pluck-env::release":
		Acoustic_Pluck_set_Pluck_Env_release(p, value)
		return true
	case "Pluck_Env_sustain", "ac-pluck-env::sustain":
		Acoustic_Pluck_set_Pluck_Env_sustain(p, value)
		return true
	case "String_Tone_cutoff", "ac-tone::cutoff":
		Acoustic_Pluck_set_String_Tone_cutoff(p, value)
		return true
	case "String_Tone_resonance", "ac-tone::resonance":
		Acoustic_Pluck_set_String_Tone_resonance(p, value)
		return true
	case "String_amplitude", "ac-string::amplitude":
		Acoustic_Pluck_set_String_amplitude(p, value)
		return true
	case "outMax", "ac-pluck-map::outMax":
		Acoustic_Pluck_set_outMax(p, value)
		return true
	case "velocitySensitivity", "ac-amp::velocitySensitivity":
		Acoustic_Pluck_set_velocitySensitivity(p, value)
		return true
	}
	return false
}

