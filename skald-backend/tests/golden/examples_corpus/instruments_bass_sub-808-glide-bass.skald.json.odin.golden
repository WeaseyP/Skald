n808_Glide_Sub_process :: proc(p: ^n808_Glide_Sub_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	n808_Glide_Sub_process_sequence(p)
	p.total_samples += 1

	for v_idx in 0..<1 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.current_freq != voice.target_freq {
			glide_k := 1.0 / math.max(voice.glide_time * sample_rate, 1.0)
			if glide_k > 1.0 do glide_k = 1.0
			voice.current_freq += (voice.target_freq - voice.current_freq) * glide_k
			if abs(voice.target_freq - voice.current_freq) < 0.1 do voice.current_freq = voice.target_freq
		}
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_sub_amp_stage != .Release && voice.adsr_sub_amp_stage != .Idle {
				voice.adsr_sub_amp_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_sub_amp_out: f32 = 0.0
		node_sub_filter_out: f32 = 0.0
		node_sub_osc_out: f32 = 0.0
		node_sub_output_out: f32 = 0.0
		node_sub_sat_out: f32 = 0.0

		// --- Oscillator Node sub_osc (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_sub_osc_phase[i] = math.mod(voice.osc_sub_osc_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_sub_osc_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += math.sin(final_phase);
			}
			node_sub_osc_out = (unison_out / f32(unison_count)) * (p.amplitude);
		}

		// --- Filter Node sub_filter (SVF) ---
		{
			cutoff_c_sub_filter: f32 = math.clamp(f32(p.cutoff), 10.0, sample_rate * 0.16);
			f_sub_filter := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_sub_filter / sample_rate));
			q_sub_filter: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_sub_filter);
			voice.filter_sub_filter_low += f_sub_filter * voice.filter_sub_filter_band;
			high_sub_filter := f32(((node_sub_osc_out)) - voice.filter_sub_filter_low - q_sub_filter * voice.filter_sub_filter_band);
			voice.filter_sub_filter_band += f_sub_filter * high_sub_filter;
			node_sub_filter_out = voice.filter_sub_filter_low;
		}

		// --- ADSR Node sub_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_sub_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.attack) > 0 do envelope = voice.adsr_sub_amp_attack_start + (1.0 - voice.adsr_sub_amp_attack_start) * (voice.age / math.max(f32(p.attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_sub_amp_release_level = envelope;
				if voice.age >= (p.attack) {
					voice.adsr_sub_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.attack);
				if (p.decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.decay), 0.000001)) * (1.0 - (p.sustain)); else do envelope = (p.sustain);
				voice.adsr_sub_amp_release_level = envelope;
				if time_in_decay >= (p.decay) {
					voice.adsr_sub_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.sustain);
				voice.adsr_sub_amp_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_sub_amp_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.release) > 0 do envelope = voice.adsr_sub_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_sub_amp_stage = .Idle;
				}
			}
			vel_scale_sub_amp: f32 = (1.0 - (p.velocitySensitivity)) + (p.velocitySensitivity) * voice.velocity;
			node_sub_amp_out = ((node_sub_filter_out)) * envelope * (p.depth) * vel_scale_sub_amp;
		}

		// --- Distortion Node sub_sat (soft) ---
		{
			dist_in_sub_sat: f32 = ((node_sub_amp_out));
			dist_k_sub_sat: f32 = math.max(f32(p.drive), 1.0);
			dist_wet_sub_sat: f32 = math.tanh(dist_in_sub_sat * dist_k_sub_sat);
			tone_k_sub_sat: f32 = math.clamp(2.0 * f32(math.PI) * math.clamp(f32(p.tone), 100.0, 20000.0) / sample_rate, 0.001, 1.0);
			voice.dist_sub_sat_tone += tone_k_sub_sat * (dist_wet_sub_sat - voice.dist_sub_sat_tone);
			mix_sub_sat: f32 = math.clamp(f32(p.mix), 0.0, 1.0);
			node_sub_sat_out = dist_in_sub_sat * (1.0 - mix_sub_sat) + voice.dist_sub_sat_tone * mix_sub_sat;
		}

		output_left += node_sub_sat_out
		output_right += node_sub_sat_out
		if voice.adsr_sub_amp_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
n808_Glide_Sub_process_sequence :: proc(p: ^n808_Glide_Sub_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "808 Glide Sub" (16 steps)
		switch p.current_step % 16 {
		case 0:
			n808_Glide_Sub_note_on(p, 24, 0.949999988, f32(6.000000000) * (60.0 / p.bpm / 4.0))
		case 6:
			n808_Glide_Sub_note_on(p, 31, 0.699999988, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			n808_Glide_Sub_note_on(p, 24, 0.920000017, f32(4.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			n808_Glide_Sub_note_on(p, 29, 0.779999971, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 14:
			n808_Glide_Sub_note_on(p, 36, 0.720000029, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	n808_Glide_Sub: ^n808_Glide_Sub_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.750000000
	p.n808_Glide_Sub = new(n808_Glide_Sub_Processor)
	n808_Glide_Sub_init(p.n808_Glide_Sub, sr)
	n808_Glide_Sub_start(p.n808_Glide_Sub)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := n808_Glide_Sub_process(p.n808_Glide_Sub); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.n808_Glide_Sub)
}

