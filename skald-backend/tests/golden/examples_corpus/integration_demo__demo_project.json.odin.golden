Layer_process :: proc(p: ^Layer_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	Layer_process_sequence(p)
	p.total_samples += 1

	for v_idx in 0..<8 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.current_freq != voice.target_freq {
			glide_k := 1.0 / math.max(voice.glide_time * sample_rate, 1.0)
			if glide_k > 1.0 do glide_k = 1.0
			voice.current_freq += (voice.target_freq - voice.current_freq) * glide_k
			if abs(voice.target_freq - voice.current_freq) < 0.1 do voice.current_freq = voice.target_freq
		}
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_11_stage != .Release && voice.adsr_11_stage != .Idle {
				voice.adsr_11_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_10_out: f32 = 0.0
		node_11_out: f32 = 0.0
		node_12_out: f32 = 0.0

		// --- Oscillator Node 10 (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (5.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_10_phase[i] = math.mod(voice.osc_10_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_10_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += math.sin(final_phase);
			}
			node_10_out = (unison_out / f32(unison_count)) * (f32(0.500000000));
		}

		// --- ADSR Node 11 ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_11_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.001000000)) > 0 do envelope = voice.adsr_11_attack_start + (1.0 - voice.adsr_11_attack_start) * (voice.age / math.max(f32(f32(0.001000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_11_release_level = envelope;
				if voice.age >= (f32(0.001000000)) {
					voice.adsr_11_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.001000000));
				if (f32(0.080000000)) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(f32(0.080000000)), 0.000001)) * (1.0 - (f32(0.000000000))); else do envelope = (f32(0.000000000));
				voice.adsr_11_release_level = envelope;
				if time_in_decay >= (f32(0.080000000)) {
					voice.adsr_11_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.000000000));
				voice.adsr_11_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_11_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.080000000)) > 0 do envelope = voice.adsr_11_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.080000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_11_stage = .Idle;
				}
			}
			vel_scale_11: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_11_out = ((node_10_out)) * envelope * (f32(1.000000000)) * vel_scale_11;
		}

		output_left += node_11_out
		output_right += node_11_out
		if voice.adsr_11_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
Layer_process_sequence :: proc(p: ^Layer_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "Layer" (16 steps)
		switch p.current_step % 16 {
		case 0:
			Layer_note_on(p, 36, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 4:
			Layer_note_on(p, 36, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			Layer_note_on(p, 36, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			Layer_note_on(p, 36, 1.000000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	Sfx: ^Sfx_Processor,
	Layer: ^Layer_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.800000012
	p.Sfx = new(Sfx_Processor)
	Sfx_init(p.Sfx, sr)
	p.Layer = new(Layer_Processor)
	Layer_init(p.Layer, sr)
	Layer_start(p.Layer)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := Sfx_process(p.Sfx); mixed_left += l; mixed_right += r }
	{ l, r := Layer_process(p.Layer); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.Sfx)
	free(p.Layer)
}

