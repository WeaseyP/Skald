package generated_audio

// =====================================================================
// Generated by Skald.
//
// SFX assets: Sfx
// Music Layer assets: Layer
//
// Game integration: import this package and use the per-asset APIs.
//   SFX:         <Foo>_init, <Foo>_trigger, <Foo>_process, <Foo>_is_playing
//   Music Layer: <Bar>_init, <Bar>_start, <Bar>_stop, <Bar>_process,
//                <Bar>_set_loop
//
// <Foo>_trigger with duration<=0 (the default) plays a natural one-shot:
// the envelope holds through attack+decay, then releases (a patch with no
// envelope plays 1s). Pass an explicit duration in seconds to hold longer,
// or drive <Foo>_note_on / <Foo>_note_off yourself for full control.
//
// <Foo>_note_on clamps `note` to 0..127 and `velocity` to 0..1 SILENTLY —
// it is called at audio rate, so an out-of-range argument cannot afford a
// diagnostic. Check your own values if you need to know they were wrong.
// <Foo>_note_off clamps `note` the same way, because `note` is the key it
// matches voices on: if only one side clamped, note_off(200) would fail to
// release the voice note_on(200) parked at 127, and that voice would never
// free.
//
// project_init/process/destroy is a convenience wrapper for the test
// harness only — game code should consume per-asset procs directly.
// =====================================================================

import "core:math"
import "core:math/rand"

PRNG_State :: struct {
	state: u32,
}

next_float32 :: proc(rng: ^PRNG_State) -> f32 {
	x := rng.state
	x ~= x << 13
	x ~= x >> 17
	x ~= x << 5
	if x == 0 do x = 0xDEADBEEF
	rng.state = x
	return f32(x) / 4294967296.0
}

ADSR_Stage :: enum { Idle, Attack, Decay, Sustain, Release }

skald_wavetable_shape :: proc(idx: int, ph: f32) -> f32 {
	switch idx {
	case 1: return abs(ph * 4.0 - 2.0) - 1.0
	case 2: return ph * 2.0 - 1.0
	case 3: return ph < 0.5 ? 1.0 : -1.0
	}
	return math.sin(ph * 2.0 * f32(math.PI))
}

skald_wavetable_sample :: proc(ph: f32, pos: f32) -> f32 {
	p := math.clamp(pos, 0.0, 3.0)
	i1 := int(p)
	i2 := (i1 + 1) % 4
	frac := p - f32(i1)
	s1 := skald_wavetable_shape(i1, ph)
	s2 := skald_wavetable_shape(i2, ph)
	return s1 + (s2 - s1) * frac
}

// Soft limiter with a ceiling that really is 1.0 — plain tanh, not
// tanh(x*k)/k, which topped out above 1 and still clipped the device.
// Transparent for small signals (tanh(x) ~= x below ~0.3), saturating
// smoothly instead of clipping as the mix gets hot.
skald_soft_limit :: proc(l: f32, r: f32) -> (f32, f32) {
	return math.tanh(l), math.tanh(r)
}

skald_feedback_tail_seconds :: proc(period: f32, gain: f32) -> f32 {
	if math.is_nan(period) || period <= 0.0 do return 0.0
	// 0.95 is the DSP's own feedback ceiling (see generate_delay_code /
	// generate_reverb_code), so no live value can ring longer than this.
	g := math.clamp(gain, 0.0, 0.95)
	if g <= 0.0 do return period
	passes := math.ceil(math.ln(f32(0.001)) / math.ln(g))
	result := period * passes
	if math.is_nan(result) || math.is_inf(result) || result < 0.0 do return period
	return result
}

Note_Event :: struct {
	note: u8,
	velocity: f32,
	start_time: f32,
	step: int,
	duration: f32,
}

Skald_Param_Info :: struct {
	name:    string,
	min:     f32,
	max:     f32,
	default: f32,
	unit:    string,
}

Sfx_Voice_State :: struct {
	active: bool,
	note: u8,
	velocity: f32,
	age: f32,
	time_released: f32,
	current_freq: f32,
	target_freq: f32,
	glide_time: f32,
	duration: f32,
	osc_1_phase: [1]f32,
	filter_2_low: f32,
	filter_2_band: f32,
	adsr_3_stage: ADSR_Stage,
	adsr_3_release_level: f32,
	adsr_3_attack_start: f32,
}

Sfx_Processor :: struct {
	sample_rate: f32,
	bpm: f32,
	voices: [8]Sfx_Voice_State,
	prng: PRNG_State,
	total_samples: u64,
	playing: bool,
	loop: bool,
	current_step: u64,
	samples_until_next_step: u64,
	step_frac_acc: f32,
	ext_in_l: f32,
	ext_in_r: f32,
	volume: f32,
	cutoff: f32,
}

Sfx_init :: proc(p: ^Sfx_Processor, sr: f32) {
	p.sample_rate = sr
	p.bpm = 120.000000000
	p.volume = 1.000000000
	p.prng.state = 12345
	p.loop = true
	p.voices = {}
	p.total_samples = 0
	p.playing = false
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
	p.ext_in_l = 0.0
	p.ext_in_r = 0.0
	p.cutoff = 800.000000000
}

Sfx_note_on :: proc(p: ^Sfx_Processor, note: u8, velocity: f32, duration: f32) {
	// note and velocity are clamped silently to their MIDI/normalized domains.
	note := note
	if note > 127 do note = 127
	velocity := math.clamp(velocity, 0.0, 1.0)
	voice_idx := -1
	for i in 0..<8 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_age: f32 = -1.0
		for i in 0..<8 {
			if p.voices[i].age > oldest_age {
				oldest_age = p.voices[i].age
				voice_idx = i
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	adsr_3_prev_level: f32 = 0.0
	if stolen && v.adsr_3_stage != .Idle {
		adsr_3_prev_level = v.adsr_3_release_level
		if v.adsr_3_stage == .Release {
			rel_t_3: f32 = (f32(0.200000000));
			if rel_t_3 > 0.0 {
				rf_3 := 1.0 - (v.age - v.time_released) / math.max(rel_t_3, 0.000001)
				if rf_3 < 0.0 do rf_3 = 0.0
				adsr_3_prev_level *= rf_3
			} else {
				adsr_3_prev_level = 0.0
			}
		}
	}
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.050000001
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	v.adsr_3_stage = .Attack
	v.adsr_3_attack_start = adsr_3_prev_level
	v.adsr_3_release_level = adsr_3_prev_level
	if !stolen {
		v.osc_1_phase = {}
		v.filter_2_low = 0.0
		v.filter_2_band = 0.0
	}
}

Sfx_note_off :: proc(p: ^Sfx_Processor, note: u8) {
	// Clamped to match _note_on: `note` is the voice key, so both must map it.
	note := note
	if note > 127 do note = 127
	best := -1
	best_age: f32 = -1.0
	for i in 0..<8 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_3_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_3_stage = .Release
	}
}

Sfx_trigger :: proc(p: ^Sfx_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (f32(0.010000000)) + (f32(0.000000000)) > d do d = (f32(0.010000000)) + (f32(0.000000000))
		if d <= 0.0 do d = 0.001
	}
	Sfx_note_on(p, note, velocity, d)
}

Sfx_feed_input :: proc(p: ^Sfx_Processor, in_left: f32, in_right: f32) {
	p.ext_in_l = in_left
	p.ext_in_r = in_right
}

Sfx_start :: proc(p: ^Sfx_Processor) {
	p.playing = true
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
}

Sfx_stop :: proc(p: ^Sfx_Processor) {
	p.playing = false
}

Sfx_set_loop :: proc(p: ^Sfx_Processor, loop: bool) {
	p.loop = loop
}

Sfx_set_volume :: proc(p: ^Sfx_Processor, value: f32) {
	p.volume = math.clamp(value, 0.0, 1.0)
}

Sfx_is_playing :: proc(p: ^Sfx_Processor) -> bool {
	if p.playing do return true
	for i in 0..<8 {
		if p.voices[i].active do return true
	}
	return false
}

Sfx_set_cutoff :: proc(p: ^Sfx_Processor, value: f32) {
	v := value
	if v < 20.000000000 do v = 20.000000000
	if v > 20000.000000000 do v = 20000.000000000
	p.cutoff = v
}

Sfx_PARAMS := []Skald_Param_Info{
	{"cutoff", 20.000000000, 20000.000000000, 800.000000000, "Hz"},
}

Sfx_set_param :: proc(p: ^Sfx_Processor, name: string, value: f32) -> bool {
	switch name {
	case "cutoff", "2::cutoff":
		Sfx_set_cutoff(p, value)
		return true
	}
	return false
}

Sfx_get_param :: proc(p: ^Sfx_Processor, name: string) -> (f32, bool) {
	switch name {
	case "cutoff", "2::cutoff":
		return p.cutoff, true
	}
	return 0.0, false
}

Sfx_process :: proc(p: ^Sfx_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	p.total_samples += 1

	for v_idx in 0..<8 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.current_freq != voice.target_freq {
			glide_k := 1.0 / math.max(voice.glide_time * sample_rate, 1.0)
			if glide_k > 1.0 do glide_k = 1.0
			voice.current_freq += (voice.target_freq - voice.current_freq) * glide_k
			if abs(voice.target_freq - voice.current_freq) < 0.1 do voice.current_freq = voice.target_freq
		}
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_3_stage != .Release && voice.adsr_3_stage != .Idle {
				voice.adsr_3_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_1_out: f32 = 0.0
		node_2_out: f32 = 0.0
		node_3_out: f32 = 0.0
		node_4_out: f32 = 0.0

		// --- Oscillator Node 1 (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (5.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_1_phase[i] = math.mod(voice.osc_1_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_1_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += ((final_phase / f32(math.PI)) - 1.0);
			}
			node_1_out = (unison_out / f32(unison_count)) * (f32(0.500000000));
		}

		// --- Filter Node 2 (SVF) ---
		{
			cutoff_c_2: f32 = math.clamp(f32(p.cutoff), 10.0, sample_rate * 0.16);
			f_2 := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_2 / sample_rate));
			q_2: f32 = math.clamp(1.0 / math.max(f32(f32(1.000000000)), 0.1), 0.05, 1.9 - f_2);
			voice.filter_2_low += f_2 * voice.filter_2_band;
			high_2 := f32(((node_1_out)) - voice.filter_2_low - q_2 * voice.filter_2_band);
			voice.filter_2_band += f_2 * high_2;
			node_2_out = voice.filter_2_low;
		}

		// --- ADSR Node 3 ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_3_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.010000000)) > 0 do envelope = voice.adsr_3_attack_start + (1.0 - voice.adsr_3_attack_start) * (voice.age / math.max(f32(f32(0.010000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_3_release_level = envelope;
				if voice.age >= (f32(0.010000000)) {
					voice.adsr_3_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.010000000));
				if (f32(0.000000000)) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(f32(0.000000000)), 0.000001)) * (1.0 - (f32(1.000000000))); else do envelope = (f32(1.000000000));
				voice.adsr_3_release_level = envelope;
				if time_in_decay >= (f32(0.000000000)) {
					voice.adsr_3_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(1.000000000));
				voice.adsr_3_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_3_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.200000000)) > 0 do envelope = voice.adsr_3_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.200000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_3_stage = .Idle;
				}
			}
			vel_scale_3: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_3_out = ((node_2_out)) * envelope * (f32(1.000000000)) * vel_scale_3;
		}

		output_left += node_3_out
		output_right += node_3_out
		if voice.adsr_3_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
Sfx_process_sequence :: proc(p: ^Sfx_Processor) {
}

