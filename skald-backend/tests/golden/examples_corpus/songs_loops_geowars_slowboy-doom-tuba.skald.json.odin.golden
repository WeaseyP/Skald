		GW_Slowboy_Doom_Tuba_set_Amp_attack(p, value)
		return true
	case "Blat_attack", "doom-filter-env::attack":
		GW_Slowboy_Doom_Tuba_set_Blat_attack(p, value)
		return true
	case "Doom_Reed_amplitude", "doom-osc::amplitude":
		GW_Slowboy_Doom_Tuba_set_Doom_Reed_amplitude(p, value)
		return true
	case "Vibrato_amplitude", "doom-vibrato::amplitude":
		GW_Slowboy_Doom_Tuba_set_Vibrato_amplitude(p, value)
		return true
	case "Vibrato_frequency", "doom-vibrato::frequency":
		GW_Slowboy_Doom_Tuba_set_Vibrato_frequency(p, value)
		return true
	case "Windup_Shake_amplitude", "doom-shake::amplitude":
		GW_Slowboy_Doom_Tuba_set_Windup_Shake_amplitude(p, value)
		return true
	case "Windup_Shake_frequency", "doom-shake::frequency":
		GW_Slowboy_Doom_Tuba_set_Windup_Shake_frequency(p, value)
		return true
	case "cutoff", "doom-body::cutoff":
		GW_Slowboy_Doom_Tuba_set_cutoff(p, value)
		return true
	case "decay", "doom-filter-env::decay":
		GW_Slowboy_Doom_Tuba_set_decay(p, value)
		return true
	case "drive", "doom-drive::drive":
		GW_Slowboy_Doom_Tuba_set_drive(p, value)
		return true
	case "mix", "doom-drive::mix":
		GW_Slowboy_Doom_Tuba_set_mix(p, value)
		return true
	case "outMax", "doom-filter-map::outMax":
		GW_Slowboy_Doom_Tuba_set_outMax(p, value)
		return true
	case "release", "doom-amp::release":
		GW_Slowboy_Doom_Tuba_set_release(p, value)
		return true
	case "resonance", "doom-body::resonance":
		GW_Slowboy_Doom_Tuba_set_resonance(p, value)
		return true
	}
	return false
}

GW_Slowboy_Doom_Tuba_get_param :: proc(p: ^GW_Slowboy_Doom_Tuba_Processor, name: string) -> (f32, bool) {
	switch name {
	case "Amp_attack", "doom-amp::attack":
		return p.Amp_attack, true
	case "Blat_attack", "doom-filter-env::attack":
		return p.Blat_attack, true
	case "Doom_Reed_amplitude", "doom-osc::amplitude":
		return p.Doom_Reed_amplitude, true
	case "Vibrato_amplitude", "doom-vibrato::amplitude":
		return p.Vibrato_amplitude, true
	case "Vibrato_frequency", "doom-vibrato::frequency":
		return p.Vibrato_frequency, true
	case "Windup_Shake_amplitude", "doom-shake::amplitude":
		return p.Windup_Shake_amplitude, true
	case "Windup_Shake_frequency", "doom-shake::frequency":
		return p.Windup_Shake_frequency, true
	case "cutoff", "doom-body::cutoff":
		return p.cutoff, true
	case "decay", "doom-filter-env::decay":
		return p.decay, true
	case "drive", "doom-drive::drive":
		return p.drive, true
	case "mix", "doom-drive::mix":
		return p.mix, true
	case "outMax", "doom-filter-map::outMax":
		return p.outMax, true
	case "release", "doom-amp::release":
		return p.release, true
	case "resonance", "doom-body::resonance":
		return p.resonance, true
	}
	return 0.0, false
}

GW_Slowboy_Doom_Tuba_process :: proc(p: ^GW_Slowboy_Doom_Tuba_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	GW_Slowboy_Doom_Tuba_process_sequence(p)
	p.total_samples += 1

	for v_idx in 0..<3 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.current_freq != voice.target_freq {
			glide_k := 1.0 / math.max(voice.glide_time * sample_rate, 1.0)
			if glide_k > 1.0 do glide_k = 1.0
			voice.current_freq += (voice.target_freq - voice.current_freq) * glide_k
			if abs(voice.target_freq - voice.current_freq) < 0.1 do voice.current_freq = voice.target_freq
		}
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_doom_amp_stage != .Release && voice.adsr_doom_amp_stage != .Idle {
				voice.adsr_doom_amp_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_doom_filter_env_stage != .Release && voice.adsr_doom_filter_env_stage != .Idle {
				voice.adsr_doom_filter_env_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_doom_amp_out: f32 = 0.0
		node_doom_body_out: f32 = 0.0
		node_doom_drive_out: f32 = 0.0
		node_doom_filter_env_out: f32 = 0.0
		node_doom_filter_map_out: f32 = 0.0
		node_doom_osc_out: f32 = 0.0
		node_doom_output_out: f32 = 0.0
		node_doom_shake_out: f32 = 0.0
		node_doom_vibrato_out: f32 = 0.0

		// --- ADSR Node doom_filter_env ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_doom_filter_env_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Blat_attack) > 0 do envelope = voice.adsr_doom_filter_env_attack_start + (1.0 - voice.adsr_doom_filter_env_attack_start) * (voice.age / math.max(f32(p.Blat_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_doom_filter_env_release_level = envelope;
				if voice.age >= (p.Blat_attack) {
					voice.adsr_doom_filter_env_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Blat_attack);
				if (p.decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.decay), 0.000001)) * (1.0 - (f32(0.300000000))); else do envelope = (f32(0.300000000));
				voice.adsr_doom_filter_env_release_level = envelope;
				if time_in_decay >= (p.decay) {
					voice.adsr_doom_filter_env_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.300000000));
				voice.adsr_doom_filter_env_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.200000000)) > 0 do envelope = voice.adsr_doom_filter_env_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.200000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_doom_filter_env_stage = .Idle;
				}
			}
			vel_scale_doom_filter_env: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_doom_filter_env_out = (1.0) * envelope * (f32(1.000000000)) * vel_scale_doom_filter_env;
		}

		// --- LFO Node doom_shake ---
		voice.lfo_doom_shake_phase = math.mod(voice.lfo_doom_shake_phase + (2 * f32(math.PI) * (p.Windup_Shake_frequency) / sample_rate), 2 * f32(math.PI));
		if voice.lfo_doom_shake_phase < 0.0 do voice.lfo_doom_shake_phase += 2 * f32(math.PI);
		node_doom_shake_out = math.sin(voice.lfo_doom_shake_phase) * (p.Windup_Shake_amplitude);

		// --- LFO Node doom_vibrato ---
		voice.lfo_doom_vibrato_phase = math.mod(voice.lfo_doom_vibrato_phase + (2 * f32(math.PI) * (p.Vibrato_frequency) / sample_rate), 2 * f32(math.PI));
		if voice.lfo_doom_vibrato_phase < 0.0 do voice.lfo_doom_vibrato_phase += 2 * f32(math.PI);
		node_doom_vibrato_out = math.sin(voice.lfo_doom_vibrato_phase) * (p.Vibrato_amplitude);

		// --- Mapper Node doom_filter_map ---
		{
			in_range_doom_filter_map: f32 = f32(f32(1.000000000)) - f32(f32(0.000000000));
			if in_range_doom_filter_map == 0.0 do in_range_doom_filter_map = 1.0;
			node_doom_filter_map_out = math.lerp(f32(f32(0.000000000)), f32(p.outMax), math.clamp((f32((node_doom_filter_env_out)) - f32(f32(0.000000000))) / in_range_doom_filter_map, 0.0, 1.0));
		}

		// --- Oscillator Node doom_osc (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = ((voice.current_freq) * math.pow(2.0, math.clamp(f32(node_doom_vibrato_out), -10.0, 10.0))) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_doom_osc_phase[i] = math.mod(voice.osc_doom_osc_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_doom_osc_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += ((final_phase / f32(math.PI)) - 1.0);
			}
			node_doom_osc_out = (unison_out / f32(unison_count)) * ((p.Doom_Reed_amplitude) + (node_doom_shake_out));
		}

		// --- Filter Node doom_body (SVF) ---
		{
			cutoff_c_doom_body: f32 = math.clamp(f32((p.cutoff) + (node_doom_filter_map_out)), 10.0, sample_rate * 0.16);
			f_doom_body := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_doom_body / sample_rate));
			q_doom_body: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_doom_body);
			voice.filter_doom_body_low += f_doom_body * voice.filter_doom_body_band;
			high_doom_body := f32(((node_doom_osc_out)) - voice.filter_doom_body_low - q_doom_body * voice.filter_doom_body_band);
			voice.filter_doom_body_band += f_doom_body * high_doom_body;
			node_doom_body_out = voice.filter_doom_body_low;
		}

		// --- ADSR Node doom_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_doom_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Amp_attack) > 0 do envelope = voice.adsr_doom_amp_attack_start + (1.0 - voice.adsr_doom_amp_attack_start) * (voice.age / math.max(f32(p.Amp_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_doom_amp_release_level = envelope;
				if voice.age >= (p.Amp_attack) {
					voice.adsr_doom_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Amp_attack);
				if (f32(0.100000000)) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(f32(0.100000000)), 0.000001)) * (1.0 - (f32(0.850000000))); else do envelope = (f32(0.850000000));
				voice.adsr_doom_amp_release_level = envelope;
				if time_in_decay >= (f32(0.100000000)) {
					voice.adsr_doom_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.850000000));
				voice.adsr_doom_amp_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.release) > 0 do envelope = voice.adsr_doom_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_doom_amp_stage = .Idle;
				}
			}
			vel_scale_doom_amp: f32 = (1.0 - (f32(0.700000000))) + (f32(0.700000000)) * voice.velocity;
			node_doom_amp_out = ((node_doom_body_out)) * envelope * (f32(1.000000000)) * vel_scale_doom_amp;
		}

		// --- Distortion Node doom_drive (soft) ---
		{
			dist_in_doom_drive: f32 = ((node_doom_amp_out));
			dist_k_doom_drive: f32 = math.max(f32(p.drive), 1.0);
			dist_wet_doom_drive: f32 = math.tanh(dist_in_doom_drive * dist_k_doom_drive);
			tone_k_doom_drive: f32 = math.clamp(2.0 * f32(math.PI) * math.clamp(f32(f32(2800.000000000)), 100.0, 20000.0) / sample_rate, 0.001, 1.0);
			voice.dist_doom_drive_tone += tone_k_doom_drive * (dist_wet_doom_drive - voice.dist_doom_drive_tone);
			mix_doom_drive: f32 = math.clamp(f32(p.mix), 0.0, 1.0);
			node_doom_drive_out = dist_in_doom_drive * (1.0 - mix_doom_drive) + voice.dist_doom_drive_tone * mix_doom_drive;
		}

		output_left += node_doom_drive_out
		output_right += node_doom_drive_out
		if voice.adsr_doom_amp_stage != .Idle do voice_busy = true
		if voice.adsr_doom_filter_env_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	if math.is_nan(output_left) || math.is_inf(output_left) || math.is_nan(output_right) || math.is_inf(output_right) {
		p.nonfinite_count += 1
		output_left, output_right = 0.0, 0.0
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
GW_Slowboy_Doom_Tuba_process_sequence :: proc(p: ^GW_Slowboy_Doom_Tuba_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "GW Slowboy Doom Tuba" (16 steps)
		switch p.current_step % 16 {
		case 0:
			GW_Slowboy_Doom_Tuba_note_on(p, 38, 0.949999988, f32(6.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			GW_Slowboy_Doom_Tuba_note_on(p, 33, 0.899999976, f32(5.000000000) * (60.0 / p.bpm / 4.0))
		case 14:
			GW_Slowboy_Doom_Tuba_note_on(p, 36, 0.699999988, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	GW_Slowboy_Doom_Tuba: ^GW_Slowboy_Doom_Tuba_Processor,
	master_volume: f32,
	dc: Skald_Dc_Block_State,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.750000000
	p.dc = {}
	p.GW_Slowboy_Doom_Tuba = new(GW_Slowboy_Doom_Tuba_Processor)
	GW_Slowboy_Doom_Tuba_init(p.GW_Slowboy_Doom_Tuba, sr)
	GW_Slowboy_Doom_Tuba_start(p.GW_Slowboy_Doom_Tuba)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := GW_Slowboy_Doom_Tuba_process(p.GW_Slowboy_Doom_Tuba); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	mixed_left, mixed_right = skald_dc_block(&p.dc, mixed_left, mixed_right)
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.GW_Slowboy_Doom_Tuba)
}

