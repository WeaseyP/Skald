Palm_Muted_Bass_set_param :: proc(p: ^Palm_Muted_Bass_Processor, name: string, value: f32) -> bool {
	switch name {
	case "Amp_attack", "pm-amp::attack":
		Palm_Muted_Bass_set_Amp_attack(p, value)
		return true
	case "Amp_decay", "pm-amp::decay":
		Palm_Muted_Bass_set_Amp_decay(p, value)
		return true
	case "Amp_sustain", "pm-amp::sustain":
		Palm_Muted_Bass_set_Amp_sustain(p, value)
		return true
	case "Chug_amplitude", "pm-chug::amplitude":
		Palm_Muted_Bass_set_Chug_amplitude(p, value)
		return true
	case "Mute_Env_attack", "pm-filter-env::attack":
		Palm_Muted_Bass_set_Mute_Env_attack(p, value)
		return true
	case "Mute_Env_decay", "pm-filter-env::decay":
		Palm_Muted_Bass_set_Mute_Env_decay(p, value)
		return true
	case "Mute_Env_sustain", "pm-filter-env::sustain":
		Palm_Muted_Bass_set_Mute_Env_sustain(p, value)
		return true
	case "Sub_amplitude", "pm-sub::amplitude":
		Palm_Muted_Bass_set_Sub_amplitude(p, value)
		return true
	case "cutoff", "pm-filter::cutoff":
		Palm_Muted_Bass_set_cutoff(p, value)
		return true
	case "depth", "pm-amp::depth":
		Palm_Muted_Bass_set_depth(p, value)
		return true
	case "outMax", "pm-filter-map::outMax":
		Palm_Muted_Bass_set_outMax(p, value)
		return true
	case "release", "pm-amp::release":
		Palm_Muted_Bass_set_release(p, value)
		return true
	case "resonance", "pm-filter::resonance":
		Palm_Muted_Bass_set_resonance(p, value)
		return true
	case "velocitySensitivity", "pm-amp::velocitySensitivity":
		Palm_Muted_Bass_set_velocitySensitivity(p, value)
		return true
	}
	return false
}

Palm_Muted_Bass_get_param :: proc(p: ^Palm_Muted_Bass_Processor, name: string) -> (f32, bool) {
	switch name {
	case "Amp_attack", "pm-amp::attack":
		return p.Amp_attack, true
	case "Amp_decay", "pm-amp::decay":
		return p.Amp_decay, true
	case "Amp_sustain", "pm-amp::sustain":
		return p.Amp_sustain, true
	case "Chug_amplitude", "pm-chug::amplitude":
		return p.Chug_amplitude, true
	case "Mute_Env_attack", "pm-filter-env::attack":
		return p.Mute_Env_attack, true
	case "Mute_Env_decay", "pm-filter-env::decay":
		return p.Mute_Env_decay, true
	case "Mute_Env_sustain", "pm-filter-env::sustain":
		return p.Mute_Env_sustain, true
	case "Sub_amplitude", "pm-sub::amplitude":
		return p.Sub_amplitude, true
	case "cutoff", "pm-filter::cutoff":
		return p.cutoff, true
	case "depth", "pm-amp::depth":
		return p.depth, true
	case "outMax", "pm-filter-map::outMax":
		return p.outMax, true
	case "release", "pm-amp::release":
		return p.release, true
	case "resonance", "pm-filter::resonance":
		return p.resonance, true
	case "velocitySensitivity", "pm-amp::velocitySensitivity":
		return p.velocitySensitivity, true
	}
	return 0.0, false
}

Palm_Muted_Bass_process :: proc(p: ^Palm_Muted_Bass_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	Palm_Muted_Bass_process_sequence(p)
	p.total_samples += 1

	for v_idx in 0..<6 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_pm_amp_stage != .Release && voice.adsr_pm_amp_stage != .Idle {
				voice.adsr_pm_amp_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_pm_filter_env_stage != .Release && voice.adsr_pm_filter_env_stage != .Idle {
				voice.adsr_pm_filter_env_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_pm_amp_out: f32 = 0.0
		node_pm_chug_out: f32 = 0.0
		node_pm_filter_out: f32 = 0.0
		node_pm_filter_env_out: f32 = 0.0
		node_pm_filter_map_out: f32 = 0.0
		node_pm_mixer_out: f32 = 0.0
		node_pm_output_out: f32 = 0.0
		node_pm_sub_out: f32 = 0.0

		// --- Oscillator Node pm_chug (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_pm_chug_phase[i] = math.mod(voice.osc_pm_chug_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_pm_chug_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += ((final_phase / f32(math.PI)) - 1.0);
			}
			node_pm_chug_out = (unison_out / f32(unison_count)) * (p.Chug_amplitude);
		}

		// --- ADSR Node pm_filter_env ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_pm_filter_env_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Mute_Env_attack) > 0 do envelope = voice.adsr_pm_filter_env_attack_start + (1.0 - voice.adsr_pm_filter_env_attack_start) * (voice.age / math.max(f32(p.Mute_Env_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_pm_filter_env_release_level = envelope;
				if voice.age >= (p.Mute_Env_attack) {
					voice.adsr_pm_filter_env_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Mute_Env_attack);
				if (p.Mute_Env_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Mute_Env_decay), 0.000001)) * (1.0 - (p.Mute_Env_sustain)); else do envelope = (p.Mute_Env_sustain);
				voice.adsr_pm_filter_env_release_level = envelope;
				if time_in_decay >= (p.Mute_Env_decay) {
					voice.adsr_pm_filter_env_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Mute_Env_sustain);
				voice.adsr_pm_filter_env_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.050000000)) > 0 do envelope = voice.adsr_pm_filter_env_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.050000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_pm_filter_env_stage = .Idle;
				}
			}
			vel_scale_pm_filter_env: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_pm_filter_env_out = (1.0) * envelope * (f32(1.000000000)) * vel_scale_pm_filter_env;
		}

		// --- Oscillator Node pm_sub (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_pm_sub_phase[i] = math.mod(voice.osc_pm_sub_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_pm_sub_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += math.sin(final_phase);
			}
			node_pm_sub_out = (unison_out / f32(unison_count)) * (p.Sub_amplitude);
		}

		// --- Mapper Node pm_filter_map ---
		{
			in_range_pm_filter_map: f32 = f32(f32(1.000000000)) - f32(f32(0.000000000));
			if in_range_pm_filter_map == 0.0 do in_range_pm_filter_map = 1.0;
			node_pm_filter_map_out = math.lerp(f32(f32(0.000000000)), f32(p.outMax), math.clamp((f32((node_pm_filter_env_out)) - f32(f32(0.000000000))) / in_range_pm_filter_map, 0.0, 1.0));
		}

		// --- Mixer Node pm_mixer (2 inputs) ---
		{
			mix_sum_pm_mixer: f32 = 0.0;
			mix_sum_pm_mixer += node_pm_chug_out * (f32(0.649999976));
			mix_sum_pm_mixer += node_pm_sub_out * (f32(0.600000024));
		node_pm_mixer_out = mix_sum_pm_mixer;
		}

		// --- Filter Node pm_filter (SVF) ---
		{
			cutoff_c_pm_filter: f32 = math.clamp(f32((p.cutoff) + (node_pm_filter_map_out)), 10.0, sample_rate * 0.16);
			f_pm_filter := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_pm_filter / sample_rate));
			q_pm_filter: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_pm_filter);
			voice.filter_pm_filter_low += f_pm_filter * voice.filter_pm_filter_band;
			high_pm_filter := f32(((node_pm_mixer_out)) - voice.filter_pm_filter_low - q_pm_filter * voice.filter_pm_filter_band);
			voice.filter_pm_filter_band += f_pm_filter * high_pm_filter;
			node_pm_filter_out = voice.filter_pm_filter_low;
		}

		// --- ADSR Node pm_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_pm_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Amp_attack) > 0 do envelope = voice.adsr_pm_amp_attack_start + (1.0 - voice.adsr_pm_amp_attack_start) * (voice.age / math.max(f32(p.Amp_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_pm_amp_release_level = envelope;
				if voice.age >= (p.Amp_attack) {
					voice.adsr_pm_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Amp_attack);
				if (p.Amp_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Amp_decay), 0.000001)) * (1.0 - (p.Amp_sustain)); else do envelope = (p.Amp_sustain);
				voice.adsr_pm_amp_release_level = envelope;
				if time_in_decay >= (p.Amp_decay) {
					voice.adsr_pm_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Amp_sustain);
				voice.adsr_pm_amp_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.release) > 0 do envelope = voice.adsr_pm_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_pm_amp_stage = .Idle;
				}
			}
			vel_scale_pm_amp: f32 = (1.0 - (p.velocitySensitivity)) + (p.velocitySensitivity) * voice.velocity;
			node_pm_amp_out = ((node_pm_filter_out)) * envelope * (p.depth) * vel_scale_pm_amp;
		}

		output_left += node_pm_amp_out
		output_right += node_pm_amp_out
		if voice.adsr_pm_amp_stage != .Idle do voice_busy = true
		if voice.adsr_pm_filter_env_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
Palm_Muted_Bass_process_sequence :: proc(p: ^Palm_Muted_Bass_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "Palm-Muted Bass" (16 steps)
		switch p.current_step % 16 {
		case 0:
			Palm_Muted_Bass_note_on(p, 28, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 2:
			Palm_Muted_Bass_note_on(p, 28, 0.819999993, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 4:
			Palm_Muted_Bass_note_on(p, 28, 0.879999995, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 5:
			Palm_Muted_Bass_note_on(p, 28, 0.680000007, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 6:
			Palm_Muted_Bass_note_on(p, 28, 0.839999974, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			Palm_Muted_Bass_note_on(p, 31, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 10:
			Palm_Muted_Bass_note_on(p, 31, 0.779999971, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			Palm_Muted_Bass_note_on(p, 38, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 14:
			Palm_Muted_Bass_note_on(p, 28, 0.850000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	Palm_Muted_Bass: ^Palm_Muted_Bass_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.800000012
	p.Palm_Muted_Bass = new(Palm_Muted_Bass_Processor)
	Palm_Muted_Bass_init(p.Palm_Muted_Bass, sr)
	Palm_Muted_Bass_start(p.Palm_Muted_Bass)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := Palm_Muted_Bass_process(p.Palm_Muted_Bass); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.Palm_Muted_Bass)
}

