Growly_Sax_note_on :: proc(p: ^Growly_Sax_Processor, note: u8, velocity: f32, duration: f32) {
	// note and velocity are clamped silently to their MIDI/normalized domains.
	note := note
	if note > 127 do note = 127
	velocity := math.clamp(velocity, 0.0, 1.0)
	voice_idx := -1
	for i in 0..<4 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_releasing_age: f32 = -1.0
		for i in 0..<4 {
			releasing := true
			if p.voices[i].adsr_growl_amp_stage != .Release && p.voices[i].adsr_growl_amp_stage != .Idle do releasing = false
			if p.voices[i].adsr_growl_puff_stage != .Release && p.voices[i].adsr_growl_puff_stage != .Idle do releasing = false
			if p.voices[i].adsr_growl_scoop_stage != .Release && p.voices[i].adsr_growl_scoop_stage != .Idle do releasing = false
			if releasing && p.voices[i].age > oldest_releasing_age {
				oldest_releasing_age = p.voices[i].age
				voice_idx = i
			}
		}
		if voice_idx == -1 {
			oldest_age: f32 = -1.0
			for i in 0..<4 {
				if p.voices[i].age > oldest_age {
					oldest_age = p.voices[i].age
					voice_idx = i
				}
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	adsr_growl_amp_prev_level: f32 = 0.0
	if stolen && v.adsr_growl_amp_stage != .Idle {
		adsr_growl_amp_prev_level = v.adsr_growl_amp_release_level
		if v.adsr_growl_amp_stage == .Release {
			rel_t_growl_amp: f32 = (p.Amp_release);
			if rel_t_growl_amp > 0.0 {
				rf_growl_amp := 1.0 - (v.age - v.time_released) / math.max(rel_t_growl_amp, 0.000001)
				if rf_growl_amp < 0.0 do rf_growl_amp = 0.0
				adsr_growl_amp_prev_level *= rf_growl_amp
			} else {
				adsr_growl_amp_prev_level = 0.0
			}
		}
	}
	adsr_growl_puff_prev_level: f32 = 0.0
	if stolen && v.adsr_growl_puff_stage != .Idle {
		adsr_growl_puff_prev_level = v.adsr_growl_puff_release_level
		if v.adsr_growl_puff_stage == .Release {
			rel_t_growl_puff: f32 = (p.Puff_release);
			if rel_t_growl_puff > 0.0 {
				rf_growl_puff := 1.0 - (v.age - v.time_released) / math.max(rel_t_growl_puff, 0.000001)
				if rf_growl_puff < 0.0 do rf_growl_puff = 0.0
				adsr_growl_puff_prev_level *= rf_growl_puff
			} else {
				adsr_growl_puff_prev_level = 0.0
			}
		}
	}
	adsr_growl_scoop_prev_level: f32 = 0.0
	if stolen && v.adsr_growl_scoop_stage != .Idle {
		adsr_growl_scoop_prev_level = v.adsr_growl_scoop_release_level
		if v.adsr_growl_scoop_stage == .Release {
			rel_t_growl_scoop: f32 = (p.Scoop_release);
			if rel_t_growl_scoop > 0.0 {
				rf_growl_scoop := 1.0 - (v.age - v.time_released) / math.max(rel_t_growl_scoop, 0.000001)
				if rf_growl_scoop < 0.0 do rf_growl_scoop = 0.0
				adsr_growl_scoop_prev_level *= rf_growl_scoop
			} else {
				adsr_growl_scoop_prev_level = 0.0
			}
		}
	}
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.039999999
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	v.adsr_growl_amp_stage = .Attack
	v.adsr_growl_amp_attack_start = adsr_growl_amp_prev_level
	v.adsr_growl_amp_release_level = adsr_growl_amp_prev_level
	v.adsr_growl_puff_stage = .Attack
	v.adsr_growl_puff_attack_start = adsr_growl_puff_prev_level
	v.adsr_growl_puff_release_level = adsr_growl_puff_prev_level
	v.adsr_growl_scoop_stage = .Attack
	v.adsr_growl_scoop_attack_start = adsr_growl_scoop_prev_level
	v.adsr_growl_scoop_release_level = adsr_growl_scoop_prev_level
	if !stolen {
		v.filter_growl_air_low = 0.0
		v.filter_growl_air_band = 0.0
		v.filter_growl_body_low = 0.0
		v.filter_growl_body_band = 0.0
		v.dist_growl_drive_tone = 0.0
		v.filter_growl_formant_low = 0.0
		v.filter_growl_formant_band = 0.0
		v.osc_growl_reed_phase = {}
		v.lfo_growl_vibrato_phase = 0.0
	}
}

Growly_Sax_note_off :: proc(p: ^Growly_Sax_Processor, note: u8) {
	// Clamped to match _note_on: `note` is the voice key, so both must map it.
	note := note
	if note > 127 do note = 127
	best := -1
	best_age: f32 = -1.0
	for i in 0..<4 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_growl_amp_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_growl_amp_stage = .Release
		p.voices[best].adsr_growl_puff_stage = .Release
		p.voices[best].adsr_growl_scoop_stage = .Release
	}
}

Growly_Sax_trigger :: proc(p: ^Growly_Sax_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (p.Amp_attack) + (p.Amp_decay) > d do d = (p.Amp_attack) + (p.Amp_decay)
		if (p.Puff_attack) + (p.Puff_decay) > d do d = (p.Puff_attack) + (p.Puff_decay)
		if (p.Scoop_attack) + (f32(0.200000000)) > d do d = (p.Scoop_attack) + (f32(0.200000000))
		if d <= 0.0 do d = 0.001
	}
	Growly_Sax_note_on(p, note, velocity, d)
}

Growly_Sax_feed_input :: proc(p: ^Growly_Sax_Processor, in_left: f32, in_right: f32) {
	p.ext_in_l = in_left
	p.ext_in_r = in_right
}

Growly_Sax_start :: proc(p: ^Growly_Sax_Processor) {
	p.playing = true
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
}

Growly_Sax_stop :: proc(p: ^Growly_Sax_Processor) {
	p.playing = false
}

Growly_Sax_set_loop :: proc(p: ^Growly_Sax_Processor, loop: bool) {
	p.loop = loop
}

Growly_Sax_set_volume :: proc(p: ^Growly_Sax_Processor, value: f32) {
	p.volume = math.clamp(value, 0.0, 1.0)
}

Growly_Sax_is_playing :: proc(p: ^Growly_Sax_Processor) -> bool {
	if p.playing do return true
	for i in 0..<4 {
		if p.voices[i].active do return true
	}
	// The effect tail counts as playing: it is still audible after every
	// voice went inactive, and reporting false here is what let a game free
	// the asset mid-echo.
	if p.bus_tail_remaining > 0 do return true
	return false
}

Growly_Sax_set_Air_cutoff :: proc(p: ^Growly_Sax_Processor, value: f32) {
	v := value
	if v < 20.000000000 do v = 20.000000000
	if v > 20000.000000000 do v = 20000.000000000
	p.Air_cutoff = v
}

