package generated_audio

// =====================================================================
// Generated by Skald.
//
// SFX assets: (none)
// Music Layer assets: Wind
//
// Game integration: import this package and use the per-asset APIs.
//   SFX:         <Foo>_init, <Foo>_trigger, <Foo>_process, <Foo>_is_playing
//   Music Layer: <Bar>_init, <Bar>_start, <Bar>_stop, <Bar>_process,
//                <Bar>_set_loop
//
// <Foo>_trigger with duration<=0 (the default) plays a natural one-shot:
// the envelope holds through attack+decay, then releases (a patch with no
// envelope plays 1s). Pass an explicit duration in seconds to hold longer,
// or drive <Foo>_note_on / <Foo>_note_off yourself for full control.
//
// <Foo>_note_on clamps `note` to 0..127 and `velocity` to 0..1 SILENTLY —
// it is called at audio rate, so an out-of-range argument cannot afford a
// diagnostic. Check your own values if you need to know they were wrong.
// <Foo>_note_off clamps `note` the same way, because `note` is the key it
// matches voices on: if only one side clamped, note_off(200) would fail to
// release the voice note_on(200) parked at 127, and that voice would never
// free.
//
// project_init/process/destroy is a convenience wrapper for the test
// harness only — game code should consume per-asset procs directly.
// =====================================================================

import "core:math"
import "core:math/rand"

PRNG_State :: struct {
	state: u32,
}

next_float32 :: proc(rng: ^PRNG_State) -> f32 {
	x := rng.state
	x ~= x << 13
	x ~= x >> 17
	x ~= x << 5
	if x == 0 do x = 0xDEADBEEF
	rng.state = x
	return f32(x) / 4294967296.0
}

ADSR_Stage :: enum { Idle, Attack, Decay, Sustain, Release }

skald_wavetable_shape :: proc(idx: int, ph: f32) -> f32 {
	switch idx {
	case 1: return abs(ph * 4.0 - 2.0) - 1.0
	case 2: return ph * 2.0 - 1.0
	case 3: return ph < 0.5 ? 1.0 : -1.0
	}
	return math.sin(ph * 2.0 * f32(math.PI))
}

skald_wavetable_sample :: proc(ph: f32, pos: f32) -> f32 {
	p := math.clamp(pos, 0.0, 3.0)
	i1 := int(p)
	i2 := (i1 + 1) % 4
	frac := p - f32(i1)
	s1 := skald_wavetable_shape(i1, ph)
	s2 := skald_wavetable_shape(i2, ph)
	return s1 + (s2 - s1) * frac
}

// Soft limiter with a ceiling that really is 1.0 — plain tanh, not
// tanh(x*k)/k, which topped out above 1 and still clipped the device.
// Transparent for small signals (tanh(x) ~= x below ~0.3), saturating
// smoothly instead of clipping as the mix gets hot.
skald_soft_limit :: proc(l: f32, r: f32) -> (f32, f32) {
	return math.tanh(l), math.tanh(r)
}

skald_feedback_tail_seconds :: proc(period: f32, gain: f32) -> f32 {
	if math.is_nan(period) || period <= 0.0 do return 0.0
	// 0.95 is the DSP's own feedback ceiling (see generate_delay_code /
	// generate_reverb_code), so no live value can ring longer than this.
	g := math.clamp(gain, 0.0, 0.95)
	if g <= 0.0 do return period
	passes := math.ceil(math.ln(f32(0.001)) / math.ln(g))
	result := period * passes
	if math.is_nan(result) || math.is_inf(result) || result < 0.0 do return period
	return result
}

Note_Event :: struct {
	note: u8,
	velocity: f32,
	start_time: f32,
	step: int,
	duration: f32,
}

Skald_Param_Info :: struct {
	name:    string,
	min:     f32,
	max:     f32,
	default: f32,
	unit:    string,
}

Wind_Voice_State :: struct {
	active: bool,
	note: u8,
	velocity: f32,
	age: f32,
	time_released: f32,
	current_freq: f32,
	target_freq: f32,
	glide_time: f32,
	duration: f32,
	filter_wind_filter_low: f32,
	filter_wind_filter_band: f32,
	lfo_wind_gust_phase: f32,
	noise_wind_noise_rng: PRNG_State,
	noise_wind_noise_p0: f32,
	noise_wind_noise_p1: f32,
	noise_wind_noise_p2: f32,
}

Wind_Processor :: struct {
	sample_rate: f32,
	bpm: f32,
	voices: [1]Wind_Voice_State,
	prng: PRNG_State,
	total_samples: u64,
	playing: bool,
	loop: bool,
	current_step: u64,
	samples_until_next_step: u64,
	step_frac_acc: f32,
	ext_in_l: f32,
	ext_in_r: f32,
	volume: f32,
	bus_tail_remaining: u64,
	bus_tail_armed: bool,
	delay_wind_reverb_buffer: [96000]f32,
	delay_wind_reverb_write_index: int,
	reverb_wind_reverb_pre_buffer: [48000]f32,
	Pink_Air_amplitude: f32,
	Slow_Gust_amplitude: f32,
	cutoff: f32,
	decay: f32,
	frequency: f32,
	gain: f32,
	mix: f32,
	resonance: f32,
}

Wind_BUS_TAIL_SECONDS :: f32(10.060000000)

// B7-2-followup / SKB-016: the LIVE counterpart to the worst-case constant
// above. Sums, over the same Delay/Reverb nodes compute_bus_tail_seconds
// analyzed, the same feedback_tail_seconds formula — but against each
// parameter's CURRENT value instead of its range maximum. Safe to call
// outside the audio path (once per note-off, not once per sample)
// because no Delay/Reverb parameter has a modulation port: get_f32_param
// resolves every one of them to either a plain field read or a literal,
// both valid wherever `p` is in scope.
Wind_bus_tail_seconds :: proc(p: ^Wind_Processor) -> f32 {
	total: f32 = 0.0
	mix_wind_reverb: f32 = (p.mix);
	if mix_wind_reverb > 0.0 {
		pre_wind_reverb: f32 = math.clamp(f32(f32(0.010000000)), 0.0, 0.25);
		decay_gain_wind_reverb: f32 = math.clamp(math.pow(f32(0.001), f32(0.075000000) / math.max(f32(p.decay), 0.01)), 0.0, 0.95);
		total += pre_wind_reverb + skald_feedback_tail_seconds(f32(0.075000000), decay_gain_wind_reverb)
	}
	return total
}

Wind_init :: proc(p: ^Wind_Processor, sr: f32) {
	p.sample_rate = sr
	p.bpm = 72.000000000
	p.volume = 0.720000029
	p.prng.state = 12345
	p.loop = true
	p.voices = {}
	p.total_samples = 0
	p.playing = false
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
	p.ext_in_l = 0.0
	p.ext_in_r = 0.0
	p.bus_tail_remaining = 0
	p.bus_tail_armed = false
	for i in 0..<1 {
		v := &p.voices[i]
		v.noise_wind_noise_rng.state = u32(0xC0FFEE01) ~ u32(i + 1) * 2654435761
	}
	p.delay_wind_reverb_buffer = {}
	p.delay_wind_reverb_write_index = 0
	p.reverb_wind_reverb_pre_buffer = {}
	p.Pink_Air_amplitude = 0.500000000
	p.Slow_Gust_amplitude = 0.250000000
	p.cutoff = 600.000000000
	p.decay = 5.000000000
	p.frequency = 0.100000001
	p.gain = 0.649999976
	p.mix = 0.500000000
	p.resonance = 1.200000048
}

Wind_note_on :: proc(p: ^Wind_Processor, note: u8, velocity: f32, duration: f32) {
	// note and velocity are clamped silently to their MIDI/normalized domains.
	note := note
	if note > 127 do note = 127
	velocity := math.clamp(velocity, 0.0, 1.0)
	voice_idx := -1
	for i in 0..<1 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_age: f32 = -1.0
		for i in 0..<1 {
			if p.voices[i].age > oldest_age {
				oldest_age = p.voices[i].age
				voice_idx = i
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.000000000
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	if !stolen {
		v.filter_wind_filter_low = 0.0
		v.filter_wind_filter_band = 0.0
	}
}

Wind_note_off :: proc(p: ^Wind_Processor, note: u8) {
	// Clamped to match _note_on: `note` is the voice key, so both must map it.
	note := note
	if note > 127 do note = 127
	best := -1
	best_age: f32 = -1.0
	for i in 0..<1 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].active = false
	}
}

Wind_trigger :: proc(p: ^Wind_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 1.0
	}
	Wind_note_on(p, note, velocity, d)
}

Wind_feed_input :: proc(p: ^Wind_Processor, in_left: f32, in_right: f32) {
	p.ext_in_l = in_left
	p.ext_in_r = in_right
}

Wind_start :: proc(p: ^Wind_Processor) {
	p.playing = true
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
}

Wind_stop :: proc(p: ^Wind_Processor) {
	p.playing = false
}

Wind_set_loop :: proc(p: ^Wind_Processor, loop: bool) {
	p.loop = loop
}

Wind_set_volume :: proc(p: ^Wind_Processor, value: f32) {
	p.volume = math.clamp(value, 0.0, 1.0)
}

Wind_is_playing :: proc(p: ^Wind_Processor) -> bool {
	if p.playing do return true
	for i in 0..<1 {
		if p.voices[i].active do return true
	}
	// The effect tail counts as playing: it is still audible after every
	// voice went inactive, and reporting false here is what let a game free
	// the asset mid-echo.
	if p.bus_tail_remaining > 0 do return true
	return false
}

Wind_set_Pink_Air_amplitude :: proc(p: ^Wind_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 1.000000000 do v = 1.000000000
	p.Pink_Air_amplitude = v
}

Wind_set_Slow_Gust_amplitude :: proc(p: ^Wind_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 20000.000000000 do v = 20000.000000000
	p.Slow_Gust_amplitude = v
}

Wind_set_cutoff :: proc(p: ^Wind_Processor, value: f32) {
	v := value
	if v < 20.000000000 do v = 20.000000000
	if v > 20000.000000000 do v = 20000.000000000
	p.cutoff = v
}

Wind_set_decay :: proc(p: ^Wind_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 10.000000000 do v = 10.000000000
	p.decay = v
}

Wind_set_frequency :: proc(p: ^Wind_Processor, value: f32) {
	v := value
	if v < 0.010000000 do v = 0.010000000
	if v > 100.000000000 do v = 100.000000000
	p.frequency = v
}

Wind_set_gain :: proc(p: ^Wind_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 4.000000000 do v = 4.000000000
	p.gain = v
}

Wind_set_mix :: proc(p: ^Wind_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 1.000000000 do v = 1.000000000
	p.mix = v
}

Wind_set_resonance :: proc(p: ^Wind_Processor, value: f32) {
	v := value
	if v < 0.100000001 do v = 0.100000001
	if v > 20.000000000 do v = 20.000000000
	p.resonance = v
}

Wind_PARAMS := []Skald_Param_Info{
	{"Pink_Air_amplitude", 0.000000000, 1.000000000, 0.500000000, ""},
	{"Slow_Gust_amplitude", 0.000000000, 20000.000000000, 0.250000000, ""},
	{"cutoff", 20.000000000, 20000.000000000, 600.000000000, "Hz"},
	{"decay", 0.000000000, 10.000000000, 5.000000000, "s"},
	{"frequency", 0.010000000, 100.000000000, 0.100000001, "Hz"},
	{"gain", 0.000000000, 4.000000000, 0.649999976, "x"},
	{"mix", 0.000000000, 1.000000000, 0.500000000, ""},
	{"resonance", 0.100000001, 20.000000000, 1.200000048, "Q"},
}

Wind_set_param :: proc(p: ^Wind_Processor, name: string, value: f32) -> bool {
	switch name {
	case "Pink_Air_amplitude", "wind-noise::amplitude":
		Wind_set_Pink_Air_amplitude(p, value)
		return true
	case "Slow_Gust_amplitude", "wind-gust::amplitude":
		Wind_set_Slow_Gust_amplitude(p, value)
		return true
	case "cutoff", "wind-filter::cutoff":
		Wind_set_cutoff(p, value)
		return true
	case "decay", "wind-reverb::decay":
		Wind_set_decay(p, value)
		return true
	case "frequency", "wind-gust::frequency":
		Wind_set_frequency(p, value)
		return true
	case "gain", "wind-gain::gain":
		Wind_set_gain(p, value)
		return true
	case "mix", "wind-reverb::mix":
		Wind_set_mix(p, value)
		return true
	case "resonance", "wind-filter::resonance":
		Wind_set_resonance(p, value)
		return true
	}
	return false
}

Wind_get_param :: proc(p: ^Wind_Processor, name: string) -> (f32, bool) {
	switch name {
	case "Pink_Air_amplitude", "wind-noise::amplitude":
		return p.Pink_Air_amplitude, true
	case "Slow_Gust_amplitude", "wind-gust::amplitude":
		return p.Slow_Gust_amplitude, true
	case "cutoff", "wind-filter::cutoff":
		return p.cutoff, true
	case "decay", "wind-reverb::decay":
		return p.decay, true
	case "frequency", "wind-gust::frequency":
		return p.frequency, true
	case "gain", "wind-gain::gain":
		return p.gain, true
	case "mix", "wind-reverb::mix":
		return p.mix, true
	case "resonance", "wind-filter::resonance":
		return p.resonance, true
	}
	return 0.0, false
}

Wind_process :: proc(p: ^Wind_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	Wind_process_sequence(p)
	p.total_samples += 1

	node_wind_gain_out_vsum: f32 = 0.0
	for v_idx in 0..<1 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
		}
		node_wind_filter_out: f32 = 0.0
		node_wind_gain_out: f32 = 0.0
		node_wind_gust_out: f32 = 0.0
		node_wind_noise_out: f32 = 0.0

		// --- LFO Node wind_gust ---
		voice.lfo_wind_gust_phase = math.mod(voice.lfo_wind_gust_phase + (2 * f32(math.PI) * (p.frequency) / sample_rate), 2 * f32(math.PI));
		if voice.lfo_wind_gust_phase < 0.0 do voice.lfo_wind_gust_phase += 2 * f32(math.PI);
		node_wind_gust_out = math.sin(voice.lfo_wind_gust_phase) * (p.Slow_Gust_amplitude);

		// --- Noise Node wind_noise ---
		{
			white_wind_noise := next_float32(&voice.noise_wind_noise_rng) * 2.0 - 1.0;
			voice.noise_wind_noise_p0 = 0.99765 * voice.noise_wind_noise_p0 + white_wind_noise * 0.0990460;
			voice.noise_wind_noise_p1 = 0.96300 * voice.noise_wind_noise_p1 + white_wind_noise * 0.2965164;
			voice.noise_wind_noise_p2 = 0.57000 * voice.noise_wind_noise_p2 + white_wind_noise * 1.0526913;
			node_wind_noise_out = (voice.noise_wind_noise_p0 + voice.noise_wind_noise_p1 + voice.noise_wind_noise_p2 + white_wind_noise * 0.1848) * 0.25 * (p.Pink_Air_amplitude);
		}

		// --- Filter Node wind_filter (SVF) ---
		{
			cutoff_c_wind_filter: f32 = math.clamp(f32(p.cutoff), 10.0, sample_rate * 0.16);
			f_wind_filter := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_wind_filter / sample_rate));
			q_wind_filter: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_wind_filter);
			voice.filter_wind_filter_low += f_wind_filter * voice.filter_wind_filter_band;
			high_wind_filter := f32(((node_wind_noise_out)) - voice.filter_wind_filter_low - q_wind_filter * voice.filter_wind_filter_band);
			voice.filter_wind_filter_band += f_wind_filter * high_wind_filter;
			node_wind_filter_out = voice.filter_wind_filter_band;
		}

		// --- Gain Node wind_gain ---
		node_wind_gain_out = ((node_wind_filter_out)) * ((p.gain) + (node_wind_gust_out));

		node_wind_gain_out_vsum += node_wind_gain_out
		if voice.duration > 0.0 && voice.age >= voice.duration do voice.active = false
	}

	// --- Bus effects (once per sample, post voice sum) ---
	{
		node_wind_gain_out := node_wind_gain_out_vsum
		node_wind_reverb_out: f32 = 0.0
		// --- Reverb Node wind_reverb (pre-delay + feedback comb) ---
		{
			pre_delay_seconds_wind_reverb: f32 = math.clamp(f32(f32(0.010000000)), 0.0, 0.25);
			pre_delay_samples_wind_reverb := int(math.clamp(pre_delay_seconds_wind_reverb * sample_rate, 0.0, f32(48000)));
			pre_write_index_wind_reverb := p.delay_wind_reverb_write_index % len(p.reverb_wind_reverb_pre_buffer)
			pre_delayed_input_wind_reverb := f32((node_wind_gain_out))
			if pre_delay_samples_wind_reverb > 0 {
				pre_read_index_wind_reverb := (pre_write_index_wind_reverb - pre_delay_samples_wind_reverb + len(p.reverb_wind_reverb_pre_buffer)) % len(p.reverb_wind_reverb_pre_buffer)
				pre_delayed_input_wind_reverb = p.reverb_wind_reverb_pre_buffer[pre_read_index_wind_reverb]
			}
			p.reverb_wind_reverb_pre_buffer[pre_write_index_wind_reverb] = f32((node_wind_gain_out))
			delay_samples_wind_reverb := int(math.clamp((0.075000000) * sample_rate, 0, 96000-1));
			read_index_wind_reverb := (p.delay_wind_reverb_write_index - delay_samples_wind_reverb + len(p.delay_wind_reverb_buffer)) % len(p.delay_wind_reverb_buffer);
			delayed_sample_wind_reverb := p.delay_wind_reverb_buffer[read_index_wind_reverb];
			decay_gain_wind_reverb: f32 = math.clamp(math.pow(f32(0.001), f32(0.075000000) / math.max(f32(p.decay), 0.01)), 0.0, 0.95);
			p.delay_wind_reverb_buffer[p.delay_wind_reverb_write_index] = pre_delayed_input_wind_reverb + delayed_sample_wind_reverb * decay_gain_wind_reverb;
			p.delay_wind_reverb_write_index = (p.delay_wind_reverb_write_index + 1) % len(p.delay_wind_reverb_buffer);
			node_wind_reverb_out = ((node_wind_gain_out)) * (1.0 - (p.mix)) + delayed_sample_wind_reverb * (p.mix);
		}

		output_left += node_wind_reverb_out
		output_right += node_wind_reverb_out
	}

	// B7-2-followup / SKB-016: a baked worst-case constant here held
	// is_playing true for minutes on real content (every exposed tail param
	// contributed its range maximum, so glassy-fm-pluck alone baked 202.5s
	// for a true tail under 2s). Arm on the FALLING EDGE instead, from the
	// live field values — that is one ln/pow per note-off rather than per
	// sample, which is what keeps this proc off the audio path.
	{
		voice_alive := false
		for i in 0..<1 {
			if p.voices[i].active {
				voice_alive = true
				break
			}
		}
		if voice_alive || p.playing {
			p.bus_tail_armed = false
			p.bus_tail_remaining = 0
		} else if !p.bus_tail_armed {
			p.bus_tail_armed = true
			p.bus_tail_remaining = u64(Wind_bus_tail_seconds(p) * sample_rate)
		} else if p.bus_tail_remaining > 0 {
			p.bus_tail_remaining -= 1
		}
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
Wind_process_sequence :: proc(p: ^Wind_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "Wind" (64 steps)
		switch p.current_step % 64 {
		case 0:
			Wind_note_on(p, 60, 1.000000000, f32(64.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 64 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	Wind: ^Wind_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.699999988
	p.Wind = new(Wind_Processor)
	Wind_init(p.Wind, sr)
	Wind_start(p.Wind)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := Wind_process(p.Wind); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.Wind)
}

