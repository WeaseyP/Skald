	Vibrato_amplitude: f32,
	cutoff: f32,
	frequency: f32,
	outMax: f32,
	resonance: f32,
	velocitySensitivity: f32,
}

Tuba_init :: proc(p: ^Tuba_Processor, sr: f32) {
	p.sample_rate = sr
	p.bpm = 96.000000000
	p.volume = 0.850000024
	p.prng.state = 12345
	p.loop = true
	p.voices = {}
	p.total_samples = 0
	p.playing = false
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
	p.ext_in_l = 0.0
	p.ext_in_r = 0.0
	p.Amp_attack = 0.079999998
	p.Amp_decay = 0.100000001
	p.Amp_depth = 1.000000000
	p.Amp_release = 0.180000007
	p.Amp_sustain = 0.850000024
	p.Blow_attack = 0.090000004
	p.Blow_decay = 0.250000000
	p.Blow_depth = 1.000000000
	p.Blow_release = 0.150000006
	p.Blow_sustain = 0.349999994
	p.Buzz_amplitude = 0.600000024
	p.Vibrato_amplitude = 0.020000000
	p.cutoff = 220.000000000
	p.frequency = 5.000000000
	p.outMax = 700.000000000
	p.resonance = 0.800000012
	p.velocitySensitivity = 0.699999988
}

Tuba_note_on :: proc(p: ^Tuba_Processor, note: u8, velocity: f32, duration: f32) {
	// note and velocity are clamped silently to their MIDI/normalized domains.
	note := note
	if note > 127 do note = 127
	velocity := math.clamp(velocity, 0.0, 1.0)
	voice_idx := -1
	for i in 0..<8 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_age: f32 = -1.0
		for i in 0..<8 {
			if p.voices[i].age > oldest_age {
				oldest_age = p.voices[i].age
				voice_idx = i
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	adsr_tuba_amp_prev_level: f32 = 0.0
	if stolen && v.adsr_tuba_amp_stage != .Idle {
		adsr_tuba_amp_prev_level = v.adsr_tuba_amp_release_level
		if v.adsr_tuba_amp_stage == .Release {
			rel_t_tuba_amp: f32 = (p.Amp_release);
			if rel_t_tuba_amp > 0.0 {
				rf_tuba_amp := 1.0 - (v.age - v.time_released) / math.max(rel_t_tuba_amp, 0.000001)
				if rf_tuba_amp < 0.0 do rf_tuba_amp = 0.0
				adsr_tuba_amp_prev_level *= rf_tuba_amp
			} else {
				adsr_tuba_amp_prev_level = 0.0
			}
		}
	}
	adsr_tuba_blow_prev_level: f32 = 0.0
	if stolen && v.adsr_tuba_blow_stage != .Idle {
		adsr_tuba_blow_prev_level = v.adsr_tuba_blow_release_level
		if v.adsr_tuba_blow_stage == .Release {
			rel_t_tuba_blow: f32 = (p.Blow_release);
			if rel_t_tuba_blow > 0.0 {
				rf_tuba_blow := 1.0 - (v.age - v.time_released) / math.max(rel_t_tuba_blow, 0.000001)
				if rf_tuba_blow < 0.0 do rf_tuba_blow = 0.0
				adsr_tuba_blow_prev_level *= rf_tuba_blow
			} else {
				adsr_tuba_blow_prev_level = 0.0
			}
		}
	}
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.039999999
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	v.adsr_tuba_amp_stage = .Attack
	v.adsr_tuba_amp_attack_start = adsr_tuba_amp_prev_level
	v.adsr_tuba_amp_release_level = adsr_tuba_amp_prev_level
	v.adsr_tuba_blow_stage = .Attack
	v.adsr_tuba_blow_attack_start = adsr_tuba_blow_prev_level
	v.adsr_tuba_blow_release_level = adsr_tuba_blow_prev_level
	if !stolen {
		v.filter_tuba_filter_low = 0.0
		v.filter_tuba_filter_band = 0.0
		v.osc_tuba_osc_phase = {}
	}
}

Tuba_note_off :: proc(p: ^Tuba_Processor, note: u8) {
	// Clamped to match _note_on: `note` is the voice key, so both must map it.
	note := note
	if note > 127 do note = 127
	best := -1
	best_age: f32 = -1.0
	for i in 0..<8 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_tuba_amp_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_tuba_amp_stage = .Release
		p.voices[best].adsr_tuba_blow_stage = .Release
	}
}

Tuba_trigger :: proc(p: ^Tuba_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (p.Amp_attack) + (p.Amp_decay) > d do d = (p.Amp_attack) + (p.Amp_decay)
		if (p.Blow_attack) + (p.Blow_decay) > d do d = (p.Blow_attack) + (p.Blow_decay)
		if d <= 0.0 do d = 0.001
	}
	Tuba_note_on(p, note, velocity, d)
}

Tuba_feed_input :: proc(p: ^Tuba_Processor, in_left: f32, in_right: f32) {
	p.ext_in_l = in_left
	p.ext_in_r = in_right
}

Tuba_start :: proc(p: ^Tuba_Processor) {
	p.playing = true
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
}

Tuba_stop :: proc(p: ^Tuba_Processor) {
	p.playing = false
}

Tuba_set_loop :: proc(p: ^Tuba_Processor, loop: bool) {
	p.loop = loop
}

Tuba_set_volume :: proc(p: ^Tuba_Processor, value: f32) {
	p.volume = math.clamp(value, 0.0, 1.0)
}

Tuba_is_playing :: proc(p: ^Tuba_Processor) -> bool {
	if p.playing do return true
	for i in 0..<8 {
		if p.voices[i].active do return true
	}
	return false
}

