Asset_BUS_TAIL_SECONDS :: f32(0.545000000)

// B7-2-followup / SKB-016: the LIVE counterpart to the worst-case constant
// above. Sums, over the same Delay/Reverb nodes compute_bus_tail_seconds
// analyzed, the same feedback_tail_seconds formula — but against each
// parameter's CURRENT value instead of its range maximum. Safe to call
// outside the audio path (once per note-off, not once per sample)
// because no Delay/Reverb parameter has a modulation port: get_f32_param
// resolves every one of them to either a plain field read or a literal,
// both valid wherever `p` is in scope.
Asset_bus_tail_seconds :: proc(p: ^Asset_Processor) -> f32 {
	total: f32 = 0.0
	mix_4: f32 = (f32(0.300000000));
	if mix_4 > 0.0 {
		pre_4: f32 = math.clamp(f32(f32(0.020000000)), 0.0, 0.25);
		decay_gain_4: f32 = math.clamp(math.pow(f32(0.001), f32(0.075000000) / math.max(f32(f32(0.500000000)), 0.01)), 0.0, 0.95);
		total += pre_4 + skald_feedback_tail_seconds(f32(0.075000000), decay_gain_4)
	}
	return total
}

Asset_init :: proc(p: ^Asset_Processor, sr: f32) {
	p.sample_rate = sr
	p.bpm = 120.000000000
	p.volume = 1.000000000
	p.prng.state = 12345
	p.loop = true
	p.voices = {}
	p.total_samples = 0
	p.playing = false
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
	p.ext_in_l = 0.0
	p.ext_in_r = 0.0
	p.nonfinite_count = 0
	p.bus_tail_remaining = 0
	p.bus_tail_armed = false
	for i in 0..<1 {
		v := &p.voices[i]
		v.noise_1_rng.state = u32(0xC0FFEE01) ~ u32(i + 1) * 2654435761
	}
	p.delay_4_buffer = {}
	p.delay_4_write_index = 0
	p.reverb_4_pre_buffer = {}
}

Asset_note_on :: proc(p: ^Asset_Processor, note: u8, velocity: f32, duration: f32) {
	// note and velocity are clamped silently to their MIDI/normalized domains.
	note := note
	if note > 127 do note = 127
	velocity := math.clamp(velocity, 0.0, 1.0)
	voice_idx := -1
	for i in 0..<1 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_releasing_age: f32 = -1.0
		for i in 0..<1 {
			releasing := true
			if p.voices[i].adsr_3_stage != .Release && p.voices[i].adsr_3_stage != .Idle do releasing = false
			if releasing && p.voices[i].age > oldest_releasing_age {
				oldest_releasing_age = p.voices[i].age
				voice_idx = i
			}
		}
		if voice_idx == -1 {
			oldest_age: f32 = -1.0
			for i in 0..<1 {
				if p.voices[i].age > oldest_age {
					oldest_age = p.voices[i].age
					voice_idx = i
				}
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	adsr_3_prev_level: f32 = 0.0
	if stolen && v.adsr_3_stage != .Idle {
		adsr_3_prev_level = v.adsr_3_release_level
		if v.adsr_3_stage == .Release {
			rel_t_3: f32 = (f32(0.800000000));
			if rel_t_3 > 0.0 {
				rf_3 := 1.0 - (v.age - v.time_released) / math.max(rel_t_3, 0.000001)
				if rf_3 < 0.0 do rf_3 = 0.0
				adsr_3_prev_level *= rf_3
			} else {
				adsr_3_prev_level = 0.0
			}
		}
	}
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.000000000
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	v.adsr_3_stage = .Attack
	v.adsr_3_attack_start = adsr_3_prev_level
	v.adsr_3_release_level = adsr_3_prev_level
	if !stolen {
		v.filter_2_low = 0.0
		v.filter_2_band = 0.0
	}
}

Asset_note_off :: proc(p: ^Asset_Processor, note: u8) {
	// Clamped to match _note_on: `note` is the voice key, so both must map it.
	note := note
	if note > 127 do note = 127
	best := -1
	best_age: f32 = -1.0
	for i in 0..<1 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_3_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_3_stage = .Release
	}
}

Asset_trigger :: proc(p: ^Asset_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (f32(0.010000000)) + (f32(1.500000000)) > d do d = (f32(0.010000000)) + (f32(1.500000000))
		if d <= 0.0 do d = 0.001
	}
	Asset_note_on(p, note, velocity, d)
}

Asset_feed_input :: proc(p: ^Asset_Processor, in_left: f32, in_right: f32) {
	p.ext_in_l = in_left
	p.ext_in_r = in_right
}

Asset_start :: proc(p: ^Asset_Processor) {
	p.playing = true
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
}

Asset_stop :: proc(p: ^Asset_Processor) {
	p.playing = false
}

Asset_set_loop :: proc(p: ^Asset_Processor, loop: bool) {
	p.loop = loop
}

Asset_set_volume :: proc(p: ^Asset_Processor, value: f32) {
	p.volume = math.clamp(value, 0.0, 1.0)
}

Asset_is_playing :: proc(p: ^Asset_Processor) -> bool {
	if p.playing do return true
	for i in 0..<1 {
		if p.voices[i].active do return true
	}
	// The effect tail counts as playing: it is still audible after every
	// voice went inactive, and reporting false here is what let a game free
	// the asset mid-echo.
	if p.bus_tail_remaining > 0 do return true
	return false
}

Asset_PARAMS := []Skald_Param_Info{
}

Asset_set_param :: proc(p: ^Asset_Processor, name: string, value: f32) -> bool {
	return false
}

Asset_get_param :: proc(p: ^Asset_Processor, name: string) -> (f32, bool) {
	return 0.0, false
}

Asset_process :: proc(p: ^Asset_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	p.total_samples += 1

	node_3_out_vsum: f32 = 0.0
	for v_idx in 0..<1 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_3_stage != .Release && voice.adsr_3_stage != .Idle {
				voice.adsr_3_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_1_out: f32 = 0.0
		node_2_out: f32 = 0.0
		node_3_out: f32 = 0.0

		// --- Noise Node 1 ---
		node_1_out = (next_float32(&voice.noise_1_rng) * 2.0 - 1.0) * (f32(1.000000000));

		// --- Filter Node 2 (SVF) ---
		{
			cutoff_c_2: f32 = math.clamp(f32(f32(5000.000000000)), 10.0, sample_rate * 0.16);
			f_2 := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_2 / sample_rate));
			q_2: f32 = math.clamp(1.0 / math.max(f32(f32(0.800000000)), 0.1), 0.05, 1.9 - f_2);
			voice.filter_2_low += f_2 * voice.filter_2_band;
			high_2 := f32(((node_1_out)) - voice.filter_2_low - q_2 * voice.filter_2_band);
			voice.filter_2_band += f_2 * high_2;
			node_2_out = high_2;
		}

		// --- ADSR Node 3 ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_3_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.010000000)) > 0 do envelope = voice.adsr_3_attack_start + (1.0 - voice.adsr_3_attack_start) * (voice.age / math.max(f32(f32(0.010000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_3_release_level = envelope;
				if voice.age >= (f32(0.010000000)) {
					voice.adsr_3_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.010000000));
				if (f32(1.500000000)) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(f32(1.500000000)), 0.000001)) * (1.0 - (f32(0.200000000))); else do envelope = (f32(0.200000000));
				voice.adsr_3_release_level = envelope;
				if time_in_decay >= (f32(1.500000000)) {
					voice.adsr_3_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.200000000));
				voice.adsr_3_release_level = envelope;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.800000000)) > 0 do envelope = voice.adsr_3_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.800000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_3_stage = .Idle;
				}
			}
			vel_scale_3: f32 = (1.0 - (f32(0.500000000))) + (f32(0.500000000)) * voice.velocity;
			node_3_out = ((node_2_out)) * envelope * (f32(1.000000000)) * vel_scale_3;
		}

		node_3_out_vsum += node_3_out
		if voice.adsr_3_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}

	// --- Bus effects (once per sample, post voice sum) ---
	{
		node_3_out := node_3_out_vsum
		node_4_out: f32 = 0.0
		// --- Reverb Node 4 (pre-delay + feedback comb) ---
		{
			pre_delay_seconds_4: f32 = math.clamp(f32(f32(0.020000000)), 0.0, 0.25);
			pre_delay_samples_4 := int(math.clamp(pre_delay_seconds_4 * sample_rate, 0.0, f32(48000)));
			pre_write_index_4 := p.delay_4_write_index % len(p.reverb_4_pre_buffer)
			pre_delayed_input_4 := f32((node_3_out))
			if pre_delay_samples_4 > 0 {
				pre_read_index_4 := (pre_write_index_4 - pre_delay_samples_4 + len(p.reverb_4_pre_buffer)) % len(p.reverb_4_pre_buffer)
				pre_delayed_input_4 = p.reverb_4_pre_buffer[pre_read_index_4]
			}
			p.reverb_4_pre_buffer[pre_write_index_4] = f32((node_3_out))
			delay_samples_4 := int(math.clamp((0.075000000) * sample_rate, 0, 96000-1));
			read_index_4 := (p.delay_4_write_index - delay_samples_4 + len(p.delay_4_buffer)) % len(p.delay_4_buffer);
			delayed_sample_4 := p.delay_4_buffer[read_index_4];
			decay_gain_4: f32 = math.clamp(math.pow(f32(0.001), f32(0.075000000) / math.max(f32(f32(0.500000000)), 0.01)), 0.0, 0.95);
			p.delay_4_buffer[p.delay_4_write_index] = pre_delayed_input_4 + delayed_sample_4 * decay_gain_4;
			p.delay_4_write_index = (p.delay_4_write_index + 1) % len(p.delay_4_buffer);
			node_4_out = ((node_3_out)) * (1.0 - (f32(0.300000000))) + delayed_sample_4 * (f32(0.300000000));
		}

		output_left += node_4_out
		output_right += node_4_out
	}

	// B7-2-followup / SKB-016: a baked worst-case constant here held
	// is_playing true for minutes on real content (every exposed tail param
	// contributed its range maximum, so glassy-fm-pluck alone baked 202.5s
	// for a true tail under 2s). Arm on the FALLING EDGE instead, from the
	// live field values — that is one ln/pow per note-off rather than per
	// sample, which is what keeps this proc off the audio path.
	{
		voice_alive := false
		for i in 0..<1 {
			if p.voices[i].active {
				voice_alive = true
				break
			}
		}
		if voice_alive || p.playing {
			p.bus_tail_armed = false
			p.bus_tail_remaining = 0
		} else if !p.bus_tail_armed {
			p.bus_tail_armed = true
			p.bus_tail_remaining = u64(Asset_bus_tail_seconds(p) * sample_rate)
		} else if p.bus_tail_remaining > 0 {
			p.bus_tail_remaining -= 1
		}
	}
	if math.is_nan(output_left) || math.is_inf(output_left) || math.is_nan(output_right) || math.is_inf(output_right) {
		p.nonfinite_count += 1
		output_left, output_right = 0.0, 0.0
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
Asset_process_sequence :: proc(p: ^Asset_Processor) {
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	Asset: ^Asset_Processor,
	master_volume: f32,
	dc: Skald_Dc_Block_State,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 1.000000000
	p.dc = {}
	p.Asset = new(Asset_Processor)
	Asset_init(p.Asset, sr)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := Asset_process(p.Asset); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	mixed_left, mixed_right = skald_dc_block(&p.dc, mixed_left, mixed_right)
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.Asset)
}

