	return false
}

Fingered_Electric_Bass_get_param :: proc(p: ^Fingered_Electric_Bass_Processor, name: string) -> (f32, bool) {
	switch name {
	case "Amp_attack", "fb-amp::attack":
		return p.Amp_attack, true
	case "Amp_decay", "fb-amp::decay":
		return p.Amp_decay, true
	case "Amp_release", "fb-amp::release":
		return p.Amp_release, true
	case "Amp_sustain", "fb-amp::sustain":
		return p.Amp_sustain, true
	case "Body_amplitude", "fb-body::amplitude":
		return p.Body_amplitude, true
	case "Filter_Env_attack", "fb-filter-env::attack":
		return p.Filter_Env_attack, true
	case "Filter_Env_decay", "fb-filter-env::decay":
		return p.Filter_Env_decay, true
	case "Filter_Env_release", "fb-filter-env::release":
		return p.Filter_Env_release, true
	case "Filter_Env_sustain", "fb-filter-env::sustain":
		return p.Filter_Env_sustain, true
	case "Sub_amplitude", "fb-sub::amplitude":
		return p.Sub_amplitude, true
	case "cutoff", "fb-filter::cutoff":
		return p.cutoff, true
	case "depth", "fb-amp::depth":
		return p.depth, true
	case "outMax", "fb-filter-map::outMax":
		return p.outMax, true
	case "resonance", "fb-filter::resonance":
		return p.resonance, true
	case "velocitySensitivity", "fb-amp::velocitySensitivity":
		return p.velocitySensitivity, true
	}
	return 0.0, false
}

Fingered_Electric_Bass_process :: proc(p: ^Fingered_Electric_Bass_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	Fingered_Electric_Bass_process_sequence(p)
	p.total_samples += 1

	for v_idx in 0..<6 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.current_freq != voice.target_freq {
			glide_k := 1.0 / math.max(voice.glide_time * sample_rate, 1.0)
			if glide_k > 1.0 do glide_k = 1.0
			voice.current_freq += (voice.target_freq - voice.current_freq) * glide_k
			if abs(voice.target_freq - voice.current_freq) < 0.1 do voice.current_freq = voice.target_freq
		}
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_fb_amp_stage != .Release && voice.adsr_fb_amp_stage != .Idle {
				voice.adsr_fb_amp_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_fb_filter_env_stage != .Release && voice.adsr_fb_filter_env_stage != .Idle {
				voice.adsr_fb_filter_env_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_fb_amp_out: f32 = 0.0
		node_fb_body_out: f32 = 0.0
		node_fb_filter_out: f32 = 0.0
		node_fb_filter_env_out: f32 = 0.0
		node_fb_filter_map_out: f32 = 0.0
		node_fb_mixer_out: f32 = 0.0
		node_fb_output_out: f32 = 0.0
		node_fb_sub_out: f32 = 0.0

		// --- Oscillator Node fb_body (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_fb_body_phase[i] = math.mod(voice.osc_fb_body_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_fb_body_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += ((final_phase / f32(math.PI)) - 1.0);
			}
			node_fb_body_out = (unison_out / f32(unison_count)) * (p.Body_amplitude);
		}

		// --- ADSR Node fb_filter_env ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_fb_filter_env_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Filter_Env_attack) > 0 do envelope = voice.adsr_fb_filter_env_attack_start + (1.0 - voice.adsr_fb_filter_env_attack_start) * (voice.age / math.max(f32(p.Filter_Env_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_fb_filter_env_release_level = envelope;
				if voice.age >= (p.Filter_Env_attack) {
					voice.adsr_fb_filter_env_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Filter_Env_attack);
				if (p.Filter_Env_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Filter_Env_decay), 0.000001)) * (1.0 - (p.Filter_Env_sustain)); else do envelope = (p.Filter_Env_sustain);
				voice.adsr_fb_filter_env_release_level = envelope;
				if time_in_decay >= (p.Filter_Env_decay) {
					voice.adsr_fb_filter_env_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Filter_Env_sustain);
				voice.adsr_fb_filter_env_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_fb_filter_env_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Filter_Env_release) > 0 do envelope = voice.adsr_fb_filter_env_release_level * (1.0 - (time_in_release / math.max(f32(p.Filter_Env_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_fb_filter_env_stage = .Idle;
				}
			}
			vel_scale_fb_filter_env: f32 = (1.0 - (f32(0.600000000))) + (f32(0.600000000)) * voice.velocity;
			node_fb_filter_env_out = (1.0) * envelope * (f32(1.000000000)) * vel_scale_fb_filter_env;
		}

		// --- Oscillator Node fb_sub (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_fb_sub_phase[i] = math.mod(voice.osc_fb_sub_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_fb_sub_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += math.sin(final_phase);
			}
			node_fb_sub_out = (unison_out / f32(unison_count)) * (p.Sub_amplitude);
		}

		// --- Mapper Node fb_filter_map ---
		{
			in_range_fb_filter_map: f32 = f32(f32(1.000000000)) - f32(f32(0.000000000));
			if in_range_fb_filter_map == 0.0 do in_range_fb_filter_map = 1.0;
			node_fb_filter_map_out = math.lerp(f32(f32(0.000000000)), f32(p.outMax), math.clamp((f32((node_fb_filter_env_out)) - f32(f32(0.000000000))) / in_range_fb_filter_map, 0.0, 1.0));
		}

		// --- Mixer Node fb_mixer (2 inputs) ---
		{
			mix_sum_fb_mixer: f32 = 0.0;
			mix_sum_fb_mixer += node_fb_body_out * (f32(0.649999976));
			mix_sum_fb_mixer += node_fb_sub_out * (f32(0.699999988));
		node_fb_mixer_out = mix_sum_fb_mixer;
		}

		// --- Filter Node fb_filter (SVF) ---
		{
			cutoff_c_fb_filter: f32 = math.clamp(f32((p.cutoff) + (node_fb_filter_map_out)), 10.0, sample_rate * 0.16);
			f_fb_filter := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_fb_filter / sample_rate));
			q_fb_filter: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_fb_filter);
			voice.filter_fb_filter_low += f_fb_filter * voice.filter_fb_filter_band;
			high_fb_filter := f32(((node_fb_mixer_out)) - voice.filter_fb_filter_low - q_fb_filter * voice.filter_fb_filter_band);
			voice.filter_fb_filter_band += f_fb_filter * high_fb_filter;
			node_fb_filter_out = voice.filter_fb_filter_low;
		}

		// --- ADSR Node fb_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_fb_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Amp_attack) > 0 do envelope = voice.adsr_fb_amp_attack_start + (1.0 - voice.adsr_fb_amp_attack_start) * (voice.age / math.max(f32(p.Amp_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_fb_amp_release_level = envelope;
				if voice.age >= (p.Amp_attack) {
					voice.adsr_fb_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Amp_attack);
				if (p.Amp_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Amp_decay), 0.000001)) * (1.0 - (p.Amp_sustain)); else do envelope = (p.Amp_sustain);
				voice.adsr_fb_amp_release_level = envelope;
				if time_in_decay >= (p.Amp_decay) {
					voice.adsr_fb_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Amp_sustain);
				voice.adsr_fb_amp_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_fb_amp_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.Amp_release) > 0 do envelope = voice.adsr_fb_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.Amp_release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_fb_amp_stage = .Idle;
				}
			}
			vel_scale_fb_amp: f32 = (1.0 - (p.velocitySensitivity)) + (p.velocitySensitivity) * voice.velocity;
			node_fb_amp_out = ((node_fb_filter_out)) * envelope * (p.depth) * vel_scale_fb_amp;
		}

		output_left += node_fb_amp_out
		output_right += node_fb_amp_out
		if voice.adsr_fb_amp_stage != .Idle do voice_busy = true
		if voice.adsr_fb_filter_env_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
Fingered_Electric_Bass_process_sequence :: proc(p: ^Fingered_Electric_Bass_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "Fingered Bass" (16 steps)
		switch p.current_step % 16 {
		case 0:
			Fingered_Electric_Bass_note_on(p, 33, 0.899999976, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 3:
			Fingered_Electric_Bass_note_on(p, 33, 0.699999988, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 4:
			Fingered_Electric_Bass_note_on(p, 40, 0.819999993, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 6:
			Fingered_Electric_Bass_note_on(p, 33, 0.850000024, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			Fingered_Electric_Bass_note_on(p, 36, 0.860000014, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 10:
			Fingered_Electric_Bass_note_on(p, 38, 0.750000000, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			Fingered_Electric_Bass_note_on(p, 40, 0.899999976, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 14:
			Fingered_Electric_Bass_note_on(p, 31, 0.720000029, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	Fingered_Electric_Bass: ^Fingered_Electric_Bass_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.800000012
	p.Fingered_Electric_Bass = new(Fingered_Electric_Bass_Processor)
	Fingered_Electric_Bass_init(p.Fingered_Electric_Bass, sr)
	Fingered_Electric_Bass_start(p.Fingered_Electric_Bass)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := Fingered_Electric_Bass_process(p.Fingered_Electric_Bass); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.Fingered_Electric_Bass)
}

