Picked_Rock_Bass_note_off :: proc(p: ^Picked_Rock_Bass_Processor, note: u8) {
	// Clamped to match _note_on: `note` is the voice key, so both must map it.
	note := note
	if note > 127 do note = 127
	best := -1
	best_age: f32 = -1.0
	for i in 0..<6 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_pb_amp_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_pb_amp_stage = .Release
		p.voices[best].adsr_pb_click_env_stage = .Release
		p.voices[best].adsr_pb_filter_env_stage = .Release
	}
}

