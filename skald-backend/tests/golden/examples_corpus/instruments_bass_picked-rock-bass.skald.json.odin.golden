	{"depth", 0.000000000, 1.000000000, 1.000000000, ""},
	{"drive", 1.000000000, 100.000000000, 8.000000000, "x"},
	{"mix", 0.000000000, 1.000000000, 0.250000000, ""},
	{"outMax", -1000000.000000000, 1000000.000000000, 1600.000000000, ""},
	{"release", 0.000000000, 10.000000000, 0.100000001, "s"},
	{"resonance", 0.100000001, 20.000000000, 1.299999952, "Q"},
	{"velocitySensitivity", 0.000000000, 1.000000000, 0.550000012, ""},
}

Picked_Rock_Bass_set_param :: proc(p: ^Picked_Rock_Bass_Processor, name: string, value: f32) -> bool {
	switch name {
	case "Amp_attack", "pb-amp::attack":
		Picked_Rock_Bass_set_Amp_attack(p, value)
		return true
	case "Amp_decay", "pb-amp::decay":
		Picked_Rock_Bass_set_Amp_decay(p, value)
		return true
	case "Amp_sustain", "pb-amp::sustain":
		Picked_Rock_Bass_set_Amp_sustain(p, value)
		return true
	case "Click_Env_decay", "pb-click-env::decay":
		Picked_Rock_Bass_set_Click_Env_decay(p, value)
		return true
	case "Filter_Env_attack", "pb-filter-env::attack":
		Picked_Rock_Bass_set_Filter_Env_attack(p, value)
		return true
	case "Filter_Env_decay", "pb-filter-env::decay":
		Picked_Rock_Bass_set_Filter_Env_decay(p, value)
		return true
	case "Filter_Env_sustain", "pb-filter-env::sustain":
		Picked_Rock_Bass_set_Filter_Env_sustain(p, value)
		return true
	case "Pick_Click_amplitude", "pb-click::amplitude":
		Picked_Rock_Bass_set_Pick_Click_amplitude(p, value)
		return true
	case "Pick_amplitude", "pb-pick::amplitude":
		Picked_Rock_Bass_set_Pick_amplitude(p, value)
		return true
	case "Sub_amplitude", "pb-sub::amplitude":
		Picked_Rock_Bass_set_Sub_amplitude(p, value)
		return true
	case "cutoff", "pb-filter::cutoff":
		Picked_Rock_Bass_set_cutoff(p, value)
		return true
	case "depth", "pb-amp::depth":
		Picked_Rock_Bass_set_depth(p, value)
		return true
	case "drive", "pb-dist::drive":
		Picked_Rock_Bass_set_drive(p, value)
		return true
	case "mix", "pb-dist::mix":
		Picked_Rock_Bass_set_mix(p, value)
		return true
	case "outMax", "pb-filter-map::outMax":
		Picked_Rock_Bass_set_outMax(p, value)
		return true
	case "release", "pb-amp::release":
		Picked_Rock_Bass_set_release(p, value)
		return true
	case "resonance", "pb-filter::resonance":
		Picked_Rock_Bass_set_resonance(p, value)
		return true
	case "velocitySensitivity", "pb-amp::velocitySensitivity":
		Picked_Rock_Bass_set_velocitySensitivity(p, value)
		return true
	}
	return false
}

Picked_Rock_Bass_get_param :: proc(p: ^Picked_Rock_Bass_Processor, name: string) -> (f32, bool) {
	switch name {
	case "Amp_attack", "pb-amp::attack":
		return p.Amp_attack, true
	case "Amp_decay", "pb-amp::decay":
		return p.Amp_decay, true
	case "Amp_sustain", "pb-amp::sustain":
		return p.Amp_sustain, true
	case "Click_Env_decay", "pb-click-env::decay":
		return p.Click_Env_decay, true
	case "Filter_Env_attack", "pb-filter-env::attack":
		return p.Filter_Env_attack, true
	case "Filter_Env_decay", "pb-filter-env::decay":
		return p.Filter_Env_decay, true
	case "Filter_Env_sustain", "pb-filter-env::sustain":
		return p.Filter_Env_sustain, true
	case "Pick_Click_amplitude", "pb-click::amplitude":
		return p.Pick_Click_amplitude, true
	case "Pick_amplitude", "pb-pick::amplitude":
		return p.Pick_amplitude, true
	case "Sub_amplitude", "pb-sub::amplitude":
		return p.Sub_amplitude, true
	case "cutoff", "pb-filter::cutoff":
		return p.cutoff, true
	case "depth", "pb-amp::depth":
		return p.depth, true
	case "drive", "pb-dist::drive":
		return p.drive, true
	case "mix", "pb-dist::mix":
		return p.mix, true
	case "outMax", "pb-filter-map::outMax":
		return p.outMax, true
	case "release", "pb-amp::release":
		return p.release, true
	case "resonance", "pb-filter::resonance":
		return p.resonance, true
	case "velocitySensitivity", "pb-amp::velocitySensitivity":
		return p.velocitySensitivity, true
	}
	return 0.0, false
}

Picked_Rock_Bass_process :: proc(p: ^Picked_Rock_Bass_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	Picked_Rock_Bass_process_sequence(p)
	p.total_samples += 1

	for v_idx in 0..<6 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
			if voice.adsr_pb_amp_stage != .Release && voice.adsr_pb_amp_stage != .Idle {
				voice.adsr_pb_amp_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_pb_click_env_stage != .Release && voice.adsr_pb_click_env_stage != .Idle {
				voice.adsr_pb_click_env_stage = .Release
				voice.time_released = voice.age
			}
			if voice.adsr_pb_filter_env_stage != .Release && voice.adsr_pb_filter_env_stage != .Idle {
				voice.adsr_pb_filter_env_stage = .Release
				voice.time_released = voice.age
			}
		}
		voice_busy := false
		node_pb_amp_out: f32 = 0.0
		node_pb_click_out: f32 = 0.0
		node_pb_click_env_out: f32 = 0.0
		node_pb_dist_out: f32 = 0.0
		node_pb_filter_out: f32 = 0.0
		node_pb_filter_env_out: f32 = 0.0
		node_pb_filter_map_out: f32 = 0.0
		node_pb_mixer_out: f32 = 0.0
		node_pb_output_out: f32 = 0.0
		node_pb_pick_out: f32 = 0.0
		node_pb_sub_out: f32 = 0.0

		// --- Noise Node pb_click ---
		node_pb_click_out = (next_float32(&voice.noise_pb_click_rng) * 2.0 - 1.0) * (p.Pick_Click_amplitude);

		// --- ADSR Node pb_filter_env ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_pb_filter_env_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Filter_Env_attack) > 0 do envelope = voice.adsr_pb_filter_env_attack_start + (1.0 - voice.adsr_pb_filter_env_attack_start) * (voice.age / math.max(f32(p.Filter_Env_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_pb_filter_env_release_level = envelope;
				if voice.age >= (p.Filter_Env_attack) {
					voice.adsr_pb_filter_env_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Filter_Env_attack);
				if (p.Filter_Env_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Filter_Env_decay), 0.000001)) * (1.0 - (p.Filter_Env_sustain)); else do envelope = (p.Filter_Env_sustain);
				voice.adsr_pb_filter_env_release_level = envelope;
				if time_in_decay >= (p.Filter_Env_decay) {
					voice.adsr_pb_filter_env_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Filter_Env_sustain);
				voice.adsr_pb_filter_env_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_pb_filter_env_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.100000000)) > 0 do envelope = voice.adsr_pb_filter_env_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.100000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_pb_filter_env_stage = .Idle;
				}
			}
			vel_scale_pb_filter_env: f32 = (1.0 - (f32(0.700000000))) + (f32(0.700000000)) * voice.velocity;
			node_pb_filter_env_out = (1.0) * envelope * (f32(1.000000000)) * vel_scale_pb_filter_env;
		}

		// --- Oscillator Node pb_pick (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_pb_pick_phase[i] = math.mod(voice.osc_pb_pick_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_pb_pick_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += ((final_phase / f32(math.PI)) - 1.0);
			}
			node_pb_pick_out = (unison_out / f32(unison_count)) * (p.Pick_amplitude);
		}

		// --- Oscillator Node pb_sub (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_pb_sub_phase[i] = math.mod(voice.osc_pb_sub_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_pb_sub_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += math.sin(final_phase);
			}
			node_pb_sub_out = (unison_out / f32(unison_count)) * (p.Sub_amplitude);
		}

		// --- ADSR Node pb_click_env ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_pb_click_env_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (f32(0.001000000)) > 0 do envelope = voice.adsr_pb_click_env_attack_start + (1.0 - voice.adsr_pb_click_env_attack_start) * (voice.age / math.max(f32(f32(0.001000000)), 0.000001)); else do envelope = 1.0;
				voice.adsr_pb_click_env_release_level = envelope;
				if voice.age >= (f32(0.001000000)) {
					voice.adsr_pb_click_env_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (f32(0.001000000));
				if (p.Click_Env_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Click_Env_decay), 0.000001)) * (1.0 - (f32(0.000000000))); else do envelope = (f32(0.000000000));
				voice.adsr_pb_click_env_release_level = envelope;
				if time_in_decay >= (p.Click_Env_decay) {
					voice.adsr_pb_click_env_stage = .Sustain;
				}
			case .Sustain:
				envelope = (f32(0.000000000));
				voice.adsr_pb_click_env_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_pb_click_env_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (f32(0.020000000)) > 0 do envelope = voice.adsr_pb_click_env_release_level * (1.0 - (time_in_release / math.max(f32(f32(0.020000000)), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_pb_click_env_stage = .Idle;
				}
			}
			vel_scale_pb_click_env: f32 = (1.0 - (f32(0.700000000))) + (f32(0.700000000)) * voice.velocity;
			node_pb_click_env_out = ((node_pb_click_out)) * envelope * (f32(1.000000000)) * vel_scale_pb_click_env;
		}

		// --- Mapper Node pb_filter_map ---
		{
			in_range_pb_filter_map: f32 = f32(f32(1.000000000)) - f32(f32(0.000000000));
			if in_range_pb_filter_map == 0.0 do in_range_pb_filter_map = 1.0;
			node_pb_filter_map_out = math.lerp(f32(f32(0.000000000)), f32(p.outMax), math.clamp((f32((node_pb_filter_env_out)) - f32(f32(0.000000000))) / in_range_pb_filter_map, 0.0, 1.0));
		}

		// --- Mixer Node pb_mixer (3 inputs) ---
		{
			mix_sum_pb_mixer: f32 = 0.0;
			mix_sum_pb_mixer += node_pb_pick_out * (f32(0.600000024));
			mix_sum_pb_mixer += node_pb_sub_out * (f32(0.600000024));
			mix_sum_pb_mixer += node_pb_click_env_out * (f32(0.349999994));
		node_pb_mixer_out = mix_sum_pb_mixer;
		}

		// --- Filter Node pb_filter (SVF) ---
		{
			cutoff_c_pb_filter: f32 = math.clamp(f32((p.cutoff) + (node_pb_filter_map_out)), 10.0, sample_rate * 0.16);
			f_pb_filter := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_pb_filter / sample_rate));
			q_pb_filter: f32 = math.clamp(1.0 / math.max(f32(p.resonance), 0.1), 0.05, 1.9 - f_pb_filter);
			voice.filter_pb_filter_low += f_pb_filter * voice.filter_pb_filter_band;
			high_pb_filter := f32(((node_pb_mixer_out)) - voice.filter_pb_filter_low - q_pb_filter * voice.filter_pb_filter_band);
			voice.filter_pb_filter_band += f_pb_filter * high_pb_filter;
			node_pb_filter_out = voice.filter_pb_filter_low;
		}

		// --- Distortion Node pb_dist (soft) ---
		{
			dist_in_pb_dist: f32 = ((node_pb_filter_out));
			dist_k_pb_dist: f32 = math.max(f32(p.drive), 1.0);
			dist_wet_pb_dist: f32 = math.tanh(dist_in_pb_dist * dist_k_pb_dist);
			tone_k_pb_dist: f32 = math.clamp(2.0 * f32(math.PI) * math.clamp(f32(f32(3500.000000000)), 100.0, 20000.0) / sample_rate, 0.001, 1.0);
			voice.dist_pb_dist_tone += tone_k_pb_dist * (dist_wet_pb_dist - voice.dist_pb_dist_tone);
			mix_pb_dist: f32 = math.clamp(f32(p.mix), 0.0, 1.0);
			node_pb_dist_out = dist_in_pb_dist * (1.0 - mix_pb_dist) + voice.dist_pb_dist_tone * mix_pb_dist;
		}

		// --- ADSR Node pb_amp ---
		{
			envelope: f32 = 0.0;
			switch voice.adsr_pb_amp_stage {
			case .Idle:
				envelope = 0.0;
			case .Attack:
				if (p.Amp_attack) > 0 do envelope = voice.adsr_pb_amp_attack_start + (1.0 - voice.adsr_pb_amp_attack_start) * (voice.age / math.max(f32(p.Amp_attack), 0.000001)); else do envelope = 1.0;
				voice.adsr_pb_amp_release_level = envelope;
				if voice.age >= (p.Amp_attack) {
					voice.adsr_pb_amp_stage = .Decay;
				}
			case .Decay:
				time_in_decay := voice.age - (p.Amp_attack);
				if (p.Amp_decay) > 0 do envelope = 1.0 - (time_in_decay / math.max(f32(p.Amp_decay), 0.000001)) * (1.0 - (p.Amp_sustain)); else do envelope = (p.Amp_sustain);
				voice.adsr_pb_amp_release_level = envelope;
				if time_in_decay >= (p.Amp_decay) {
					voice.adsr_pb_amp_stage = .Sustain;
				}
			case .Sustain:
				envelope = (p.Amp_sustain);
				voice.adsr_pb_amp_release_level = envelope;
				if envelope <= 0.0001 do voice.adsr_pb_amp_stage = .Idle;
			case .Release:
				time_in_release := voice.age - voice.time_released;
				if (p.release) > 0 do envelope = voice.adsr_pb_amp_release_level * (1.0 - (time_in_release / math.max(f32(p.release), 0.000001))); else do envelope = 0.0;
				if envelope <= 0 {
					envelope = 0;
					voice.adsr_pb_amp_stage = .Idle;
				}
			}
			vel_scale_pb_amp: f32 = (1.0 - (p.velocitySensitivity)) + (p.velocitySensitivity) * voice.velocity;
			node_pb_amp_out = ((node_pb_dist_out)) * envelope * (p.depth) * vel_scale_pb_amp;
		}

		output_left += node_pb_amp_out
		output_right += node_pb_amp_out
		if voice.adsr_pb_amp_stage != .Idle do voice_busy = true
		if voice.adsr_pb_click_env_stage != .Idle do voice_busy = true
		if voice.adsr_pb_filter_env_stage != .Idle do voice_busy = true
		if !voice_busy do voice.active = false
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
Picked_Rock_Bass_process_sequence :: proc(p: ^Picked_Rock_Bass_Processor) {
	if !p.playing do return
	samples_per_step_f := p.sample_rate * 60.0 / (p.bpm * 4.0)
	if p.samples_until_next_step == 0 {
		// Track "Picked Bass" (16 steps)
		switch p.current_step % 16 {
		case 0:
			Picked_Rock_Bass_note_on(p, 28, 0.949999988, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 2:
			Picked_Rock_Bass_note_on(p, 28, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 4:
			Picked_Rock_Bass_note_on(p, 28, 0.850000024, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 6:
			Picked_Rock_Bass_note_on(p, 40, 0.899999976, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 8:
			Picked_Rock_Bass_note_on(p, 28, 0.899999976, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		case 10:
			Picked_Rock_Bass_note_on(p, 28, 0.800000012, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 12:
			Picked_Rock_Bass_note_on(p, 31, 0.879999995, f32(1.000000000) * (60.0 / p.bpm / 4.0))
		case 14:
			Picked_Rock_Bass_note_on(p, 33, 0.920000017, f32(2.000000000) * (60.0 / p.bpm / 4.0))
		}
		p.current_step += 1
		if p.current_step >= 16 {
			if p.loop {
				p.current_step = 0
			} else {
				p.playing = false
			}
		}
		p.step_frac_acc += samples_per_step_f
		n_step := u64(math.max(p.step_frac_acc, 1.0))
		p.step_frac_acc -= f32(n_step)
		p.samples_until_next_step = n_step - 1
	} else {
		p.samples_until_next_step -= 1
	}
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	Picked_Rock_Bass: ^Picked_Rock_Bass_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 0.779999971
	p.Picked_Rock_Bass = new(Picked_Rock_Bass_Processor)
	Picked_Rock_Bass_init(p.Picked_Rock_Bass, sr)
	Picked_Rock_Bass_start(p.Picked_Rock_Bass)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := Picked_Rock_Bass_process(p.Picked_Rock_Bass); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.Picked_Rock_Bass)
}

