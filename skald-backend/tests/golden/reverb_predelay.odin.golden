package generated_audio

// =====================================================================
// Generated by Skald.
//
// SFX assets: Asset
// Music Layer assets: (none)
//
// Game integration: import this package and use the per-asset APIs.
//   SFX:         <Foo>_init, <Foo>_trigger, <Foo>_process, <Foo>_is_playing
//   Music Layer: <Bar>_init, <Bar>_start, <Bar>_stop, <Bar>_process,
//                <Bar>_set_loop
//
// <Foo>_trigger with duration<=0 (the default) plays a natural one-shot:
// the envelope holds through attack+decay, then releases (a patch with no
// envelope plays 1s). Pass an explicit duration in seconds to hold longer,
// or drive <Foo>_note_on / <Foo>_note_off yourself for full control.
//
// <Foo>_note_on clamps `note` to 0..127 and `velocity` to 0..1 SILENTLY —
// it is called at audio rate, so an out-of-range argument cannot afford a
// diagnostic. Check your own values if you need to know they were wrong.
// <Foo>_note_off clamps `note` the same way, because `note` is the key it
// matches voices on: if only one side clamped, note_off(200) would fail to
// release the voice note_on(200) parked at 127, and that voice would never
// free.
//
// Effect assets (instruments with an Input node) process external audio:
// call <Foo>_feed_input(p, l, r) with one stereo sample, then <Foo>_process.
//
// project_init/process/destroy is a convenience wrapper for the test
// harness only — game code should consume per-asset procs directly.
// =====================================================================

import "core:math"
import "core:math/rand"

PRNG_State :: struct {
	state: u32,
}

next_float32 :: proc(rng: ^PRNG_State) -> f32 {
	x := rng.state
	x ~= x << 13
	x ~= x >> 17
	x ~= x << 5
	if x == 0 do x = 0xDEADBEEF
	rng.state = x
	return f32(x) / 4294967296.0
}

ADSR_Stage :: enum { Idle, Attack, Decay, Sustain, Release }

skald_wavetable_shape :: proc(idx: int, ph: f32) -> f32 {
	switch idx {
	case 1: return abs(ph * 4.0 - 2.0) - 1.0
	case 2: return ph * 2.0 - 1.0
	case 3: return ph < 0.5 ? 1.0 : -1.0
	}
	return math.sin(ph * 2.0 * f32(math.PI))
}

skald_wavetable_sample :: proc(ph: f32, pos: f32) -> f32 {
	p := math.clamp(pos, 0.0, 3.0)
	i1 := int(p)
	i2 := (i1 + 1) % 4
	frac := p - f32(i1)
	s1 := skald_wavetable_shape(i1, ph)
	s2 := skald_wavetable_shape(i2, ph)
	return s1 + (s2 - s1) * frac
}

// Soft limiter with a ceiling that really is 1.0 — plain tanh, not
// tanh(x*k)/k, which topped out above 1 and still clipped the device.
// Transparent for small signals (tanh(x) ~= x below ~0.3), saturating
// smoothly instead of clipping as the mix gets hot.
skald_soft_limit :: proc(l: f32, r: f32) -> (f32, f32) {
	return math.tanh(l), math.tanh(r)
}

Note_Event :: struct {
	note: u8,
	velocity: f32,
	start_time: f32,
	step: int,
	duration: f32,
}

Skald_Param_Info :: struct {
	name:    string,
	min:     f32,
	max:     f32,
	default: f32,
	unit:    string,
}

Asset_Voice_State :: struct {
	active: bool,
	note: u8,
	velocity: f32,
	age: f32,
	time_released: f32,
	current_freq: f32,
	target_freq: f32,
	glide_time: f32,
	duration: f32,
}

Asset_Processor :: struct {
	sample_rate: f32,
	bpm: f32,
	voices: [1]Asset_Voice_State,
	prng: PRNG_State,
	total_samples: u64,
	playing: bool,
	loop: bool,
	current_step: u64,
	samples_until_next_step: u64,
	step_frac_acc: f32,
	ext_in_l: f32,
	ext_in_r: f32,
	volume: f32,
	bus_tail_remaining: u64,
	delay_2_buffer: [96000]f32,
	delay_2_write_index: int,
	reverb_2_pre_buffer: [48000]f32,
	preDelay: f32,
}

// Worst-case seconds this asset's Delay/Reverb tail keeps sounding after
// the last voice releases; _is_playing stays true for that long so a game
// polling it cannot free the asset mid-echo. Any tail parameter that is
// exposed contributes its RANGE MAXIMUM, not its authored value, so no
// runtime set_param can make the real tail outlast this count.
Asset_BUS_TAIL_SECONDS :: f32(0.400000000)

Asset_init :: proc(p: ^Asset_Processor, sr: f32) {
	p.sample_rate = sr
	p.bpm = 120.000000000
	p.volume = 1.000000000
	p.prng.state = 12345
	p.loop = true
	p.voices = {}
	p.total_samples = 0
	p.playing = false
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
	p.ext_in_l = 0.0
	p.ext_in_r = 0.0
	p.bus_tail_remaining = 0
	p.delay_2_buffer = {}
	p.delay_2_write_index = 0
	p.reverb_2_pre_buffer = {}
	p.preDelay = 0.020000000
}

Asset_note_on :: proc(p: ^Asset_Processor, note: u8, velocity: f32, duration: f32) {
	// note and velocity are clamped silently to their MIDI/normalized domains.
	note := note
	if note > 127 do note = 127
	velocity := math.clamp(velocity, 0.0, 1.0)
	voice_idx := -1
	for i in 0..<1 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_age: f32 = -1.0
		for i in 0..<1 {
			if p.voices[i].age > oldest_age {
				oldest_age = p.voices[i].age
				voice_idx = i
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.000000000
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
}

Asset_note_off :: proc(p: ^Asset_Processor, note: u8) {
	// Clamped to match _note_on: `note` is the voice key, so both must map it.
	note := note
	if note > 127 do note = 127
	best := -1
	best_age: f32 = -1.0
	for i in 0..<1 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].active = false
	}
}

Asset_trigger :: proc(p: ^Asset_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 1.0
	}
	Asset_note_on(p, note, velocity, d)
}

Asset_feed_input :: proc(p: ^Asset_Processor, in_left: f32, in_right: f32) {
	p.ext_in_l = in_left
	p.ext_in_r = in_right
}

Asset_start :: proc(p: ^Asset_Processor) {
	p.playing = true
	p.current_step = 0
	p.samples_until_next_step = 0
	p.step_frac_acc = 0.0
}

Asset_stop :: proc(p: ^Asset_Processor) {
	p.playing = false
}

Asset_set_loop :: proc(p: ^Asset_Processor, loop: bool) {
	p.loop = loop
}

Asset_set_volume :: proc(p: ^Asset_Processor, value: f32) {
	p.volume = math.clamp(value, 0.0, 1.0)
}

Asset_is_playing :: proc(p: ^Asset_Processor) -> bool {
	if p.playing do return true
	for i in 0..<1 {
		if p.voices[i].active do return true
	}
	// The effect tail counts as playing: it is still audible after every
	// voice went inactive, and reporting false here is what let a game free
	// the asset mid-echo.
	if p.bus_tail_remaining > 0 do return true
	return false
}

Asset_set_preDelay :: proc(p: ^Asset_Processor, value: f32) {
	v := value
	if v < 0.000000000 do v = 0.000000000
	if v > 0.250000000 do v = 0.250000000
	p.preDelay = v
}

Asset_PARAMS := []Skald_Param_Info{
	{"preDelay", 0.000000000, 0.250000000, 0.020000000, "s"},
}

Asset_set_param :: proc(p: ^Asset_Processor, name: string, value: f32) -> bool {
	switch name {
	case "preDelay", "2::preDelay":
		Asset_set_preDelay(p, value)
		return true
	}
	return false
}

Asset_get_param :: proc(p: ^Asset_Processor, name: string) -> (f32, bool) {
	switch name {
	case "preDelay", "2::preDelay":
		return p.preDelay, true
	}
	return 0.0, false
}

Asset_process :: proc(p: ^Asset_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	p.total_samples += 1

	for v_idx in 0..<1 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
		}

		if voice.duration > 0.0 && voice.age >= voice.duration do voice.active = false
	}

	// --- Bus effects (once per sample, post voice sum) ---
	{
		node_1_out: f32 = 0.0
		node_2_out: f32 = 0.0
		// --- Instrument Input 1 (fed by <Foo>_feed_input) ---
		node_1_out = (p.ext_in_l + p.ext_in_r) * 0.5

		// --- Reverb Node 2 (pre-delay + feedback comb) ---
		{
			pre_delay_seconds_2: f32 = math.clamp(f32(p.preDelay), 0.0, 0.25);
			pre_delay_samples_2 := int(math.clamp(pre_delay_seconds_2 * sample_rate, 0.0, f32(48000)));
			pre_write_index_2 := p.delay_2_write_index % len(p.reverb_2_pre_buffer)
			pre_delayed_input_2 := f32((node_1_out))
			if pre_delay_samples_2 > 0 {
				pre_read_index_2 := (pre_write_index_2 - pre_delay_samples_2 + len(p.reverb_2_pre_buffer)) % len(p.reverb_2_pre_buffer)
				pre_delayed_input_2 = p.reverb_2_pre_buffer[pre_read_index_2]
			}
			p.reverb_2_pre_buffer[pre_write_index_2] = f32((node_1_out))
			delay_samples_2 := int(math.clamp((0.075000000) * sample_rate, 0, 96000-1));
			read_index_2 := (p.delay_2_write_index - delay_samples_2 + len(p.delay_2_buffer)) % len(p.delay_2_buffer);
			delayed_sample_2 := p.delay_2_buffer[read_index_2];
			decay_gain_2: f32 = math.clamp(math.pow(f32(0.001), f32(0.075) / math.max(f32(f32(0.100000000)), 0.01)), 0.0, 0.95);
			p.delay_2_buffer[p.delay_2_write_index] = pre_delayed_input_2 + delayed_sample_2 * decay_gain_2;
			p.delay_2_write_index = (p.delay_2_write_index + 1) % len(p.delay_2_buffer);
			node_2_out = ((node_1_out)) * (1.0 - (f32(1.000000000))) + delayed_sample_2 * (f32(1.000000000));
		}

		output_left += node_2_out
		output_right += node_2_out
	}

	// SKB-016: keep _is_playing true for as long as the effect tail can still
	// be heard. Re-armed on every sample anything is sounding rather than on
	// the falling edge, so the countdown is already full the moment the last
	// voice goes inactive and no edge can be missed.
	{
		voice_alive := false
		for i in 0..<1 {
			if p.voices[i].active {
				voice_alive = true
				break
			}
		}
		if voice_alive || p.playing {
			p.bus_tail_remaining = u64(Asset_BUS_TAIL_SECONDS * sample_rate)
		} else if p.bus_tail_remaining > 0 {
			p.bus_tail_remaining -= 1
		}
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
Asset_process_sequence :: proc(p: ^Asset_Processor) {
}

// --- Project Wrapper (test-harness convenience) ---
Project_State :: struct {
	Asset: ^Asset_Processor,
	master_volume: f32,
}

project_init :: proc(p: ^Project_State, sr: f32) {
	p.master_volume = 1.000000000
	p.Asset = new(Asset_Processor)
	Asset_init(p.Asset, sr)
}

project_set_master_volume :: proc(p: ^Project_State, value: f32) {
	p.master_volume = math.clamp(value, 0.0, 1.0)
}

project_process :: proc(p: ^Project_State) -> (f32, f32) {
	mixed_left: f32 = 0.0
	mixed_right: f32 = 0.0
	{ l, r := Asset_process(p.Asset); mixed_left += l; mixed_right += r }
	mixed_left *= p.master_volume
	mixed_right *= p.master_volume
	return skald_soft_limit(mixed_left, mixed_right)
}

project_destroy :: proc(p: ^Project_State) {
	free(p.Asset)
}

