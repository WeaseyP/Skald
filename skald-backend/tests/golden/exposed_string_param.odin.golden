Asset_set_volume :: proc(p: ^Asset_Processor, value: f32) {
	p.volume = math.clamp(value, 0.0, 1.0)
}

Asset_is_playing :: proc(p: ^Asset_Processor) -> bool {
	if p.playing do return true
	for i in 0..<1 {
		if p.voices[i].active do return true
	}
	return false
}

Asset_set_cutoff :: proc(p: ^Asset_Processor, value: f32) {
	v := value
	if v < 20.000000000 do v = 20.000000000
	if v > 20000.000000000 do v = 20000.000000000
	p.cutoff = v
}

Asset_PARAMS := []Skald_Param_Info{
	{"cutoff", 20.000000000, 20000.000000000, 800.000000000, "Hz"},
}

Asset_set_param :: proc(p: ^Asset_Processor, name: string, value: f32) -> bool {
	switch name {
	case "cutoff", "flt::cutoff":
		Asset_set_cutoff(p, value)
		return true
	}
	return false
}

Asset_get_param :: proc(p: ^Asset_Processor, name: string) -> (f32, bool) {
	switch name {
	case "cutoff", "flt::cutoff":
		return p.cutoff, true
	}
	return 0.0, false
}

Asset_process :: proc(p: ^Asset_Processor) -> (f32, f32) {
	sample_rate := p.sample_rate
	output_left: f32 = 0.0
	output_right: f32 = 0.0
	p.total_samples += 1

	for v_idx in 0..<1 {
		voice := &p.voices[v_idx]
		if !voice.active do continue

		voice.age += 1.0 / sample_rate;
		if voice.age >= voice.duration && voice.duration > 0.0 {
		}
		node_flt_out: f32 = 0.0
		node_midi_out: f32 = 0.0
		node_osc_out: f32 = 0.0
		node_out_out: f32 = 0.0

		// --- MIDI Input Node midi ---
		node_midi_out_pitch := (f32(voice.note) - 69.0) / 12.0
		node_midi_out_gate := f32(1.0)
		if voice.time_released > 0.0 do node_midi_out_gate = 0.0
		node_midi_out_velocity := voice.velocity

		// --- Oscillator Node osc (Unison/Detune) ---
		{
			unison_out: f32 = 0.0;
			unison_count := 1;
			for i in 0..<unison_count {
				detune_amount: f32 = 0.0;
				if unison_count > 1 do detune_amount = (f32(i) / (f32(unison_count) - 1.0) - 0.5) * 2.0 * (0.000000000);
				detuned_freq: f32 = (voice.current_freq) * math.pow(2.0, detune_amount / 1200.0);
				phase_rads: f32 = f32(f32(0.000000000)) * (f32(math.PI) / 180.0);
				voice.osc_osc_phase[i] = math.mod(voice.osc_osc_phase[i] + (2 * f32(math.PI) * detuned_freq / sample_rate), 2 * f32(math.PI));
				final_phase := math.mod(voice.osc_osc_phase[i] + phase_rads, 2 * f32(math.PI));
				unison_out += ((final_phase / f32(math.PI)) - 1.0);
			}
			node_osc_out = (unison_out / f32(unison_count)) * (f32(0.400000000));
		}

		// --- Filter Node flt (SVF) ---
		{
			cutoff_c_flt: f32 = math.clamp(f32(p.cutoff), 10.0, sample_rate * 0.16);
			f_flt := f32(2.0 * math.sin(f32(math.PI) * cutoff_c_flt / sample_rate));
			q_flt: f32 = math.clamp(1.0 / math.max(f32(f32(1.000000000)), 0.1), 0.05, 1.9 - f_flt);
			voice.filter_flt_low += f_flt * voice.filter_flt_band;
			high_flt := f32(((node_osc_out)) - voice.filter_flt_low - q_flt * voice.filter_flt_band);
			voice.filter_flt_band += f_flt * high_flt;
			node_flt_out = voice.filter_flt_low;
		}

		output_left += node_flt_out
		output_right += node_flt_out
		if voice.duration > 0.0 && voice.age >= voice.duration do voice.active = false
	}
	return skald_soft_limit(output_left * p.volume, output_right * p.volume)
}
