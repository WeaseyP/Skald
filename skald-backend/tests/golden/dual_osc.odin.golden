Asset_note_on :: proc(p: ^Asset_Processor, note: u8, velocity: f32, duration: f32) {
	// note and velocity are clamped silently to their MIDI/normalized domains.
	note := note
	if note > 127 do note = 127
	velocity := math.clamp(velocity, 0.0, 1.0)
	voice_idx := -1
	for i in 0..<8 {
		if !p.voices[i].active {
			voice_idx = i
			break
		}
	}
	stolen := false
	if voice_idx == -1 {
		stolen = true
		oldest_releasing_age: f32 = -1.0
		for i in 0..<8 {
			releasing := true
			if p.voices[i].adsr_4_stage != .Release && p.voices[i].adsr_4_stage != .Idle do releasing = false
			if releasing && p.voices[i].age > oldest_releasing_age {
				oldest_releasing_age = p.voices[i].age
				voice_idx = i
			}
		}
		if voice_idx == -1 {
			oldest_age: f32 = -1.0
			for i in 0..<8 {
				if p.voices[i].age > oldest_age {
					oldest_age = p.voices[i].age
					voice_idx = i
				}
			}
		}
	}

	v := &p.voices[voice_idx]
	prev_freq := v.current_freq
	adsr_4_prev_level: f32 = 0.0
	if stolen && v.adsr_4_stage != .Idle {
		adsr_4_prev_level = v.adsr_4_release_level
		if v.adsr_4_stage == .Release {
			rel_t_4: f32 = (p.release);
			if rel_t_4 > 0.0 {
				rf_4 := 1.0 - (v.age - v.time_released) / math.max(rel_t_4, 0.000001)
				if rf_4 < 0.0 do rf_4 = 0.0
				adsr_4_prev_level *= rf_4
			} else {
				adsr_4_prev_level = 0.0
			}
		}
	}
	v.active = true
	v.note = note
	v.velocity = velocity
	v.age = 0.0
	v.time_released = 0.0
	freq := 440.0 * math.pow(2.0, (f32(note) - 69.0) / 12.0)
	v.target_freq = freq
	v.glide_time = 0.050000001
	if stolen && v.glide_time > 0.0 && prev_freq > 0.0 {
		v.current_freq = prev_freq
	} else {
		v.current_freq = freq
	}
	v.duration = duration
	v.adsr_4_stage = .Attack
	v.adsr_4_attack_start = adsr_4_prev_level
	v.adsr_4_release_level = adsr_4_prev_level
	if !stolen {
		v.osc_1_phase = {}
		v.osc_2_phase = {}
	}
}

Asset_note_off :: proc(p: ^Asset_Processor, note: u8) {
	// Clamped to match _note_on: `note` is the voice key, so both must map it.
	note := note
	if note > 127 do note = 127
	best := -1
	best_age: f32 = -1.0
	for i in 0..<8 {
		if p.voices[i].active && p.voices[i].note == note {
			if p.voices[i].adsr_4_stage == .Release do continue
			if p.voices[i].age > best_age {
				best_age = p.voices[i].age
				best = i
			}
		}
	}
	if best >= 0 {
		p.voices[best].time_released = p.voices[best].age
		p.voices[best].adsr_4_stage = .Release
	}
}

Asset_trigger :: proc(p: ^Asset_Processor, note: u8 = 60, velocity: f32 = 1.0, duration: f32 = 0.0) {
	d := duration
	if d <= 0.0 {
		d = 0.0
		if (p.attack) + (p.decay) > d do d = (p.attack) + (p.decay)
		if d <= 0.0 do d = 0.001
	}
	Asset_note_on(p, note, velocity, d)
}

