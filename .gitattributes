# Normalize line endings: LF in the repo, native on checkout.
* text=auto

# Windows batch files must stay CRLF (cmd.exe misparses LF-only labels).
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binaries — never normalize.
*.exe binary
*.wasm binary
*.png binary
*.jpg binary
*.ico binary
*.icns binary

# Goldens are compared byte-for-byte against what the generator emits (LF). On an
# autocrlf checkout or a `git archive` export they came out CRLF, and cmd's `fc` text
# mode wraps lines longer than its buffer differently with CR present, so a golden
# whose only long line was the E8 warp call read as a diff in a pristine tree while
# 68 others passed. Pin them to LF so the checkout is the emission.
*.golden text eol=lf
# The checked-in generated_audio.odin copies are compared the same way (regen_generated.bat,
# `fc` text mode) and hit the same wrap quirk on the integration demo's long lines.
**/generated_audio/generated_audio.odin text eol=lf
